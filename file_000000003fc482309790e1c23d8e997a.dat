import numpy as np
import pandas as pd
import requests
from io import StringIO

DATAFLOW = None

AGE_GROUPS = ["child", "young", "middle", "senior"]
INCOME_GROUPS = ["low", "medium", "high"]
EDUCATION = ["low", "medium", "high"]
HOUSEHOLD_TYPES = ["single", "couple", "family", "other"]
SOCIAL_TYPES = ["traditional", "progressive", "pragmatic", "disengaged"]

BEHAVIOUR_COLS = [
    "vote_propensity",
    "voluntary_work",
    "community_participation",
    "institutional_trust",
    "life_satisfaction",
    "risk_tolerance",
]

def fetch_abs_census_joint():
    if DATAFLOW is None:
        return None

def baseline_joint_distribution_fallback():
    p_age = np.array([0.15, 0.27, 0.38, 0.20])
    p_age = p_age / p_age.sum()

    p_income_given_age = np.array([
        [0.55, 0.35, 0.10],
        [0.40, 0.40, 0.20],
        [0.25, 0.45, 0.30],
        [0.35, 0.45, 0.20],
    ])
    p_income_given_age = p_income_given_age / p_income_given_age.sum(axis=1, keepdims=True)

    p_edu_given_age = np.array([
        [0.55, 0.35, 0.10],
        [0.30, 0.45, 0.25],
        [0.25, 0.45, 0.30],
        [0.40, 0.40, 0.20],
    ])
    p_edu_given_age = p_edu_given_age / p_edu_given_age.sum(axis=1, keepdims=True)

    base_p_hh = np.array([0.20, 0.25, 0.45, 0.10])

    def p_hh_given_age_income(age_idx, income_idx):
        p = base_p_hh.copy().astype(float)
        if AGE_GROUPS[age_idx] == "young":
            if INCOME_GROUPS[income_idx] == "low":
                p *= [1.6, 0.9, 0.7, 0.8]
            elif INCOME_GROUPS[income_idx] == "medium":
                p *= [1.3, 1.0, 0.9, 0.8]
            else:
                p *= [1.2, 1.1, 0.9, 0.8]
        elif AGE_GROUPS[age_idx] == "middle":
            if INCOME_GROUPS[income_idx] == "low":
                p *= [0.9, 0.9, 1.2, 1.0]
            elif INCOME_GROUPS[income_idx] == "medium":
                p *= [0.8, 1.0, 1.3, 0.9]
            else:
                p *= [0.7, 1.1, 1.4, 0.8]
        elif AGE_GROUPS[age_idx] == "senior":
            p *= [0.7, 1.2, 0.9, 1.2]
        else:
            p *= [0.4, 0.8, 1.6, 0.6]

        p = p / p.sum()
        return p

    records = []
    for ai, age in enumerate(AGE_GROUPS):
        for ii, income in enumerate(INCOME_GROUPS):
            for ei, edu in enumerate(EDUCATION):
                for hi, hh in enumerate(HOUSEHOLD_TYPES):
                    prob = (
                        p_age[ai]
                        * p_income_given_age[ai, ii]
                        * p_edu_given_age[ai, ei]
                        * p_hh_given_age_income(ai, ii)[hi]
                    )
                    records.append({
                        "age": age,
                        "income": income,
                        "education": edu,
                        "household_type": hh,
                        "prob": prob,
                    })

    df = pd.DataFrame(records)
    df["prob"] = df["prob"] / df["prob"].sum()
    return df

def baseline_joint_distribution():
    df_abs = fetch_abs_census_joint()
    if df_abs is not None:
        print("Using ABS Census-derived joint distribution.")
        return df_abs
    else:
        print("ABS data not available; using fallback synthetic joint distribution.")
        return baseline_joint_distribution_fallback()

MAGIC_RATIOS = {
    "balanced": {"single": 0.25, "couple": 0.25, "family": 0.40, "other": 0.10},
}

def reweight_to_target_marginal(df_joint, target_marginal, group_col="household_type"):
    df = df_joint.copy()
    current = df.groupby(group_col)["prob"].sum().reindex(HOUSEHOLD_TYPES).fillna(0)
    target = pd.Series(target_marginal).reindex(HOUSEHOLD_TYPES).fillna(0)

    ratio = target / current.replace(0, np.nan)
    ratio = ratio.fillna(0)

    df["prob_adj"] = df["prob"] * df[group_col].map(ratio)
    df["prob_adj"] = df["prob_adj"] / df["prob_adj"].sum()
    return df, ratio

BASE_BEHAVIOUR = {
    "traditional": {"vote_propensity": 0.85, "voluntary_work": 0.22, "community_participation": 0.55, "institutional_trust": 0.60, "life_satisfaction": 0.72, "risk_tolerance": 0.35},
    "progressive": {"vote_propensity": 0.80, "voluntary_work": 0.26, "community_participation": 0.62, "institutional_trust": 0.45, "life_satisfaction": 0.70, "risk_tolerance": 0.55},
    "pragmatic": {"vote_propensity": 0.88, "voluntary_work": 0.24, "community_participation": 0.52, "institutional_trust": 0.55, "life_satisfaction": 0.73, "risk_tolerance": 0.40},
    "disengaged": {"vote_propensity": 0.55, "voluntary_work": 0.10, "community_participation": 0.28, "institutional_trust": 0.30, "life_satisfaction": 0.58, "risk_tolerance": 0.38},
}

DEMO_MOD = {
    "vote_propensity": {"age": 0.06, "income": 0.02, "education": 0.04},
    "voluntary_work": {"age": 0.02, "income": 0.01, "education": 0.06},
    "community_participation": {"age": 0.00, "income": 0.02, "education": 0.05},
    "institutional_trust": {"age": 0.04, "income": 0.03, "education": -0.02},
    "life_satisfaction": {"age": -0.01, "income": 0.06, "education": 0.02},
    "risk_tolerance": {"age": -0.06, "income": 0.03, "education": 0.02},
}

def social_type_scores(row):
    age = row["age"]; income = row["income"]; edu = row["education"]; hh = row["household_type"]
    age_map = {"child": 0, "young": 1, "middle": 2, "senior": 3}
    income_map = {"low": 0, "medium": 1, "high": 2}
    edu_map = {"low": 0, "medium": 1, "high": 2}
    hh_map = {"single": 0, "couple": 1, "family": 2, "other": 3}

    a = age_map[age] / 3.0
    inc = income_map[income] / 2.0
    e = edu_map[edu] / 2.0
    h = hh_map[hh]

    scores = {}
    scores["traditional"] = 0.6 * a + 0.2 * (1.0 - e) + 0.2 * (1.0 if h in [1, 2] else 0.3)
    scores["progressive"] = 0.5 * (1.0 - a) + 0.4 * e + 0.1 * (1.0 if h in [0, 1] else 0.3)
    scores["pragmatic"] = 0.5 * (1.0 - abs(a - 2/3)) + 0.3 * (1.0 - abs(inc - 0.5)) + 0.2 * (1.0 if h == 2 else 0.5)
    scores["disengaged"] = 0.5 * (1.0 - inc) + 0.3 * (1.0 - e) + 0.2 * (1.0 if h in [0, 3] else 0.4)
    return scores

def sample_social_type(row, rng=None):
    if rng is None:
        rng = np.random.default_rng()
    scores = social_type_scores(row)
    types = list(scores.keys())
    s = np.array([scores[t] for t in types], dtype=float)
    temp = 1.0
    exp_s = np.exp(s / temp)
    probs = exp_s / exp_s.sum()
    chosen = rng.choice(types, p=probs)
    return chosen, probs

def generate_behaviour(row, social_type, rng=None):
    if rng is None:
        rng = np.random.default_rng()
    base = BASE_BEHAVIOUR[social_type].copy()
    age_map = {"child": 0, "young": 1, "middle": 2, "senior": 3}
    income_map = {"low": 0, "medium": 1, "high": 2}
    edu_map = {"low": 0, "medium": 1, "high": 2}
    a = age_map[row["age"]] / 3.0
    inc = income_map[row["income"]] / 2.0
    e = edu_map[row["education"]] / 2.0

    out = {}
    for k in BEHAVIOUR_COLS:
        val = base[k]
        mod = DEMO_MOD[k]
        val += mod["age"] * (a - 0.5)
        val += mod["income"] * (inc - 0.5)
        val += mod["education"] * (e - 0.5)
        noise = rng.normal(0.0, 0.03)
        val = np.clip(val + noise, 0.0, 1.0)
        out[k] = val
    return out

def sample_synthetic_population_with_behaviour(df_weighted, n_samples, seed=0, community_type="balanced"):
    rng = np.random.default_rng(seed)
    probs = df_weighted["prob_adj"].to_numpy()
    indices = rng.choice(len(df_weighted), size=n_samples, p=probs)
    base_sample = df_weighted.iloc[indices].reset_index(drop=True)

    records = []
    for i, row in base_sample.iterrows():
        social_type, type_probs = sample_social_type(row, rng=rng)
        behav = generate_behaviour(row, social_type, rng=rng)
        rec = {"id": i, "age": row["age"], "income": row["income"], "education": row["education"], "household_type": row["household_type"], "social_type": social_type}
        rec.update(behav)
        for t in SOCIAL_TYPES:
            rec[f"type_prob_{t}"] = type_probs[SOCIAL_TYPES.index(t)]
        records.append(rec)
    return pd.DataFrame(records)

from scipy.optimize import minimize

def simulate_for_household_mix(hh_mix, n_samples=5000, seed=None):
    hh_mix = np.array(hh_mix)
    if np.any(hh_mix < 0) or not np.isclose(hh_mix.sum(), 1.0):
        return None
    target_marginal = {"single": float(hh_mix[0]), "couple": float(hh_mix[1]), "family": float(hh_mix[2]), "other": float(hh_mix[3])}
    df_joint = baseline_joint_distribution()
    df_weighted, ratio = reweight_to_target_marginal(df_joint, target_marginal, group_col="household_type")
    sample = sample_synthetic_population_with_behaviour(df_weighted, n_samples, seed=seed or 0, community_type="optimised")
    return sample

def objective_function(hh_mix, n_samples=5000, seed_base=123):
    sample = simulate_for_household_mix(hh_mix, n_samples=n_samples, seed=seed_base)
    if sample is None:
        return 1e6
    means = sample[BEHAVIOUR_COLS].mean()
    score = 1.0 * means["institutional_trust"] + 1.0 * means["community_participation"] + 1.0 * means["voluntary_work"]
    return -score

def optimise_magic_ratios(n_samples=5000, seed_base=123):
    x0 = np.array([0.25, 0.25, 0.40, 0.10])
    constraints = {"type": "eq", "fun": lambda x: x.sum() - 1.0}
    bounds = [(0.0, 1.0) for _ in range(4)]
    res = minimize(lambda x: objective_function(x, n_samples=n_samples, seed_base=seed_base), x0, method="SLSQP", bounds=bounds, constraints=constraints, options={"maxiter": 20, "ftol": 1e-3})
    if not res.success:
        print("Optimisation warning:", res.message)
    best_mix = res.x
    best_mix = best_mix / best_mix.sum()
    best_sample = simulate_for_household_mix(best_mix, n_samples, seed_base)
    return res, best_sample, best_mix

if __name__ == "__main__":
    print("=== Testing baseline ===")
    df_joint = baseline_joint_distribution()
    print(df_joint.head())
    print("\n=== Testing optimisation ===")
    res, best_sample, best_mix = optimise_magic_ratios(n_samples=2000, seed_base=99)
    print("success:", res.success, "message:", res.message)
    print("nit:", res.nit, "nfev:", res.nfev)
    print("x0:", [0.25,0.25,0.40,0.10])
    print("best_mix:", best_mix)
    print("fun:", res.fun)