from __future__ import annotations

from concurrent.futures import ProcessPoolExecutor, as_completed
from dataclasses import dataclass, field
from multiprocessing import freeze_support
from typing import Callable, Optional, Sequence
import random
import time

"""
Equation-driven subset-sum solver -- memory/compute-efficient version.

Two changes from the earlier version, both needed once n gets into the
millions:

1. PATH REPRESENTATION: paths were stored as Python lists and rebuilt with
   `path + [x]` on every "include" step -- that's an O(depth) copy PER
   CANDIDATE PER STEP, so total path-copying cost alone is O(width * n^2)
   in the worst case. Fixed by using an immutable linked-list ("cons cell":
   (value, parent_node)) instead. Extending a path is now O(1): "exclude"
   reuses the same node reference, "include" allocates exactly one new
   node. The full path is only ever materialized once, at the very end,
   by walking the parent chain of the winning candidate.

2. BEAM WIDTH CAP: n**c is not a usable real-world cap once n is large
   (2_490_000**2 ~ 6.2e12 -- you cannot materialize trillions of beam
   candidates). Added an explicit `max_beam_width` that hard-caps memory
   regardless of what the formula's n^c theoretically allows -- this is
   the actual, honest cap; n^c was never enforceable as a memory bound.

Also: dedup by partial sum (many different item combinations often land
on the same partial sum -- no need to keep more than one path per sum),
and use heapq.nsmallest instead of a full sort to pick the width-best
candidates in O(m log width) instead of O(m log m).
"""

import math, random, heapq
from itertools import islice


def _materialize(node):
    """Walk an immutable path linked-list back to a plain Python list."""
    out = []
    while node is not None:
        val, node = node
        out.append(val)
    out.reverse()
    return out


def equation_beam_search(nums, target, r, c=2, max_beam_width=2000):
    """
    Beam search where beam width at step k is driven by the image's
    formula, log-space to avoid overflow, and hard-capped at
    max_beam_width for actual memory sanity.
    """
    n = len(nums)
    theoretical_cap = n ** c  # kept only for reporting; NOT used as the real cap
    cap = min(theoretical_cap, max_beam_width)

    # beam: list of (partial_sum, path_node)   path_node is None or (value, parent)
    beam = [(0, None)]

    for k in range(1, n + 1):
        x = nums[k - 1]

        # dedupe by partial sum as we expand -- keep first path reaching each sum
        seen = {}
        for partial, node in beam:
            # exclude: path unchanged, O(1), no copy
            if partial not in seen:
                seen[partial] = node
            # include
            new_partial = partial + x
            if new_partial <= target and new_partial not in seen:
                seen[new_partial] = (x, node)   # O(1) cons, no list copy

        if target in seen:
            return _materialize(seen[target]), k

        # ---- THE EQUATION DRIVES THE PRUNING (log-space, hard-capped) ----
        log_width = n * math.log(2) + k * math.log(1 - r)
        if log_width > math.log(cap):
            width = cap
        else:
            width = max(1, min(cap, math.ceil(math.exp(log_width))))

        items = seen.items()
        if len(items) <= width:
            beam = list(items)
        else:
            # O(m log width) partial selection instead of O(m log m) full sort
            beam = heapq.nsmallest(width, items, key=lambda kv: abs(target - kv[0]))

    return None, n


def measure_r(nums, sample_size=24, subset_fraction=5, seed=None):
    """
    Automatically estimate r for THIS dataset, instead of the caller
    guessing a number.

    Method: take a random sample of `sample_size` items from nums, build
    a target for that sample the same way real subset-sum targets arise
    (sum of a random subset of the sample), then run REAL branch-and-bound
    (with actual pruning, no beam-width tricks) on just that small sample.
    Its node count vs the sample's own 2^sample_size gives an honest,
    instance-specific r via r = 1 - (nodes / 2^sample_size)^(1/sample_size)
    -- same relationship as before, just automated instead of hand-fed.

    This is a PILOT MEASUREMENT, not a proof: it assumes the sample is
    representative of the full array's value distribution. If nums has
    very non-uniform structure (e.g. clustered vs spread-out regions),
    the measured r may not hold everywhere -- same caveat as always.
    """
    rng = random.Random(seed)
    sample_size = min(sample_size, len(nums))
    sample = rng.sample(nums, sample_size)
    k = max(1, min(subset_fraction, sample_size))
    sample_target = sum(rng.sample(sample, k))

    n = sample_size
    suffix = [0] * (n + 1)
    for i in range(n - 1, -1, -1):
        suffix[i] = suffix[i + 1] + sample[i]

    nodes = 0
    stack = [(0, 0)]
    while stack:
        i, partial = stack.pop()
        nodes += 1
        if partial == sample_target:
            break
        if i == n or partial > sample_target or partial + suffix[i] < sample_target:
            continue
        stack.append((i + 1, partial))
        stack.append((i + 1, partial + sample[i]))

    total = 2 ** n
    ratio = max(nodes / total, 1e-300)     # guard against log(0)
    r = 1 - math.exp(math.log(ratio) / n)
    r = min(max(r, 1e-6), 1 - 1e-6)        # keep strictly inside (0,1)

    return r, nodes, sample_size, sample_target


def run(label, nums, target, c=2, max_beam_width=2000, r=None, seed=None):
    n = len(nums)

    if r is None:
        r, sample_nodes, sample_n, sample_target = measure_r(nums, seed=seed)
        print(f"=== {label}  (n={n}, target={target}, c={c}, "
              f"max_beam_width={max_beam_width}) ===")
        print(f"auto-measured r: pilot search on {sample_n} sampled items "
              f"(target={sample_target}) visited {sample_nodes} nodes "
              f"-> r = {r:.4f}")
    else:
        print(f"=== {label}  (n={n}, target={target}, r={r} [manual], c={c}, "
              f"max_beam_width={max_beam_width}) ===")

    result, steps_used = equation_beam_search(nums, target, r, c, max_beam_width)
    print(f"equation-driven beam search: "
          f"{'found ' + str(result) if result else 'FAILED to find one'}"
          f"  (ran {steps_used} steps)")
    print()


# Hardware-independent top-level callbacks. Replace these with GPIO/motor code.
DEMO_TOUCH_STATE = False


def read_demo_touch_pin() -> bool:
    return DEMO_TOUCH_STATE


def demo_motor_move(limb: str, axis: str, move: int) -> None:
    global DEMO_TOUCH_STATE
    print(f"MOTOR: {limb} {axis}-axis move {move}")

    # Demonstration only: create contact during one simulated move.
    if limb == "right_arm" and axis == "x" and move == 230:
        DEMO_TOUCH_STATE = True


def demo_emergency_stop(limb: str, axis: str, reason: str) -> None:
    print(f"!!! EMERGENCY STOP: {limb} {axis}-axis: {reason}")


def normalize_angle(angle_deg: float) -> float:
    return (angle_deg + 180.0) % 360.0 - 180.0


@dataclass(frozen=True)
class DeadAngle:
    start_deg: float
    end_deg: float
    name: str = "dead-angle"

    def contains(self, angle_deg: float) -> bool:
        angle = normalize_angle(angle_deg)
        start = normalize_angle(self.start_deg)
        end = normalize_angle(self.end_deg)
        if start <= end:
            return start <= angle <= end
        return angle >= start or angle <= end


@dataclass
class TouchSensor:
    read_pressed: Callable[[], bool]
    debounce_ms: int = 30
    active_high: bool = True
    _last_raw: bool = field(default=False, init=False)
    _stable_state: bool = field(default=False, init=False)
    _changed_at: float = field(default_factory=time.monotonic, init=False)

    def pressed(self) -> bool:
        raw = bool(self.read_pressed())
        if not self.active_high:
            raw = not raw

        now = time.monotonic()
        if raw != self._last_raw:
            self._last_raw = raw
            self._changed_at = now

        if (now - self._changed_at) * 1000.0 >= self.debounce_ms:
            self._stable_state = raw

        return self._stable_state


@dataclass
class AxisJob:
    limb: str
    axis: str
    moves: Sequence[int]
    target: int
    is_approach_axis: bool = False
    c: float = 2.0
    max_beam_width: int = 2000
    r: Optional[float] = None
    seed: Optional[int] = None
    dead_angles: Sequence[DeadAngle] = field(default_factory=tuple)
    current_angle_deg: float = 0.0
    degrees_per_move: float = 1.0


@dataclass
class AxisResult:
    limb: str
    axis: str
    found: bool
    moves_used: list[int] = field(default_factory=list)
    steps_used: int = 0
    r_used: Optional[float] = None
    is_approach_axis: bool = False
    single_stroke: Optional[bool] = None
    safety_triggered: bool = False
    safety_reason: Optional[str] = None
    stopped_angle_deg: Optional[float] = None


def angle_blocked(angle_deg: float, dead_angles: Sequence[DeadAngle]) -> bool:
    return any(zone.contains(angle_deg) for zone in dead_angles)


def angle_reason(angle_deg: float, dead_angles: Sequence[DeadAngle]) -> str:
    names = [zone.name for zone in dead_angles if zone.contains(angle_deg)]
    return ", ".join(names) if names else "clear"


def path_enters_dead_angle(
    current_angle_deg: float,
    next_angle_deg: float,
    dead_angles: Sequence[DeadAngle],
    samples: int = 32,
) -> bool:
    for i in range(max(2, samples) + 1):
        fraction = i / max(2, samples)
        angle = current_angle_deg + (next_angle_deg - current_angle_deg) * fraction
        if angle_blocked(angle, dead_angles):
            return True
    return False


def plan_is_safe(job: AxisJob, moves: Sequence[int]) -> bool:
    angle = job.current_angle_deg
    if angle_blocked(angle, job.dead_angles):
        return False

    for move in moves:
        next_angle = angle + move * job.degrees_per_move
        if path_enters_dead_angle(angle, next_angle, job.dead_angles):
            return False
        angle = next_angle

    return True


def solve_candidate(
    job: AxisJob,
    candidate: Optional[Sequence[int]],
    steps: int,
    r_used: Optional[float],
    single_stroke: Optional[bool],
) -> AxisResult:
    if candidate is None:
        return AxisResult(
            limb=job.limb,
            axis=job.axis,
            found=False,
            steps_used=steps,
            r_used=r_used,
            is_approach_axis=job.is_approach_axis,
            single_stroke=single_stroke,
        )

    candidate = list(candidate)
    if not plan_is_safe(job, candidate):
        return AxisResult(
            limb=job.limb,
            axis=job.axis,
            found=False,
            steps_used=steps,
            r_used=r_used,
            is_approach_axis=job.is_approach_axis,
            single_stroke=single_stroke,
            safety_triggered=True,
            safety_reason="planned path enters dead angle",
            stopped_angle_deg=job.current_angle_deg,
        )

    return AxisResult(
        limb=job.limb,
        axis=job.axis,
        found=True,
        moves_used=candidate,
        steps_used=steps,
        r_used=r_used,
        is_approach_axis=job.is_approach_axis,
        single_stroke=single_stroke,
    )


def _solve_one_axis(job: AxisJob) -> AxisResult:
    if job.is_approach_axis and job.target in job.moves:
        return solve_candidate(job, [job.target], 1, None, True)

    r_used = job.r
    if r_used is None:
        r_used, _, _, _ = measure_r(job.moves, seed=job.seed)

    result, steps = equation_beam_search(
        job.moves,
        job.target,
        r_used,
        c=job.c,
        max_beam_width=job.max_beam_width,
    )

    return solve_candidate(
        job,
        result,
        steps,
        r_used,
        False if job.is_approach_axis else None,
    )


def solve_all_limbs(
    jobs: Sequence[AxisJob],
    max_workers: Optional[int] = None,
) -> dict[tuple[str, str], AxisResult]:
    results: dict[tuple[str, str], AxisResult] = {}

    with ProcessPoolExecutor(max_workers=max_workers) as pool:
        futures = {
            pool.submit(_solve_one_axis, job): (job.limb, job.axis)
            for job in jobs
        }
        for future in as_completed(futures):
            key = futures[future]
            results[key] = future.result()

    return results


def execute_axis_moves(
    job: AxisJob,
    moves: Sequence[int],
    touch_sensor: Optional[TouchSensor] = None,
    move_callback: Optional[Callable[[str, str, int], None]] = None,
    stop_callback: Optional[Callable[[str, str, str], None]] = None,
) -> tuple[list[int], bool, Optional[str], float]:
    executed: list[int] = []
    current_angle = job.current_angle_deg

    for move in moves:
        if touch_sensor is not None and touch_sensor.pressed():
            reason = "touch sensor pressed"
            if stop_callback:
                stop_callback(job.limb, job.axis, reason)
            return executed, True, reason, current_angle

        if angle_blocked(current_angle, job.dead_angles):
            reason = angle_reason(current_angle, job.dead_angles)
            if stop_callback:
                stop_callback(job.limb, job.axis, reason)
            return executed, True, reason, current_angle

        next_angle = current_angle + move * job.degrees_per_move
        if path_enters_dead_angle(current_angle, next_angle, job.dead_angles):
            reason = "planned move enters dead angle"
            if stop_callback:
                stop_callback(job.limb, job.axis, reason)
            return executed, True, reason, current_angle

        if move_callback:
            move_callback(job.limb, job.axis, move)

        executed.append(move)
        current_angle = next_angle

        if touch_sensor is not None and touch_sensor.pressed():
            reason = "touch sensor pressed during movement"
            if stop_callback:
                stop_callback(job.limb, job.axis, reason)
            return executed, True, reason, current_angle

    return executed, False, None, current_angle


def print_grasp_plan(limb: str, axis_results: dict[str, AxisResult]) -> None:
    tangential = [(a, r) for a, r in axis_results.items() if not r.is_approach_axis]
    approach = [(a, r) for a, r in axis_results.items() if r.is_approach_axis]

    print(f"\n=== {limb}: grasp plan ===")

    safety_failures = [(a, r) for a, r in axis_results.items() if r.safety_triggered]
    if safety_failures:
        print("  SAFETY STOP -- dead-angle signal:")
        for axis, result in safety_failures:
            print(
                f"    {axis}-axis: {result.safety_reason}; "
                f"angle={result.stopped_angle_deg}"
            )
        return

    missing = [a for a, r in axis_results.items() if not r.found]
    if missing:
        print(f"  INCOMPLETE -- no safe combination for: {missing}")
        return

    print("  Phase 1 -- tangential positioning:")
    for axis, result in tangential:
        print(f"    {axis}-axis: moves {result.moves_used} (sum {sum(result.moves_used)})")

    print("  Phase 2 -- perpendicular approach into receptacle:")
    for axis, result in approach:
        note = (
            "single clean stroke, 90° into receptacle"
            if result.single_stroke
            else "WARNING: no single move fit -- multi-step approach"
        )
        print(f"    {axis}-axis: moves {result.moves_used} (sum {sum(result.moves_used)}) -- {note}")


def execute_grasp_plan(
    limb: str,
    jobs_by_axis: dict[str, AxisJob],
    results_by_axis: dict[str, AxisResult],
    touch_sensor: Optional[TouchSensor] = None,
    move_callback: Optional[Callable[[str, str, int], None]] = None,
    stop_callback: Optional[Callable[[str, str, str], None]] = None,
) -> dict:
    ordered_axes = sorted(
        jobs_by_axis,
        key=lambda axis: jobs_by_axis[axis].is_approach_axis,
    )

    for axis in ordered_axes:
        job = jobs_by_axis[axis]
        result = results_by_axis[axis]

        if not result.found:
            return {
                "completed": False,
                "axis": axis,
                "reason": result.safety_reason or "axis has no solution",
            }

        executed, stopped, reason, final_angle = execute_axis_moves(
            job,
            result.moves_used,
            touch_sensor=touch_sensor,
            move_callback=move_callback,
            stop_callback=stop_callback,
        )

        if stopped:
            return {
                "completed": False,
                "axis": axis,
                "executed_moves": executed,
                "reason": reason,
                "final_angle_deg": final_angle,
            }

        job.current_angle_deg = final_angle

    return {"completed": True, "limb": limb}


def _demo() -> None:
    global DEMO_TOUCH_STATE
    DEMO_TOUCH_STATE = False
    random.seed(4)

    touch_sensor = TouchSensor(
        read_pressed=read_demo_touch_pin,
        debounce_ms=0,
        active_high=True,
    )

    limbs_config = {
        "left_arm": {
            "approach_axis": "z",
            "dead_angles": (
                DeadAngle(80.0, 100.0, "left receptacle wall"),
                DeadAngle(-15.0, 15.0, "left mechanical dead angle"),
            ),
        },
        "right_arm": {
            "approach_axis": "x",
            "dead_angles": (
                DeadAngle(120.0, 145.0, "right receptacle wall"),
            ),
        },
    }

    def make_moves(n: int = 2000) -> list[int]:
        return [random.randint(1, 500) for _ in range(n)]

    jobs: list[AxisJob] = []
    jobs_by_limb: dict[str, dict[str, AxisJob]] = {}

    for limb, config in limbs_config.items():
        approach_axis = config["approach_axis"]
        jobs_by_limb[limb] = {}

        for axis in ("x", "y", "z"):
            moves = make_moves()
            is_approach = axis == approach_axis

            if is_approach and limb == "left_arm":
                moves[0] = 187
                target = 187
            elif is_approach and limb == "right_arm":
                target = sum(random.sample(moves, 4))
                while target in moves:
                    target += 1
            else:
                target = sum(random.sample(moves, 5))

            job = AxisJob(
                limb=limb,
                axis=axis,
                moves=moves,
                target=target,
                is_approach_axis=is_approach,
                max_beam_width=1500,
                seed=hash((limb, axis)) % (2**31),
                dead_angles=config["dead_angles"],
                current_angle_deg=40.0,
                degrees_per_move=0.01,
            )
            jobs.append(job)
            jobs_by_limb[limb][axis] = job

    print(f"Solving {len(jobs)} (limb, axis) jobs concurrently...")
    results = solve_all_limbs(jobs)

    for limb, limb_jobs in jobs_by_limb.items():
        axis_results = {
            axis: results[(limb, axis)]
            for axis in limb_jobs
        }
        print_grasp_plan(limb, axis_results)

        execution = execute_grasp_plan(
            limb=limb,
            jobs_by_axis=limb_jobs,
            results_by_axis=axis_results,
            touch_sensor=touch_sensor,
            move_callback=demo_motor_move,
            stop_callback=demo_emergency_stop,
        )
        print(f"Execution result: {execution}")


if __name__ == "__main__":
    freeze_support()
    _demo()
