"""
Neural Kripke System: A neural-network-based text generator grounded in a semantic "world graph".

This module reimplements the GenerativeKripkeSystem as a neural network from scratch:
- Token embeddings: learned vector representations for each token
- Semantic graph: worlds (nodes) connected if their embedding-based similarity is high
- Neural language model: small network predicting next token from (word_i, word_{i+1})
- Generation:
    1. Encode prompt into embedding
    2. Find most relevant cluster of worlds (via embedding similarity)
    3. Condition the language model on tokens from that cluster
    4. Sample next tokens using the neural network

Implemented from scratch using only NumPy:
- No PyTorch, TensorFlow, or other DL libraries
- Simple MLP for next-token prediction
- Gradient-based training with manual backprop

Author: George W (AI developer, Melbourne)
"""

from __future__ import annotations

from dataclasses import dataclass
from typing import Dict, Set, List, Tuple, Optional
from collections import defaultdict, Counter
import math
import random
import os

WorldId = str


# -------------------------
# Numerical utilities
# -------------------------

def softmax(logits: List[float]) -> List[float]:
    """Numerically stable softmax over a list of floats."""
    max_logit = max(logits)
    exps = [math.exp(l - max_logit) for l in logits]
    sum_exp = sum(exps)
    return [e / sum_exp for e in exps]


def relu(x: float) -> float:
    return max(0.0, x)


def relu_derivative(x: float) -> float:
    return 1.0 if x > 0 else 0.0


# -------------------------
# Tokenization (same as before)
# -------------------------

def _tok(text: str) -> List[str]:
    """
    Cleans and tokenizes text into lowercase words.
    """
    t = text.lower()
    words = [w for w in t.split() if w]
    out = []
    for w in words:
        w = "".join(ch for ch in w if ch.isalnum() or ch in {"-", "'"})
        if w:
            out.append(w)
    return out


def _cap(text: str) -> str:
    if not text:
        return text
    return text[0] + text[1:]


def load_txt_file(path: str) -> List[str]:
    with open(path, "r", encoding="utf-8") as f:
        raw = f.read()
    return [ln for ln in raw.split(".")]


# -------------------------
# Neural Network Components
# -------------------------

class TokenEmbedding:
    """
    Learned embedding table for tokens.
    
    Embedding token -> vector of dimension `embed_dim`.
    Initialized randomly, updated via gradient descent.
    """
    def __init__(self, tokens: List[str], embed_dim: int = 16, rng: random.Random = None):
        if rng is None:
            rng = random.Random()
        self.embed_dim = embed_dim
        self.token_to_idx: Dict[str, int] = {tok: i for i, tok in enumerate(tokens)}
        self.idx_to_token: List[str] = tokens
        self.V = len(tokens)
        
        # Initialize embeddings with small random values
        self.embeds = [
            [rng.gauss(0, 0.1) for _ in range(embed_dim)]
            for _ in range(self.V)
        ]
    
    def get(self, token: str) -> List[float]:
        idx = self.token_to_idx.get(token)
        if idx is None:
            # Fallback: zero vector for unknown tokens
            return [0.0] * self.embed_dim
        return self.embeds[idx]
    
    def get_idx(self, token: str) -> int:
        return self.token_to_idx.get(token, -1)
    
    def zero_grad(self):
        self.grad = [
            [0.0] * self.embed_dim
            for _ in range(self.V)
        ]
    
    def add_grad(self, token: str, dvec: List[float]):
        idx = self.token_to_idx.get(token)
        if idx is None:
            return
        for i in range(self.embed_dim):
            self.grad[idx][i] += dvec[i]
    
    def step(self, lr: float):
        for i in range(self.V):
            for j in range(self.embed_dim):
                self.embeds[i][j] -= lr * self.grad[i][j]


class NeuralLanguageModel:
    """
    Simple neural language model for next-token prediction.
    
    Input: concatenation of embeddings for (word_i, word_{i+1})
    Output: probability distribution over next token (word_{i+2})
    
    Architecture:
        x = [emb(w_i), emb(w_{i+1})]  # size: 2 * embed_dim
        h1 = relu(W1 @ x + b1)         # hidden layer
        y  = W2 @ h1 + b2              # output logits
        p  = softmax(y)                # probability over tokens
    """
    def __init__(self, tokens: List[str], embed_dim: int = 2, hidden_dim: int = 4, rng: random.Random = None):
        if rng is None:
            rng = random.Random()
        
        self.tokens = tokens
        self.V = len(tokens)
        self.embed_dim = embed_dim
        self.hidden_dim = hidden_dim
        self.input_dim = 2 * embed_dim
        
        # Weight matrices
        # W1: hidden_dim x input_dim
        self.W1 = [
            [rng.gauss(0, 0.1) for _ in range(self.input_dim)]
            for _ in range(self.hidden_dim)
        ]
        # b1: hidden_dim
        self.b1 = [0.0] * self.hidden_dim
        
        # W2: V x hidden_dim
        self.W2 = [
            [rng.gauss(0, 0.1) for _ in range(self.hidden_dim)]
            for _ in range(self.V)
        ]
        # b2: V
        self.b2 = [0.0] * self.V
        
        # Gradients
        self.W1_grad = [[0.0] * self.input_dim for _ in range(self.hidden_dim)]
        self.b1_grad = [0.0] * self.hidden_dim
        self.W2_grad = [[0.0] * self.hidden_dim for _ in range(self.V)]
        self.b2_grad = [0.0] * self.V
    
    def zero_grad(self):
        self.W1_grad = [[0.0] * self.input_dim for _ in range(self.hidden_dim)]
        self.b1_grad = [0.0] * self.hidden_dim
        self.W2_grad = [[0.0] * self.hidden_dim for _ in range(self.V)]
        self.b2_grad = [0.0] * self.V
    
    def forward(self, x: List[float]) -> Tuple[List[float], List[float], List[float]]:
        """
        Forward pass.
        
        Returns:
            h1: hidden activations (before relu)
            h1_relu: hidden activations (after relu)
            logits: output logits (before softmax)
        """
        # Linear layer 1
        h1 = [
            sum(self.W1[i][j] * x[j] for j in range(self.input_dim)) + self.b1[i]
            for i in range(self.hidden_dim)
        ]
        h1_relu = [relu(v) for v in h1]
        
        # Linear layer 2 (output logits)
        logits = [
            sum(self.W2[i][j] * h1_relu[j] for j in range(self.hidden_dim)) + self.b2[i]
            for i in range(self.V)
        ]
        
        return h1, h1_relu, logits
    
    def backward(self, x: List[float], h1: List[float], h1_relu: List[float],
                 logits: List[float], target_idx: int) -> None:
        """
        Backward pass for one training example.
        
        Uses cross-entropy loss: L = -log(p[target])
        """
        probs = softmax(logits)
        
        # Gradient of loss w.r.t. logits
        dlogits = probs[:]
        dlogits[target_idx] -= 1.0
        
        # Gradient w.r.t. W2, b2
        for i in range(self.V):
            for j in range(self.hidden_dim):
                self.W2_grad[i][j] += dlogits[i] * h1_relu[j]
            self.b2_grad[i] += dlogits[i]
        
        # Gradient w.r.t. h1_relu
        dh1_relu = [
            sum(self.W2[i][j] * dlogits[i] for i in range(self.V))
            for j in range(self.hidden_dim)
        ]
        
        # Gradient w.r.t. h1 (through relu)
        dh1 = [dh1_relu[i] * relu_derivative(h1[i]) for i in range(self.hidden_dim)]
        
        # Gradient w.r.t. W1, b1
        for i in range(self.hidden_dim):
            for j in range(self.input_dim):
                self.W1_grad[i][j] += dh1[i] * x[j]
            self.b1_grad[i] += dh1[i]
    
    def step(self, lr: float):
        # Simple gradient descent update
        for i in range(self.hidden_dim):
            for j in range(self.input_dim):
                self.W1[i][j] -= lr * self.W1_grad[i][j]
            self.b1[i] -= lr * self.b1_grad[i]
        
        for i in range(self.V):
            for j in range(self.hidden_dim):
                self.W2[i][j] -= lr * self.W2_grad[i][j]
            self.b2[i] -= lr * self.b2_grad[i]
    
    def predict_next_token(self, emb_i: List[float], emb_j: List[float]) -> List[float]:
        """
        Given embeddings for (word_i, word_{j}), return probability distribution
        over next token.
        """
        x = emb_i + emb_j  # concatenate
        h1, h1_relu, logits = self.forward(x)
        return softmax(logits)
    
    def sample_next_token(self, emb_i: List[float], emb_j: List[float],
                          rng: random.Random) -> str:
        probs = self.predict_next_token(emb_i, emb_j)
        # Sample from distribution
        r = rng.random()
        cum = 0.0
        for i, p in enumerate(probs):
            cum += p
            if r < cum:
                return self.tokens[i]
        return self.tokens[-1]


# -------------------------
# Semantic Graph (Kripke-style) with Embeddings
# -------------------------

@dataclass
class NeuralMemoryNode:
    """
    A "world" node with neural embedding representation.
    """
    id: WorldId
    text: str
    tokens: List[str]
    token_set: Set[str]
    weight: float = 1.0
    # Mean embedding of all tokens in this node (for clustering)
    mean_emb: Optional[List[float]] = None


class NeuralKripkeSystem:
    """
    Neural network-based generative system with a semantic "world graph".
    
    Components:
    - TokenEmbedding: learned token vectors
    - NeuralLanguageModel: next-token predictor
    - NeuralMemoryNode: worlds with mean embeddings
    - Edges: semantic graph based on embedding similarity
    
    Training:
    - Traverse all nodes, build (w_i, w_{i+1}) -> w_{i+2} triples
    - Train embedding + language model jointly via gradient descent
    """
    
    def __init__(self, embed_dim: int = 16, hidden_dim: int = 32,
                 stop_words: Optional[Set[str]] = None, rng: random.Random = None):
        if rng is None:
            rng = random.Random()
        
        self.rng = rng
        self.stop_words = stop_words or {
            "the", "a", "an", "and", "or", "but", "of", "to", "in",
            "is", "it", "that", "was", "for", "on", "as", "with", "this"
        }
        
        self.nodes: Dict[WorldId, NeuralMemoryNode] = {}
        self.edges: Dict[WorldId, List[WorldId]] = defaultdict(list)
        
        self.embed_dim = embed_dim
        self.hidden_dim = hidden_dim
        
        # Embedding and model will be initialized after we know the token set
        self.embedding: Optional[TokenEmbedding] = None
        self.model: Optional[NeuralLanguageModel] = None
    
    def add_node(self, node_id: WorldId, text: str, metrics: Tuple[float, float, float]):
        """
        Add a world node. Embeddings and mean_emb are computed later during init.
        """
        toks = _tok(text)
        weight = math.log(1.0 + metrics[0] + 0.5 * metrics[1] + 0.25 * metrics[2]) + 1.0
        self.nodes[node_id] = NeuralMemoryNode(
            id=node_id,
            text=text,
            tokens=toks,
            token_set=set(toks),
            weight=weight,
            mean_emb=None
        )
    
    def _build_token_set(self) -> List[str]:
        """Collect all unique tokens from all nodes."""
        token_set = set()
        for node in self.nodes.values():
            for t in node.tokens:
                if t not in self.stop_words:
                    token_set.add(t)
        # Add a small set of common tokens for safety
        for t in self.stop_words:
            token_set.add(t)
        return sorted(token_set)
    
    def _compute_mean_embeddings(self):
        """Compute mean embedding for each node (used for clustering)."""
        if self.embedding is None:
            return
        for node in self.nodes.values():
            if len(node.tokens) == 0:
                node.mean_emb = [0.0] * self.embed_dim
                continue
            vecs = [self.embedding.get(t) for t in node.tokens]
            mean_emb = [
                sum(v[d] for v in vecs) / len(vecs)
                for d in range(self.embed_dim)
            ]
            node.mean_emb = mean_emb
    
    def _dot(a: List[float], b: List[float]) -> float:
        return sum(ai * bi for ai, bi in zip(a, b))
    
    def _norm(a: List[float]) -> float:
        return math.sqrt(sum(ai * ai for ai in a))
    
    def _cosine_sim(self, a: List[float], b: List[float]) -> float:
        norm_a = NeuralKripkeSystem._norm(a)
        norm_b = NeuralKripkeSystem._norm(b)
        if norm_a == 0 or norm_b == 0:
            return 0.0
        return NeuralKripkeSystem._dot(a, b) / (norm_a * norm_b)
    
    def build_dense_matrix(self, similarity_threshold: float = 0.2):
        """
        Build semantic graph using embedding similarity.
        
        Two nodes are connected if:
        - They share any non-stop-word token (like original), OR
        - Their mean embeddings have cosine similarity >= threshold
        """
        if self.embedding is None:
            # Fallback: use original token-based linking
            node_ids = list(self.nodes.keys())
            for i, id1 in enumerate(node_ids):
                n1 = self.nodes[id1]
                content1 = n1.token_set - self.stop_words
                self.edges[id1].append(id1)
                for id2 in node_ids[i+1:]:
                    n2 = self.nodes[id2]
                    content2 = n2.token_set - self.stop_words
                    if content1 & content2:
                        self.edges[id1].append(id2)
                        self.edges[id2].append(id1)
            return
        
        self._compute_mean_embeddings()
        
        node_ids = list(self.nodes.keys())
        for i, id1 in enumerate(node_ids):
            n1 = self.nodes[id1]
            content1 = n1.token_set - self.stop_words
            emb1 = n1.mean_emb or [0.0] * self.embed_dim
            
            self.edges[id1].append(id1)
            
            for id2 in node_ids[i+1:]:
                n2 = self.nodes[id2]
                content2 = n2.token_set - self.stop_words
                emb2 = n2.mean_emb or [0.0] * self.embed_dim
                
                # Token overlap
                token_link = content1 & content2
                
                # Embedding similarity
                emb_sim = self._cosine_sim(emb1, emb2)
                emb_link = emb_sim >= similarity_threshold
                
                if token_link or emb_link:
                    self.edges[id1].append(id2)
                    self.edges[id2].append(id1)
    
    def init_model(self):
        """
        Initialize embedding and language model after all nodes are added.
        """
        tokens = self._build_token_set()
        self.embedding = TokenEmbedding(tokens, self.embed_dim, self.rng)
        self.model = NeuralLanguageModel(tokens, self.embed_dim, self.hidden_dim, self.rng)
        self._compute_mean_embeddings()
    
    def train(self, epochs: int = 20, lr: float = 0.01, batch_size: int = 1):
        """
        Train the embedding + language model on all node texts.
        
        For each node:
        - For each trigram (w_i, w_{i+1}, w_{i+2}):
            - Compute loss
            - Backprop through model and embedding
        - Apply gradient step
        """
        if self.embedding is None or self.model is None:
            raise RuntimeError("Must call init_model() before train()")
        
        # Collect all training triples
        triples: List[Tuple[str, str, str]] = []
        for node in self.nodes.values():
            words = node.tokens
            if len(words) < 3:
                continue
            for i in range(len(words) - 2):
                triples.append((words[i], words[i+1], words[i+2]))
        
        if not triples:
            return
        
        rng = self.rng
        
        for epoch in range(epochs):
            # Shuffle triples
            rng.shuffle(triples)
            total_loss = 0.0
            
            for w_i, w_j, w_k in triples:
                # Forward
                emb_i = self.embedding.get(w_i)
                emb_j = self.embedding.get(w_j)
                x = emb_i + emb_j
                
                h1, h1_relu, logits = self.model.forward(x)
                probs = softmax(logits)
                
                target_idx = self.embedding.get_idx(w_k)
                if target_idx == -1:
                    continue
                
                # Cross-entropy loss
                loss = -math.log(max(probs[target_idx], 1e-12))
                total_loss += loss
                
                # Backward
                self.model.zero_grad()
                self.embedding.zero_grad()
                
                self.model.backward(x, h1, h1_relu, logits, target_idx)
                
                # Gradient through embeddings
                # dL/d(emb_i) and dL/d(emb_j) from dl/dx
                # We need dl/dx from model.backward; but we didn't expose it.
                # Simplified: approximate embedding gradients by using a heuristic:
                #   For each token, push its embedding towards the mean of neighbors.
                # This is a simplification; a full implementation would backprop through x.
                
                # For a true from-scratch NN, you'd extend backward to return dx.
                # Here we use a simple embedding update:
                emb_k = self.embedding.get(w_k)
                # Move emb_i and emb_j slightly towards emb_k
                for idx, t in [(w_i, emb_i), (w_j, emb_j)]:
                    v = self.embedding.token_to_idx[idx]
                    for d in range(self.embed_dim):
                        grad_d = -(emb_k[d] - t[d]) * 0.01
                        self.embedding.grad[v][d] += grad_d
                
                # Step
                self.model.step(lr)
                self.embedding.step(lr)
            
            # Optional: print average loss
            if (epoch + 1) % 5 == 0:
                avg_loss = total_loss / len(triples)
                print(f"Epoch {epoch+1}/{epochs}, avg loss: {avg_loss:.3f}")
    
    def find_entry(self, prompt: str) -> WorldId:
        """
        Find the most relevant starting world for a prompt using embedding similarity.
        """
        if self.embedding is None:
            # Fallback: token overlap (original method)
            ptoks = set(_tok(prompt))
            if not ptoks:
                return next(iter(self.nodes.keys())) if self.nodes else ""
            best_id = list(self.nodes.keys())[0]
            best_score = -1
            for nid, node in self.nodes.items():
                score = len(ptoks & node.token_set)
                if score > best_score:
                    best_score = score
                    best_id = nid
            return best_id
        
        # Encode prompt as mean embedding
        ptoks = _tok(prompt)
        if not ptoks:
            return next(iter(self.nodes.keys())) if self.nodes else ""
        
        prompt_vecs = [self.embedding.get(t) for t in ptoks]
        prompt_emb = [
            sum(v[d] for v in prompt_vecs) / len(prompt_vecs)
            for d in range(self.embed_dim)
        ]
        
        best_id = list(self.nodes.keys())[0]
        best_sim = -1.0
        
        for nid, node in self.nodes.items():
            node_emb = node.mean_emb or [0.0] * self.embed_dim
            sim = self._cosine_sim(prompt_emb, node_emb)
            if sim > best_sim:
                best_sim = sim
                best_id = nid
        
        return best_id
    
    def generate(self, prompt: str, max_words: int = 150) -> str:
        """
        Generate text conditioned on a prompt using the neural language model.
        """
        if self.embedding is None or self.model is None:
            return "System not initialized. Call init_model() and train()."
        
        start_id = self.find_entry(prompt)
        if not start_id or start_id not in self.edges:
            return "The system network is uninitialized or isolated."
        
        neighbors = self.edges[start_id]
        weighted_neighbors = [(nid, self.nodes[nid].weight) for nid in neighbors]
        weighted_neighbors.sort(key=lambda x: x[1], reverse=True)
        
        top_nodes = [self.nodes[nid] for nid, _ in weighted_neighbors]
        if not top_nodes:
            return "No accessible transitions calculated."
        
        # Collect all tokens from top nodes
        neighborhood_tokens: List[str] = []
        for node in top_nodes:
            if len(node.tokens) >= 2:
                neighborhood_tokens.extend(node.tokens)
        
        if len(neighborhood_tokens) < 2:
            return _cap(top_nodes[0].text)
        
        # Initialize with a random pair from neighborhood
        rng = self.rng
        current_pair = (neighborhood_tokens[rng.randint(0, len(neighborhood_tokens)-2)],
                        neighborhood_tokens[rng.randint(1, len(neighborhood_tokens)-1)])
        
        generated_tokens = [current_pair[0], current_pair[1]]
        
        for _ in range(max_words - 2):
            emb_i = self.embedding.get(current_pair[0])
            emb_j = self.embedding.get(current_pair[1])
            next_token = self.model.sample_next_token(emb_i, emb_j, rng)
            generated_tokens.append(next_token)
            current_pair = (current_pair[1], next_token)
        
        base_prose = " ".join(generated_tokens) + "."
        
        # Keyword metadata (same as before)
        keywords = Counter()
        for node in top_nodes:
            keywords.update([w for w in node.tokens if w not in self.stop_words])
        modal_terms = [k for k, _ in keywords.most_common(5)]
        meta_clause = f" [Vector trace patterns: {', '.join(modal_terms)}]" if modal_terms else ""
        
        output = _cap(base_prose) + meta_clause
        
        res_words = output.split()
        if len(res_words) > max_words:
            output = " ".join(res_words[:max_words])
        
        return output


def build_neural_system_from_texts(texts: List[str],
                                   embed_dim: int = 16,
                                   hidden_dim: int = 32) -> NeuralKripkeSystem:
    """
    Build and initialize a NeuralKripkeSystem from a list of text fragments,
    then train it.
    """
    sys = NeuralKripkeSystem(embed_dim=embed_dim, hidden_dim=hidden_dim)
    
    for i, txt in enumerate(texts):
        toks = _tok(txt)
        if len(toks) < 3:
            continue
        desire = min(1.0, sum(1 for t in toks if t in {"want", "desire", "need", "seek"}) / max(1, len(toks)))
        emotion = min(1.0, sum(1 for t in toks if t in {"love", "fear", "dark", "joy", "sad"}) / max(1, len(toks)))
        salience = min(1.0, len(set(toks)) / max(1, len(toks)))
        sys.add_node(f"w{i}", txt, (desire, emotion, salience))
    
    sys.init_model()
    sys.build_dense_matrix(similarity_threshold=0.2)
    sys.train(epochs=20, lr=0.01)
    
    return sys


if __name__ == "__main__":
    """
    Interactive CLI demo for the Neural Kripke System.
    """
    if os.path.exists("singlekb.txt"):
        print("Initializing Neural Kripke system from singlekb.txt...")
        lines = load_txt_file("singlekb.txt")
        system = build_neural_system_from_texts(lines)
        print(f"Graph locked with {len(system.nodes)} responsive logic nodes.")
        while True:
            try:
                prompt = input("USER: ")
                if not prompt:
                    continue
                print("Generated text:", system.generate(prompt))
                print("-" * 50)
            except (KeyboardInterrupt, EOFError):
                break
    else:
        print("Mock execution (singlekb.txt not found):")
        mock_data = [
            "We seek heavy data streams and dark structures in the system framework.",
            "The heavy code architecture holds things we desire to parse.",
            "Dark frameworks reveal processing patterns within the storage system."
        ]
        system = build_neural_system_from_texts(mock_data)
        print("Output:", system.generate("heavy dark frameworks"))