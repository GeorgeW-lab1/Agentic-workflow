\n465\n466\n467\n468\n469\n470\n471\n472\n473\n474\n475\n476\n477\n478\n479\n480\n481\n482\n483\n484\n485\n486\n487\n488", "is_citable": true, "prompt_context_metadata": {"search_provider": "anthropic", "url": "https://github.com/llvm/llvm-project/blob/5184dc2d7cce5971f4386c6f99d04f87233dd313/clang/lib/Headers/avx512fp16intrin.h"}, "links": null}, {"type": "knowledge", "title": "git.zx2c4.com", "url": "https://git.zx2c4.com/wireguard-openbsd/plain/gnu/llvm/clang/lib/Headers/avx512bf16intrin.h", "metadata": {"type": "webpage_metadata", "site_domain": "zx2c4.com", "favicon_url": "https://www.google.com/s2/favicons?sz=64&domain=zx2c4.com", "site_name": "zx2c4"}, "is_missing": false, "text": "/*===------------ avx512bf16intrin.h - AVX512_BF16 intrinsics --------------=== * * Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions. * See https://llvm.org/LICENSE.txt for license information. * SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception * *===-----------------------------------------------------------------------=== */ #ifndef __IMMINTRIN_H #error \"Never use directly; include instead.\" #endif #ifndef __AVX512BF16INTRIN_H #define __AVX512BF16INTRIN_H typedef short __m512bh __attribute__((__vector_size__(64), __aligned__(64))); typedef short __m256bh __attribute__((__vector_size__(32), __aligned__(32))); typedef unsigned short __bfloat16; #define __DEFAULT_FN_ATTRS512 \\ __attribute__((__always_inline__, __nodebug__, __target__(\"avx512bf16\"), \\ __min_vector_width__(512))) #define __DEFAULT_FN_ATTRS \\ __attribute__((__always_inline__, __nodebug__, __target__(\"avx512bf16\"))) /// Convert One BF16 Data to One Single Float Data.", "is_citable": true, "prompt_context_metadata": {"search_provider": "anthropic", "url": "https://git.zx2c4.com/wireguard-openbsd/plain/gnu/llvm/clang/lib/Headers/avx512bf16intrin.h"}, "links": null}, {"type": "knowledge", "title": "gnu.googlesource.com", "url": "https://gnu.googlesource.com/gcc/+/a6d3012b274f38b20e2a57162106f625746af6c6/gcc/config/i386/avx512bf16intrin.h", "metadata": {"type": "webpage_metadata", "site_domain": "googlesource.com", "favicon_url": "https://www.google.com/s2/favicons?sz=64&domain=googlesource.com", "site_name": "googlesource"}, "is_missing": false, "text": "| <http://www.gnu.org/licenses/>. */ |\n| |\n| #ifndef _IMMINTRIN_H_INCLUDED |\n| #error \"Never use <avx512bf16intrin.h> directly; include <immintrin.h> instead.\" |\n| #endif |\n| |\n| #ifndef _AVX512BF16INTRIN_H_INCLUDED |\n| #define _AVX512BF16INTRIN_H_INCLUDED |\n| |\n| #ifndef __AVX512BF16__ |\n| #pragma GCC push_options |\n| #pragma GCC target(\"avx512bf16\") |\n| #define __DISABLE_AVX512BF16__ |\n| #endif /* __AVX512BF16__ */ |\n| |\n| /* Internal data types for implementing the intrinsics. */ |\n| typedef short __v32bh __attribute__ ((__vector_size__ (64))); |\n| |\n| /* The Intel API is flexible enough that we must allow aliasing with other |\n| vector types, and their scalar components. */ |\n| typedef short __m512bh __attribute__ ((__vector_size__ (64), __may_alias__)); |\n| |\n| /* vcvtne2ps2bf16 */ |\n| |\n| extern __inline __m512bh |\n| __attribute__((__gnu_inline__, __always_inline__, __artificial__)) |\n| _mm512_cvtne2ps_pbh (__m512 __A, __m512 __B) |\n| { |", "is_citable": true, "prompt_context_metadata": {"search_provider": "anthropic", "url": "https://gnu.googlesource.com/gcc/+/a6d3012b274f38b20e2a57162106f625746af6c6/gcc/config/i386/avx512bf16intrin.h"}, "links": null}, {"type": "knowledge", "title": "llvm.googlesource.com", "url": "https://llvm.googlesource.com/llvm-project/+/1e25b67fc9d0d40dd3e02d6923d02b0303681933/clang/lib/Headers/avx512bf16intrin.h", "metadata": {"type": "webpage_metadata", "site_domain": "googlesource.com", "favicon_url": "https://www.google.com/s2/favicons?sz=64&domain=googlesource.com", "site_name": "googlesource"}, "is_missing": false, "text": "| /*===------------ avx512bf16intrin.h - AVX512_BF16 intrinsics --------------=== |\n| * |\n| * Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions. |\n| * See https://llvm.org/LICENSE.txt for license information. |\n| * SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception |\n| * |\n| *===-----------------------------------------------------------------------=== |\n| */ |\n| #ifndef __IMMINTRIN_H |\n| #error \"Never use <avx512bf16intrin.h> directly; include <immintrin.h> instead.\" |\n| #endif |\n| |\n| #ifdef __SSE2__ |\n| |\n| #ifndef __AVX512BF16INTRIN_H |\n| #define __AVX512BF16INTRIN_H |\n| |\n| typedef __bf16 __v32bf __attribute__((__vector_size__(64), __aligned__(64))); |\n| typedef __bf16 __m512bh __attribute__((__vector_size__(64), __aligned__(64))); |\n| typedef __bf16 __bfloat16 __attribute__((deprecated(\"use __bf16 instead\"))); |\n| |\n| #define __DEFAULT_FN_ATTRS512 \\ |\n| __attribute__((__always_inline__, __nodebug__, __target__(\"avx512bf16,evex512\"), \\ |", "is_citable": true, "prompt_context_metadata": {"search_provider": "anthropic", "url": "https://llvm.googlesource.com/llvm-project/+/1e25b67fc9d0d40dd3e02d6923d02b0303681933/clang/lib/Headers/avx512bf16intrin.h"}, "links": null}, {"type": "knowledge", "title": "git.raptorcs.com", "url": "https://git.raptorcs.com/git/bcm5719-llvm/plain/clang/lib/Headers/avx512vlbf16intrin.h", "metadata": {"type": "webpage_metadata", "site_domain": "raptorcs.com", "favicon_url": "https://www.google.com/s2/favicons?sz=64&domain=raptorcs.com", "site_name": "raptorcs"}, "is_missing": false, "text": "/*===--------- avx512vlbf16intrin.h - AVX512_BF16 intrinsics ---------------=== * * Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions. * See https://llvm.org/LICENSE.txt for license information. * SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception * *===-----------------------------------------------------------------------=== */ #ifndef __IMMINTRIN_H #error \"Never use directly; include instead.\" #endif #ifndef __AVX512VLBF16INTRIN_H #define __AVX512VLBF16INTRIN_H typedef short __m128bh __attribute__((__vector_size__(16), __aligned__(16))); #define __DEFAULT_FN_ATTRS128 \\ __attribute__((__always_inline__, __nodebug__, \\ __target__(\"avx512vl, avx512bf16\"), __min_vector_width__(128))) #define __DEFAULT_FN_ATTRS256 \\ __attribute__((__always_inline__, __nodebug__, \\ __target__(\"avx512vl, avx512bf16\"), __min_vector_width__(256))) /// Convert Two Packed Single Data to One Packed BF16 Data.", "is_citable": true, "prompt_context_metadata": {"search_provider": "anthropic", "url": "https://git.raptorcs.com/git/bcm5719-llvm/plain/clang/lib/Headers/avx512vlbf16intrin.h"}, "links": null}, {"type": "knowledge", "title": "blob: e75c7e318a2fcdcda84690bcbc8dcf850ab1e086 [file] [log] [blame]", "url": "https://llvm.googlesource.com/clang/+/refs/heads/google/stable/lib/Headers/avx512bf16intrin.h", "metadata": {"type": "webpage_metadata", "site_domain": "googlesource.com", "favicon_url": "https://www.google.com/s2/favicons?sz=64&domain=googlesource.com", "site_name": "googlesource"}, "is_missing": false, "text": "blob: e75c7e318a2fcdcda84690bcbc8dcf850ab1e086 [file] [log] [blame]\n/*===------------ avx512bf16intrin.h - AVX512_BF16 intrinsics --------------===\n* Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.\n* See for license information.\n* SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception\n#ifndef __IMMINTRIN_H\n#error \"Never use <avx512bf16intrin.h> directly; include <immintrin.h> instead.\"\n#ifndef __AVX512BF16INTRIN_H\n#define __AVX512BF16INTRIN_H\ntypedef short __m512bh __attribute__((__vector_size__(64), __aligned__(64)));\ntypedef short __m256bh __attribute__((__vector_size__(32), __aligned__(32)));\n#define __DEFAULT_FN_ATTRS512 \\\n__attribute__((__always_inline__, __nodebug__, __target__(\"avx512bf16\"), \\\n/// Convert Two Packed Single Data to One Packed BF16 Data.\n/// \\headerfile <x86intrin.h>\n/// This intrinsic corresponds to the <c> VCVTNE2PS2BF16 </c> instructions.\n/// \\param __A\n/// A 512-bit vector of [16 x float].\n/// \\param __B\n\n\n_mm512_mask_cvtneps_pbh(__m256bh __W, __mmask16 __U, __m512 __A) {\nreturn (__m256bh)__builtin_ia32_selectw_256((__mmask16)__U,\n/// Convert Packed Single Data to Packed BF16 Data.\n/// \\headerfile <x86intrin.h>\n/// This intrinsic corresponds to the <c> VCVTNEPS2BF16 </c> instructions.\n/// \\param __A\n/// A 512-bit vector of [16 x float].\n/// \\param __U\n/// An immediate value containing an 16-bit value specifying which element\n/// is choosed. 1 means __A, 0 means zero.\n/// \\returns A 256-bit vector of [16 x bfloat] come from convertion of src\nstatic __inline__ __m256bh __DEFAULT_FN_ATTRS512\n_mm512_maskz_cvtneps_pbh(__mmask16 __U, __m512 __A) {\nreturn (__m256bh)__builtin_ia32_selectw_256((__mmask16)__U,\n/// Dot Product of BF16 Pairs Accumulated into Packed Single Precision.\n/// \\headerfile <x86intrin.h>\n/// This intrinsic corresponds to the <c> VDPBF16PS </c> instructions.\n/// \\param __A\n/// A 512-bit vector of [32 x bfloat].\n/// \\param __B\n/// A 512-bit vector of [32 x bfloat].\n\n\n#undef __DEFAULT_FN_ATTRS512", "is_citable": true, "prompt_context_metadata": {"search_provider": "anthropic", "url": "https://llvm.googlesource.com/clang/+/refs/heads/google/stable/lib/Headers/avx512bf16intrin.h"}, "links": null}, {"type": "knowledge", "title": "xref: /llvm-project/clang/lib/Headers/avx512bf16intrin.h (revision f229ba4e8d6bb24622b2d41b3c89585cb9005d8d)", "url": "https://src.rcs.uwaterloo.ca/xref/llvm-project/clang/lib/Headers/avx512bf16intrin.h", "metadata": {"type": "webpage_metadata", "site_domain": "uwaterloo.ca", "favicon_url": "https://www.google.com/s2/favicons?sz=64&domain=uwaterloo.ca", "site_name": "uwaterloo"}, "is_missing": false, "text": "xref: /llvm-project/clang/lib/Headers/avx512bf16intrin.h (revision f229ba4e8d6bb24622b2d41b3c89585cb9005d8d)\n1\u00a0/*===------------ avx512bf16intrin.h - AVX512_BF16 intrinsics --------------===\n2\u00a0 *\n3\u00a0 * Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.\n4\u00a0 * See https://llvm.org/LICENSE.txt for license information.\n5\u00a0 * SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception\n6\u00a0 *\n7\u00a0 *===-----------------------------------------------------------------------===\n8\u00a0 */\n9\u00a0#ifndef __IMMINTRIN_H\n10\u00a0#error \"Never use <avx512bf16intrin.h> directly; include <immintrin.h> instead.\"\n11\u00a0#endif\n12\u00a0\n13\u00a0#ifdef __SSE2__\n14\u00a0\n15\u00a0#ifndef __AVX512BF16INTRIN_H\n16\u00a0#define __AVX512BF16INTRIN_H\n17\u00a0\n18\u00a0typedef __bf16 __v32bf __attribute__((__vector_size__(64), __aligned__(64)));\n19\u00a0typedef __bf16 __m512bh __attribute__((__vector_size__(64), __aligned__(64)));\n20\u00a0typedef __bf16 __bfloat16 __attribute__((deprecated(\"use __bf16 instead\")));\n21\u00a0\n\n\n22\u00a0#define __DEFAULT_FN_ATTRS512 \\\n23\u00a0  __attribute__((__always_inline__, __nodebug__, __target__(\"avx512bf16,evex512\"), \\\n24\u00a0                 __min_vector_width__(512)))\n25\u00a0#define __DEFAULT_FN_ATTRS                                                     \\\n26\u00a0  __attribute__((__always_inline__, __nodebug__,                               \\\n27\u00a0                 __target__(\"avx512bf16,no-evex512\")))\n28\u00a0\n29\u00a0/// Convert One BF16 Data to One Single Float Data.\n30\u00a0///\n31\u00a0/// \\headerfile <x86intrin.h>\n32\u00a0///\n33\u00a0/// This intrinsic does not correspond to a specific instruction.\n34\u00a0///\n35\u00a0/// \\param __A\n36\u00a0///    A bfloat data.\n37\u00a0/// \\returns A float data whose sign field and exponent field keep unchanged,\n38\u00a0///    and fraction field is extended to 23 bits.\n_mm_cvtsbh_ss(__bf16 __A)39\u00a0static __inline__ float __DEFAULT_FN_ATTRS _mm_cvtsbh_ss(__bf16 __A) {\n40\u00a0  return __builtin_ia32_cvtsbf162ss_32(__A);\n41\u00a0}\n42\u00a0\n43\u00a0/// Convert Two Packed Single Data to One Packed BF16 Data.\n\n\n44\u00a0///\n45\u00a0/// \\heade", "is_citable": true, "prompt_context_metadata": {"search_provider": "anthropic", "url": "https://src.rcs.uwaterloo.ca/xref/llvm-project/clang/lib/Headers/avx512bf16intrin.h"}, "links": null}], "is_error": false, "structured_content": null, "meta": null, "message": null, "integration_name": null, "mcp_server_url": null, "integration_icon_url": null, "icon_name": "globe", "display_content": null, "hidden_in_chat": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-09-26T23:29:32.136362Z", "stop_timestamp": "2026-09-26T23:29:32.506601Z", "flags": null, "type": "tool_use", "id": "toolu_015HdrnPvWTLmmpyEAZbLSeR", "name": "web_search_fast", "input": {"query": "\"_AVX512BF16VLINTRIN_H_INCLUDED\" gcc avx512bf16vlintrin.h"}, "message": "Searching the web", "integration_name": null, "integration_icon_url": null, "tool_identifier": null, "icon_name": "globe", "context": null, "display_content": null, "approval_options": null, "approval_key": null, "approval_key_legacy": null, "is_mcp_app": null, "hidden_in_chat": null, "mcp_server_url": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-09-26T23:29:33.085893Z", "stop_timestamp": "2026-09-26T23:29:33.085936Z", "flags": null, "type": "tool_result", "tool_use_id": "toolu_015HdrnPvWTLmmpyEAZbLSeR", "name": "web_search_fast", "content": [{"type": "knowledge", "title": "gnu.googlesource.com", "url": "https://gnu.googlesource.com/gcc/+/70ee703c479081ac2ea67eb67041551216e66783/gcc/config/i386/avx512fp16vlintrin.h", "metadata": {"type": "webpage_metadata", "site_domain": "googlesource.com", "favicon_url": "https://www.google.com/s2/favicons?sz=64&domain=googlesource.com", "site_name": "googlesource"}, "is_missing": false, "text": "| <http://www.gnu.org/licenses/>. */ |\n| |\n| #ifndef _IMMINTRIN_H_INCLUDED |\n| #error \"Never use <avx512fp16vlintrin.h> directly; include <immintrin.h> instead.\" |\n| #endif |\n| |\n| #ifndef __AVX512FP16VLINTRIN_H_INCLUDED |\n| #define __AVX512FP16VLINTRIN_H_INCLUDED |\n| |\n| #if !defined(__AVX512VL__) || !defined(__AVX512FP16__) |\n| #pragma GCC push_options |\n| #pragma GCC target(\"avx512fp16,avx512vl\") |\n| #define __DISABLE_AVX512FP16VL__ |\n| #endif /* __AVX512FP16VL__ */ |\n| |\n| /* Intrinsics v[add,sub,mul,div]ph. */ |\n| extern __inline __m128h |\n| __attribute__ ((__gnu_inline__, __always_inline__, __artificial__)) |\n| _mm_add_ph (__m128h __A, __m128h __B) |\n| { |\n| return (__m128h) ((__v8hf) __A + (__v8hf) __B); |\n| } |\n| |\n| extern __inline __m256h |\n| __attribute__ ((__gnu_inline__, __always_inline__, __artificial__)) |\n| _mm256_add_ph (__m256h __A, __m256h __B) |\n| { |\n| return (__m256h) ((__v16hf) __A + (__v16hf) __B); |\n| } |\n| |\n| extern __inline __m128h |", "is_citable": true, "prompt_context_metadata": {"search_provider": "anthropic", "url": "https://gnu.googlesource.com/gcc/+/70ee703c479081ac2ea67eb67041551216e66783/gcc/config/i386/avx512fp16vlintrin.h"}, "links": null}, {"type": "knowledge", "title": "dawn2.umd.edu", "url": "https://dawn2.umd.edu/cwrf-bias-correction-env/lib/gcc/x86_64-conda-linux-gnu/14.3.0/include/avx512bf16vlintrin.h", "metadata": {"type": "webpage_metadata", "site_domain": "umd.edu", "favicon_url": "https://www.google.com/s2/favicons?sz=64&domain=umd.edu", "site_name": "umd"}, "is_missing": false, "text": "#ifndef _IMMINTRIN_H_INCLUDED\n#error \"Never use <avx512bf16vlintrin.h> directly; include <immintrin.h> instead.\"\n#endif\n\n#ifndef _AVX512BF16VLINTRIN_H_INCLUDED\n#define _AVX512BF16VLINTRIN_H_INCLUDED\n\n#if !defined(__AVX512VL__) || !defined(__AVX512BF16__) || defined (__EVEX512__)\n#pragma GCC push_options\n#pragma GCC target(\"avx512bf16,avx512vl,no-evex512\")\n#define __DISABLE_AVX512BF16VL__\n#endif /* __AVX512BF16__ */\n\n/* Internal data types for implementing the intrinsics.  */\ntypedef __bf16 __v16bf __attribute__ ((__vector_size__ (32)));\ntypedef __bf16 __v8bf __attribute__ ((__vector_size__ (16)));\n\n/* The Intel API is flexible enough that we must allow aliasing with other\n   vector types, and their scalar components.  */\ntypedef __bf16 __m256bh __attribute__ ((__vector_size__ (32), __may_alias__));\ntypedef __bf16 __m128bh __attribute__ ((__vector_size__ (16), __may_alias__));\n\ntypedef __bf16 __bfloat16;\n\n\n\n__attribute__ ((__gnu_inline__, __always_inline__, __artificial__))\n_mm256_avx512_cvtepi16_epi32 (__m128i __X)\n{\n  return (__m256i) __builtin_ia32_pmovsxwd256 ((__v8hi)__X);\n}\n\n#define _mm256_cvtneps_pbh(A) \\\n  (__m128bh) __builtin_ia32_cvtneps2bf16_v8sf (A)\n#define _mm_cvtneps_pbh(A) \\\n  (__m128bh) __builtin_ia32_cvtneps2bf16_v4sf (A)\n\n/* vcvtne2ps2bf16 */\n\nextern __inline __m256bh\n__attribute__((__gnu_inline__, __always_inline__, __artificial__))\n_mm256_cvtne2ps_pbh (__m256 __A, __m256 __B)\n{\n  return (__m256bh)__builtin_ia32_cvtne2ps2bf16_v16bf(__A, __B);\n}\n\nextern __inline __m256bh\n__attribute__((__gnu_inline__, __always_inline__, __artificial__))\n_mm256_mask_cvtne2ps_pbh (__m256bh __A, __mmask16 __B, __m256 __C, __m256 __D)\n{\n  return (__m256bh)__builtin_ia32_cvtne2ps2bf16_v16bf_mask(__C, __D, __A, __B);\n}\n\nextern __inline __m256bh\n__attribute__((__gnu_inline__, __always_inline__, __artificial__))\n_mm256_maskz_cvtne2ps_pbh (__mmask16 __A, __m256 __B, __m256 __C)\n{\n\n\n\t (__m256i)_mm256_avx512_cvtepi16_epi32 ((__m128i)__A), 16));\n}\n\nextern __inline __m128\n__attr", "is_citable": true, "prompt_context_metadata": {"search_provider": "anthropic", "url": "https://dawn2.umd.edu/cwrf-bias-correction-env/lib/gcc/x86_64-conda-linux-gnu/14.3.0/include/avx512bf16vlintrin.h"}, "links": null}, {"type": "knowledge", "title": "gnu.googlesource.com", "url": "https://gnu.googlesource.com/gcc/+/1ba7adabf29eb671e418692fad076ea6edd08e3d/gcc/config/i386/immintrin.h", "metadata": {"type": "webpage_metadata", "site_domain": "googlesource.com", "favicon_url": "https://www.google.com/s2/favicons?sz=64&domain=googlesource.com", "site_name": "googlesource"}, "is_missing": false, 