ull | head -2; python3 $S info /tmp/t2/v2.cotw.gz 2>&1 | head -4\necho \"---- weave kernel build from file\"; head -c 300000 data.jsonl > small.txt; python3 $S build small.txt -o w.cotw --kernel weave --cot-vocab cot.txt 2>&1 | tail -1\npython3 $S generate w.cotw --prompt \"The machine\" --stack-target 3 --chunk 10 </dev/null 2>&1 | grep -E \"stack|kernel\"", "description": "Test info, scan generate, extend with HF slice, legacy load, weave kernel"}, "message": "Test info, scan generate, extend with HF slice, legacy load, weave kernel", "integration_name": "File Creation", "integration_icon_url": null, "tool_identifier": null, "icon_name": "commandLine", "context": null, "display_content": {"type": "json_block", "json_block": "{\"language\": \"bash\", \"code\": \"cd /tmp/t3 && S=/mnt/user-data/outputs/cot_weight_extender.py\\necho \\\"---- info\\\"; python3 run.py $S info big.cotw 2>&1 | tail -12\\necho \\\"---- generate scan stack\\\"; python3 run.py $S generate big.cotw --prompt \\\"The machine\\\" --stack-target 12 --chunk 12 </dev/null 2>&1 | grep -E \\\"stack|kernel|wall|coverage\\\"\\necho \\\"---- generate scan fixed trace\\\"; python3 run.py $S generate big.cotw --prompt \\\"The machine\\\" --stack-target 0 --cycles 1 --chunks-per-cycle 3 --chunk 10 --trace </dev/null 2>&1 | grep -E \\\"^\\\\[cycle|wall\\\"\\necho \\\"---- extend with another HF slice + decay\\\"; python3 run.py $S extend big.cotw -o big2.cotw --decay 0.9 --hf-dataset json --hf-data-files data.jsonl --hf-split train --hf-max-bytes 3MB --max-entries 1500000 2>&1 | grep -E \\\"extended|decayed|wall|coverage\\\"\\necho \\\"---- legacy v2 gzip checkpoint\\\"; ls /tmp/t2/*.cotw.gz 2>/dev/null | head -2; python3 $S info /tmp/t2/v2.cotw.gz 2>&1 | head -4\\necho \\\"---- weave kernel build from file\\\"; head -c 300000 data.jsonl > small.txt; python3 $S build small.txt -o w.cotw --kernel weave --cot-vocab cot.txt 2>&1 | tail -1\\npython3 $S generate w.cotw --prompt \\\"The machine\\\" --stack-target 3 --chunk 10 </dev/null 2>&1 | grep -E \\\"stack|kernel\\\"\"}"}, "approval_options": null, "approval_key": null, "approval_key_legacy": null, "is_mcp_app": null, "hidden_in_chat": null, "mcp_server_url": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-10-14T22:26:02.697946Z", "stop_timestamp": "2026-10-14T22:26:02.698014Z", "flags": null, "type": "tool_result", "tool_use_id": "toolu_015M8oezw1f81HLV7qgZuMHM", "name": "bash_tool", "content": [{"type": "text", "text": "{\"returncode\":0,\"stdout\":\"---- info\\nformat       cot-weights-v3   kernel scan\\norder        3   alpha 0.25\\nvocab types  13,507   tokens 4,451,465\\ndataset      4,407,130 tokens, 13,506 distinct words\\ncontexts     n=0: 1, n=1: 13,507, n=2: 174,613   entries 1,450,361\\nextensions   0   sources hf:json\\ncycle        the of and machine thought signal memory pattern system feedback network state simulate recall correct imagine decide observe verify associate plan anticipate reflect abstract act\\ndiverge=question converge=compare integrate=adapt start=predict\\ncoverage     12/29 CoT words occur in the dataset; absent: simulate, recall, correct, imagine, decide, observe, verify, associate, plan, anticipate, reflect, abstract, act, question, compare, adapt, predict\\n[wall 2s, peak RSS 328 MB]\\n---- generate scan stack\\nscan coverage: 12/29 CoT words occur in the dataset (absent: simulate, recall, correct, imagine, decide, observe, verify, associate, plan, anticipate ...)\\nkernel: scan\\n[stack] depth 12/12  attempts 12  forced 0  monotonic order verified: True\\n[wall 3s, peak RSS 328 MB]\\n---- generate scan fixed trace\\n[cycle 1/1 chunk 1] tokens=10 mean_logp=-2.48 rep=0.80 -> question (T=0.98) scan[predict:start hits=0 ground=1.00]\\n[cycle 1/1 chunk 2] tokens=10 mean_logp=-2.43 rep=0.80 -> question (T=1.12) scan[question:diverge hits=0 ground=1.00]\\n[cycle 1/1 chunk 3] tokens=10 mean_logp=-2.53 rep=0.70 -> question (T=1.29) scan[question:diverge hits=0 ground=1.00]\\n[wall 2s, peak RSS 328 MB]\\n---- extend with another HF slice + decay\\ndecayed existing weights by 0.9 (dataset is not decayed)\\nscan coverage: 12/29 CoT words occur in the dataset (absent: simulate, recall, correct, imagine, decide, observe, verify, associate, plan, anticipate ...)\\nextended -> big2.cotw [scan kernel]: 13,507 types, +528,805 tokens, 1,102,028 n-gram entries, dataset 4,935,935 tokens\\n[wall 11s, peak RSS 544 MB]\\n---- legacy v2 gzip checkpoint\\n/tmp/t2/base.cotw.gz\\n/tmp/t2/v2.cotw.gz\\nformat       cot-weights-v3   kernel scan\\norder        3   alpha 0.25\\nvocab types  85   tokens 3,934\\ndataset      4,275 tokens, 84 distinct words\\n---- weave kernel build from file\\nbuilt w.cotw [weave kernel]: 4,712 types, 52,588 tokens read, 85,212 n-gram entries, dataset 52,588 tokens\\nkernel: weave\\n[stack] depth 3/3  attempts 78  forced 3  monotonic order verified: True\\n\",\"stderr\":\"\"}"}], "is_error": false, "structured_content": null, "meta": {"output_format_category": "none"}, "message": null, "integration_name": "File Creation", "mcp_server_url": null, "integration_icon_url": null, "icon_name": "commandLine", "display_content": {"type": "json_block", "json_block": "{\"returncode\":0,\"stdout\":\"---- info\\nformat       cot-weights-v3   kernel scan\\norder        3   alpha 0.25\\nvocab types  13,507   tokens 4,451,465\\ndataset      4,407,130 tokens, 13,506 distinct words\\ncontexts     n=0: 1, n=1: 13,507, n=2: 174,613   entries 1,450,361\\nextensions   0   sources hf:json\\ncycle        the of and machine thought signal memory pattern system feedback network state simulate recall correct imagine decide observe verify associate plan anticipate reflect abstract act\\ndiverge=question converge=compare integrate=adapt start=predict\\ncoverage     12/29 CoT words occur in the dataset; absent: simulate, recall, correct, imagine, decide, observe, verify, associate, plan, anticipate, reflect, abstract, act, question, compare, adapt, predict\\n[wall 2s, peak RSS 328 MB]\\n---- generate scan stack\\nscan coverage: 12/29 CoT words occur in the dataset (absent: simulate, recall, correct, imagine, decide, observe, verify, associate, plan, anticipate ...)\\nkernel: scan\\n[stack] depth 12/12  attempts 12  forced 0  monotonic order verified: True\\n[wall 3s, peak RSS 328 MB]\\n---- generate scan fixed trace\\n[cycle 1/1 chunk 1] tokens=10 mean_logp=-2.48 rep=0.80 -> question (T=0.98) scan[predict:start hits=0 ground=1.00]\\n[cycle 1/1 chunk 2] tokens=10 mean_logp=-2.43 rep=0.80 -> question (T=1.12) scan[question:diverge hits=0 ground=1.00]\\n[cycle 1/1 chunk 3] tokens=10 mean_logp=-2.53 rep=0.70 -> question (T=1.29) scan[question:diverge hits=0 ground=1.00]\\n[wall 2s, peak RSS 328 MB]\\n---- extend with another HF slice + decay\\ndecayed existing weights by 0.9 (dataset is not decayed)\\nscan coverage: 12/29 CoT words occur in the dataset (absent: simulate, recall, correct, imagine, decide, observe, verify, associate, plan, anticipate ...)\\nextended -> big2.cotw [scan kernel]: 13,507 types, +528,805 tokens, 1,102,028 n-gram entries, dataset 4,935,935 tokens\\n[wall 11s, peak RSS 544 MB]\\n---- legacy v2 gzip checkpoint\\n/tmp/t2/base.cotw.gz\\n/tmp/t2/v2.cotw.gz\\nformat       cot-weights-v3   kernel scan\\norder        3   alpha 0.25\\nvocab types  85   tokens 3,934\\ndataset      4,275 tokens, 84 distinct words\\n---- weave kernel build from file\\nbuilt w.cotw [weave kernel]: 4,712 types, 52,588 tokens read, 85,212 n-gram entries, dataset 52,588 tokens\\nkernel: weave\\n[stack] depth 3/3  attempts 78  forced 3  monotonic order verified: True\\n\",\"stderr\":\"\"}"}, "hidden_in_chat": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-10-14T22:26:04.853072Z", "stop_timestamp": "2026-10-14T22:26:09.800123Z", "flags": null, "type": "thinking", "thinking": "", "summaries": [{"summary": "Spotting repetition artifacts in the synthetic test data."}], "cut_off": false, "truncated": true, "hidden": false, "thinking_hidden": true, "alternative_display_type": null, "signature": null}, {"start_timestamp": "2026-10-14T22:26:09.800191Z", "stop_timestamp": "2026-10-14T22:26:10.058631Z", "flags": null, "type": "tool_use", "id": "toolu_01AXYiQhYoHtpvnYqg1C2qxr", "name": "present_files", "input": {"filepaths": ["/mnt/user-data/outputs/cot_weight_extender.py"]}, "message": "Presenting file(s)...", "integration_name": "File Creation", "integration_icon_url": null, "tool_identifier": null, "icon_name": "file", "context": null, "display_content": {"type": "table", "table": [["filepaths", "['/mnt/user-data/outputs/cot_weight_extender.py']"]]}, "approval_options": null, "approval_key": null, "approval_key_legacy": null, "is_mcp_app": null, "hidden_in_chat": null, "mcp_server_url": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-10-14T22:26:10.085471Z", "stop_timestamp": "2026-10-14T22:26:10.085505Z", "flags": null, "type": "tool_result", "tool_use_id": "toolu_01AXYiQhYoHtpvnYqg1C2qxr", "name": "present_files", "content": [{"type": "local_resource", "file_path": "/mnt/user-data/outputs/cot_weight_extender.py", "name": "cot weight extender", "mime_type": "text/x-python", "artifact_publishable": false}, {"type": "text", "text": "\n\nThe file cards appear with your reply, and where they sit relative to its text depends on the app the user is reading in; finish the reply with text, and refer to a file by its name, never as above or below."}], "is_error": false, "structured_content": null, "meta": {"output_format_category": "other"}, "message": "Presented file", "integration_name": "File Creation", "mcp_server_url": null, "integration_icon_url": null, "icon_name": "file", "display_content": null, "hidden_in_chat": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-10-14T22:26:21.065214Z", "stop_timestamp": "2026-10-14T22:26:22.020092Z", "flags": null, "type": "text", "text": "`cot_weight_extender.py` can now train from a streamed Hugging Face dataset, capped at 200MB of text by default. I couldn't reach huggingface.co from my sandbox, so I tested the same `datasets` streaming path on a local 33MB JSONL file. A real Hugging Face run is untested.\n\nFor a ~200MB run, `Salesforce/wikitext` with config `wikitext-103-raw-v1` is a good fit. Its train split is about 550MB, and streaming stops at your byte budget, so you never download the whole thing.\n\n```\npip install datasets\npython cot_weight_extender.py build -o wiki.cotw \\\n    --hf-dataset Salesforce/wikitext --hf-config wikitext-103-raw-v1 \\\n    --hf-max-bytes 200MB --cot-vocab cot.txt\n```\n\nYou can also pass local corpus files alongside `--hf-dataset`, and `extend` takes the same flags. `--hf-field`, `--hf-split` and `--hf-data-files` cover other datasets and loaders.\n\n**What changed to make 200MB workable**\n- **Streaming:** documents are trained one at a time, so memory stays flat.\n- **Compact dataset:** the dataset the scan kernel reads is now an int32 id array plus a word table, with a numpy position index, instead of a Python list.\n- **Memory bound:** `--max-entries` (default 5M) caps the n-gram tables. When they grow past it, rare n-grams (count below 2, then 3, and so on) are dropped. This is lossy for rare n-grams, and `0` turns it off. The scan kernel still reads the full dataset.\n- **Checkpoint format:** it is now a zip holding the model state as JSON plus the dataset ids as a `.npy` file. Old v1 and v2 gzip checkpoints still load.\n- **CoT vocabulary without a list:** with no `--cot-vocab`, the words are picked from the first ~2MB of the stream.\n\n**What I measured**\n- **Throughput:** the local test file gave 4.4M tokens in 30s (about 210k tokens/s) and peaked at 583 MB with `--max-entries 1.5M`.\n- **Extend, generate and legacy loading:** all worked.\n- **Weave kernel:** also worked.\n- **Estimate for 200MB of real English:** roughly 35M tokens, about 3 minutes plus pruning passes, and a few GB of RAM at the default cap. I did not measure that.\n- **Pruning on real text:** my test data was random, so it pruned harder than real text will. Raise `--max-entries` if you have the memory.\n- **Raw wikitext markup:** it includes things like `= Heading =` lines and ` @-@ `, which will end up in the n-grams and the scan.", "citations": []}], "sender": "assistant", "created_at": "2026-10-14T22:26:22.109449Z", "updated_at": "2026-10-14T22:26:22.109449Z", "attachments": [], "files": [], "parent_message_uuid": "01a13c80-e748-7d72-93ac-1766806958fd"}]},{"uuid": "ca576c38-feb4-4510-bf8e-23bb0872e451", "name": "Non-isomorphic adiabatic text generator", "summary": "", "created_at": "2026-10-14T23:18:13.093322Z", "updated_at": "2026-10-14T23:40:08.961229Z", "account": {"uuid": "8d7882cd-3e98-47cc-a6e7-61494a1ee4ac"}, "chat_messages": [{"uuid": "01a13cb5-8f54-7ae9-8c31-503b3fa4f1ab", "text": "#!/usr/bin/env python3\n\"\"\"\nNon-isomorphic adiabatic text generator\n=======================================\n\nA runnable corpus-based text generator in which next-token candidates are\nscored by an n-gram language model and filtered/reweighted by several\nnon-isomorphic process fragments.\n\nConceptual mapping:\n  F       reference next-token distribution from the n-gram model\n  g_k     fragment-specific transforms of candidate/context features\n  I_k     local approximate inverse/lift (not a global inverse)\n  lambda  smooth adiabatic continuation from exploratory to selective scoring\n  D       proposed \"diopathane\" consistency score\n  tau     maximum permitted D score for a candidate\n\nThis is an experimental algorithmic analogy, not an established physical\nmodel. \"Diopathane\" is a user-defined name for the consistency constraint.\n\nExamples:\n  python nonisomorphic_adiabatic_textgen.py corpus.txt --prompt \"once upon a\" --tokens 80\n  python nonisomorphic_adiabatic_textgen.py --prompt \"The machine\" --tokens 60\n  python nonisomorphic_adiabatic_textgen.py corpus.txt --order 4 --beam 8 --tau 0.65\n\nOnly dependency: NumPy\nInstall: python -m pip install numpy\n\"\"\"\n\nimport argparse\nimport math\nimport random\nimport re\nfrom collections import Counter, defaultdict\nfrom dataclasses import dataclass\nfrom pathlib import Path\nfrom typing import Dict, List, Sequence, Tuple\n\nimport numpy as np\n\nTOKEN_RE = re.compile(r\"[A-Za-z]+(?:['\u2019][A-Za-z]+)*|\\\\d+(?:\\\\.\\\\d+)?|[^\\\\w\\\\s]\", re.UNICODE)\nwith open(input(\"Filename: \"), \"r\", encoding=\"utf-8\") as file:\n        \n    BUILTIN_CORPUS = file.read()\n\n\ndef tokenize(text: str) -> List[str]:\n    return text.split()\n\n\ndef detokenize(tokens: Sequence[str]) -> str:\n    \"\"\"Join tokens into readable text without spaces before common punctuation.\"\"\"\n    out = \"\"\n    no_space_before = set(\".,!?;:%)]}\u00bb\u201d\u2019\")\n    no_space_after = set(\"([{\u00ab\u201c\u2018\")\n    for token in tokens:\n        if not out:\n            out = token\n        elif token in no_space_before or out[-1:] in no_space_after:\n            out += token\n        else:\n            out += \" \" + token\n    return out\n\n\n@dataclass\nclass Candidate:\n    token: str\n    base_logp: float\n    score: float\n    consistency: float\n    alignment: float\n    probability: float = 0.0\n\n\nclass NGramModel:\n    \"\"\"Smoothed n-gram model with backoff to shorter contexts.\"\"\"\n\n    def __init__(self, order: int = 3, alpha: float = 0.25):\n        self.order = max(1, int(order))\n        self.alpha = max(1e-9, float(alpha))\n        self.counts = [defaultdict(Counter) for _ in range(self.order)]\n        self.vocab = Counter()\n        self.total_tokens = 0\n\n    def train(self, text: str) -> None:\n        tokens = [\"<bos>\"] * (self.order - 1) + tokenize(text) + [\"<eos>\"]\n        if not tokens:\n            return\n        for i in range(self.order - 1, len(tokens)):\n            target = tokens[i]\n            self.vocab[target] += 1\n            self.total_tokens += 1\n            for ctx_len in range(self.order):\n                context = tuple(tokens[i - ctx_len:i]) if ctx_len else ()\n                self.counts[ctx_len][context][target] += 1\n\n    def candidates(self, context_tokens: Sequence[str], limit: int = 80) -> List[Tuple[str, float]]:\n        vocab_size = max(1, len(self.vocab))\n        context = list(context_tokens)\n        counter = Counter()\n        # Blend backoff levels; a longer context receives more weight.\n        for ctx_len in range(min(self.order - 1, len(context)), -1, -1):\n            key = tuple(context[-ctx_len:]) if ctx_len else ()\n            found = self.counts[ctx_len].get(key)\n            if not found:\n                continue\n            weight = 1.0 + 0.7 * ctx_len\n            for token, count in found.items():\n                counter[token] += weight * count\n            if ctx_len >= 1:\n                break\n        if not counter:\n            counter.update(self.vocab)\n        total = sum(counter.values())\n        ranked = []\n        for token, count in counter.items():\n            prob = (count + self.alpha) / (total + self.alpha * vocab_size)\n            ranked.append((token, math.log(max(prob, 1e-12))))\n        ranked.sort(key=lambda item: item[1], reverse=True)\n        return ranked[:max(1, limit)]\n\n\nclass NonIsomorphicFragments:\n    \"\"\"\n    Fragment transforms candidate features into differently sized spaces.\n    The transforms are intentionally not inverses of one another.\n    \"\"\"\n\n    def __init__(self, seed: int = 17):\n        rng = np.random.default_rng(seed)\n        self.w_context = rng.normal(0, 0.7, size=(5, 3))\n        self.w_word = rng.normal(0, 0.7, size=(5, 4))\n        self.w_transition = rng.normal(0, 0.7, size=(5, 2))\n\n    @staticmethod\n    def _unit(v: np.ndarray) -> np.ndarray:\n        n = float(np.linalg.norm(v))\n        return v / n if n > 1e-12 else np.zeros_like(v)\n\n    @staticmethod\n    def _hash_features(token: str, width: int) -> np.ndarray:\n        \"\"\"Stable token features; does not depend on Python's randomized hash.\"\"\"\n        raw = token.lower().encode(\"utf-8\", errors=\"ignore\")\n        vals = np.zeros(width, dtype=float)\n        if not raw:\n            return vals\n        for i, byte in enumerate(raw):\n            vals[i % width] += ((byte % 31) - 15) / 15.0\n            vals[(i * 3 + 1) % width] += ((byte % 17) - 8) / 8.0\n        vals /= max(1, len(raw))\n        vals[0] += min(len(raw), 20) / 20.0\n        vals[1] += sum(chr(b).isalpha() for b in raw) / max(1, len(raw))\n        return np.tanh(vals)\n\n    def features(self, context: Sequence[str], token: str, logp: float, rank: int) -> Tuple[np.ndarray, np.ndarray, np.ndarray]:\n        recent = list(context[-4:])\n        ctx_vec = np.zeros(5, dtype=float)\n        if recent:\n            for i, word in enumerate(recent):\n                f = self._hash_features(word, 5)\n                ctx_vec += f * (0.65 ** (len(recent) - i - 1))\n            ctx_vec /= max(1, len(recent))\n        word_vec = self._hash_features(token, 5)\n        transition_vec = np.array([\n            np.tanh(logp),\n            1.0 / (1.0 + rank),\n            1.0 if token[:1].isupper() else 0.0,\n            1.0 if token in \".,!?;:\" else 0.0,\n            min(len(token), 24) / 24.0\n        ], dtype=float)\n        # Distinct output dimensions: R^3, R^4, and R^2.\n        g1 = np.tanh(ctx_vec @ self.w_context)\n        g2 = np.tanh(word_vec @ self.w_word)\n        g3 = np.tanh(transition_vec @ self.w_transition)\n        return g1, g2, g3\n\n    def score(self, context: Sequence[str], token: str, logp: float, rank: int, lam: float) -> Tuple[float, float]:\n        g1, g2, g3 = self.features(context, token, logp, rank)\n        # Project each distinct fragment to a scalar summary, not an isomorphism.\n        summaries = np.array([\n            np.linalg.norm(g1),\n            np.linalg.norm(g2),\n            np.linalg.norm(g3)\n        ])\n        mean = float(np.mean(summaries))\n        spread = float(np.std(summaries) / (mean + 1e-9))\n        consistency = float(np.clip(0.55 * spread + 0.45 * (1.0 - np.mean(summaries)), 0.0, 1.0))\n\n        # Alignment is cosine similarity between padded/truncated local summaries\n        # and a context-conditioned reference vector.\n        ref = self._unit(np.array([\n            np.mean(g1),\n            np.mean(g2),\n            np.mean(g3),\n            np.tanh(logp),\n        ]))\n        candidate = self._unit(np.array([\n            g1[0],\n            g2[0],\n            g3[0],\n            np.tanh(logp + 0.1 * rank)\n        ]))\n        cosine = float(np.dot(ref, candidate))\n        alignment = (cosine + 1.0) / 2.0\n\n        # As lambda rises, the model moves from exploratory scoring to\n        # stronger language-model and fragment alignment influence.\n        fragment_score = 1.6 * alignment - 1.15 * consistency\n        total_score = (1.0 - lam) * (0.75 * logp + 0.25 * fragment_score) + lam * (1.25 * logp + 0.85 * fragment_score)\n        return total_score, consistency\n\n\ndef adiabatic_lambda(step: int, total_steps: int) -> float:\n    u = min(1.0, max(0.0, step / max(1, total_steps - 1)))\n    return 3.0 * u * u - 2.0 * u * u * u\n\n\ndef softmax(values: Sequence[float], temperature: float = 1.0) -> np.ndarray:\n    temp = max(1e-6, float(temperature))\n    arr = np.asarray(values, dtype=float) / temp\n    arr -= np.max(arr)\n    exp = np.exp(np.clip(arr, -60, 60))\n    return exp / max(float(exp.sum()), 1e-12)\n\n\ndef generate(\n    model: NGramModel,\n    prompt: str,\n    token_count: int = 800,\n    beam_size: int = 8,\n    tau: float = 0.65,\n    temperature: float = 0.85,\n    seed: int = 7,\n    show_trace: bool = False,\n) -> str:\n    rng = random.Random(seed)\n    fragments = NonIsomorphicFragments(seed)\n    output = tokenize(prompt)\n    if not output:\n        output = [\"The\"]\n    original_prompt_len = len(output)\n\n    for step in range(max(0, token_count)):\n        lam = adiabatic_lambda(step, max(1, token_count))\n        ranked = model.candidates(output, limit=max(40, beam_size * 8))\n        scored: List[Candidate] = []\n\n        for rank, (token, logp) in enumerate(ranked):\n            score, consistency = fragments.score(output, token, logp, rank, lam)\n            # Alignment proxy retained for traceability.\n            alignment = float(np.clip((score - logp) / 2.5 + 0.5, 0.0, 1.0))\n            if consistency <= tau:\n                scored.append(Candidate(token, logp, score, consistency, alignment))\n\n        # Avoid a dead end if all candidates fail the constraint.\n        if not scored:\n            token, logp = ranked[0]\n            score, consistency = fragments.score(output, token, logp, 0, lam)\n            scored = [Candidate(token, logp, score, consistency, 0.5)]\n\n        scored.sort(key=lambda c: c.score, reverse=True)\n        beam = scored[:max(1, beam_size)]\n        probs = softmax([c.score for c in beam], temperature)\n        for candidate, prob in zip(beam, probs):\n            candidate.probability = float(prob)\n\n        chosen = beam[0] if temperature <= 0.01 else rng.choices(beam, weights=probs, k=1)[0]\n        output.append(chosen.token)\n\n\n    # Remove internal end marker and preserve the prompt as part of the result.\n\n    text = ' '.join(output)\n\n    return text\n\n\ndef main() -> None:\n    parser = argparse.ArgumentParser(description=\"N-gram text generator with non-isomorphic adiabatic fragment scoring.\")\n    parser.add_argument(\"corpus\", nargs=\"?\", help=\"UTF-8 text corpus file; uses a small built-in corpus if omitted.\")\n    parser.add_argument(\"--prompt\", default=\"A process\", help=\"Initial text context.\")\n    parser.add_argument(\"--tokens\", type=int, default=800, help=\"Maximum number of new tokens.\")\n    parser.add_argument(\"--order\", type=int, default=3, help=\"N-gram order (default: 3).\")\n    parser.add_argument(\"--alpha\", type=float, default=0.25, help=\"Additive smoothing value.\")\n    parser.add_argument(\"--beam\", type=int, default=8, help=\"Number of candidate next words retained before sampling.\")\n    parser.add_argument(\"--tau\", type=float, default=0.65, help=\"Maximum allowed fragment consistency score (0..1).\")\n    parser.add_argument(\"--temperature\", type=float, default=0.85, help=\"Sampling temperature; near zero selects the top candidate.\")\n    parser.add_argument(\"--seed\", type=int, default=7, help=\"Random seed for repeatable generation.\")\n    parser.add_argument(\"--trace\", action=\"store_true\", help=\"Print per-token scoring diagnostics.\")\n    parser.add_argument(\"--save\", help=\"Optional output text file.\")\n    args = parser.parse_args()\n\n    if args.corpus:\n        corpus_path = Path(args.corpus)\n        if not corpus_path.is_file():\n            parser.error(f\"Corpus file not found: {corpus_path}\")\n        try:\n            corpus_text = corpus_path.read_text(encoding=\"utf-8-sig\")\n        except UnicodeDecodeError as exc:\n            parser.error(f\"Could not decode corpus as UTF-8: {exc}\")\n    else:\n        corpus_text = BUILTIN_CORPUS\n\n    if not tokenize(corpus_text):\n        parser.error(\"Corpus contains no recognizable tokens.\")\n    model = NGramModel(order=args.order, alpha=args.alpha)\n    model.train(corpus_text)\n    while True:\n        result = generate(\n            model=model,\n            prompt=input(\"USER: \"),\n            token_count=args.tokens,\n            beam_size=args.beam,\n            tau=float(np.clip(args.tau, 0.0, 1.0)),\n            temperature=max(0.0, args.temperature),\n            seed=args.seed,\n            show_trace=args.trace,\n        )\n\n        print(\"\\n--- GENERATED TEXT ---\\n\")\n        print(result)\n       \nif __name__ == \"__main__\":\n    main()\n\nmake all the functions into non communitative graphs", "content": [{"start_timestamp": "2026-10-14T23:18:14.642186Z", "stop_timestamp": "2026-10-14T23:18:14.642186Z", "flags": null, "type": "text", "text": "#!/usr/bin/env python3\n\"\"\"\nNon-isomorphic adiabatic text generator\n=======================================\n\nA runnable corpus-based text generator in which next-token candidates are\nscored by an n-gram language model and filtered/reweighted by several\nnon-isomorphic process fragments.\n\nConceptual mapping:\n  F       reference next-token distribution from the n-gram model\n  g_k     fragment-specific transforms of candidate/context features\n  I_k     local approximate inverse/lift (not a global inverse)\n  lambda  smooth adiabatic continuation from exploratory to selective scoring\n  D       proposed \"diopathane\" consistency score\n  tau     maximum permitted D score for a candidate\n\nThis is an experimental algorithmic analogy, not an established physical\nmodel. \"Diopathane\" is a user-defined name for the consistency constraint.\n\nExamples:\n  python nonisomorphic_adiabatic_textgen.py corpus.txt --prompt \"once upon a\" --tokens 80\n  python nonisomorphic_adiabatic_textgen.py --prompt \"The machine\" --tokens 60\n  python nonisomorphic_adiabatic_textgen.py corpus.txt --order 4 --beam 8 --tau 0.65\n\nOnly dependency: NumPy\nInstall: python -m pip install numpy\n\"\"\"\n\nimport argparse\nimport math\nimport random\nimport re\nfrom collections import Counter, defaultdict\nfrom dataclasses import dataclass\nfrom pathlib import Path\nfrom typing import Dict, List, Sequence, Tuple\n\nimport numpy as np\n\nTOKEN_RE = re.compile(r\"[A-Za-z]+(?:['\u2019][A-Za-z]+)*|\\\\d+(?:\\\\.\\\\d+)?|[^\\\\w\\\\s]\", re.UNICODE)\nwith open(input(\"Filename: \"), \"r\", encoding=\"utf-8\") as file:\n        \n    BUILTIN_CORPUS = file.read()\n\n\ndef tokenize(text: str) -> List[str]:\n    return text.split()\n\n\ndef detokenize(tokens: Sequence[str]) -> str:\n    \"\"\"Join tokens into readable text without spaces before common punctuation.\"\"\"\n    out = \"\"\n    no_space_before = set(\".,!?;:%)]}\u00bb\u201d\u2019\")\n    no_space_after = set(\"([{\u00ab\u201c\u2018\")\n    for token in tokens:\n        if not out:\n            out = token\n        elif token in no_space_before or out[-1:] in no_space_after:\n            out += token\n        else:\n            out += \" \" + token\n    return out\n\n\n@dataclass\nclass Candidate:\n    token: str\n    base_logp: float\n    score: float\n    consistency: float\n    alignment: float\n    probability: float = 0.0\n\n\nclass NGramModel:\n    \"\"\"Smoothed n-gram model with backoff to shorter contexts.\"\"\"\n\n    def __init__(self, order: int = 3, alpha: float = 0.25):\n        self.order = max(1, int(order))\n        self.alpha = max(1e-9, float(alpha))\n        self.counts = [defaultdict(Counter) for _ in range(self.order)]\n        self.vocab = Counter()\n        self.total_tokens = 0\n\n    def train(self, text: str) -> None:\n        tokens = [\"<bos>\"] * (self.order - 1) + tokenize(text) + [\"<eos>\"]\n        if not tokens:\n            return\n        for i in range(self.order - 1, len(tokens)):\n            target = tokens[i]\n            self.vocab[target] += 1\n            self.total_tokens += 1\n            for ctx_len in range(self.order):\n                context = tuple(tokens[i - ctx_len:i]) if ctx_len else ()\n                self.counts[ctx_len][context][target] += 1\n\n    def candidates(self, context_tokens: Sequence[str], limit: int = 80) -> List[Tuple[str, float]]:\n        vocab_size = max(1, len(self.vocab))\n        context = list(context_tokens)\n        counter = Counter()\n        # Blend backoff levels; a longer context receives more weight.\n        for ctx_len in range(min(self.order - 1, len(context)), -1, -1):\n            key = tuple(context[-ctx_len:]) if ctx_len else ()\n            found = self.counts[ctx_len].get(key)\n            if not found:\n                continue\n            weight = 1.0 + 0.7 * ctx_len\n            for token, count in found.items():\n                counter[token] += weight * count\n            if ctx_len >= 1:\n                break\n        if not counter:\n            counter.update(self.vocab)\n        total = sum(counter.values())\n        ranked = []\n        for token, count in counter.items():\n            prob = (count + self.alpha) / (total + self.alpha * vocab_size)\n            ranked.append((token, math.log(max(prob, 1e-12))))\n        ranked.sort(key=lambda item: item[1], reverse=True)\n        return ranked[:max(1, limit)]\n\n\nclass NonIsomorphicFragments:\n    \"\"\"\n    Fragment transforms candidate features into differently sized spaces.\n    The transforms are intentionally not inverses of one another.\n    \"\"\"\n\n    def __init__(self, seed: int = 17):\n        rng = np.random.default_rng(seed)\n        self.w_context = rng.normal(0, 0.7, size=(5, 3))\n        self.w_word = rng.normal(0, 0.7, size=(5, 4))\n        self.w_transition = rng.normal(0, 0.7, size=(5, 2))\n\n    @staticmethod\n    def _unit(v: np.ndarray) -> np.ndarray:\n        n = float(np.linalg.norm(v))\n        return v / n if n > 1e-12 else np.zeros_like(v)\n\n    @staticmethod\n    def _hash_features(token: str, width: int) -> np.ndarray:\n        \"\"\"Stable token features; does not depend on Python's randomized hash.\"\"\"\n        raw = token.lower().encode(\"utf-8\", errors=\"ignore\")\n        vals = np.zeros(width, dtype=float)\n        if not raw:\n            return vals\n        for i, byte in enumerate(raw):\n            vals[i % width] += ((byte % 31) - 15) / 15.0\n            vals[(i * 3 + 1) % width] += ((byte % 17) - 8) / 8.0\n        vals /= max(1, len(raw))\n        vals[0] += min(len(raw), 20) / 20.0\n        vals[1] += sum(chr(b).isalpha() for b in raw) / max(1, len(raw))\n        return np.tanh(vals)\n\n    def features(self, context: Sequence[str], token: str, logp: float, rank: int) -> Tuple[np.ndarray, np.ndarray, np.ndarray]:\n        recent = list(context[-4:])\n        ctx_vec = np.zeros(5, dtype=float)\n        if recent:\n            for i, word in enumerate(recent):\n                f = self._hash_features(word, 5)\n                ctx_vec += f * (0.65 ** (len(recent) - i - 1))\n            ctx_vec /= max(1, len(recent))\n        word_vec = self._hash_features(token, 5)\n        transition_vec = np.array([\n            np.tanh(logp),\n            1.0 / (1.0 + rank),\n            1.0 if token[:1].isupper() else 0.0,\n            1.0 if token in \".,!?;:\" else 0.0,\n            min(len(token), 24) / 24.0\n        ], dtype=float)\n        # Distinct output dimensions: R^3, R^4, and R^2.\n        g1 = np.tanh(ctx_vec @ self.w_context)\n        g2 = np.tanh(word_vec @ self.w_word)\n        g3 = np.tanh(transition_vec @ self.w_transition)\n        return g1, g2, g3\n\n    def score(self, context: Sequence[str], token: str, logp: float, rank: int, lam: float) -> Tuple[float, float]:\n        g1, g2, g3 = self.features(context, token, logp, rank)\n        # Project each distinct fragment to a scalar summary, not an isomorphism.\n        summaries = np.array([\n            np.linalg.norm(g1),\n            np.linalg.norm(g2),\n            np.linalg.norm(g3)\n        ])\n        mean = float(np.mean(summaries))\n        spread = float(np.std(summaries) / (mean + 1e-9))\n        consistency = float(np.clip(0.55 * spread + 0.45 * (1.0 - np.mean(summaries)), 0.0, 1.0))\n\n        # Alignment is cosine similarity between padded/truncated local summaries\n        # and a context-conditioned reference vector.\n        ref = self._unit(np.array([\n            np.mean(g1),\n            np.mean(g2),\n            np.mean(g3),\n            np.tanh(logp),\n        ]))\n        candidate = self._unit(np.array([\n            g1[0],\n            g2[0],\n            g3[0],\n            np.tanh(logp + 0.1 * rank)\n        ]))\n        cosine = float(np.dot(ref, candidate))\n        alignment = (cosine + 1.0) / 2.0\n\n        # As lambda rises, the model moves from exploratory scoring to\n        # stronger language-model and fragment alignment influence.\n        fragment_score = 1.6 * alignment - 1.15 * consistency\n        total_score = (1.0 - lam) * (0.75 * logp + 0.25 * fragment_score) + lam * (1.25 * logp + 0.85 * fragment_score)\n        return total_score, consistency\n\n\ndef adiabatic_lambda(step: int, total_steps: int) -> float:\n    u = min(1.0, max(0.0, step / max(1, total_steps - 1)))\n    return 3.0 * u * u - 2.0 * u * u * u\n\n\ndef softmax(values: Sequence[float], temperature: float = 1.0) -> np.ndarray:\n    temp = max(1e-6, float(temperature))\n    arr = np.asarray(values, dtype=float) / temp\n    arr -= np.max(arr)\n    exp = np.exp(np.clip(arr, -60, 60))\n    return exp / max(float(exp.sum()), 1e-12)\n\n\ndef generate(\n    model: NGramModel,\n    prompt: str,\n    token_count: int = 800,\n    beam_size: int = 8,\n    tau: float = 0.65,\n    temperature: float = 0.85,\n    seed: int = 7,\n    show_trace: bool = False,\n) -> str:\n    rng = random.Random(seed)\n    fragments = NonIsomorphicFragments(seed)\n    output = tokenize(prompt)\n    if not output:\n        output = [\"The\"]\n    original_prompt_len = len(output)\n\n    for step in range(max(0, token_count)):\n        lam = adiabatic_lambda(step, max(1, token_count))\n        ranked = model.candidates(output, limit=max(40, beam_size * 8))\n        scored: List[Candidate] = []\n\n        for rank, (token, logp) in enumerate(ranked):\n            score, consistency = fragments.score(output, token, logp, rank, lam)\n            # Alignment proxy retained for traceability.\n            alignment = float(np.clip((score - logp) / 2.5 + 0.5, 0.0, 1.0))\n            if consistency <= tau:\n                scored.append(Candidate(token, logp, score, consistency, alignment))\n\n        # Avoid a dead end if all candidates fail the constraint.\n        if not scored:\n            token, logp = ranked[0]\n            score, consistency = fragments.score(output, token, logp, 0, lam)\n            scored = [Candidate(token, logp, score, consistency, 0.5)]\n\n        scored.sort(key=lambda c: c.score, reverse=True)\n        beam = scored[:max(1, beam_size)]\n        probs = softmax([c.score for c in beam], temperature)\n        for candidate, prob in zip(beam, probs):\n            candidate.probability = float(prob)\n\n        chosen = beam[0] if temperature <= 0.01 else rng.choices(beam, weights=probs, k=1)[0]\n        output.append(chosen.token)\n\n\n    # Remove internal end marker and preserve the prompt as part of the result.\n\n    text = ' '.join(output)\n\n    return text\n\n\ndef main() -> None:\n    parser = argparse.ArgumentParser(description=\"N-gram text generator with non-isomorphic adiabatic fragment scoring.\")\n    parser.add_argument(\"corpus\", nargs=\"?\", help=\"UTF-8 text corpus file; uses a small built-in corpus if omitted.\")\n    parser.add_argument(\"--prompt\", default=\"A process\", help=\"Initial text context.\")\n    parser.add_argument(\"--tokens\", type=int, default=800, help=\"Maximum number of new tokens.\")\n    parser.add_argument(\"--order\", type=int, default=3, help=\"N-gram order (default: 3).\")\n    parser.add_argument(\"--alpha\", type=float, default=0.25, help=\"Additive smoothing value.\")\n    parser.add_argument(\"--beam\", type=int, default=8, help=\"Number of candidate next words retained before sampling.\")\n    parser.add_argument(\"--tau\", type=float, default=0.65, help=\"Maximum allowed fragment consistency score (0..1).\")\n    parser.add_argument(\"--temperature\", type=float, default=0.85, help=\"Sampling temperature; near zero selects the top candidate.\")\n    parser.add_argument(\"--seed\", type=int, default=7, help=\"Random seed for repeatable generation.\")\n    parser.add_argument(\"--trace\", action=\"store_true\", help=\"Print per-token scoring diagnostics.\")\n    parser.add_argument(\"--save\", help=\"Optional output text file.\")\n    args = parser.parse_args()\n\n    if args.corpus:\n        corpus_path = Path(args.corpus)\n        if not corpus_path.is_file():\n            parser.error(f\"Corpus file not found: {corpus_path}\")\n        try:\n            corpus_text = corpus_path.read_text(encoding=\"utf-8-sig\")\n        except UnicodeDecodeError as exc:\n            parser.error(f\"Could not decode corpus as UTF-8: {exc}\")\n    else:\n        corpus_text = BUILTIN_CORPUS\n\n    if not tokenize(corpus_text):\n        parser.error(\"Corpus contains no recognizable tokens.\")\n    model = NGramModel(order=args.order, alpha=args.alpha)\n    model.train(corpus_text)\n    while True:\n        result = generate(\n            model=model,\n            prompt=input(\"USER: \"),\n            token_count=args.tokens,\n            beam_size=args.beam,\n            tau=float(np.clip(args.tau, 0.0, 1.0)),\n            temperature=max(0.0, args.temperature),\n            seed=args.seed,\n            show_trace=args.trace,\n        )\n\n        print(\"\\n--- GENERATED TEXT ---\\n\")\n        print(result)\n       \nif __name__ == \"__main__\":\n    main()\n\nmake all the functions into non communitative graphs", "citations": []}], "sender": "human", "created_at": "2026-10-14T23:18:14.705280Z", "updated_at": "2026-10-14T23:18:14.705280Z", "attachments": [], "files": [], "parent_message_uuid": "00000000-0000-4000-8000-000000000000"}, {"uuid": "01a13cb5-8f54-74e9-8de5-457821605e11", "text": "I'll read \"non-commutative graphs\" as: each function becomes a node in a directed graph, and composition order matters. `a >> b` is not the same as `b >> a`, because each node declares what it reads and writes, and the graph refuses to run if a node would execute before its inputs exist. I'll write it and test it.\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\nI rewrote the script so every function is a node in a directed graph, and it runs. The test generated text, and running the nodes in reverse order failed as intended.\n\n**How the graphs work**\n- Each function is a `Node` that declares the state keys it reads and writes.\n- `a >> b` adds the edge a \u2192 b, and edge order matters. Running `append >> choose` raises `GraphOrderError`, because `append` needs `chosen` before `choose` has produced it.\n- `Graph.commutes(a, b, state)` checks whether two nodes give the same result in either order. Most pairs don't. A pair like `adiabatic_lambda` and `candidates` does commute, because they touch independent keys, and the tool says so honestly.\n\n**The four graphs**\n- `TRAIN`: `load_corpus >> tokenize_corpus >> train_model`\n- `FRAGMENT`: `features >> summaries >> consistency >> alignment >> blend`. The three non-invertible projections (R\u2075 \u2192 R\u00b3, R\u2074, R\u00b2) now feed this graph.\n- `STEP`: `adiabatic_lambda >> candidates >> score >> filter >> beam >> probabilities >> choose >> append`\n- `GENERATE`: `init_generation >> run_steps >> finish`. `run_steps` applies `STEP` once per token.\n\nRun `--show-graph` to print every graph's node order.\n\n**Bugs fixed along the way**\n- `TOKEN_RE` had doubled backslashes (`\\\\d`), so it matched literal backslashes. It is fixed and now actually used. The original `tokenize` just called `.split()`.\n- `input(\"Filename: \")` ran at import time. The corpus now comes from the CLI argument, or from a small built-in corpus if you omit it.\n- `generate` returned `' '.join(output)`, which left `detokenize` unused and `<eos>` in the output. It now stops at `<eos>`, strips markers, and detokenizes.\n- `--trace` did nothing before. It now prints per-token diagnostics.\n- `--once` skips the interactive loop, and `--tokens` defaults to 80 instead of 800.\n\nI read your request as \"composition order matters in a graph of the functions.\" If you meant something else, such as a graph with matrix-valued edge weights that don't commute, or non-commutative graphs in the operator-algebra sense, tell me and I'll rework it.\n\nThe code is in `noncommutative_graph_textgen.py`.", "content": [{"start_timestamp": "2026-10-14T23:18:14.642046Z", "stop_timestamp": "2026-10-14T23:18:28.174646Z", "flags": null, "type": "thinking", "thinking": "", "summaries": [{"summary": "Untangling an ambiguous request to restructure code as graphs."}, {"summary": "Designing a non-commutative directed graph framework for the functions."}], "cut_off": false, "truncated": true, "hidden": false, "thinking_hidden": true, "alternative_display_type": null, "signature": null}, {"start_timestamp": "2026-10-14T23:18:28.174672Z", "stop_timestamp": "2026-10-14T23:18:28.975347Z", "flags": null, "type": "text", "text": "I'll read \"non-commutative graphs\" as: each function becomes a node in a directed graph, and composition order matters. `a >> b` is not the same as `b >> a`, because each node declares what it reads and writes, and the graph refuses to run if a node would execute before its inputs exist. I'll write it and test it.", "citations": []}, {"start_timestamp": "2026-10-14T23:18:28.975372Z", "stop_timestamp": "2026-10-14T23:19:09.393186Z", "flags": null, "type": "tool_use", "id": "toolu_01DFjA3EvddcsR6V9hwRWPrD", "name": "create_file", "input": {"description": "Rewrite the generator so every function is a node in a non-commutative directed graph", "path": "/mnt/user-data/outputs/noncommutative_graph_textgen.py", "file_text": "#!/usr/bin/env python3\n\"\"\"\nNon-commutative graph text generator\n====================================\n\nEvery function from the original script is now a Node in a directed graph.\n\nNon-commutativity:\n  * A Node declares which state keys it `reads` and which it `writes`.\n  * `a >> b` adds the directed edge a -> b. It is NOT symmetric: `b >> a`\n    is a different graph, and usually an invalid one (b reads something\n    only a writes), so Graph.run raises an error.\n  * `Graph.commutes(a, b, state)` tests this empirically.\n\nGraphs:\n  TRAIN_GRAPH     load_corpus >> tokenize_corpus >> train_model\n  FRAGMENT_GRAPH  features >> summaries >> consistency >> alignment >> blend\n  STEP_GRAPH      lambda >> candidates >> score >> filter >> beam >> probs >> choose >> append\n  GENERATE_GRAPH  init_generation >> (STEP_GRAPH repeated) >> finish\n\nUsage:\n  python noncommutative_graph_textgen.py corpus.txt --prompt \"once upon a\" --tokens 80\n  python noncommutative_graph_textgen.py corpus.txt --once --prompt \"The machine\"\n  python noncommutative_graph_textgen.py corpus.txt --show-graph\nOnly dependency: NumPy\n\"\"\"\n\nimport argparse\nimport math\nimport random\nimport re\nfrom collections import Counter, defaultdict\nfrom dataclasses import dataclass\nfrom pathlib import Path\nfrom typing import Callable, Dict, List, Sequence, Set, Tuple\n\nimport numpy as np\n\n# --------------------------------------------------------------------------\n# Graph core\n# --------------------------------------------------------------------------\n\nState = Dict[str, object]\n\n\nclass GraphOrderError(RuntimeError):\n    \"\"\"Raised when a node runs before the keys it reads exist.\"\"\"\n\n\nclass Node:\n    \"\"\"A function lifted into a graph node: State -> dict of written keys.\"\"\"\n\n    def __init__(self, name: str, fn: Callable[[State], Dict[str, object]],\n                 reads: Sequence[str] = (), writes: Sequence[str] = ()):\n        self.name, self.fn = name, fn\n        self.reads, self.writes = tuple(reads), tuple(writes)\n\n    def __call__(self, state: State) -> State:\n        missing = [k for k in self.reads if k not in state]\n        if missing:\n            raise GraphOrderError(f\"node '{self.name}' needs {missing} before it can run\")\n        out = dict(state)\n        out.update(self.fn(state))\n        return out\n\n    def __rshift__(self, other) -> \"Graph\":\n        return Graph([self]) >> other\n\n    def __repr__(self) -> str:\n        return f\"Node({self.name})\"\n\n\ndef node(name: str, reads: Sequence[str] = (), writes: Sequence[str] = ()):\n    \"\"\"Decorator: turn a function into a Node.\"\"\"\n    def wrap(fn):\n        return Node(name, fn, reads, writes)\n    return wrap\n\n\nclass Graph:\n    \"\"\"Directed graph of nodes. Edge order is meaningful (non-commutative).\"\"\"\n\n    def __init__(self, nodes: Sequence[Node] = (), edges: Sequence[Tuple[Node, Node]] = ()):\n        self.nodes: List[Node] = list(nodes)\n        self.edges: List[Tuple[Node, Node]] = list(edges)\n\n    def _tails(self) -> List[Node]:\n        has_out = {a for a, _ in self.edges}\n        return [n for n in self.nodes if n not in has_out] or self.nodes[-1:]\n\n    def _heads(self) -> List[Node]:\n        has_in = {b for _, b in self.edges}\n        return [n for n in self.nodes if n not in has_in] or self.nodes[:1]\n\n    def __rshift__(self, other) -> \"Graph\":\n        other_g = other if isinstance(other, Graph) else Graph([other])\n        nodes = self.nodes + [n for n in other_g.nodes if n not in self.nodes]\n        edges = self.edges + other_g.edges\n        for t in self._tails():\n            for h in other_g._heads():\n                edges.append((t, h))\n        return Graph(nodes, edges)\n\n    def topo_order(self) -> List[Node]:\n        indeg = {n: 0 for n in self.nodes}\n        for _, b in self.edges:\n            indeg[b] += 1\n        ready = [n for n in self.nodes if indeg[n] == 0]\n        order: List[Node] = []\n        while ready:\n            n = ready.pop(0)\n            order.append(n)\n            for a, b in self.edges:\n                if a is n:\n                    indeg[b] -= 1\n                    if indeg[b] == 0:\n                        ready.append(b)\n        if len(order) != len(self.nodes):\n            raise GraphOrderError(\"graph contains a cycle\")\n        return order\n\n    def run(self, state: State) -> State:\n        for n in self.topo_order():\n            state = n(state)\n        return state\n\n    def __call__(self, state: State) -> State:\n        return self.run(state)\n\n    def describe(self) -> str:\n        return \" -> \".join(n.name for n in self.topo_order())\n\n    @staticmethod\n    def commutes(a: \"Node\", b: \"Node\", state: State) -> bool:\n        \"\"\"True only if running a>>b and b>>a both succeed with equal results.\"\"\"\n        try:\n            ab = (a >> b).run(dict(state))\n            ba = (b >> a).run(dict(state))\n        except GraphOrderError:\n            return False\n        keys = set(ab) | set(ba)\n        return all(_same(ab.get(k), ba.get(k)) for k in keys)\n\n\ndef _same(x, y) -> bool:\n    try:\n        return bool(np.all(x == y))\n    except Exception:\n        return x is y\n\n\n# --------------------------------------------------------------------------\n# Text helpers\n# --------------------------------------------------------------------------\n\nTOKEN_RE = re.compile(r\"[A-Za-z]+(?:['\u2019][A-Za-z]+)*|\\d+(?:\\.\\d+)?|[^\\w\\s]\", re.UNICODE)\n\nBUILTIN_CORPUS = (\n    \"A process can be explored before it is selected. The machine reads the text \"\n    \"and the text shapes the machine. Once upon a time a small process learned to \"\n    \"write, and the words it wrote taught the process what to write next.\"\n)\n\nNO_SPACE_BEFORE = set(\".,!?;:%)]}\u00bb\u201d\u2019\")\nNO_SPACE_AFTER = set(\"([{\u00ab\u201c\u2018\")\n\n\ndef detokenize(tokens: Sequence[str]) -> str:\n    out = \"\"\n    for token in tokens:\n        if not out:\n            out = token\n        elif token in NO_SPACE_BEFORE or out[-1:] in NO_SPACE_AFTER:\n            out += token\n        else:\n            out += \" \" + token\n    return out\n\n\n# --------------------------------------------------------------------------\n# Model classes (unchanged logic; their methods are wrapped as nodes below)\n# --------------------------------------------------------------------------\n\n@dataclass\nclass Candidate:\n    token: str\n    base_logp: float\n    score: float\n    consistency: float\n    alignment: float\n    probability: float = 0.0\n\n\nclass NGramModel:\n    def __init__(self, order: int = 3, alpha: float = 0.25):\n        self.order = max(1, int(order))\n        self.alpha = max(1e-9, float(alpha))\n        self.counts = [defaultdict(Counter) for _ in range(self.order)]\n        self.vocab = Counter()\n        self.total_tokens = 0\n\n    def train_tokens(self, words: Sequence[str]) -> None:\n        tokens = [\"<bos>\"] * (self.order - 1) + list(words) + [\"<eos>\"]\n        for i in range(self.order - 1, len(tokens)):\n            target = tokens[i]\n            self.vocab[target] += 1\n            self.total_tokens += 1\n            for ctx_len in range(self.order):\n                context = tuple(tokens[i - ctx_len:i]) if ctx_len else ()\n                self.counts[ctx_len][context][target] += 1\n\n    def candidates(self, context_tokens: Sequence[str], limit: int = 80) -> List[Tuple[str, float]]:\n        vocab_size = max(1, len(self.vocab))\n        context = list(context_tokens)\n        counter: Counter = Counter()\n        for ctx_len in range(min(self.order - 1, len(context)), -1, -1):\n            key = tuple(context[-ctx_len:]) if ctx_len else ()\n            found = self.counts[ctx_len].get(key)\n            if not found:\n                continue\n            weight = 1.0 + 0.7 * ctx_len\n            for token, count in found.items():\n                counter[token] += weight * count\n            if ctx_len >= 1:\n                break\n        if not counter:\n            counter.update(self.vocab)\n        total = sum(counter.values())\n        ranked = [(t, math.log(max((c + self.alpha) / (total + self.alpha * vocab_size), 1e-12)))\n                  for t, c in counter.items()]\n        ranked.sort(key=lambda item: item[1], reverse=True)\n        return ranked[:max(1, limit)]\n\n\nclass FragmentWeights:\n    \"\"\"Holds the fixed random projections (R^5 -> R^3, R^4, R^2): not invertible.\"\"\"\n\n    def __init__(self, seed: int = 17):\n        rng = np.random.default_rng(seed)\n        self.w_context = rng.normal(0, 0.7, size=(5, 3))\n        self.w_word = rng.normal(0, 0.7, size=(5, 4))\n        self.w_transition = rng.normal(0, 0.7, size=(5, 2))\n\n\ndef _unit(v: np.ndarray) -> np.ndarray:\n    n = float(np.linalg.norm(v))\n    return v / n if n > 1e-12 else np.zeros_like(v)\n\n\ndef _hash_features(token: str, width: int) -> np.ndarray:\n    raw = token.lower().encode(\"utf-8\", errors=\"ignore\")\n    vals = np.zeros(width, dtype=float)\n    if not raw:\n        return vals\n    for i, byte in enumerate(raw):\n        vals[i % width] += ((byte % 31) - 15) / 15.0\n        vals[(i * 3 + 1) % width] += ((byte % 17) - 8) / 8.0\n    vals /= max(1, len(raw))\n    vals[0] += min(len(raw), 20) / 20.0\n    vals[1] += sum(chr(b).isalpha() for b in raw) / max(1, len(raw))\n    return np.tanh(vals)\n\n\ndef softmax(values: Sequence[float], temperature: float = 1.0) -> np.ndarray:\n    temp = max(1e-6, float(temperature))\n    arr = np.asarray(values, dtype=float) / temp\n    arr -= np.max(arr)\n    exp = np.exp(np.clip(arr, -60, 60))\n    return exp / max(float(exp.sum()), 1e-12)\n\n\n# --------------------------------------------------------------------------\n# TRAIN_GRAPH:  load_corpus >> tokenize_corpus >> train_model\n# --------------------------------------------------------------------------\n\n@node(\"load_corpus\", reads=[\"corpus_path\"], writes=[\"corpus_text\"])\ndef load_corpus(s: State):\n    path = s[\"corpus_path\"]\n    if not path:\n        return {\"corpus_text\": BUILTIN_CORPUS}\n    p = Path(str(path))\n    if not p.is_file():\n        raise FileNotFoundError(f\"Corpus file not found: {p}\")\n    return {\"corpus_text\": p.read_text(encoding=\"utf-8-sig\")}\n\n\n@node(\"tokenize_corpus\", reads=[\"corpus_text\"], writes=[\"corpus_tokens\"])\ndef tokenize_corpus(s: State):\n    toks = TOKEN_RE.findall(str(s[\"corpus_text\"]))\n    if not toks:\n        raise ValueError(\"Corpus contains no recognizable tokens.\")\n    return {\"corpus_tokens\": toks}\n\n\n@node(\"train_model\", reads=[\"corpus_tokens\", \"order\", \"alpha\"], writes=[\"model\"])\ndef train_model(s: State):\n    model = NGramModel(order=int(s[\"order\"]), alpha=float(s[\"alpha\"]))\n    model.train_tokens(s[\"corpus_tokens\"])  # type: ignore[arg-type]\n    return {\"model\": model}\n\n\nTRAIN_GRAPH = load_corpus >> tokenize_corpus >> train_model\n\n\n# --------------------------------------------------------------------------\n# FRAGMENT_GRAPH:  features >> summaries >> consistency >> alignment >> blend\n# state in:  weights, context, token, logp, rank, lam\n# state out: frag_score (total_score), frag_consistency\n# --------------------------------------------------------------------------\n\n@node(\"features\", reads=[\"weights\", \"context\", \"token\", \"logp\", \"rank\"], writes=[\"g1\", \"g2\", \"g3\"])\ndef features_node(s: State):\n    w: FragmentWeights = s[\"weights\"]  # type: ignore[assignment]\n    context, token, logp, rank = s[\"context\"], s[\"token\"], float(s[\"logp\"]), int(s[\"rank\"])\n    recent = list(context[-4:])  # type: ignore[index]\n    ctx_vec = np.zeros(5)\n    for i, word in enumerate(recent):\n        ctx_vec += _hash_features(word, 5) * (0.65 ** (len(recent) - i - 1))\n    ctx_vec /= max(1, len(recent))\n    word_vec = _hash_features(str(token), 5)\n    transition_vec = np.array([\n        np.tanh(logp), 1.0 / (1.0 + rank),\n        1.0 if str(token)[:1].isupper() else 0.0,\n        1.0 if token in \".,!?;:\" else 0.0,\n        min(len(str(token)), 24) / 24.0,\n    ])\n    return {\n        \"g1\": np.tanh(ctx_vec @ w.w_context),\n        \"g2\": np.tanh(word_vec @ w.w_word),\n        \"g3\": np.tanh(transition_vec @ w.w_transition),\n    }\n\n\n@node(\"summaries\", reads=[\"g1\", \"g2\", \"g3\"], writes=[\"summaries\"])\ndef summaries_node(s: State):\n    return {\"summaries\": np.array([np.linalg.norm(s[\"g1\"]), np.linalg.norm(s[\"g2\"]), np.linalg.norm(s[\"g3\"])])}\n\n\n@node(\"consistency\", reads=[\"summaries\"], writes=[\"frag_consistency\"])\ndef consistency_node(s: State):\n    summ = s[\"summaries\"]\n    mean = float(np.mean(summ))\n    spread = float(np.std(summ) / (mean + 1e-9))\n    return {\"frag_consistency\": float(np.clip(0.55 * spread + 0.45 * (1.0 - mean), 0.0, 1.0))}\n\n\n@node(\"alignment\", reads=[\"g1\", \"g2\", \"g3\", \"logp\", \"rank\"], writes=[\"frag_alignment\"])\ndef alignment_node(s: State):\n    g1, g2, g3 = s[\"g1\"], s[\"g2\"], s[\"g3\"]\n    logp, rank = float(s[\"logp\"]), int(s[\"rank\"])\n    ref = _unit(np.array([np.mean(g1), np.mean(g2), np.mean(g3), np.tanh(logp)]))\n    cand = _unit(np.array([g1[0], g2[0], g3[0], np.tanh(logp + 0.1 * rank)]))\n    return {\"frag_alignment\": (float(np.dot(ref, cand)) + 1.0) / 2.0}\n\n\n@node(\"blend\", reads=[\"frag_alignment\", \"frag_consistency\", \"logp\", \"lam\"], writes=[\"frag_score\"])\ndef blend_node(s: State):\n    logp, lam = float(s[\"logp\"]), float(s[\"lam\"])\n    frag = 1.6 * s[\"frag_alignment\"] - 1.15 * s[\"frag_consistency\"]  # type: ignore[operator]\n    total = (1.0 - lam) * (0.75 * logp + 0.25 * frag) + lam * (1.25 * logp + 0.85 * frag)\n    return {\"frag_score\": float(total)}\n\n\nFRAGMENT_GRAPH = features_node >> summaries_node >> consistency_node >> alignment_node >> blend_node\n\n\n# --------------------------------------------------------------------------\n# STEP_GRAPH: one generation step\n# --------------------------------------------------------------------------\n\n@node(\"adiabatic_lambda\", reads=[\"step\", \"total_steps\"], writes=[\"lam\"])\ndef lambda_node(s: State):\n    u = min(1.0, max(0.0, int(s[\"step\"]) / max(1, int(s[\"total_steps\"]) - 1)))\n    return {\"lam\": 3.0 * u * u - 2.0 * u * u * u}\n\n\n@node(\"candidates\", reads=[\"model\", \"output\", \"beam_size\"], writes=[\"ranked\"])\ndef candidates_node(s: State):\n    model: NGramModel = s[\"model\"]  # type: ignore[assignment]\n    return {\"ranked\": model.candidates(s[\"output\"], limit=max(40, int(s[\"beam_size\"]) * 8))}  # type: ignore[arg-type]\n\n\n@node(\"score\", reads=[\"weights\", \"output\", \"ranked\", \"lam\"], writes=[\"scored_all\"])\ndef score_node(s: State):\n    rows = []\n    for rank, (token, logp) in enumerate(s[\"ranked\"]):  # type: ignore[arg-type]\n        r = FRAGMENT_GRAPH.run({\n            \"weights\": s[\"weights\"], \"context\": s[\"output\"], \"token\": token,\n            \"logp\": logp, \"rank\": rank, \"lam\": s[\"lam\"],\n        })\n        rows.append((token, logp, float(r[\"frag_score\"]), float(r[\"frag_consistency\"])))\n    return {\"scored_all\": rows}\n\n\n@node(\"filter\", reads=[\"scored_all\", \"ranked\", \"tau\"], writes=[\"scored\"])\ndef filter_node(s: State):\n    tau = float(s[\"tau\"])\n    scored = []\n    for token, logp, score, cons in s[\"scored_all\"]:  # type: ignore[union-attr]\n        if cons <= tau:\n            alignment = float(np.clip((score - logp) / 2.5 + 0.5, 0.0, 1.0))\n            scored.append(Candidate(token, logp, score, cons, alignment))\n    if not scored:  # avoid a dead end\n        token, logp, score, cons = s[\"scored_all\"][0]  # type: ignore[index]\n        scored = [Candidate(token, logp, score, cons, 0.5)]\n    return {\"scored\": scored}\n\n\n@node(\"beam\", reads=[\"scored\", \"beam_size\"], writes=[\"beam\"])\ndef beam_node(s: State):\n    ranked = sorted(s[\"scored\"], key=lambda c: c.score, reverse=True)  # type: ignore[union-attr]\n    return {\"beam\": ranked[:max(1, int(s[\"beam_size\"]))]}\n\n\n@node(\"probabilities\", reads=[\"beam\", \"temperature\"], writes=[\"beam_probs\"])\ndef probs_node(s: State):\n    beam: List[Candidate] = s[\"beam\"]  # type: ignore[assignment]\n    probs = softmax([c.score for c in beam], float(s[\"temperature\"]))\n    for c, p in zip(beam, probs):\n        c.probability = float(p)\n    return {\"beam_probs\": probs}\n\n\n@node(\"choose\", reads=[\"beam\", \"beam_probs\", \"temperature\", \"rng\"], writes=[\"chosen\"])\ndef choose_node(s: State):\n    beam: List[Candidate] = s[\"beam\"]  # type: ignore[assignment]\n    if float(s[\"temperature\"]) <= 0.01:\n        return {\"chosen\": beam[0]}\n    rng: random.Random = s[\"rng\"]  # type: ignore[assignment]\n    return {\"chosen\": rng.choices(beam, weights=list(s[\"beam_probs\"]), k=1)[0]}  # type: ignore[arg-type]\n\n\n@node(\"append\", reads=[\"output\", \"chosen\"], writes=[\"output\"])\ndef append_node(s: State):\n    return {\"output\": list(s[\"output\"]) + [s[\"chosen\"].token]}  # type: ignore[union-attr]\n\n\nSTEP_GRAPH = (lambda_node >> candidates_node >> score_node >> filter_node\n              >> beam_node >> probs_node >> choose_node >> append_node)\n\n\n# --------------------------------------------------------------------------\n# GENERATE_GRAPH: init >> (STEP_GRAPH repeated) >> finish\n# --------------------------------------------------------------------------\n\n@node(\"init_generation\", reads=[\"prompt\", \"seed\"], writes=[\"output\", \"weights\", \"rng\", \"prompt_len\"])\ndef init_generation(s: State):\n    out = TOKEN_RE.findall(str(s[\"prompt\"])) or [\"The\"]\n    return {\n        \"output\": out,\n        \"prompt_len\": len(out),\n        \"weights\": FragmentWeights(int(s[\"seed\"])),\n        \"rng\": random.Random(int(s[\"seed\"])),\n    }\n\n\n@node(\"run_steps\", reads=[\"token_count\", \"output\"], writes=[\"output\", \"trace\"])\ndef run_steps(s: State):\n    state = dict(s)\n    total = max(1, int(s[\"token_count\"]))\n    trace = []\n    for step in range(max(0, int(s[\"token_count\"]))):\n        state.update(step=step, total_steps=total)\n        state = STEP_GRAPH.run(state)\n        chosen: Candidate = state[\"chosen\"]  # type: ignore[assignment]\n        trace.append((step, state[\"lam\"], chosen.token, chosen.base_logp, chosen.score, chosen.consistency))\n        if chosen.token == \"<eos>\":\n            break\n    return {\"output\": state[\"output\"], \"trace\": trace}\n\n\n@node(\"finish\", reads=[\"output\", \"show_trace\"], writes=[\"text\"])\ndef finish(s: State):\n    toks = [t for t in s[\"output\"] if t not in (\"<eos>\", \"<bos>\")]  # type: ignore[union-attr]\n    if s[\"show_trace\"]:\n        for step, lam, tok, logp, score, cons in s[\"trace\"]:  # type: ignore[union-attr]\n            print(f\"[{step:4d}] lam={lam:.3f} tok={tok!r:<14} logp={logp:7.3f} score={score:7.3f} D={cons:.3f}\")\n    return {\"text\": detokenize(toks)}\n\n\nGENERATE_GRAPH = init_generation >> run_steps >> finish\n\n\n# --------------------------------------------------------------------------\n# CLI\n# --------------------------------------------------------------------------\n\ndef main() -> None:\n    ap = argparse.ArgumentParser(description=\"Non-commutative graph n-gram generator.\")\n    ap.add_argument(\"corpus\", nargs=\"?\", help=\"UTF-8 corpus file (built-in corpus if omitted).\")\n    ap.add_argument(\"--prompt\", default=\"A process\")\n    ap.add_argument(\"--tokens\", type=int, default=80)\n    ap.add_argument(\"--order\", type=int, default=3)\n    ap.add_argument(\"--alpha\", type=float, default=0.25)\n    ap.add_argument(\"--beam\", type=int, default=8)\n    ap.add_argument(\"--tau\", type=float, default=0.65)\n    ap.add_argument(\"--temperature\", type=float, default=0.85)\n    ap.add_argument(\"--seed\", type=int, default=7)\n    ap.add_argument(\"--trace\", action=\"store_true\")\n    ap.add_argument(\"--once\", action=\"store_true\", help=\"Generate once from --prompt instead of an interactive loop.\")\n    ap.add_argument(\"--show-graph\", action=\"store_true\", help=\"Print each graph's node order and exit.\")\n    args = ap.parse_args()\n\n    if args.show_graph:\n        for name, g in [(\"TRAIN\", TRAIN_GRAPH), (\"FRAGMENT\", FRAGMENT_GRAPH),\n                        (\"STEP\", STEP_GRAPH), (\"GENERATE\", GENERATE_GRAPH)]:\n            print(f\"{name:9s}: {g.describe()}\")\n        return\n\n    try:\n        trained = TRAIN_GRAPH.run({\"corpus_path\": args.corpus, \"order\": args.order, \"alpha\": args.alpha})\n    except (FileNotFoundError, ValueError) as exc:\n        ap.error(str(exc))\n\n    base = {\n        \"model\": trained[\"model\"], \"token_count\": args.tokens, \"beam_size\": args.beam,\n        \"tau\": float(np.clip(args.tau, 0.0, 1.0)), \"temperature\": max(0.0, args.temperature),\n        \"seed\": args.seed, \"show_trace\": args.trace,\n    }\n\n    while True:\n        prompt = args.prompt if args.once else input(\"USER: \")\n        result = GENERATE_GRAPH.run({**base, \"prompt\": prompt})\n        print(\"\\n--- GENERATED TEXT ---\\n\")\n        print(result[\"text\"])\n        print()\n        if args.once:\n            break\n\n\nif __name__ == \"__main__\":\n    main()\n"}, "message": "Rewrite the generator so every function is a node in a non-commutative directed graph", "integration_name": "File Creation", "integration_icon_url": null, "tool_identifier": null, "icon_name": "file", "context": null, "display_content": {"type": "json_block", "json_block": "{\"language\": \"python\", \"code\": \"#!/usr/bin/env python3\\n\\\"\\\"\\\"\\nNon-commutative graph text generator\\n====================================\\n\\nEvery function from the original script is now a Node in a directed graph.\\n\\nNon-commutativity:\\n  * A Node declares which state keys it `reads` and which it `writes`.\\n  * `a >> b` adds the directed edge a -> b. It is NOT symmetric: `b >> a`\\n    is a different graph, and usually an invalid one (b reads something\\n    only a writes), so Graph.run raises an error.\\n  * `Graph.commutes(a, b, state)` tests this empirically.\\n\\nGraphs:\\n  TRAIN_GRAPH     load_corpus >> tokenize_corpus >> train_model\\n  FRAGMENT_GRAPH  features >> summaries >> consistency >> alignment >> blend\\n  STEP_GRAPH      lambda >> candidates >> score >> filter >> beam >> probs >> choose >> append\\n  GENERATE_GRAPH  init_generation >> (STEP_GRAPH repeated) >> finish\\n\\nUsage:\\n  python noncommutative_graph_textgen.py corpus.txt --prompt \\\"once upon a\\\" --tokens 80\\n  python noncommutative_graph_textgen.py corpus.txt --once --prompt \\\"The machine\\\"\\n  python noncommutative_graph_textgen.py corpus.txt --show-graph\\nOnly dependency: NumPy\\n\\\"\\\"\\\"\\n\\nimport argparse\\nimport math\\nimport random\\nimport re\\nfrom collections import Counter, defaultdict\\nfrom dataclasses import dataclass\\nfrom pathlib import Path\\nfrom typing import Callable, Dict, List, Sequence, Set, Tuple\\n\\nimport numpy as np\\n\\n# --------------------------------------------------------------------------\\n# Graph core\\n# --------------------------------------------------------------------------\\n\\nState = Dict[str, object]\\n\\n\\nclass GraphOrderError(RuntimeError):\\n    \\\"\\\"\\\"Raised when a node runs before the keys it reads exist.\\\"\\\"\\\"\\n\\n\\nclass Node:\\n    \\\"\\\"\\\"A function lifted into a graph node: State -> dict of written keys.\\\"\\\"\\\"\\n\\n    def __init__(self, name: str, fn: Callable[[State], Dict[str, object]],\\n                 reads: Sequence[str] = (), writes: Sequence[str] = ()):\\n        self.name, self.fn = name, fn\\n        self.reads, self.writes = tuple(reads), tuple(writes)\\n\\n    def __call__(self, state: State) -> State:\\n        missing = [k for k in self.reads if k not in state]\\n        if missing:\\n            raise GraphOrderError(f\\\"node '{self.name}' needs {missing} before it can run\\\")\\n        out = dict(state)\\n        out.update(self.fn(state))\\n        return out\\n\\n    def __rshift__(self, other) -> \\\"Graph\\\":\\n        return Graph([self]) >> other\\n\\n    def __repr__(self) -> str:\\n        return f\\\"Node({self.name})\\\"\\n\\n\\ndef node(name: str, reads: Sequence[str] = (), writes: Sequence[str] = ()):\\n    \\\"\\\"\\\"Decorator: turn a function into a Node.\\\"\\\"\\\"\\n    def wrap(fn):\\n        return Node(name, fn, reads, writes)\\n    return wrap\\n\\n\\nclass Graph:\\n    \\\"\\\"\\\"Directed graph of nodes. Edge order is meaningful (non-commutative).\\\"\\\"\\\"\\n\\n    def __init__(self, nodes: Sequence[Node] = (), edges: Sequence[Tuple[Node, Node]] = ()):\\n        self.nodes: List[Node] = list(nodes)\\n        self.edges: List[Tuple[Node, Node]] = list(edges)\\n\\n    def _tails(self) -> List[Node]:\\n        has_out = {a for a, _ in self.edges}\\n        return [n for n in self.nodes if n not in has_out] or self.nodes[-1:]\\n\\n    def _heads(self) -> List[Node]:\\n        has_in = {b for _, b in self.edges}\\n        return [n for n in self.nodes if n not in has_in] or self.nodes[:1]\\n\\n    def __rshift__(self, other) -> \\\"Graph\\\":\\n        other_g = other if isinstance(other, Graph) else Graph([other])\\n        nodes = self.nodes + [n for n in other_g.nodes if n not in self.nodes]\\n        edges = self.edges + other_g.edges\\n        for t in self._tails():\\n            for h in other_g._heads():\\n                edges.append((t, h))\\n        return Graph(nodes, edges)\\n\\n    def topo_order(self) -> List[Node]:\\n        indeg = {n: 0 for n in self.nodes}\\n        for _, b in self.edges:\\n            indeg[b] += 1\\n        ready = [n for n in self.nodes if indeg[n] == 0]\\n        order: List[Node] = []\\n        while ready:\\n            n = ready.pop(0)\\n            order.append(n)\\n            for a, b in self.edges:\\n                if a is n:\\n                    indeg[b] -= 1\\n                    if indeg[b] == 0:\\n                        ready.append(b)\\n        if len(order) != len(self.nodes):\\n            raise GraphOrderError(\\\"graph contains a cycle\\\")\\n        return order\\n\\n    def run(self, state: State) -> State:\\n        for n in self.topo_order():\\n            state = n(state)\\n        return state\\n\\n    def __call__(self, state: State) -> State:\\n        return self.run(state)\\n\\n    def describe(self) -> str:\\n        return \\\" -> \\\".join(n.name for n in self.topo_order())\\n\\n    @staticmethod\\n    def commutes(a: \\\"Node\\\", b: \\\"Node\\\", state: State) -> bool:\\n        \\\"\\\"\\\"True only if running a>>b and b>>a both succeed with equal results.\\\"\\\"\\\"\\n        try:\\n            ab = (a >> b).run(dict(state))\\n            ba = (b >> a).run(dict(state))\\n        except GraphOrderError:\\n            return False\\n        keys = set(ab) | set(ba)\\n        return all(_same(ab.get(k), ba.get(k)) for k in keys)\\n\\n\\ndef _same(x, y) -> bool:\\n    try:\\n        return bool(np.all(x == y))\\n    except Exception:\\n        return x is y\\n\\n\\n# --------------------------------------------------------------------------\\n# Text helpers\\n# --------------------------------------------------------------------------\\n\\nTOKEN_RE = re.compile(r\\\"[A-Za-z]+(?:['\\u2019][A-Za-z]+)*|\\\\d+(?:\\\\.\\\\d+)?|[^\\\\w\\\\s]\\\", re.UNICODE)\\n\\nBUILTIN_CORPUS = (\\n    \\\"A process can be explored before it is selected. The machine reads the text \\\"\\n    \\\"and the text shapes the machine. Once upon a time a small process learned to \\\"\\n    \\\"write, and the words it wrote taught the process what to write next.\\\"\\n)\\n\\nNO_SPACE_BEFORE = set(\\\".,!?;:%)]}\\u00bb\\u201d\\u2019\\\")\\nNO_SPACE_AFTER = set(\\\"([{\\u00ab\\u201c\\u2018\\\")\\n\\n\\ndef detokenize(tokens: Sequence[str]) -> str:\\n    out = \\\"\\\"\\n    for token in tokens:\\n        if not out:\\n            out = token\\n        elif token in NO_SPACE_BEFORE or out[-1:] in NO_SPACE_AFTER:\\n            out += token\\n        else:\\n            out += \\\" \\\" + token\\n    return out\\n\\n\\n# --------------------------------------------------------------------------\\n# Model classes (unchanged logic; their methods are wrapped as nodes below)\\n# --------------------------------------------------------------------------\\n\\n@dataclass\\nclass Candidate:\\n    token: str\\n    base_logp: float\\n    score: float\\n    consistency: float\\n    alignment: float\\n    probability: float = 0.0\\n\\n\\nclass NGramModel:\\n    def __init__(self, order: int = 3, alpha: float = 0.25):\\n        self.order = max(1, int(order))\\n        self.alpha = max(1e-9, float(alpha))\\n        self.counts = [defaultdict(Counter) for _ in range(self.order)]\\n        self.vocab = Counter()\\n        self.total_tokens = 0\\n\\n    def train_tokens(self, words: Sequence[str]) -> None:\\n        tokens = [\\\"<bos>\\\"] * (self.order - 1) + list(words) + [\\\"<eos>\\\"]\\n        for i in range(self.order - 1, len(tokens)):\\n            target = tokens[i]\\n            self.vocab[target] += 1\\n            self.total_tokens += 1\\n            for ctx_len in range(self.order):\\n                context = tuple(tokens[i - ctx_len:i]) if ctx_len else ()\\n                self.counts[ctx_len][context][target] += 1\\n\\n    def candidates(self, context_tokens: Sequence[str], limit: int = 80) -> List[Tuple[str, float]]:\\n        vocab_size = max(1, len(self.vocab))\\n        context = list(context_tokens)\\n        counter: Counter = Counter()\\n        for ctx_len in range(min(self.order - 1, len(context)), -1, -1):\\n            key = tuple(context[-ctx_len:]) if ctx_len else ()\\n            found = self.counts[ctx_len].get(key)\\n            if not found:\\n                continue\\n            weight = 1.0 + 0.7 * ctx_len\\n            for token, count in found.items():\\n                counter[token] += weight * count\\n            if ctx_len >= 1:\\n                break\\n        if not counter:\\n            counter.update(self.vocab)\\n        total = sum(counter.values())\\n        ranked = [(t, math.log(max((c + self.alpha) / (total + self.alpha * vocab_size), 1e-12)))\\n                  for t, c in counter.items()]\\n        ranked.sort(key=lambda item: item[1], reverse=True)\\n        return ranked[:max(1, limit)]\\n\\n\\nclass FragmentWeights:\\n    \\\"\\\"\\\"Holds the fixed random projections (R^5 -> R^3, R^4, R^2): not invertible.\\\"\\\"\\\"\\n\\n    def __init__(self, seed: int = 17):\\n        rng = np.random.default_rng(seed)\\n        self.w_context = rng.normal(0, 0.7, size=(5, 3))\\n        self.w_word = rng.normal(0, 0.7, size=(5, 4))\\n        self.w_transition = rng.normal(0, 0.7, size=(5, 2))\\n\\n\\ndef _unit(v: np.ndarray) -> np.ndarray:\\n    n = float(np.linalg.norm(v))\\n    return v / n if n > 1e-12 else np.zeros_like(v)\\n\\n\\ndef _hash_features(token: str, width: int) -> np.ndarray:\\n    raw = token.lower().encode(\\\"utf-8\\\", errors=\\\"ignore\\\")\\n    vals = np.zeros(width, dtype=float)\\n    if not raw:\\n        return vals\\n    for i, byte in enumerate(raw):\\n        vals[i % width] += ((byte % 31) - 15) / 15.0\\n        vals[(i * 3 + 1) % width] += ((byte % 17) - 8) / 8.0\\n    vals /= max(1, len(raw))\\n    vals[0] += min(len(raw), 20) / 20.0\\n    vals[1] += sum(chr(b).isalpha() for b in raw) / max(1, len(raw))\\n    return np.tanh(vals)\\n\\n\\ndef softmax(values: Sequence[float], temperature: float = 1.0) -> np.ndarray:\\n    temp = max(1e-6, float(temperature))\\n    arr = np.asarray(values, dtype=float) / temp\\n    arr -= np.max(arr)\\n    exp = np.exp(np.clip(arr, -60, 60))\\n    return exp / max(float(exp.sum()), 1e-12)\\n\\n\\n# --------------------------------------------------------------------------\\n# TRAIN_GRAPH:  load_corpus >> tokenize_corpus >> train_model\\n# --------------------------------------------------------------------------\\n\\n@node(\\\"load_corpus\\\", reads=[\\\"corpus_path\\\"], writes=[\\\"corpus_text\\\"])\\ndef load_corpus(s: State):\\n    path = s[\\\"corpus_path\\\"]\\n    if not path:\\n        return {\\\"corpus_text\\\": BUILTIN_CORPUS}\\n    p = Path(str(path))\\n    if not p.is_file():\\n        raise FileNotFoundError(f\\\"Corpus file not found: {p}\\\")\\n    return {\\\"corpus_text\\\": p.read_text(encoding=\\\"utf-8-sig\\\")}\\n\\n\\n@node(\\\"tokenize_corpus\\\", reads=[\\\"corpus_text\\\"], writes=[\\\"corpus_tokens\\\"])\\ndef tokenize_corpus(s: State):\\n    toks = TOKEN_RE.findall(str(s[\\\"corpus_text\\\"]))\\n    if not toks:\\n        raise ValueError(\\\"Corpus contains no recognizable tokens.\\\")\\n    return {\\\"corpus_tokens\\\": toks}\\n\\n\\n@node(\\\"train_model\\\", reads=[\\\"corpus_tokens\\\", \\\"order\\\", \\\"alpha\\\"], writes=[\\\"model\\\"])\\ndef train_model(s: State):\\n    model = NGramModel(order=int(s[\\\"order\\\"]), alpha=float(s[\\\"alpha\\\"]))\\n    model.train_tokens(s[\\\"corpus_tokens\\\"])  # type: ignore[arg-type]\\n    return {\\\"model\\\": model}\\n\\n\\nTRAIN_GRAPH = load_corpus >> tokenize_corpus >> train_model\\n\\n\\n# --------------------------------------------------------------------------\\n# FRAGMENT_GRAPH:  features >> summaries >> consistency >> alignment >> blend\\n# state in:  weights, context, token, logp, rank, lam\\n# state out: frag_score (total_score), frag_consistency\\n# --------------------------------------------------------------------------\\n\\n@node(\\\"features\\\", reads=[\\\"weights\\\", \\\"context\\\", \\\"token\\\", \\\"logp\\\", \\\"rank\\\"], writes=[\\\"g1\\\", \\\"g2\\\", \\\"g3\\\"])\\ndef features_node(s: State):\\n    w: FragmentWeights = s[\\\"weights\\\"]  # type: ignore[assignment]\\n    context, token, logp, rank = s[\\\"context\\\"], s[\\\"token\\\"], float(s[\\\"logp\\\"]), int(s[\\\"rank\\\"])\\n    recent = list(context[-4:])  # type: ignore[index]\\n    ctx_vec = np.zeros(5)\\n    for i, word in enumerate(recent):\\n        ctx_vec += _hash_features(word, 5) * (0.65 ** (len(recent) - i - 1))\\n    ctx_vec /= max(1, len(recent))\\n    word_vec = _hash_features(str(token), 5)\\n    transition_vec = np.array([\\n        np.tanh(logp), 1.0 / (1.0 + rank),\\n        1.0 if str(token)[:1].isupper() else 0.0,\\n        1.0 if token in \\\".,!?;:\\\" else 0.0,\\n        min(len(str(token)), 24) / 24.0,\\n    ])\\n    return {\\n        \\\"g1\\\": np.tanh(ctx_vec @ w.w_context),\\n        \\\"g2\\\": np.tanh(word_vec @ w.w_word),\\n        \\\"g3\\\": np.tanh(transition_vec @ w.w_transition),\\n    }\\n\\n\\n@node(\\\"summaries\\\", reads=[\\\"g1\\\", \\\"g2\\\", \\\"g3\\\"], writes=[\\\"summaries\\\"])\\ndef summaries_node(s: State):\\n    return {\\\"summaries\\\": np.array([np.linalg.norm(s[\\\"g1\\\"]), np.linalg.norm(s[\\\"g2\\\"]), np.linalg.norm(s[\\\"g3\\\"])])}\\n\\n\\n@node(\\\"consistency\\\", reads=[\\\"summaries\\\"], writes=[\\\"frag_consistency\\\"])\\ndef consistency_node(s: State):\\n    summ = s[\\\"summaries\\\"]\\n    mean = float(np.mean(summ))\\n    spread = float(np.std(summ) / (mean + 1e-9))\\n    return {\\\"frag_consistency\\\": float(np.clip(0.55 * spread + 0.45 * (1.0 - mean), 0.0, 1.0))}\\n\\n\\n@node(\\\"alignment\\\", reads=[\\\"g1\\\", \\\"g2\\\", \\\"g3\\\", \\\"logp\\\", \\\"rank\\\"], writes=[\\\"frag_alignment\\\"])\\ndef alignment_node(s: State):\\n    g1, g2, g3 = s[\\\"g1\\\"], s[\\\"g2\\\"], s[\\\"g3\\\"]\\n    logp, rank = float(s[\\\"logp\\\"]), int(s[\\\"rank\\\"])\\n    ref = _unit(np.array([np.mean(g1), np.mean(g2), np.mean(g3), np.tanh(logp)]))\\n    cand = _unit(np.array([g1[0], g2[0], g3[0], np.tanh(logp + 0.1 * rank)]))\\n    return {\\\"frag_alignment\\\": (float(np.dot(ref, cand)) + 1.0) / 2.0}\\n\\n\\n@node(\\\"blend\\\", reads=[\\\"frag_alignment\\\", \\\"frag_consistency\\\", \\\"logp\\\", \\\"lam\\\"], writes=[\\\"frag_score\\\"])\\ndef blend_node(s: State):\\n    logp, lam = float(s[\\\"logp\\\"]), float(s[\\\"lam\\\"])\\n    frag = 1.6 * s[\\\"frag_alignment\\\"] - 1.15 * s[\\\"frag_consistency\\\"]  # type: ignore[operator]\\n    total = (1.0 - lam) * (0.75 * logp + 0.25 * frag) + lam * (1.25 * logp + 0.85 * frag)\\n    return {\\\"frag_score\\\": float(total)}\\n\\n\\nFRAGMENT_GRAPH = features_node >> summaries_node >> consistency_node >> alignment_node >> blend_node\\n\\n\\n# --------------------------------------------------------------------------\\n# STEP_GRAPH: one generation step\\n# --------------------------------------------------------------------------\\n\\n@node(\\\"adiabatic_lambda\\\", reads=[\\\"step\\\", \\\"total_steps\\\"], writes=[\\\"lam\\\"])\\ndef lambda_node(s: State):\\n    u = min(1.0, max(0.0, int(s[\\\"step\\\"]) / max(1, int(s[\\\"total_steps\\\"]) - 1)))\\n    return {\\\"lam\\\": 3.0 * u * u - 2.0 * u * u * u}\\n\\n\\n@node(\\\"candidates\\\", reads=[\\\"model\\\", \\\"output\\\", \\\"beam_size\\\"], writes=[\\\"ranked\\\"])\\ndef candidates_node(s: State):\\n    model: NGramModel = s[\\\"model\\\"]  # type: ignore[assignment]\\n    return {\\\"ranked\\\": model.candidates(s[\\\"output\\\"], limit=max(40, int(s[\\\"beam_size\\\"]) * 8))}  # type: ignore[arg-type]\\n\\n\\n@node(\\\"score\\\", reads=[\\\"weights\\\", \\\"output\\\", \\\"ranked\\\", \\\"lam\\\"], writes=[\\\"scored_all\\\"])\\ndef score_node(s: State):\\n    rows = []\\n    for rank, (token, logp) in enumerate(s[\\\"ranked\\\"]):  # type: ignore[arg-type]\\n        r = FRAGMENT_GRAPH.run({\\n            \\\"weights\\\": s[\\\"weights\\\"], \\\"context\\\": s[\\\"output\\\"], \\\"token\\\": token,\\n            \\\"logp\\\": logp, \\\"rank\\\": rank, \\\"lam\\\": s[\\\"lam\\\"],\\n        })\\n        rows.append((token, logp, float(r[\\\"frag_score\\\"]), float(r[\\\"frag_consistency\\\"])))\\n    return {\\\"scored_all\\\": rows}\\n\\n\\n@node(\\\"filter\\\", reads=[\\\"scored_all\\\", \\\"ranked\\\", \\\"tau\\\"], writes=[\\\"scored\\\"])\\ndef filter_node(s: State):\\n    tau = float(s[\\\"tau\\\"])\\n    scored = []\\n    for token, logp, score, cons in s[\\\"scored_all\\\"]:  # type: ignore[union-attr]\\n        if cons <= tau:\\n            alignment = float(np.clip((score - logp) / 2.5 + 0.5, 0.0, 1.0))\\n            scored.append(Candidate(token, logp, score, cons, alignment))\\n    if not scored:  # avoid a dead end\\n        token, logp, score, cons = s[\\\"scored_all\\\"][0]  # type: ignore[index]\\n        scored = [Candidate(token, logp, score, cons, 0.5)]\\n    return {\\\"scored\\\": scored}\\n\\n\\n@node(\\\"beam\\\", reads=[\\\"scored\\\", \\\"beam_size\\\"], writes=[\\\"beam\\\"])\\ndef beam_node(s: State):\\n    ranked = sorted(s[\\\"scored\\\"], key=lambda c: c.score, reverse=True)  # type: ignore[union-attr]\\n    return {\\\"beam\\\": ranked[:max(1, int(s[\\\"beam_size\\\"]))]}\\n\\n\\n@node(\\\"probabilities\\\", reads=[\\\"beam\\\", \\\"temperature\\\"], writes=[\\\"beam_probs\\\"])\\ndef probs_node(s: State):\\n    beam: List[Candidate] = s[\\\"beam\\\"]  # type: ignore[assignment]\\n    probs = softmax([c.score for c in beam], float(s[\\\"temperature\\\"]))\\n    for c, p in zip(beam, probs):\\n        c.probability = float(p)\\n    return {\\\"beam_probs\\\": probs}\\n\\n\\n@node(\\\"choose\\\", reads=[\\\"beam\\\", \\\"beam_probs\\\", \\\"temperature\\\", \\\"rng\\\"], writes=[\\\"chosen\\\"])\\ndef choose_node(s: State):\\n    beam: List[Candidate] = s[\\\"beam\\\"]  # type: ignore[assignment]\\n    if float(s[\\\"temperature\\\"]) <= 0.01:\\n        return {\\\"chosen\\\": beam[0]}\\n    rng: random.Random = s[\\\"rng\\\"]  # type: ignore[assignment]\\n    return {\\\"chosen\\\": rng.choices(beam, weights=list(s[\\\"beam_probs\\\"]), k=1)[0]}  # type: ignore[arg-type]\\n\\n\\n@node(\\\"append\\\", reads=[\\\"output\\\", \\\"chosen\\\"], writes=[\\\"output\\\"])\\ndef append_node(s: State):\\n    return {\\\"output\\\": list(s[\\\"output\\\"]) + [s[\\\"chosen\\\"].token]}  # type: ignore[union-attr]\\n\\n\\nSTEP_GRAPH = (lambda_node >> candidates_node >> score_node >> filter_node\\n              >> beam_node >> probs_node >> choose_node >> append_node)\\n\\n\\n# --------------------------------------------------------------------------\\n# GENERATE_GRAPH: init >> (STEP_GRAPH repeated) >> finish\\n# --------------------------------------------------------------------------\\n\\n@node(\\\"init_generation\\\", reads=[\\\"prompt\\\", \\\"seed\\\"], writes=[\\\"output\\\", \\\"weights\\\", \\\"rng\\\", \\\"prompt_len\\\"])\\ndef init_generation(s: State):\\n    out = TOKEN_RE.findall(str(s[\\\"prompt\\\"])) or [\\\"The\\\"]\\n    return {\\n        \\\"output\\\": out,\\n        \\\"prompt_len\\\": len(out),\\n        \\\"weights\\\": FragmentWeights(int(s[\\\"seed\\\"])),\\n        \\\"rng\\\": random.Random(int(s[\\\"seed\\\"])),\\n    }\\n\\n\\n@node(\\\"run_steps\\\", reads=[\\\"token_count\\\", \\\"output\\\"], writes=[\\\"output\\\", \\\"trace\\\"])\\ndef run_steps(s: State):\\n    state = dict(s)\\n    total = max(1, int(s[\\\"token_count\\\"]))\\n    trace = []\\n    for step in range(max(0, int(s[\\\"token_count\\\"]))):\\n        state.update(step=step, total_steps=total)\\n        state = STEP_GRAPH.run(state)\\n        chosen: Candidate = state[\\\"chosen\\\"]  # type: ignore[assignment]\\n        trace.append((step, state[\\\"lam\\\"], chosen.token, chosen.base_logp, chosen.score, chosen.consistency))\\n        if chosen.token == \\\"<eos>\\\":\\n            break\\n    return {\\\"output\\\": state[\\\"output\\\"], \\\"trace\\\": trace}\\n\\n\\n@node(\\\"finish\\\", reads=[\\\"output\\\", \\\"show_trace\\\"], writes=[\\\"text\\\"])\\ndef finish(s: State):\\n    toks = [t for t in s[\\\"output\\\"] if t not in (\\\"<eos>\\\", \\\"<bos>\\\")]  # type: ignore[union-attr]\\n    if s[\\\"show_trace\\\"]:\\n        for step, lam, tok, logp, score, cons in s[\\\"trace\\\"]:  # type: ignore[union-attr]\\n            print(f\\\"[{step:4d}] lam={lam:.3f} tok={tok!r:<14} logp={logp:7.3f} score={score:7.3f} D={cons:.3f}\\\")\\n    return {\\\"text\\\": detokenize(toks)}\\n\\n\\nGENERATE_GRAPH = init_generation >> run_steps >> finish\\n\\n\\n# --------------------------------------------------------------------------\\n# CLI\\n# --------------------------------------------------------------------------\\n\\ndef main() -> None:\\n    ap = argparse.ArgumentParser(description=\\\"Non-commutative graph n-gram generator.\\\")\\n    ap.add_argument(\\\"corpus\\\", nargs=\\\"?\\\", help=\\\"UTF-8 corpus file (built-in corpus if omitted).\\\")\\n    ap.add_argument(\\\"--prompt\\\", default=\\\"A process\\\")\\n    ap.add_argument(\\\"--tokens\\\", type=int, default=80)\\n    ap.add_argument(\\\"--order\\\", type=int, default=3)\\n    ap.add_argument(\\\"--alpha\\\", type=float, default=0.25)\\n    ap.add_argument(\\\"--beam\\\", type=int, default=8)\\n    ap.add_argument(\\\"--tau\\\", type=float, default=0.65)\\n    ap.add_argument(\\\"--temperature\\\", type=float, default=0.85)\\n    ap.add_argument(\\\"--seed\\\", type=int, default=7)\\n    ap.add_argument(\\\"--trace\\\", action=\\\"store_true\\\")\\n    ap.add_argument(\\\"--once\\\", action=\\\"store_true\\\", help=\\\"Generate once from --prompt instead of an interactive loop.\\\")\\n    ap.add_argument(\\\"--show-graph\\\", action=\\\"store_true\\\", help=\\\"Print each graph's node order and exit.\\\")\\n    args = ap.parse_args()\\n\\n    if args.show_graph:\\n        for name, g in [(\\\"TRAIN\\\", TRAIN_GRAPH), (\\\"FRAGMENT\\\", FRAGMENT_GRAPH),\\n                        (\\\"STEP\\\", STEP_GRAPH), (\\\"GENERATE\\\", GENERATE_GRAPH)]:\\n            print(f\\\"{name:9s}: {g.describe()}\\\")\\n        return\\n\\n    try:\\n        trained = TRAIN_GRAPH.run({\\\"corpus_path\\\": args.corpus, \\\"order\\\": args.order, \\\"alpha\\\": args.alpha})\\n    except (FileNotFoundError, ValueError) as exc:\\n        ap.error(str(exc))\\n\\n    base = {\\n        \\\"model\\\": trained[\\\"model\\\"], \\\"token_count\\\": args.tokens, \\\"beam_size\\\": args.beam,\\n        \\\"tau\\\": float(np.clip(args.tau, 0.0, 1.0)), \\\"temperature\\\": max(0.0, args.temperature),\\n        \\\"seed\\\": args.seed, \\\"show_trace\\\": args.trace,\\n    }\\n\\n    while True:\\n        prompt = args.prompt if args.once else input(\\\"USER: \\\")\\n        result = GENERATE_GRAPH.run({**base, \\\"prompt\\\": prompt})\\n        print(\\\"\\\\n--- GENERATED TEXT ---\\\\n\\\")\\n        print(result[\\\"text\\\"])\\n        print()\\n        if args.once:\\n            break\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\", \"filename\": \"/mnt/user-data/outputs/noncommutative_graph_textgen.py\"}"}, "approval_options": null, "approval_key": null, "approval_key_legacy": null, "is_mcp_app": null, "hidden_in_chat": null, "mcp_server_url": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-10-14T23:19:10.807236Z", "stop_timestamp": "2026-10-14T23:19:10.807265Z", "flags": null, "type": "tool_result", "tool_use_id": "toolu_01DFjA3EvddcsR6V9hwRWPrD", "name": "create_file", "content": [{"type": "text", "text": "File created successfully: /mnt/user-data/outputs/noncommutative_graph_textgen.py"}], "is_error": false, "structured_content": null, "meta": {"output_format_category": "other"}, "message": null, "integration_name": "File Creation", "mcp_server_url": null, "integration_icon_url": null, "icon_name": "file", "display_content": {"type": "text", "text": "File created successfully: /mnt/user-data/outputs/noncommutative_graph_textgen.py"}, "hidden_in_chat": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-10-14T23:19:12.209697Z", "stop_timestamp": "2026-10-14T23:19:13.694213Z", "flags": null, "type": "tool_use", "id": "toolu_014ZQ2FTWn6awcqT2RJUycad", "name": "bash_tool", "input": {"command": "cd /mnt/user-data/outputs && python noncommutative_graph_textgen.py --show-graph && python noncommutative_graph_textgen.py --once --prompt \"The machine\" --tokens 25 && python - <<'EOF'\nimport noncommutative_graph_textgen as g\nprint(\"lambda/candidates commute?\", g.Graph.commutes(g.lambda_node, g.candidates_node, {\"step\":0,\"total_steps\":5,\"model\":g.NGramModel(),\"output\":[\"a\"],\"beam_size\":4}))\ntry:\n    (g.append_node >> g.choose_node).run({})\nexcept g.GraphOrderError as e: print(\"reverse order fails:\", e)\nEOF", "description": "Test the graph script"}, "message": "Test the graph script", "integration_name": "File Creation", "integration_icon_url": null, "tool_identifier": null, "icon_name": "commandLine", "context": null, "display_content": {"type": "json_block", "json_block": "{\"language\": \"bash\", \"code\": \"cd /mnt/user-data/outputs && python noncommutative_graph_textgen.py --show-graph && python noncommutative_graph_textgen.py --once --prompt \\\"The machine\\\" --tokens 25 && python - <<'EOF'\\nimport noncommutative_graph_textgen as g\\nprint(\\\"lambda/candidates commute?\\\", g.Graph.commutes(g.lambda_node, g.candidates_node, {\\\"step\\\":0,\\\"total_steps\\\":5,\\\"model\\\":g.NGramModel(),\\\"output\\\":[\\\"a\\\"],\\\"beam_size\\\":4}))\\ntry:\\n    (g.append_node >> g.choose_node).run({})\\nexcept g.GraphOrderError as e: print(\\\"reverse order fails:\\\", e)\\nEOF\"}"}, "approval_options": null, "approval_key": null, "approval_key_legacy": null, "is_mcp_app": null, "hidden_in_chat": null, "mcp_server_url": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-10-14T23:19:14.819660Z", "stop_timestamp": "2026-10-14T23:19:14.819697Z", "flags": null, "type": "tool_result", "tool_use_id": "toolu_014ZQ2FTWn6awcqT2RJUycad", "name": "bash_tool", "content": [{"type": "text", "text": "{\"returncode\":0,\"stdout\":\"TRAIN    : load_corpus -> tokenize_corpus -> train_model\\nFRAGMENT : features -> summaries -> consistency -> alignment -> blend\\nSTEP     : adiabatic_lambda -> candidates -> score -> filter -> beam -> probabilities -> choose -> append\\nGENERATE : init_generation -> run_steps -> finish\\n\\n--- GENERATED TEXT ---\\n\\nThe machine reads the text and the text and the text and the text and the text and the words it wrote taught the process what to\\n\\nlambda/candidates commute? True\\nreverse order fails: node 'append' needs ['output', 'chosen'] before it can run\\n\",\"stderr\":\"\"}"}], "is_error": false, "structured_content": null, "meta": {"output_format_category": "none"}, "message": null, "integration_name": "File Creation", "mcp_server_url": null, "integration_icon_url": null, "icon_name": "commandLine", "display_content": {"type": "json_block", "json_block": "{\"returncode\":0,\"stdout\":\"TRAIN    : load_corpus -> tokenize_corpus -> train_model\\nFRAGMENT : features -> summaries -> consistency -> alignment -> blend\\nSTEP     : adiabatic_lambda -> candidates -> score -> filter -> beam -> probabilities -> choose -> append\\nGENERATE : init_generation -> run_steps -> finish\\n\\n--- GENERATED TEXT ---\\n\\nThe machine reads the text and the text and the text and the text and the text and the words it wrote taught the process what to\\n\\nlambda/candidates commute? True\\nreverse order fails: node 'append' needs ['output', 'chosen'] before it can run\\n\",\"stderr\":\"\"}"}, "hidden_in_chat": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-10-14T23:19:16.309442Z", "stop_timestamp": "2026-10-14T23:19:16.579797Z", "flags": null, "type": "tool_use", "id": "toolu_01VtW6s8Jr55aqSuZ6CkiEXz", "name": "present_files", "input": {"filepaths": ["/mnt/user-data/outputs/noncommutative_graph_textgen.py"]}, "message": "Presenting file(s)...", "integration_name": "File Creation", "integration_icon_url": null, "tool_identifier": null, "icon_name": "file", "context": null, "display_content": {"type": "table", "table": [["filepaths", "['/mnt/user-data/outputs/noncommutative_graph_textgen.py']"]]}, "approval_options": null, "approval_key": null, "approval_key_legacy": null, "is_mcp_app": null, "hidden_in_chat": null, "mcp_server_url": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-10-14T23:19:16.602858Z", "stop_timestamp": "2026-10-14T23:19:16.602884Z", "flags": null, "type": "tool_result", "tool_use_id": "toolu_01VtW6s8Jr55aqSuZ6CkiEXz", "name": "present_files", "content": [{"type": "local_resource", "file_path": "/mnt/user-data/outputs/noncommutative_graph_textgen.py", "name": "noncommutative graph textgen", "mime_type": "text/x-python", "artifact_publishable": false}, {"type": "text", "text": "\n\nThe file cards appear with your reply, and where they sit relative to its text depends on the app the user is reading in; finish the reply with text, and refer to a file by its name, never as above or below."}], "is_error": false, "structured_content": null, "meta": {"output_format_category": "other"}, "message": "Presented file", "integration_name": "File Creation", "mcp_server_url": null, "integration_icon_url": null, "icon_name": "file", "display_content": null, "hidden_in_chat": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-10-14T23:19:22.599302Z", "stop_timestamp": "2026-10-14T23:19:22.985712Z", "flags": null, "type": "text", "text": "I rewrote the script so every function is a node in a directed graph, and it runs. The test generated text, and running the nodes in reverse order failed as intended.\n\n**How the graphs work**\n- Each function is a `Node` that declares the state keys it reads and writes.\n- `a >> b` adds the edge a \u2192 b, and edge order matters. Running `append >> choose` raises `GraphOrderError`, because `append` needs `chosen` before `choose` has produced it.\n- `Graph.commutes(a, b, state)` checks whether two nodes give the same result in either order. Most pairs don't. A pair like `adiabatic_lambda` and `candidates` does commute, because they touch independent keys, and the tool says so honestly.\n\n**The four graphs**\n- `TRAIN`: `load_corpus >> tokenize_corpus >> train_model`\n- `FRAGMENT`: `features >> summaries >> consistency >> alignment >> blend`. The three non-invertible projections (R\u2075 \u2192 R\u00b3, R\u2074, R\u00b2) now feed this graph.\n- `STEP`: `adiabatic_lambda >> candidates >> score >> filter >> beam >> probabilities >> choose >> append`\n- `GENERATE`: `init_generation >> run_steps >> finish`. `run_steps` applies `STEP` once per token.\n\nRun `--show-graph` to print every graph's node order.\n\n**Bugs fixed along the way**\n- `TOKEN_RE` had doubled backslashes (`\\\\d`), so it matched literal backslashes. It is fixed and now actually used. The original `tokenize` just called `.split()`.\n- `input(\"Filename: \")` ran at import time. The corpus now comes from the CLI argument, or from a small built-in corpus if you omit it.\n- `generate` returned `' '.join(output)`, which left `detokenize` unused and `<eos>` in the output. It now stops at `<eos>`, strips markers, and detokenizes.\n- `--trace` did nothing before. It now prints per-token diagnostics.\n- `--once` skips the interactive loop, and `--tokens` defaults to 80 instead of 800.\n\nI read your request as \"composition order matters in a graph of the functions.\" If you meant something else, such as a graph with matrix-valued edge weights that don't commute, or non-commutative graphs in the operator-algebra sense, tell me and I'll rework it.\n\nThe code is in `noncommutative_graph_textgen.py`.", "citations": []}], "sender": "assistant", "created_at": "2026-10-14T23:19:23.095651Z", "updated_at": "2026-10-14T23:19:23.095651Z", "attachments": [], "files": [], "parent_message_uuid": "01a13cb5-8f54-7ae9-8c31-503b3fa4f1ab"}, {"uuid": "01a13cbd-88a0-7a3f-9062-303507b7fc62", "text": "apply the non commutative to the non isomorphic sentence endings/ compartmentialisation", "content": [{"start_timestamp": "2026-10-14T23:38:35.552294Z", "stop_timestamp": "2026-10-14T23:38:35.552294Z", "flags": null, "type": "text", "text": "apply the non commutative to the non isomorphic sentence endings/ compartmentialisation", "citations": []}], "sender": "human", "created_at": "2026-10-14T23:38:35.552514Z", "updated_at": "2026-10-14T23:38:35.552514Z", "attachments": [], "files": [], "parent_message_uuid": "01a13cb5-8f54-74e9-8de5-457821605e11"}, {"uuid": "01a13cbd-88a0-7921-ac47-0e036bf7164f", "text": "Here is how I'm applying it. Each sentence becomes a **compartment** with its own state, and the sentence-ending decision becomes a graph whose steps don't commute. I'm extending the previous file rather than replacing it.\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\n", "content": [{"start_timestamp": "2026-10-14T23:38:35.552099Z", "stop_timestamp": "2026-10-14T23:39:33.453409Z", "flags": null, "type": "thinking", "thinking": "", "summaries": [{"summary": "Untangling how sentence endings should be grouped."}, {"summary": "Designing a layered graph for scoring sentence endings."}, {"summary": "Ordering bracket closure, termination, and capitalization steps."}, {"summary": "Tracking compartment boundaries with lossy summaries between sentences."}, {"summary": "Assigning weighted features to score ending pressure."}, {"summary": "Using noncommutative matrix steps to combine ending pressure signals."}, {"summary": "Sequencing terminator choice and compartment sealing after closures."}, {"summary": "Wiring prompt tokens into compartment initialization and tracing."}], "cut_off": false, "truncated": true, "hidden": false, "thinking_hidden": true, "alternative_display_type": null, "signature": null}, {"start_timestamp": "2026-10-14T23:39:33.453432Z", "stop_timestamp": "2026-10-14T23:39:34.356932Z", "flags": null, "type": "text", "text": "Here is how I'm applying it. Each sentence becomes a **compartment** with its own state, and the sentence-ending decision becomes a graph whose steps don't commute. I'm extending the previous file rather than replacing it.", "citations": []}, {"start_timestamp": "2026-10-14T23:39:34.356964Z", "stop_timestamp": "2026-10-14T23:40:07.411914Z", "flags": null, "type": "tool_use", "id": "toolu_01F6wQoruGVowGMprEpzpVdV", "name": "create_file", "input": {"description": "Add compartmentalised, non-commutative sentence-ending graphs on top of the previous module", "path": "/mnt/user-data/outputs/noncommutative_sentence_endings.py", "file_text": "#!/usr/bin/env python3\n\"\"\"\nNon-commutative, non-isomorphic sentence endings with compartmentalisation\n==========================================================================\n\nBuilds on noncommutative_graph_textgen.py (keep both files in one folder).\n\nCompartments\n  Each sentence is a compartment: its own token list, its own stack of open\n  brackets/quotes. When a compartment is sealed, only a lossy 2-number\n  `carry` summary crosses the boundary (many sentences -> same carry, so the\n  boundary map is not invertible). `carry` sets the next sentence's target length.\n\nNon-isomorphic ending fragments (different input -> output dimensions)\n  length_fragment   R^2 -> R^1   how long the sentence is vs its target\n  closure_fragment  R^3 -> R^2   open brackets, dangling function word, too short\n  rhythm_fragment   R^4 -> R^3   lengths of the last four words\n\nNon-commutativity (two independent sources)\n  1. Each fragment is an affine action on a 2-vector accumulator:\n         acc <- tanh(M_i @ acc + v_i)\n     with M_i a shear / rotation / shear. Matrix products do not commute, so\n     length >> closure >> rhythm  !=  rhythm >> closure >> length.\n  2. Ending edits are order-sensitive text operations:\n         close_brackets >> emit_terminator   gives  \"word ) .\"?  no: \"word ) .\"\n     is wrong; the right order gives  \"word ) .\"  vs  \"word . )\"  -- see --demo.\n\nUsage\n  python noncommutative_sentence_endings.py corpus.txt --prompt \"The machine\" --tokens 120\n  python noncommutative_sentence_endings.py corpus.txt --once --trace\n  python noncommutative_sentence_endings.py --show-graph\n  python noncommutative_sentence_endings.py --demo\n\"\"\"\n\nimport argparse\nfrom typing import List\n\nimport numpy as np\n\nfrom noncommutative_graph_textgen import (\n    TOKEN_RE, TRAIN_GRAPH, STEP_GRAPH, Candidate, FragmentWeights, Graph,\n    GraphOrderError, NGramModel, Node, detokenize, init_generation, node,\n)\n\nOPENERS = {\"(\": \")\", \"[\": \"]\", \"{\": \"}\", \"\u201c\": \"\u201d\", \"\u00ab\": \"\u00bb\", \"\u2018\": \"\u2019\"}\nTERMINATORS = (\".\", \"!\", \"?\")\nFUNCTION_WORDS = {\n    \"a\", \"an\", \"the\", \"of\", \"to\", \"in\", \"on\", \"at\", \"for\", \"with\", \"and\", \"or\",\n    \"but\", \"by\", \"from\", \"as\", \"is\", \"are\", \"was\", \"were\", \"that\", \"this\", \"it\",\n}\n\n\nclass EndingWeights:\n    \"\"\"Fixed fragment matrices of different shapes + non-commuting accumulator maps.\"\"\"\n\n    def __init__(self, seed: int = 17):\n        rng = np.random.default_rng(seed + 101)\n        noise = lambda *shape: 0.05 * rng.normal(size=shape)\n        self.w_len = np.array([[1.4], [0.8]]) + noise(2, 1)                           # R^2 -> R^1\n        self.w_close = np.array([[-1.2, -0.6], [-1.0, -0.6], [-1.2, -0.4]]) + noise(3, 2)  # R^3 -> R^2\n        self.w_rhythm = 0.5 * np.ones((4, 3)) + noise(4, 3)                           # R^4 -> R^3\n        th = 0.3\n        self.m_len = np.array([[1.0, 0.4], [0.0, 1.0]])                               # shear\n        self.m_close = np.array([[np.cos(th), -np.sin(th)], [np.sin(th), np.cos(th)]])  # rotation\n        self.m_rhythm = np.array([[1.0, 0.0], [0.5, 1.0]])                            # opposite shear\n\n\n# --------------------------------------------------------------------------\n# Compartment bookkeeping\n# --------------------------------------------------------------------------\n\ndef _track(token: str, current: List[str], stack: List[str]) -> bool:\n    \"\"\"Update the compartment with one token. Returns True on a natural sentence end.\"\"\"\n    current.append(token)\n    if token in OPENERS:\n        stack.append(OPENERS[token])\n    elif token == '\"':\n        if stack and stack[-1] == '\"':\n            stack.pop()\n        else:\n            stack.append('\"')\n    elif stack and token == stack[-1]:\n        stack.pop()\n    return token in TERMINATORS\n\n\ndef _carry(current: List[str]) -> np.ndarray:\n    \"\"\"Lossy boundary map: a whole sentence -> R^2. Not invertible.\"\"\"\n    words = [t for t in current if t[:1].isalnum()]\n    last = len(words[-1]) if words else 0\n    return np.array([min(len(words), 30) / 30.0, min(last, 12) / 12.0])\n\n\n@node(\"init_compartments\", reads=[\"output\"],\n      writes=[\"current\", \"open_stack\", \"compartments\", \"carry\", \"natural_end\", \"end\"])\ndef init_compartments(s):\n    current: List[str] = []\n    stack: List[str] = []\n    compartments: List[List[str]] = []\n    carry = np.array([0.4, 0.3])\n    for tok in s[\"output\"]:  # replay the prompt through the same bookkeeping\n        if _track(tok, current, stack):\n            compartments.append(current)\n            carry = _carry(current)\n            current = []\n    return {\"current\": current, \"open_stack\": stack, \"compartments\": compartments,\n            \"carry\": carry, \"natural_end\": False, \"end\": False}\n\n\n# --------------------------------------------------------------------------\n# ENDING_GRAPH  (order is meaningful end to end)\n# --------------------------------------------------------------------------\n\n@node(\"track_compartment\", reads=[\"chosen\", \"current\", \"open_stack\"],\n      writes=[\"current\", \"open_stack\", \"natural_end\"])\ndef track_compartment(s):\n    current, stack = list(s[\"current\"]), list(s[\"open_stack\"])\n    natural = _track(s[\"chosen\"].token, current, stack)\n    return {\"current\": current, \"open_stack\": stack, \"natural_end\": natural}\n\n\n@node(\"reset_accumulator\", reads=[\"carry\"], writes=[\"acc\", \"target_len\"])\ndef reset_accumulator(s):\n    return {\"acc\": np.zeros(2), \"target_len\": 16.0 - 10.0 * float(s[\"carry\"][0])}\n\n\ndef _words(current):\n    return [t for t in current if t[:1].isalnum()]\n\n\n@node(\"length_fragment\", reads=[\"ending_weights\", \"current\", \"target_len\", \"acc\"], writes=[\"acc\"])\ndef length_fragment(s):\n    w: EndingWeights = s[\"ending_weights\"]\n    n, target = len(_words(s[\"current\"])), float(s[\"target_len\"])\n    x = np.array([min(n / target, 2.0) / 2.0, 1.0 if n >= target else 0.0])   # R^2\n    a = float(np.tanh(x @ w.w_len)[0])                                          # -> R^1\n    return {\"acc\": np.tanh(w.m_len @ s[\"acc\"] + np.array([a, 0.5 * a]))}\n\n\n@node(\"closure_fragment\", reads=[\"ending_weights\", \"current\", \"open_stack\", \"acc\"], writes=[\"acc\"])\ndef closure_fragment(s):\n    w: EndingWeights = s[\"ending_weights\"]\n    words = _words(s[\"current\"])\n    x = np.array([                                                              # R^3\n        1.0 if s[\"open_stack\"] else 0.0,\n        1.0 if words and words[-1].lower() in FUNCTION_WORDS else 0.0,\n        1.0 if len(words) < 3 else 0.0,\n    ])\n    y = np.tanh(x @ w.w_close)                                                  # -> R^2\n    return {\"acc\": np.tanh(w.m_close @ s[\"acc\"] + y)}\n\n\n@node(\"rhythm_fragment\", reads=[\"ending_weights\", \"current\", \"acc\"], writes=[\"acc\"])\ndef rhythm_fragment(s):\n    w: EndingWeights = s[\"ending_weights\"]\n    lens = [min(len(t), 12) / 12.0 for t in _words(s[\"current\"])[-4:]]\n    x = np.array(([0.0] * 4 + lens)[-4:])                                       # R^4\n    y = np.tanh(x @ w.w_rhythm)                                                 # -> R^3\n    return {\"acc\": np.tanh(w.m_rhythm @ s[\"acc\"] + np.array([y.mean(), y.max() - y.min()]))}\n\n\n@node(\"ending_decision\", reads=[\"acc\", \"natural_end\", \"current\", \"rng\"], writes=[\"end\", \"pressure\"])\ndef ending_decision(s):\n    pressure = float(s[\"acc\"][0])\n    if s[\"natural_end\"]:\n        return {\"end\": True, \"pressure\": pressure}\n    if len(_words(s[\"current\"])) < 3:\n        return {\"end\": False, \"pressure\": pressure}\n    p_end = 1.0 / (1.0 + np.exp(-6.0 * (pressure - 0.75)))\n    return {\"end\": bool(s[\"rng\"].random() < p_end), \"pressure\": pressure}\n\n\n@node(\"close_brackets\", reads=[\"end\", \"natural_end\", \"open_stack\", \"output\", \"current\"],\n      writes=[\"output\", \"current\", \"open_stack\"])\ndef close_brackets(s):\n    if not s[\"end\"] or s[\"natural_end\"] or not s[\"open_stack\"]:\n        return {}\n    closers = list(reversed(s[\"open_stack\"]))\n    return {\"output\": list(s[\"output\"]) + closers,\n            \"current\": list(s[\"current\"]) + closers, \"open_stack\": []}\n\n\n@node(\"choose_terminator\", reads=[\"end\", \"natural_end\", \"model\", \"output\"], writes=[\"terminator\"])\ndef choose_terminator(s):\n    if not s[\"end\"] or s[\"natural_end\"]:\n        return {\"terminator\": None}\n    ranked = s[\"model\"].candidates(s[\"output\"], limit=100000)\n    for tok, _ in ranked:\n        if tok in TERMINATORS:\n            return {\"terminator\": tok}\n    return {\"terminator\": \".\"}\n\n\n@node(\"emit_terminator\", reads=[\"terminator\", \"output\", \"current\"], writes=[\"output\", \"current\"])\ndef emit_terminator(s):\n    if s[\"terminator\"] is None:\n        return {}\n    return {\"output\": list(s[\"output\"]) + [s[\"terminator\"]],\n            \"current\": list(s[\"current\"]) + [s[\"terminator\"]]}\n\n\n@node(\"seal_compartment\", reads=[\"end\", \"current\", \"compartments\"],\n      writes=[\"current\", \"compartments\", \"carry\"])\ndef seal_compartment(s):\n    if not s[\"end\"]:\n        return {}\n    return {\"compartments\": list(s[\"compartments\"]) + [list(s[\"current\"])],\n            \"carry\": _carry(s[\"current\"]), \"current\": []}\n\n\nENDING_GRAPH = (reset_accumulator >> length_fragment >> closure_fragment >> rhythm_fragment\n                >> ending_decision >> close_brackets >> choose_terminator\n                >> emit_terminator >> seal_compartment)\n\nSTEP_GRAPH_V2 = STEP_GRAPH >> track_compartment >> ENDING_GRAPH\n\n\n# --------------------------------------------------------------------------\n# GENERATE_GRAPH_V2\n# --------------------------------------------------------------------------\n\n@node(\"init_ending_weights\", reads=[\"seed\"], writes=[\"ending_weights\"])\ndef init_ending_weights(s):\n    return {\"ending_weights\": EndingWeights(int(s[\"seed\"]))}\n\n\n@node(\"run_steps_v2\", reads=[\"token_count\", \"output\", \"compartments\"], writes=[\"output\", \"trace\"])\ndef run_steps_v2(s):\n    state = dict(s)\n    total = max(1, int(s[\"token_count\"]))\n    trace = []\n    for step in range(max(0, int(s[\"token_count\"]))):\n        state.update(step=step, total_steps=total)\n        state = STEP_GRAPH_V2.run(state)\n        chosen: Candidate = state[\"chosen\"]\n        trace.append((step, chosen.token, state[\"pressure\"], state[\"end\"], len(state[\"compartments\"])))\n        if chosen.token == \"<eos>\":\n            break\n    return {\"output\": state[\"output\"], \"trace\": trace,\n            \"compartments\": state[\"compartments\"], \"current\": state[\"current\"]}\n\n\ndef _capitalise(tokens: List[str]) -> List[str]:\n    toks = list(tokens)\n    for i, t in enumerate(toks):\n        if t[:1].isalpha():\n            toks[i] = t[:1].upper() + t[1:]\n            break\n    return toks\n\n\n@node(\"render_compartments\", reads=[\"compartments\", \"current\", \"show_trace\"], writes=[\"text\"])\ndef render_compartments(s):\n    if s[\"show_trace\"]:\n        for step, tok, pressure, end, n in s[\"trace\"]:\n            mark = \"  <-- END\" if end else \"\"\n            print(f\"[{step:4d}] tok={tok!r:<14} pressure={pressure:+.3f} sentences={n}{mark}\")\n    parts = list(s[\"compartments\"]) + ([s[\"current\"]] if s[\"current\"] else [])\n    clean = [[t for t in p if t not in (\"<eos>\", \"<bos>\")] for p in parts]\n    return {\"text\": \" \".join(detokenize(_capitalise(p)) for p in clean if p)}\n\n\nGENERATE_GRAPH_V2 = (init_generation >> init_compartments >> init_ending_weights\n                     >> run_steps_v2 >> render_compartments)\n\n\n# --------------------------------------------------------------------------\n# Non-commutativity demo\n# --------------------------------------------------------------------------\n\ndef demo() -> None:\n    w = EndingWeights()\n    base = {\n        \"ending_weights\": w, \"acc\": np.zeros(2), \"target_len\": 8.0,\n        \"current\": [\"the\", \"machine\", \"(\", \"reads\", \"text\"], \"open_stack\": [\")\"],\n    }\n    print(\"Fragment order (acc after each order):\")\n    for a, b in [(length_fragment, closure_fragment), (closure_fragment, rhythm_fragment),\n                 (length_fragment, rhythm_fragment)]:\n        ab = (a >> b).run(dict(base))[\"acc\"]\n        ba = (b >> a).run(dict(base))[\"acc\"]\n        print(f\"  {a.name:>17} >> {b.name:<17} {np.round(ab, 4)}\")\n        print(f\"  {b.name:>17} >> {a.name:<17} {np.round(ba, 4)}   commutes={Graph.commutes(a, b, base)}\")\n\n    model = NGramModel(order=2)\n    model.train_tokens([\"a\", \"b\", \".\"])\n    st = {\"end\": True, \"natural_end\": False, \"open_stack\": [\")\"], \"terminator\": \".\",\n          \"output\": [\"the\", \"machine\", \"(\", \"reads\", \"text\"],\n          \"current\": [\"the\", \"machine\", \"(\", \"reads\", \"text\"]}\n    print(\"\\nEnding edit order:\")\n    print(\"  close >> emit :\", detokenize((close_brackets >> emit_terminator).run(dict(st))[\"output\"]))\n    print(\"  emit >> close :\", detokenize((emit_terminator >> close_brackets).run(dict(st))[\"output\"]))\n    print(\"  commutes      :\", Graph.commutes(close_brackets, emit_terminator, st))\n\n\n# --------------------------------------------------------------------------\n# CLI\n# --------------------------------------------------------------------------\n\ndef main() -> None:\n    ap = argparse.ArgumentParser(description=\"Compartmentalised non-commutative sentence endings.\")\n    ap.add_argument(\"corpus\", nargs=\"?\")\n    ap.add_argument(\"--prompt\", default=\"A process\")\n    ap.add_argument(\"--tokens\", type=int, default=120)\n    ap.add_argument(\"--order\", type=int, default=3)\n    ap.add_argument(\"--alpha\", type=float, default=0.25)\n    ap.add_argument(\"--beam\", type=int, default=8)\n    ap.add_argument(\"--tau\", type=float, default=0.65)\n    ap.add_argument(\"--temperature\", type=float, default=0.85)\n    ap.add_argument(\"--seed\", type=int, default=7)\n    ap.add_argument(\"--trace\", action=\"store_true\")\n    ap.add_argument(\"--once\", action=\"store_true\")\n    ap.add_argument(\"--show-graph\", action=\"store_true\")\n    ap.add_argument(\"--demo\", action=\"store_true\", help=\"Show order-dependence of the ending nodes.\")\n    args = ap.parse_args()\n\n    if args.show_graph:\n        print(\"ENDING  :\", ENDING_GRAPH.describe())\n        print(\"STEP v2 :\", STEP_GRAPH_V2.describe())\n        print(\"GENERATE:\", GENERATE_GRAPH_V2.describe())\n        return\n    if args.demo:\n        demo()\n        return\n\n    try:\n        trained = TRAIN_GRAPH.run({\"corpus_path\": args.corpus, \"order\": args.order, \"alpha\": args.alpha})\n    except (FileNotFoundError, ValueError) as exc:\n        ap.error(str(exc))\n\n    base = {\n        \"model\": trained[\"model\"], \"token_count\": args.tokens, \"beam_size\": args.beam,\n        \"tau\": float(np.clip(args.tau, 0.0, 1.0)), \"temperature\": max(0.0, args.temperature),\n        \"seed\": args.seed, \"show_trace\": args.trace,\n    }\n    while True:\n        prompt = args.prompt if args.once else input(\"USER: \")\n        result = GENERATE_GRAPH_V2.run({**base, \"prompt\": prompt})\n        print(\"\\n--- GENERATED TEXT ---\\n\")\n        print(result[\"text\"])\n        print(f\"\\n[{len(result['compartments'])} sealed sentence compartments]\\n\")\n        if args.once:\n            break\n\n\nif __name__ == \"__main__\":\n    main()\n"}, "message": "Add compartmentalised, non-commutative sentence-ending graphs on top of the previous module", "integration_name": "File Creation", "integration_icon_url": null, "tool_identifier": null, "icon_name": "file", "context": null, "display_content": {"type": "json_block", "json_block": "{\"language\": \"python\", \"code\": \"#!/usr/bin/env python3\\n\\\"\\\"\\\"\\nNon-commutative, non-isomorphic sentence endings with compartmentalisation\\n==========================================================================\\n\\nBuilds on noncommutative_graph_textgen.py (keep both files in one folder).\\n\\nCompartments\\n  Each sentence is a compartment: its own token list, its own stack of open\\n  brackets/quotes. When a compartment is sealed, only a lossy 2-number\\n  `carry` summary crosses the boundary (many sentences -> same carry, so the\\n  boundary map is not invertible). `carry` sets the next sentence's target length.\\n\\nNon-isomorphic ending fragments (different input -> output dimensions)\\n  length_fragment   R^2 -> R^1   how long the sentence is vs its target\\n  closure_fragment  R^3 -> R^2   open brackets, dangling function word, too short\\n  rhythm_fragment   R^4 -> R^3   lengths of the last four words\\n\\nNon-commutativity (two independent sources)\\n  1. Each fragment is an affine action on a 2-vector accumulator:\\n         acc <- tanh(M_i @ acc + v_i)\\n     with M_i a shear / rotation / shear. Matrix products do not commute, so\\n     length >> closure >> rhythm  !=  rhythm >> closure >> length.\\n  2. Ending edits are order-sensitive text operations:\\n         close_brackets >> emit_terminator   gives  \\\"word ) .\\\"?  no: \\\"word ) .\\\"\\n     is wrong; the right order gives  \\\"word ) .\\\"  vs  \\\"word . )\\\"  -- see --demo.\\n\\nUsage\\n  python noncommutative_sentence_endings.py corpus.txt --prompt \\\"The machine\\\" --tokens 120\\n  python noncommutative_sentence_endings.py corpus.txt --once --trace\\n  python noncommutative_sentence_endings.py --show-graph\\n  python noncommutative_sentence_endings.py --demo\\n\\\"\\\"\\\"\\n\\nimport argparse\\nfrom typing import List\\n\\nimport numpy as np\\n\\nfrom noncommutative_graph_textgen import (\\n    TOKEN_RE, TRAIN_GRAPH, STEP_GRAPH, Candidate, FragmentWeights, Graph,\\n    GraphOrderError, NGramModel, Node, detokenize, init_generation, node,\\n)\\n\\nOPENERS = {\\\"(\\\": \\\")\\\", \\\"[\\\": \\\"]\\\", \\\"{\\\": \\\"}\\\", \\\"\\u201c\\\": \\\"\\u201d\\\", \\\"\\u00ab\\\": \\\"\\u00bb\\\", \\\"\\u2018\\\": \\\"\\u2019\\\"}\\nTERMINATORS = (\\\".\\\", \\\"!\\\", \\\"?\\\")\\nFUNCTION_WORDS = {\\n    \\\"a\\\", \\\"an\\\", \\\"the\\\", \\\"of\\\", \\\"to\\\", \\\"in\\\", \\\"on\\\", \\\"at\\\", \\\"for\\\", \\\"with\\\", \\\"and\\\", \\\"or\\\",\\n    \\\"but\\\", \\\"by\\\", \\\"from\\\", \\\"as\\\", \\\"is\\\", \\\"are\\\", \\\"was\\\", \\\"were\\\", \\\"that\\\", \\\"this\\\", \\\"it\\\",\\n}\\n\\n\\nclass EndingWeights:\\n    \\\"\\\"\\\"Fixed fragment matrices of different shapes + non-commuting accumulator maps.\\\"\\\"\\\"\\n\\n    def __init__(self, seed: int = 17):\\n        rng = np.random.default_rng(seed + 101)\\n        noise = lambda *shape: 0.05 * rng.normal(size=shape)\\n        self.w_len = np.array([[1.4], [0.8]]) + noise(2, 1)                           # R^2 -> R^1\\n        self.w_close = np.array([[-1.2, -0.6], [-1.0, -0.6], [-1.2, -0.4]]) + noise(3, 2)  # R^3 -> R^2\\n        self.w_rhythm = 0.5 * np.ones((4, 3)) + noise(4, 3)                           # R^4 -> R^3\\n        th = 0.3\\n        self.m_len = np.array([[1.0, 0.4], [0.0, 1.0]])                               # shear\\n        self.m_close = np.array([[np.cos(th), -np.sin(th)], [np.sin(th), np.cos(th)]])  # rotation\\n        self.m_rhythm = np.array([[1.0, 0.0], [0.5, 1.0]])                            # opposite shear\\n\\n\\n# --------------------------------------------------------------------------\\n# Compartment bookkeeping\\n# --------------------------------------------------------------------------\\n\\ndef _track(token: str, current: List[str], stack: List[str]) -> bool:\\n    \\\"\\\"\\\"Update the compartment with one token. Returns True on a natural sentence end.\\\"\\\"\\\"\\n    current.append(token)\\n    if token in OPENERS:\\n        stack.append(OPENERS[token])\\n    elif token == '\\\"':\\n        if stack and stack[-1] == '\\\"':\\n            stack.pop()\\n        else:\\n            stack.append('\\\"')\\n    elif stack and token == stack[-1]:\\n        stack.pop()\\n    return token in TERMINATORS\\n\\n\\ndef _carry(current: List[str]) -> np.ndarray:\\n    \\\"\\\"\\\"Lossy boundary map: a whole sentence -> R^2. Not invertible.\\\"\\\"\\\"\\n    words = [t for t in current if t[:1].isalnum()]\\n    last = len(words[-1]) if words else 0\\n    return np.array([min(len(words), 30) / 30.0, min(last, 12) / 12.0])\\n\\n\\n@node(\\\"init_compartments\\\", reads=[\\\"output\\\"],\\n      writes=[\\\"current\\\", \\\"open_stack\\\", \\\"compartments\\\", \\\"carry\\\", \\\"natural_end\\\", \\\"end\\\"])\\ndef init_compartments(s):\\n    current: List[str] = []\\n    stack: List[str] = []\\n    compartments: List[List[str]] = []\\n    carry = np.array([0.4, 0.3])\\n    for tok in s[\\\"output\\\"]:  # replay the prompt through the same bookkeeping\\n        if _track(tok, current, stack):\\n            compartments.append(current)\\n            carry = _carry(current)\\n            current = []\\n    return {\\\"current\\\": current, \\\"open_stack\\\": stack, \\\"compartments\\\": compartments,\\n            \\\"carry\\\": carry, \\\"natural_end\\\": False, \\\"end\\\": False}\\n\\n\\n# --------------------------------------------------------------------------\\n# ENDING_GRAPH  (order is meaningful end to end)\\n# --------------------------------------------------------------------------\\n\\n@node(\\\"track_compartment\\\", reads=[\\\"chosen\\\", \\\"current\\\", \\\"open_stack\\\"],\\n      writes=[\\\"current\\\", \\\"open_stack\\\", \\\"natural_end\\\"])\\ndef track_compartment(s):\\n    current, stack = list(s[\\\"current\\\"]), list(s[\\\"open_stack\\\"])\\n    natural = _track(s[\\\"chosen\\\"].token, current, stack)\\n    return {\\\"current\\\": current, \\\"open_stack\\\": stack, \\\"natural_end\\\": natural}\\n\\n\\n@node(\\\"reset_accumulator\\\", reads=[\\\"carry\\\"], writes=[\\\"acc\\\", \\\"target_len\\\"])\\ndef reset_accumulator(s):\\n    return {\\\"acc\\\": np.zeros(2), \\\"target_len\\\": 16.0 - 10.0 * float(s[\\\"carry\\\"][0])}\\n\\n\\ndef _words(current):\\n    return [t for t in current if t[:1].isalnum()]\\n\\n\\n@node(\\\"length_fragment\\\", reads=[\\\"ending_weights\\\", \\\"current\\\", \\\"target_len\\\", \\\"acc\\\"], writes=[\\\"acc\\\"])\\ndef length_fragment(s):\\n    w: EndingWeights = s[\\\"ending_weights\\\"]\\n    n, target = len(_words(s[\\\"current\\\"])), float(s[\\\"target_len\\\"])\\n    x = np.array([min(n / target, 2.0) / 2.0, 1.0 if n >= target else 0.0])   # R^2\\n    a = float(np.tanh(x @ w.w_len)[0])                                          # -> R^1\\n    return {\\\"acc\\\": np.tanh(w.m_len @ s[\\\"acc\\\"] + np.array([a, 0.5 * a]))}\\n\\n\\n@node(\\\"closure_fragment\\\", reads=[\\\"ending_weights\\\", \\\"current\\\", \\\"open_stack\\\", \\\"acc\\\"], writes=[\\\"acc\\\"])\\ndef closure_fragment(s):\\n    w: EndingWeights = s[\\\"ending_weights\\\"]\\n    words = _words(s[\\\"current\\\"])\\n    x = np.array([                                                              # R^3\\n        1.0 if s[\\\"open_stack\\\"] else 0.0,\\n        1.0 if words and words[-1].lower() in FUNCTION_WORDS else 0.0,\\n        1.0 if len(words) < 3 else 0.0,\\n    ])\\n    y = np.tanh(x @ w.w_close)                                                  # -> R^2\\n    return {\\\"acc\\\": np.tanh(w.m_close @ s[\\\"acc\\\"] + y)}\\n\\n\\n@node(\\\"rhythm_fragment\\\", reads=[\\\"ending_weights\\\", \\\"current\\\", \\\"acc\\\"], writes=[\\\"acc\\\"])\\ndef rhythm_fragment(s):\\n    w: EndingWeights = s[\\\"ending_weights\\\"]\\n    lens = [min(len(t), 12) / 12.0 for t in _words(s[\\\"current\\\"])[-4:]]\\n    x = np.array(([0.0] * 4 + lens)[-4:])                                       # R^4\\n    y = np.tanh(x @ w.w_rhythm)                                                 # -> R^3\\n    return {\\\"acc\\\": np.tanh(w.m_rhythm @ s[\\\"acc\\\"] + np.array([y.mean(), y.max() - y.min()]))}\\n\\n\\n@node(\\\"ending_decision\\\", reads=[\\\"acc\\\", \\\"natural_end\\\", \\\"current\\\", \\\"rng\\\"], writes=[\\\"end\\\", \\\"pressure\\\"])\\ndef ending_decision(s):\\n    pressure = float(s[\\\"acc\\\"][0])\\n    if s[\\\"natural_end\\\"]:\\n        return {\\\"end\\\": True, \\\"pressure\\\": pressure}\\n    if len(_words(s[\\\"current\\\"])) < 3:\\n        return {\\\"end\\\": False, \\\"pressure\\\": pressure}\\n    p_end = 1.0 / (1.0 + np.exp(-6.0 * (pressure - 0.75)))\\n    return {\\\"end\\\": bool(s[\\\"rng\\\"].random() < p_end), \\\"pressure\\\": pressure}\\n\\n\\n@node(\\\"close_brackets\\\", reads=[\\\"end\\\", \\\"natural_end\\\", \\\"open_stack\\\", \\\"output\\\", \\\"current\\\"],\\n      writes=[\\\"output\\\", \\\"current\\\", \\\"open_stack\\\"])\\ndef close_brackets(s):\\n    if not s[\\\"end\\\"] or s[\\\"natural_end\\\"] or not s[\\\"open_stack\\\"]:\\n        return {}\\n    closers = list(reversed(s[\\\"open_stack\\\"]))\\n    return {\\\"output\\\": list(s[\\\"output\\\"]) + closers,\\n            \\\"current\\\": list(s[\\\"current\\\"]) + closers, \\\"open_stack\\\": []}\\n\\n\\n@node(\\\"choose_terminator\\\", reads=[\\\"end\\\", \\\"natural_end\\\", \\\"model\\\", \\\"output\\\"], writes=[\\\"terminator\\\"])\\ndef choose_terminator(s):\\n    if not s[\\\"end\\\"] or s[\\\"natural_end\\\"]:\\n        return {\\\"terminator\\\": None}\\n    ranked = s[\\\"model\\\"].candidates(s[\\\"output\\\"], limit=100000)\\n    for tok, _ in ranked:\\n        if tok in TERMINATORS:\\n            return {\\\"terminator\\\": tok}\\n    return {\\\"terminator\\\": \\\".\\\"}\\n\\n\\n@node(\\\"emit_terminator\\\", reads=[\\\"terminator\\\", \\\"output\\\", \\\"current\\\"], writes=[\\\"output\\\", \\\"current\\\"])\\ndef emit_terminator(s):\\n    if s[\\\"terminator\\\"] is None:\\n        return {}\\n    return {\\\"output\\\": list(s[\\\"output\\\"]) + [s[\\\"terminator\\\"]],\\n            \\\"current\\\": list(s[\\\"current\\\"]) + [s[\\\"terminator\\\"]]}\\n\\n\\n@node(\\\"seal_compartment\\\", reads=[\\\"end\\\", \\\"current\\\", \\\"compartments\\\"],\\n      writes=[\\\"current\\\", \\\"compartments\\\", \\\"carry\\\"])\\ndef seal_compartment(s):\\n    if not s[\\\"end\\\"]:\\n        return {}\\n    return {\\\"compartments\\\": list(s[\\\"compartments\\\"]) + [list(s[\\\"current\\\"])],\\n            \\\"carry\\\": _carry(s[\\\"current\\\"]), \\\"current\\\": []}\\n\\n\\nENDING_GRAPH = (reset_accumulator >> length_fragment >> closure_fragment >> rhythm_fragment\\n                >> ending_decision >> close_brackets >> choose_terminator\\n                >> emit_terminator >> seal_compartment)\\n\\nSTEP_GRAPH_V2 = STEP_GRAPH >> track_compartment >> ENDING_GRAPH\\n\\n\\n# --------------------------------------------------------------------------\\n# GENERATE_GRAPH_V2\\n# --------------------------------------------------------------------------\\n\\n@node(\\\"init_ending_weights\\\", reads=[\\\"seed\\\"], writes=[\\\"ending_weights\\\"])\\ndef init_ending_weights(s):\\n    return {\\\"ending_weights\\\": EndingWeights(int(s[\\\"seed\\\"]))}\\n\\n\\n@node(\\\"run_steps_v2\\\", reads=[\\\"token_count\\\", \\\"output\\\", \\\"compartments\\\"], writes=[\\\"output\\\", \\\"trace\\\"])\\ndef run_steps_v2(s):\\n    state = dict(s)\\n    total = max(1, int(s[\\\"token_count\\\"]))\\n    trace = []\\n    for step in range(max(0, int(s[\\\"token_count\\\"]))):\\n        state.update(step=step, total_steps=total)\\n        state = STEP_GRAPH_V2.run(state)\\n        chosen: Candidate = state[\\\"chosen\\\"]\\n        trace.append((step, chosen.token, state[\\\"pressure\\\"], state[\\\"end\\\"], len(state[\\\"compartments\\\"])))\\n        if chosen.token == \\\"<eos>\\\":\\n            break\\n    return {\\\"output\\\": state[\\\"output\\\"], \\\"trace\\\": trace,\\n            \\\"compartments\\\": state[\\\"compartments\\\"], \\\"current\\\": state[\\\"current\\\"]}\\n\\n\\ndef _capitalise(tokens: List[str]) -> List[str]:\\n    toks = list(tokens)\\n    for i, t in enumerate(toks):\\n        if t[:1].isalpha():\\n            toks[i] = t[:1].upper() + t[1:]\\n            break\\n    return toks\\n\\n\\n@node(\\\"render_compartments\\\", reads=[\\\"compartments\\\", \\\"current\\\", \\\"show_trace\\\"], writes=[\\\"text\\\"])\\ndef render_compartments(s):\\n    if s[\\\"show_trace\\\"]:\\n        for step, tok, pressure, end, n in s[\\\"trace\\\"]:\\n            mark = \\\"  <-- END\\\" if end else \\\"\\\"\\n            print(f\\\"[{step:4d}] tok={tok!r:<14} pressure={pressure:+.3f} sentences={n}{mark}\\\")\\n    parts = list(s[\\\"compartments\\\"]) + ([s[\\\"current\\\"]] if s[\\\"current\\\"] else [])\\n    clean = [[t for t in p if t not in (\\\"<eos>\\\", \\\"<bos>\\\")] for p in parts]\\n    return {\\\"text\\\": \\\" \\\".join(detokenize(_capitalise(p)) for p in clean if p)}\\n\\n\\nGENERATE_GRAPH_V2 = (init_generation >> init_compartments >> init_ending_weights\\n                     >> run_steps_v2 >> render_compartments)\\n\\n\\n# --------------------------------------------------------------------------\\n# Non-commutativity demo\\n# --------------------------------------------------------------------------\\n\\ndef demo() -> None:\\n    w = EndingWeights()\\n    base = {\\n        \\\"ending_weights\\\": w, \\\"acc\\\": np.zeros(2), \\\"target_len\\\": 8.0,\\n        \\\"current\\\": [\\\"the\\\", \\\"machine\\\", \\\"(\\\", \\\"reads\\\", \\\"text\\\"], \\\"open_stack\\\": [\\\")\\\"],\\n    }\\n    print(\\\"Fragment order (acc after each order):\\\")\\n    for a, b in [(length_fragment, closure_fragment), (closure_fragment, rhythm_fragment),\\n                 (length_fragment, rhythm_fragment)]:\\n        ab = (a >> b).run(dict(base))[\\\"acc\\\"]\\n        ba = (b >> a).run(dict(base))[\\\"acc\\\"]\\n        print(f\\\"  {a.name:>17} >> {b.name:<17} {np.round(ab, 4)}\\\")\\n        print(f\\\"  {b.name:>17} >> {a.name:<17} {np.round(ba, 4)}   commutes={Graph.commutes(a, b, base)}\\\")\\n\\n    model = NGramModel(order=2)\\n    model.train_tokens([\\\"a\\\", \\\"b\\\", \\\".\\\"])\\n    st = {\\\"end\\\": True, \\\"natural_end\\\": False, \\\"open_stack\\\": [\\\")\\\"], \\\"terminator\\\": \\\".\\\",\\n          \\\"output\\\": [\\\"the\\\", \\\"machine\\\", \\\"(\\\", \\\"reads\\\", \\\"text\\\"],\\n          \\\"current\\\": [\\\"the\\\", \\\"machine\\\", \\\"(\\\", \\\"reads\\\", \\\"text\\\"]}\\n    print(\\\"\\\\nEnding edit order:\\\")\\n    print(\\\"  close >> emit :\\\", detokenize((close_brackets >> emit_terminator).run(dict(st))[\\\"output\\\"]))\\n    print(\\\"  emit >> close :\\\", detokenize((emit_terminator >> close_brackets).run(dict(st))[\\\"output\\\"]))\\n    print(\\\"  commutes      :\\\", Graph.commutes(close_brackets, emit_terminator, st))\\n\\n\\n# --------------------------------------------------------------------------\\n# CLI\\n# --------------------------------------------------------------------------\\n\\ndef main() -> None:\\n    ap = argparse.ArgumentParser(description=\\\"Compartmentalised non-commutative sentence endings.\\\")\\n    ap.add_argument(\\\"corpus\\\", nargs=\\\"?\\\")\\n    ap.add_argument(\\\"--prompt\\\", default=\\\"A process\\\")\\n    ap.add_argument(\\\"--tokens\\\", type=int, default=120)\\n    ap.add_argument(\\\"--order\\\", type=int, default=3)\\n    ap.add_argument(\\\"--alpha\\\", type=float, default=0.25)\\n    ap.add_argument(\\\"--beam\\\", type=int, default=8)\\n    ap.add_argument(\\\"--tau\\\", type=float, default=0.65)\\n    ap.add_argument(\\\"--temperature\\\", type=float, default=0.85)\\n    ap.add_argument(\\\"--seed\\\", type=int, default=7)\\n    ap.add_argument(\\\"--trace\\\", action=\\\"store_true\\\")\\n    ap.add_argument(\\\"--once\\\", action=\\\"store_true\\\")\\n    ap.add_argument(\\\"--show-graph\\\", action=\\\"store_true\\\")\\n    ap.add_argument(\\\"--demo\\\", action=\\\"store_true\\\", help=\\\"Show order-dependence of the ending nodes.\\\")\\n    args = ap.parse_args()\\n\\n    if args.show_graph:\\n        print(\\\"ENDING  :\\\", ENDING_GRAPH.describe())\\n        print(\\\"STEP v2 :\\\", STEP_GRAPH_V2.describe())\\n        print(\\\"GENERATE:\\\", GENERATE_GRAPH_V2.describe())\\n        return\\n    if args.demo:\\n        demo()\\n        return\\n\\n    try:\\n        trained = TRAIN_GRAPH.run({\\\"corpus_path\\\": args.corpus, \\\"order\\\": args.order, \\\"alpha\\\": args.alpha})\\n    except (FileNotFoundError, ValueError) as exc:\\n        ap.error(str(exc))\\n\\n    base = {\\n        \\\"model\\\": trained[\\\"model\\\"], \\\"token_count\\\": args.tokens, \\\"beam_size\\\": args.beam,\\n        \\\"tau\\\": float(np.clip(args.tau, 0.0, 1.0)), \\\"temperature\\\": max(0.0, args.temperature),\\n        \\\"seed\\\": args.seed, \\\"show_trace\\\": args.trace,\\n    }\\n    while True:\\n        prompt = args.prompt if args.once else input(\\\"USER: \\\")\\n        result = GENERATE_GRAPH_V2.run({**base, \\\"prompt\\\": prompt})\\n        print(\\\"\\\\n--- GENERATED TEXT ---\\\\n\\\")\\n        print(result[\\\"text\\\"])\\n        print(f\\\"\\\\n[{len(result['compartments'])} sealed sentence compartments]\\\\n\\\")\\n        if args.once:\\n            break\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\", \"filename\": \"/mnt/user-data/outputs/noncommutative_sentence_endings.py\"}"}, "approval_options": null, "approval_key": null, "approval_key_legacy": null, "is_mcp_app": null, "hidden_in_chat": null, "mcp_server_url": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-10-14T23: