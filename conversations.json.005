   if (from_pool) g_pool_spill_bytes += size;''','''static unsigned long long g_alloc_calls = 0, g_alloc_bytes = 0, g_free_calls = 0;\nstatic inline void note_alloc(size_t size, void* p, bool from_pool) {\n    g_alloc_calls++; g_alloc_bytes += size;\n    if (from_pool) g_pool_spill_bytes += size;''',1)\ns=s.replace('''static inline void note_free(void* p) {''','''static inline void note_free(void* p) {\n    g_free_calls++;''',1)\nopen(p,'w').write(s)\np='kernel_parts/09_terminal_window.h'\ns=open(p).read()\na=s.index('\\t\\t\\tsnprintf(mb, sizeof mb, \"head after init')\nb=s.index('\\t\\t\\tconsole_print(mb);',a)\ns=s[:a]+'''\\t\\t\\tsnprintf(mb, sizeof mb, \"head: init=%d loop=%d now=%d\\\\n\",\n\\t\\t\\t         (int)(uintptr_t)g_head_after_init, (int)(uintptr_t)g_head_in_loop, (int)(uintptr_t)g_allocator.head());\n'''+s[b:]\ns=s.replace('''\\t\\t\\tconsole_print(mb);\n\\t\\t\\tsnprintf(mb, sizeof mb, \"probe       : head=%d''','''\\t\\t\\tconsole_print(mb);\n\\t\\t\\tsnprintf(mb, sizeof mb, \"allocs: %d calls, %d KB total, %d frees\\\\n\",\n\\t\\t\\t         (int)g_alloc_calls, (int)(g_alloc_bytes / 1024), (int)g_free_calls);\n\\t\\t\\tconsole_print(mb);\n\\t\\t\\tsnprintf(mb, sizeof mb, \"probe       : head=%d''',1)\nopen(p,'w').write(s)\nEOF\nfor f in kernel_parts/01_fs_encryption.h kernel_parts/09_terminal_window.h; do cp $f /tmp/kb/$f; done; cd /tmp/kb && touch kernel.cpp && (make BOCHS=1 -j4 > /tmp/kbuild11.log 2>&1; echo exit=$?); grep -n \"error\" /tmp/kbuild11.log | head -5\n/tmp/boot.sh /tmp/kb/main.iso /home/claude/OS/disk.img; cd /tmp && python3 - <<'EOF'\nexec(open('/tmp/qm.py').read())\nfrom PIL import Image\nkeys('meminfo\\n'); time.sleep(3)\nshot('mi4',1); Image.open('/tmp/mi4.ppm').crop((130,80,770,300)).resize((960,330),Image.NEAREST).save('/tmp/mi4.png')\nEOF", "description": "Add allocation call/byte totals and re-read meminfo"}, "message": "Add allocation call/byte totals and re-read meminfo", "integration_name": "File Creation", "integration_