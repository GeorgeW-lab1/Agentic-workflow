al decay"}], "cut_off": false, "truncated": true, "hidden": false, "thinking_hidden": true, "alternative_display_type": null, "signature": null}, {"start_timestamp": "2026-10-06T09:42:30.823306Z", "stop_timestamp": "2026-10-06T09:42:35.547581Z", "flags": null, "type": "tool_use", "id": "toolu_01QDVtQBdBCF1vByPyVw5ecy", "name": "bash_tool", "input": {"command": "cd /home/claude/med && cat > /tmp/purity3.py <<'EOF'\nimport sys, json, argparse\nimport numpy as np\nsys.path.insert(0, \"/mnt/user-data/outputs\")\nimport neural_llm as nl\n\na = argparse.Namespace(mri=\"real_brain_mri_t1.nii.gz\", downsample=4, voxel_threshold=0.2,\n    edges_path=\"/tmp/e.bin\", steps=4, decay=0.6, gain=0.0, fire_threshold=0.55,\n    circuit_vocab=2000, circuit_min_count=2, skip_top=8, dots_cache=None)\ntopics = json.load(open(\"/tmp/topics.json\"))\nword2topic = {w: t for t, ws in topics.items() for w in ws}\nsents = nl.load_sentences(\"/tmp/topics.txt\")\nvocab = nl.Vocab(sents); model = nl.NGram(vocab, 2)\nmodel.fit([[vocab.bos] + vocab.encode(s) + [vocab.eos] for s in sents])\ncirc = nl.build_circuit(sents, vocab, a)\n\nperm = np.random.default_rng(0).permutation(len(circ.ids))\ninfo_shuf = dict(circ.info); info_shuf[\"curve\"] = circ.info[\"curve\"][perm]      # curves moved to wrong words\ncirc_cshuf = nl.Circuit(circ.ids, circ.row_of, circ.G, circ.Gp, circ.ppmi, circ.stats, info_shuf)\n\ndef purity(co, prompt_word, n=80, **kw):\n    topic = word2topic[prompt_word]\n    g = nl.Gen(max_len=14, min_len=8, top_k=40, temp=1.0, dots=\"circuit\", beta=6, **kw)\n    hit = tot = 0\n    for _ in range(n):\n        out, _ = nl.generate(model, vocab, [prompt_word], g, co)\n        for o in out:\n            w = vocab.itos[o]\n            if w in word2topic: tot += 1; hit += word2topic[w] == topic\n    return hit / max(tot, 1)\n\nnp.random.seed(0)\nprompts = [\"rocket\", \"ocean\", \"bread\"]\nprint(\"topic purity (chance ~0.33); window = words of context kept\")\nprint(f\"{'arm':36s}\" + \"\".join(f\"{p:>8s}\" for p in prompts) + \"    mean\")\narms = [(\"no context feedback (fb=0)\",          circ,       dict(fb=0.0)),\n        (\"exp decay, window 4\",                 circ,       dict(fb=1.0, curves=\"exp\", fb_window=4)),\n        (\"noodle curves, window 4\",             circ,       dict(fb=1.0, curves=\"noodle\", fb_window=4)),\n        (\"exp decay, window 8\",                 circ,       dict(fb=1.0, curves=\"exp\", fb_window=8)),\n        (\"noodle curves, window 8\",             circ,       dict(fb=1.0, curves=\"noodle\", fb_window=8)),\n        (\"noodle curves SHUFFLED, window 8\",    circ_cshuf, dict(fb=1.0, curves=\"noodle\", fb_window=8))]\nfor label, co, kw in arms:\n    r = [purity(co, p, **kw) for p in prompts]\n    print(f\"{label:36s}\" + \"\".join(f\"{x:8.2f}\" for x in r) + f\"{np.mean(r):8.2f}\")\nEOF\ntimeout 280 python /tmp/purity3.py 2>&1 | tail -9", "description": "Topic purity: noodle curves vs exponential decay vs shuffled curves"}, "message": "Topic purity: noodle curves vs exponential decay vs shuffled curves", "integration_name": "File Creation", "integration_icon_url": null, "tool_identifier": null, "icon_name": "commandLine", "context": null, "display_content": {"type": "json_block", "json_block": "{\"language\": \"bash\", \"code\": \"cd /home/claude/med && cat > /tmp/purity3.py <<'EOF'\\nimport sys, json, argparse\\nimport numpy as np\\nsys.path.insert(0, \\\"/mnt/user-data/outputs\\\")\\nimport neural_llm as nl\\n\\na = argparse.Namespace(mri=\\\"real_brain_mri_t1.nii.gz\\\", downsample=4, voxel_threshold=0.2,\\n    edges_path=\\\"/tmp/e.bin\\\", steps=4, decay=0.6, gain=0.0, fire_threshold=0.55,\\n    circuit_vocab=2000, circuit_min_count=2, skip_top=8, dots_cache=None)\\ntopics = json.load(open(\\\"/tmp/topics.json\\\"))\\nword2topic = {w: t for t, ws in topics.items() for w in ws}\\nsents = nl.load_sentences(\\\"/tmp/topics.txt\\\")\\nvocab = nl.Vocab(sents); model = nl.NGram(vocab, 2)\\nmodel.fit([[vocab.bos] + vocab.encode(s) + [vocab.eos] for s in sents])\\ncirc = nl.build_circuit(sents, vocab, a)\\n\\nperm = np.random.default_rng(0).permutation(len(circ.ids))\\ninfo_shuf = dict(circ.info); info_shuf[\\\"curve\\\"] = circ.info[\\\"curve\\\"][perm]      # curves moved to wrong words\\ncirc_cshuf = nl.Circuit(circ.ids, circ.row_of, circ.G, circ.Gp, circ.ppmi, circ.stats, info_shuf)\\n\\ndef purity(co, prompt_word, n=80, **kw):\\n    topic = word2topic[prompt_word]\\n    g = nl.Gen(max_len=14, min_len=8, top_k=40, temp=1.0, dots=\\\"circuit\\\", beta=6, **kw)\\n    hit = tot = 0\\n    for _ in range(n):\\n        out, _ = nl.generate(model, vocab, [prompt_word], g, co)\\n        for o in out:\\n            w = vocab.itos[o]\\n            if w in word2topic: tot += 1; hit += word2topic[w] == topic\\n    return hit / max(tot, 1)\\n\\nnp.random.seed(0)\\nprompts = [\\\"rocket\\\", \\\"ocean\\\", \\\"bread\\\"]\\nprint(\\\"topic purity (chance ~0.33); window = words of context kept\\\")\\nprint(f\\\"{'arm':36s}\\\" + \\\"\\\".join(f\\\"{p:>8s}\\\" for p in prompts) + \\\"    mean\\\")\\narms = [(\\\"no context feedback (fb=0)\\\",          circ,       dict(fb=0.0)),\\n        (\\\"exp decay, window 4\\\",                 circ,       dict(fb=1.0, curves=\\\"exp\\\", fb_window=4)),\\n        (\\\"noodle curves, window 4\\\",             circ,       dict(fb=1.0, curves=\\\"noodle\\\", fb_window=4)),\\n        (\\\"exp decay, window 8\\\",                 circ,       dict(fb=1.0, curves=\\\"exp\\\", fb_window=8)),\\n        (\\\"noodle curves, window 8\\\",             circ,       dict(fb=1.0, curves=\\\"noodle\\\", fb_window=8)),\\n        (\\\"noodle curves SHUFFLED, window 8\\\",    circ_cshuf, dict(fb=1.0, curves=\\\"noodle\\\", fb_window=8))]\\nfor label, co, kw in arms:\\n    r = [purity(co, p, **kw) for p in prompts]\\n    print(f\\\"{label:36s}\\\" + \\\"\\\".join(f\\\"{x:8.2f}\\\" for x in r) + f\\\"{np.mean(r):8.2f}\\\")\\nEOF\\ntimeout 280 python /tmp/purity3.py 2>&1 | tail -9\"}"}, "approval_options": null, "approval_key": null, "approval_key_legacy": null, "is_mcp_app": null, "hidden_in_chat": null, "mcp_server_url": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-10-06T09:42:39.385689Z", "stop_timestamp": "2026-10-06T09:42:39.385750Z", "flags": null, "type": "tool_result", "tool_use_id": "toolu_01QDVtQBdBCF1vByPyVw5ecy", "name": "bash_tool", "content": [{"type": "text", "text": "{\"returncode\":0,\"stdout\":\"[circuit] extracted 32x32 dot products; each token's response covers ~67 nodes (0.28% of brain)\\ntopic purity (chance ~0.33); window = words of context kept\\narm                                   rocket   ocean   bread    mean\\nno context feedback (fb=0)              0.74    0.67    0.73    0.71\\nexp decay, window 4                     0.93    0.96    0.92    0.94\\nnoodle curves, window 4                 0.93    0.94    0.92    0.93\\nexp decay, window 8                     0.94    0.97    0.92    0.94\\nnoodle curves, window 8                 0.94    0.95    0.93    0.94\\nnoodle curves SHUFFLED, window 8        0.83    0.95    0.90    0.89\\n\",\"stderr\":\"\"}"}], "is_error": false, "structured_content": null, "meta": {"output_format_category": "none"}, "message": null, "integration_name": "File Creation", "mcp_server_url": null, "integration_icon_url": null, "icon_name": "commandLine", "display_content": {"type": "json_block", "json_block": "{\"returncode\":0,\"stdout\":\"[circuit] extracted 32x32 dot products; each token's response covers ~67 nodes (0.28% of brain)\\ntopic purity (chance ~0.33); window = words of context kept\\narm                                   rocket   ocean   bread    mean\\nno context feedback (fb=0)              0.74    0.67    0.73    0.71\\nexp decay, window 4                     0.93    0.96    0.92    0.94\\nnoodle curves, window 4                 0.93    0.94    0.92    0.93\\nexp decay, window 8                     0.94    0.97    0.92    0.94\\nnoodle curves, window 8                 0.94    0.95    0.93    0.94\\nnoodle curves SHUFFLED, window 8        0.83    0.95    0.90    0.89\\n\",\"stderr\":\"\"}"}, "hidden_in_chat": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-10-06T09:42:41.232246Z", "stop_timestamp": "2026-10-06T09:42:46.482979Z", "flags": null, "type": "thinking", "thinking": "", "summaries": [{"summary": "Comparing decay curves against shuffled baselines for measurable gains."}], "cut_off": false, "truncated": true, "hidden": false, "thinking_hidden": true, "alternative_display_type": null, "signature": null}, {"start_timestamp": "2026-10-06T09:42:46.483093Z", "stop_timestamp": "2026-10-06T09:42:46.483267Z", "flags": null, "type": "text", "text": "Last check: generation with trace and diagnose on the final file.", "citations": []}, {"start_timestamp": "2026-10-06T09:42:46.483277Z", "stop_timestamp": "2026-10-06T09:42:48.285863Z", "flags": null, "type": "tool_use", "id": "toolu_01XDrmfvKmKigefYntjXQXk2", "name": "bash_tool", "input": {"command": "cd /home/claude/med && rm -f /tmp/dots.npz && timeout 250 python /mnt/user-data/outputs/neural_llm.py /tmp/topics.txt --prompt \"the rocket and planet\" --dots circuit --trace --min-len 6 --max-len 9 --diagnose --edges-path /tmp/e.bin --mri real_brain_mri_t1.nii.gz --dots-cache /tmp/dots.npz --skip-top 8 2>&1 | tail -22; echo \"--- beam + noodle window 6\"; timeout 100 python /mnt/user-data/outputs/neural_llm.py /tmp/topics.txt --prompt \"the ocean and ship\" --dots circuit --beam 6 --fb-window 6 --min-len 6 --edges-path /tmp/e.bin --dots-cache /tmp/dots.npz --skip-top 8 2>&1 | tail -2", "description": "Final end-to-end check of trace, diagnose and beam"}, "message": "Final end-to-end check of trace, diagnose and beam", "integration_name": "File Creation", "integration_icon_url": null, "tool_identifier": null, "icon_name": "commandLine", "context": null, "display_content": {"type": "json_block", "json_block": "{\"language\": \"bash\", \"code\": \"cd /home/claude/med && rm -f /tmp/dots.npz && timeout 250 python /mnt/user-data/outputs/neural_llm.py /tmp/topics.txt --prompt \\\"the rocket and planet\\\" --dots circuit --trace --min-len 6 --max-len 9 --diagnose --edges-path /tmp/e.bin --mri real_brain_mri_t1.nii.gz --dots-cache /tmp/dots.npz --skip-top 8 2>&1 | tail -22; echo \\\"--- beam + noodle window 6\\\"; timeout 100 python /mnt/user-data/outputs/neural_llm.py /tmp/topics.txt --prompt \\\"the ocean and ship\\\" --dots circuit --beam 6 --fb-window 6 --min-len 6 --edges-path /tmp/e.bin --dots-cache /tmp/dots.npz --skip-top 8 2>&1 | tail -2\"}"}, "approval_options": null, "approval_key": null, "approval_key_legacy": null, "is_mcp_app": null, "hidden_in_chat": null, "mcp_server_url": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-10-06T09:42:50.389997Z", "stop_timestamp": "2026-10-06T09:42:50.390052Z", "flags": null, "type": "tool_result", "tool_use_id": "toolu_01XDrmfvKmKigefYntjXQXk2", "name": "bash_tool", "content": [{"type": "text", "text": "{\"returncode\":0,\"stdout\":\"[circuit] volume (60, 60, 39): 24408 nodes, 139342 directed edges, largest component 24407/24408, mean edge weight 0.93, gain 0.89 (spreads only if gain*w > threshold 0.55)\\n[noodles] 16 noodles/word, 24 steps: context half-life min/median/max = 1/2/24 steps (tube-ness stop threshold 0.032)\\n[circuit] extracted 32x32 dot products; each token's response covers ~67 nodes (0.28% of brain)\\n  the rocket and planet. planet galaxy planet galaxy.\\n  per-word MRI context (bias = dot-product logit boost this word received):\\n    .            bias  0.00   no circuit vector\\n    planet       bias  0.00   right-anterior-inferior, low, footprint 23, noodle half-life 2\\n    galaxy       bias  1.81   right-anterior-inferior, low, footprint 23, noodle half-life 1\\n    planet       bias  1.00   right-anterior-inferior, low, footprint 23, noodle half-life 2\\n    galaxy       bias  1.66   right-anterior-inferior, low, footprint 23, noodle half-life 1\\n    .            bias  0.00   no circuit vector\\n  arm                prompt-PMI anchor-rate mean len\\n  none                    0.426      0.0000      8.2\\n  anchor                  0.287      0.0307      8.7\\n  ppmi dots               1.060      0.0111      9.0\\n  circuit dots            0.831      0.0000      8.8\\n  circuit+exp ctx         0.871      0.0114      8.8\\n  circuit+noodle ctx      0.910      0.0000      8.7\\n--- beam + noodle window 6\\n[circuit] loaded cached dot products from /tmp/dots.npz\\n  the ocean and ship. wave ship wave ship wave\\n\",\"stderr\":\"\"}"}], "is_error": false, "structured_content": null, "meta": {"output_format_category": "none"}, "message": null, "integration_name": "File Creation", "mcp_server_url": null, "integration_icon_url": null, "icon_name": "commandLine", "display_content": {"type": "json_block", "json_block": "{\"returncode\":0,\"stdout\":\"[circuit] volume (60, 60, 39): 24408 nodes, 139342 directed edges, largest component 24407/24408, mean edge weight 0.93, gain 0.89 (spreads only if gain*w > threshold 0.55)\\n[noodles] 16 noodles/word, 24 steps: context half-life min/median/max = 1/2/24 steps (tube-ness stop threshold 0.032)\\n[circuit] extracted 32x32 dot products; each token's response covers ~67 nodes (0.28% of brain)\\n  the rocket and planet. planet galaxy planet galaxy.\\n  per-word MRI context (bias = dot-product logit boost this word received):\\n    .            bias  0.00   no circuit vector\\n    planet       bias  0.00   right-anterior-inferior, low, footprint 23, noodle half-life 2\\n    galaxy       bias  1.81   right-anterior-inferior, low, footprint 23, noodle half-life 1\\n    planet       bias  1.00   right-anterior-inferior, low, footprint 23, noodle half-life 2\\n    galaxy       bias  1.66   right-anterior-inferior, low, footprint 23, noodle half-life 1\\n    .            bias  0.00   no circuit vector\\n  arm                prompt-PMI anchor-rate mean len\\n  none                    0.426      0.0000      8.2\\n  anchor                  0.287      0.0307      8.7\\n  ppmi dots               1.060      0.0111      9.0\\n  circuit dots            0.831      0.0000      8.8\\n  circuit+exp ctx         0.871      0.0114      8.8\\n  circuit+noodle ctx      0.910      0.0000      8.7\\n--- beam + noodle window 6\\n[circuit] loaded cached dot products from /tmp/dots.npz\\n  the ocean and ship. wave ship wave ship wave\\n\",\"stderr\":\"\"}"}, "hidden_in_chat": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-10-06T09:42:52.124957Z", "stop_timestamp": "2026-10-06T09:42:52.473513Z", "flags": null, "type": "tool_use", "id": "toolu_016M6NmaGDQz2WYL9mi8JbCt", "name": "present_files", "input": {"filepaths": ["/mnt/user-data/outputs/neural_llm.py", "/mnt/user-data/outputs/context_curves.png"]}, "message": "Presenting file(s)...", "integration_name": "File Creation", "integration_icon_url": null, "tool_identifier": null, "icon_name": "file", "context": null, "display_content": {"type": "table", "table": [["filepaths", "['/mnt/user-data/outputs/neural_llm.py', '/mnt/user-data/outputs/context_curves.png']"]]}, "approval_options": null, "approval_key": null, "approval_key_legacy": null, "is_mcp_app": null, "hidden_in_chat": null, "mcp_server_url": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-10-06T09:42:52.545546Z", "stop_timestamp": "2026-10-06T09:42:52.545592Z", "flags": null, "type": "tool_result", "tool_use_id": "toolu_016M6NmaGDQz2WYL9mi8JbCt", "name": "present_files", "content": [{"type": "local_resource", "file_path": "/mnt/user-data/outputs/neural_llm.py", "name": "neural llm", "mime_type": "text/x-python", "artifact_publishable": false}, {"type": "local_resource", "file_path": "/mnt/user-data/outputs/context_curves.png", "name": "context curves", "mime_type": "image/png", "artifact_publishable": false}, {"type": "text", "text": "\n\nThe file cards appear at the end of your reply if it ends with text, otherwise under this step; say they are below only if you finish the reply with text."}], "is_error": false, "structured_content": null, "meta": {"output_format_category": "other"}, "message": "Presented 2 files", "integration_name": "File Creation", "mcp_server_url": null, "integration_icon_url": null, "icon_name": "file", "display_content": null, "hidden_in_chat": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-10-06T09:42:59.060681Z", "stop_timestamp": "2026-10-06T09:43:00.140724Z", "flags": null, "type": "text", "text": "I took \"noodles\" to mean streamlines traced through the scan and \"ctx curves\" to mean per-word context curves, and built that into `neural_llm.py`. If you meant something else by either term, tell me. On my test the noodle curves did no better than a plain exponential decay.\n\n**How the curves work**\n- From each word's node, 16 noodles are traced through the scan. They follow the local structure orientation (the direction of least intensity change).\n- A noodle stops when it leaves tissue, turns more than 70\u00b0 in one step, or reaches a region with no tube-like structure.\n- A word's curve, `S(k)`, is the share of its noodles still alive after `k` steps. A word that sits on a long coherent structure carries its context far, and one that doesn't fades quickly.\n- When a generated word feeds back into the context, its weight at a given age is read from its own curve. Before, every word used the same exponential decay. `--curves exp` brings the old behaviour back.\n- This is a T1 scan with no diffusion data, so the noodles follow image structure. They are not anatomical fibre tracts.\n\n**What the curves look like**\n- The plot above shows them for four words. \"planet\" has a half-life of 2 steps, \"ocean\" 11, \"rocket\" 13, and \"bread\" holds at about 0.6 through step 24.\n- `--explain WORD` prints a sparkline of the curve, `--trace` shows each generated word's half-life, and `--plot-curves out.png` makes the figure.\n\n**Topic-purity test** (chance about 0.33)\n\n| arm | mean purity |\n|---|---|\n| no context feedback | 0.71 |\n| exponential decay, window 4 | 0.94 |\n| noodle curves, window 4 | 0.93 |\n| exponential decay, window 8 | 0.94 |\n| noodle curves, window 8 | 0.94 |\n| noodle curves shuffled across words, window 8 | 0.89 |\n\n- The noodle curves match exponential decay but don't beat it. The gain over no feedback comes from feeding generated words back through the dot products.\n- Shuffling the curves across words costs about 0.05, so the curves are word-specific rather than arbitrary, but that is a weak effect.\n- On this test the curves make the context interpretable without improving the output.\n\n**Other fixes**\n- Passing `--explain` or `--plot-curves` without a prompt used to drop into interactive mode and wait on input, which is why one of my runs timed out. It now just prints and exits.\n- Word placement changed between runs because the SVD started from a random vector. It is now seeded, so placement is reproducible.\n- The intensity labels were relative thirds of the scan, not tissue types, so I renamed them to low, mid and high intensity.", "citations": []}], "sender": "assistant", "created_at": "2026-10-06T09:43:00.230010Z", "updated_at": "2026-10-06T09:43:00.230010Z", "attachments": [], "files": [{"file_uuid": "ae823247-d9d6-5ef8-abb5-e6b4f235ffde", "file_name": "context_curves.png"}], "parent_message_uuid": "01a1108f-c2e5-7e75-86d4-4a940747b165"}]},{"uuid": "6fd68a2f-baa5-40c6-8e37-29e4bd3a62b9", "name": "Expanding vocabulary recognition", "summary": "", "created_at": "2026-10-06T21:02:12.479625Z", "updated_at": "2026-10-06T21:04:50.526465Z", "account": {"uuid": "8d7882cd-3e98-47cc-a6e7-61494a1ee4ac"}, "chat_messages": [{"uuid": "01a11306-1a3a-7fe6-be38-7aa66b0dcaaa", "text": "enhance the amout of words it recognises", "content": [{"start_timestamp": "2026-10-06T21:02:14.302074Z", "stop_timestamp": "2026-10-06T21:02:14.302074Z", "flags": null, "type": "text", "text": "enhance the amout of words it recognises", "citations": []}], "sender": "human", "created_at": "2026-10-06T21:02:14.302223Z", "updated_at": "2026-10-06T21:02:14.302223Z", "attachments": [{"file_name": "", "file_size": 43891, "file_type": "txt", "extracted_content": "#!/usr/bin/env python3\n\"\"\"neural_llm.py -- MRI neural-circuit simulator + Markov text generator in one file.\n\nPipeline\n  1. MRI volume -> voxel graph (edges streamed to disk, read back via np.memmap)\n  2. Corpus co-occurrence (PPMI) -> 3-D coordinates -> each content token is\n     placed on a brain node (nearest node in the largest connected component)\n  3. A pulse at each token's node is propagated through the circuit\n     (leaky threshold-gated dynamics from the simulator). The accumulated\n     activity is that token's response vector r_i.\n  4. DOT PRODUCTS:  G[i, j] = r_i . r_j   (unit-norm rows, so cosine similarity\n     through the brain's wiring). G is extracted once and cached.\n  5. PER-WORD MRI CONTEXT: every word keeps its own context read off the scan:\n     where its node sits (region), the local tissue intensity, how far its\n     pulse spreads (footprint), and its nearest words through the wiring.\n     `--explain WORD` prints it; `--trace` prints it for each generated word.\n  6. NOODLE CONTEXT CURVES: noodles (streamlines) are traced through the scan from\n     each word's node, following the local structure-tensor orientation. A\n     noodle ends when it leaves tissue, turns too sharply, or hits a region with\n     no tube-like structure. The share of a word's noodles still alive after k\n     steps is that word's context curve S_w(k): how long its context carries\n     forward. NOTE: this is a T1 scan (no diffusion data), so the noodles follow\n     image structure and are NOT anatomical fibre tracts.\n  7. Decoding: the prompt's content words act as a self-stimulating seed\n     (bias = beta * level(t) * normalise(G @ prompt), re-pulsed every few steps).\n     With `--fb`, every word generated so far also injects its OWN response\n     vector into the circuit state, weighted by that word's noodle curve at its\n     age (`--curves exp` swaps in a plain exponential decay), so the context\n     evolves word by word instead of being fixed by the prompt.\n\nOther generation controls: entropy-targeted temperature, direct leaky anchor,\nbeam search (heapq + linked-list paths + exact state dedup), min-len,\nfeasibility-based length floor, beam calibration, and an ablation `--diagnose`\nthat compares: no bias / direct anchor / PPMI dots (no brain) / circuit dots.\n\n  python neural_llm.py data.txt --prompt \"the old river\" --dots circuit --beta 6\n  python neural_llm.py data.txt --prompt \"the old river\" --diagnose --beta 6\n  python neural_llm.py data.txt --explain river ocean --plot-curves curves.png\n  python neural_llm.py data.txt --prompt \"the old river\" --dots circuit --fb 0.5 --trace\n  python neural_llm.py data.txt --sim-report --calibrate\n  python neural_llm.py data.txt --interactive --dots circuit --target-entropy 1.5\n\"\"\"\nimport argparse\nimport heapq\nimport json\nimport os\nimport random\nimport re\nfrom collections import Counter, defaultdict, deque\nfrom dataclasses import dataclass, replace\n\nimport numpy as np\nimport scipy.sparse as sp\nfrom scipy.sparse.csgraph import connected_components\nfrom scipy.sparse.linalg import svds\nfrom scipy.spatial import cKDTree\n\nPAD, UNK, BOS, EOS = \"<pad>\", \"<unk>\", \"<bos>\", \"\"\nTOKEN_RE = re.compile(r\"[a-z0-9']+|[.,!?;:]\")\nSENT_SPLIT = re.compile(r\"(?<=[.!?])\\s+|\\n{2,}\")\nWORD_RE = re.compile(r\"[a-z0-9']\")\n\ndef explain_words(values):\n    \"\"\"Expand one or more command-line values into individual explainable words.\"\"\"\n    words = []\n    for value in values or []:\n        words.extend(TOKEN_RE.findall(value.lower()))\n    return words\n\n\nEDGE_DTYPE = np.dtype([(\"src\", \"<u4\"), (\"dst\", \"<u4\"), (\"w\", \"<f4\")])\n\n\n# ===========================================================================\n# PART 1 -- NEURAL CIRCUIT: MRI -> graph -> dynamics\n# ===========================================================================\ndef synthesize_volume(shape=(60, 60, 40), seed=0):\n    \"\"\"Stand-in brain (ellipsoid + smooth texture) when no MRI file is present.\"\"\"\n    rng = np.random.default_rng(seed)\n    z, y, x = np.meshgrid(*[np.linspace(-1, 1, s) for s in shape], indexing=\"ij\")\n    body = (x ** 2 / 0.8 + y ** 2 / 0.9 + z ** 2 / 0.8) < 1\n    tex = rng.normal(size=shape).astype(np.float32)\n    for _ in range(2):\n        tex = (tex + np.roll(tex, 1, 0) + np.roll(tex, 1, 1) + np.roll(tex, 1, 2)) / 4\n    return np.clip(0.6 + 0.5 * tex, 0, 1) * body\n\n\ndef load_volume(path, downsample=4):\n    \"\"\"Real NIfTI scan, downsampled and robustly normalised (99th percentile).\n    Returns (volume, axis_codes); codes come from the scan's affine, e.g. ('R','A','S').\"\"\"\n    if path and os.path.exists(path):\n        import nibabel as nib\n        img = nib.load(path)\n        data = img.get_fdata().astype(np.float32)[::downsample, ::downsample, ::downsample]\n        codes = tuple(nib.aff2axcodes(img.affine))\n        return np.clip(data / np.percentile(data[data > 0], 99), 0, 1), codes\n    print(f\"[circuit] MRI '{path}' not found; using a synthetic volume (region labels nominal)\")\n    return synthesize_volume(), (\"R\", \"A\", \"S\")\n\n\ndef build_graph(vol, threshold, edges_path):\n    \"\"\"Vectorised: tissue voxels -> nodes; 6-neighbour edges written to disk.\"\"\"\n    mask = vol > threshold\n    n = int(mask.sum())\n    idx = np.full(vol.shape, -1, np.int64)\n    idx[mask] = np.arange(n)\n    coords = np.argwhere(mask)                    # same C-order as idx assignment\n    src, dst, wts = [], [], []\n    for ax in range(3):\n        a, b = [slice(None)] * 3, [slice(None)] * 3\n        a[ax], b[ax] = slice(None, -1), slice(1, None)\n        ia, ib = idx[tuple(a)], idx[tuple(b)]\n        ok = (ia >= 0) & (ib >= 0)\n        w = 1.0 - np.abs(vol[tuple(a)] - vol[tuple(b)])\n        src.append(ia[ok]); dst.append(ib[ok]); wts.append(w[ok])\n    s, d, w = np.concatenate(src), np.concatenate(dst), np.concatenate(wts)\n    rec = np.empty(2 * len(s), EDGE_DTYPE)        # both directions\n    rec[\"src\"], rec[\"dst\"], rec[\"w\"] = np.r_[s, d], np.r_[d, s], np.r_[w, w]\n    rec.tofile(edges_path)\n    return coords, n\n\n\ndef load_adjacency(edges_path, n):\n    rec = np.memmap(edges_path, dtype=EDGE_DTYPE, mode=\"r\")   # disk-backed, lazy\n    return sp.csr_matrix((np.asarray(rec[\"w\"], np.float32),\n                          (np.asarray(rec[\"src\"]), np.asarray(rec[\"dst\"]))), shape=(n, n))\n\n\ndef step_dynamics(A, W, decay, gain, thr):\n    \"\"\"One step of the simulator rule: nodes above `thr` fire and push\n    gain * w * activity to neighbours; everything leaks by `decay`.\"\"\"\n    fire = np.where(A > thr, A, 0.0)\n    return np.minimum(decay * A + gain * (W @ fire), 3.0).astype(np.float32)\n\n\ndef simulate_activity(W, seed, steps=60, decay=0.6, gain=0.4, thr=0.55,\n                      stim_interval=0, amp=1.0):\n    \"\"\"Single pulse (stim_interval=0) or periodic self-stimulation at `seed`.\n    Returns (active node counts, firing node counts) per step.\"\"\"\n    a = np.zeros((W.shape[0], 1), np.float32)\n    a[seed] = amp\n    active, firing = [int((a > 0).sum())], [int((a > thr).sum())]\n    for t in range(steps):\n        a = step_dynamics(a, W, decay, gain, thr)\n        if stim_interval and (t + 1) % stim_interval == 0:\n            a[seed] += amp\n        active.append(int((a > 0).sum())); firing.append(int((a > thr).sum()))\n    return active, firing\n\n\ndef circuit_responses(W, seed_nodes, steps, decay, gain, thr, batch=64, prune=1e-3):\n    \"\"\"Response vector of each seed: activity integrated over `steps`, as sparse\n    unit-norm rows. Batched dense propagation keeps memory flat.\"\"\"\n    N, chunks = W.shape[0], []\n    for s in range(0, len(seed_nodes), batch):\n        sn = seed_nodes[s:s + batch]\n        A = np.zeros((N, len(sn)), np.float32)\n        A[sn, np.arange(len(sn))] = 1.0\n        acc = A.copy()\n        for _ in range(steps):\n            A = step_dynamics(A, W, decay, gain, thr)\n            acc += A\n        acc[acc < prune] = 0\n        chunks.append(sp.csr_matrix(acc.T))\n    R = sp.vstack(chunks).tocsr()\n    norm = np.sqrt(np.asarray(R.multiply(R).sum(axis=1)).ravel()) + 1e-8\n    return sp.diags(1.0 / norm) @ R\n\n\n# ===========================================================================\n# PART 2 -- CORPUS + VOCAB + N-GRAM\n# ===========================================================================\ndef detok(tokens):\n    return re.sub(r\"\\s+([.,!?;:])\", r\"\\1\", \" \".join(tokens))\n\n\ndef load_sentences(path):\n    text = open(path, encoding=\"utf-8\").read().lower()\n    sents = [TOKEN_RE.findall(c) for c in SENT_SPLIT.split(text)]\n    return [s for s in sents if len(s) >= 2]\n\n\nclass Vocab:\n    def __init__(self, sents, min_count=1):\n        counts = Counter(t for s in sents for t in s)\n        kept = sorted((t for t, c in counts.items() if c >= min_count),\n                      key=lambda t: (-counts[t], t))\n        self.itos = [PAD, UNK, BOS, EOS] + kept\n        self.stoi = {t: i for i, t in enumerate(self.itos)}\n        self.V = len(self.itos)\n        self.pad, self.unk, self.bos, self.eos = range(4)\n        self.counts = np.zeros(self.V)\n        for t in kept:\n            self.counts[self.stoi[t]] = counts[t]\n\n    def encode(self, toks):\n        return [self.stoi.get(t, self.unk) for t in toks]\n\n\nclass NGram:\n    \"\"\"Interpolated n-gram; order = number of previous tokens used.\"\"\"\n\n    def __init__(self, vocab, order=2, lam=0.7, k=0.01, base_clip=100.0):\n        self.v, self.order, self.lam, self.k = vocab, order, lam, k\n        self.base_clip = base_clip\n        self.tables = [defaultdict(Counter) for _ in range(order + 1)]\n\n    def fit(self, seqs):\n        for seq in seqs:\n            for t in range(1, len(seq)):\n                for n in range(min(self.order, t) + 1):\n                    self.tables[n][tuple(seq[t - n:t])][seq[t]] += 1\n        base = self.v.counts.copy()\n        base[self.v.eos] = len(seqs)\n        if self.base_clip < 100:\n            pos = base[base > 0]\n            base = np.minimum(base, np.percentile(pos, self.base_clip))\n        base += self.k\n        base[[self.v.pad, self.v.bos, self.v.unk]] = 0.0\n        self.base = base / base.sum()\n\n    def dist(self, ctx):\n        p = self.base\n        ctx = tuple(ctx[-self.order:]) if self.order else ()\n        for n in range(len(ctx) + 1):\n            c = self.tables[n].get(ctx[len(ctx) - n:] if n else ())\n            if c:\n                vec = np.zeros(self.v.V)\n                for tok, cnt in c.items():\n                    vec[tok] = cnt\n                p = self.lam * vec / vec.sum() + (1 - self.lam) * p\n        return p\n\n    def logits(self, ctx):\n        lg = np.log(np.maximum(self.dist(ctx), 1e-300))\n        lg[[self.v.pad, self.v.bos, self.v.unk]] = -np.inf\n        return lg\n\n\n# ===========================================================================\n# PART 3 -- DOT-PRODUCT EXTRACTION: token placement on the brain + G matrix\n# ===========================================================================\n@dataclass\nclass Circuit:\n    ids: np.ndarray        # vocab ids that have a circuit vector\n    row_of: np.ndarray     # vocab id -> row in G (or -1)\n    G: np.ndarray          # circuit dot products  r_i . r_j   (diag = 0)\n    Gp: np.ndarray         # ablation: PPMI-cosine dots, no brain (diag = 0)\n    ppmi: np.ndarray       # raw PPMI (used only by the diagnostic metric)\n    stats: dict\n    info: dict = None      # per-word MRI context arrays (see word_context)\n\n\ndef rank01(x):\n    return np.argsort(np.argsort(x, kind=\"stable\"), kind=\"stable\") / max(len(x) - 1, 1)\n\n\ndef noodle_field(vol, mask, tube_pct=25.0, sigma_grad=1.0, sigma_int=2.0):\n    \"\"\"Structure-tensor orientation field. For each tissue voxel: the direction of least\n    intensity variation (along a noodle) and a tube-ness score (~1 tube-like, ~0 plane or\n    isotropic). The stopping threshold is a percentile of the scan's own tube-ness, because\n    the absolute scale depends on resolution and contrast.\"\"\"\n    from scipy.ndimage import gaussian_filter\n    sm = gaussian_filter(vol, sigma_grad)\n    g = np.stack(np.gradient(sm), -1)\n    J = np.empty(vol.shape + (3, 3), np.float32)\n    for i in range(3):\n        for j in range(i, 3):\n            J[..., i, j] = J[..., j, i] = gaussian_filter(g[..., i] * g[..., j], sigma_int)\n    w, v = np.linalg.eigh(J[mask])                       # eigenvalues ascending\n    direction = np.zeros(vol.shape + (3,), np.float32)\n    direction[mask] = v[:, :, 0]\n    tube = np.zeros(vol.shape, np.float32)\n    tube[mask] = (w[:, 1] - w[:, 0]) / (w[:, 2] + 1e-9)\n    return dict(dir=direction, tube=tube, mask=mask,\n                thr=float(np.percentile(tube[mask], tube_pct)))\n\n\ndef trace_noodles(field, seeds, K=16, L=24, max_angle=70.0, seed=0, paths=False):\n    \"\"\"Trace K noodles from each seed (grid coords, shape (n,3)) for up to L unit steps.\n    Returns survival S of shape (n, L+1): S[w, k] = share of word w's noodles still alive\n    after k steps (S[:,0] = 1). With paths=True also returns positions/alive for plotting.\"\"\"\n    rng = np.random.default_rng(seed)\n    n, shape = len(seeds), np.array(field[\"mask\"].shape)\n    pos = np.repeat(np.asarray(seeds, np.float64), K, 0) + rng.normal(0, 0.7, (n * K, 3))\n    sign = np.tile([1.0, -1.0], (n * K + 1) // 2)[:n * K]     # half go each way\n    cos_lim = np.cos(np.deg2rad(max_angle))\n    alive, prev = np.ones(n * K, bool), None\n    surv = [alive.reshape(n, K).mean(1)]\n    hist, ahist = [pos.copy()], [alive.copy()]\n    for _ in range(L):\n        idt = tuple(np.clip(np.rint(pos).astype(int), 0, shape - 1).T)\n        d = field[\"dir\"][idt].astype(np.float64) * sign[:, None]\n        ok = field[\"mask\"][idt] & (field[\"tube\"][idt] >= field[\"thr\"])\n        if prev is not None:\n            dot = (d * prev).sum(1)\n            d[dot < 0] *= -1                                   # orientation has no sign\n            ok &= np.abs(dot) >= cos_lim\n        alive &= ok\n        pos, prev = pos + d, d\n        surv.append(alive.reshape(n, K).mean(1))\n        hist.append(pos.copy()); ahist.append(alive.copy())\n    S = np.array(surv).T.astype(np.float32)\n    if paths:\n        return S, dict(pos=np.array(hist).reshape(L + 1, n, K, 3),\n                       alive=np.array(ahist).reshape(L + 1, n, K))\n    return S\n\n\n_SPARK = \" \u2581\u2582\u2583\u2584\u2585\u2586\u2587\u2588\"\n\n\ndef sparkline(v):\n    return \"\".join(_SPARK[int(round(min(max(x, 0), 1) * 8))] for x in v)\n\n\n_AXIS_NAMES = {\"R\": (\"right\", \"left\"), \"L\": (\"left\", \"right\"),\n               \"A\": (\"anterior\", \"posterior\"), \"P\": (\"posterior\", \"anterior\"),\n               \"S\": (\"superior\", \"inferior\"), \"I\": (\"inferior\", \"superior\")}\n_AXIS_ORDER = {\"right\": 0, \"left\": 0, \"anterior\": 1, \"posterior\": 1, \"superior\": 2, \"inferior\": 2}\n\n\ndef region_label(xyz, mid, codes):\n    \"\"\"Coarse octant name from voxel position and the scan's axis codes.\"\"\"\n    parts = [_AXIS_NAMES[c][0] if xyz[k] > mid[k] else _AXIS_NAMES[c][1]\n             for k, c in enumerate(codes)]\n    return \"-\".join(sorted(parts, key=_AXIS_ORDER.get))\n\n\ndef word_context_table(R, seeds, coords_all, vals, keep_cc, codes):\n    \"\"\"Per-word context read from the scan: seed position/region/tissue band and\n    the footprint of the word's pulse (size, centroid, mean intensity).\"\"\"\n    mid = (keep_cc.min(0) + keep_cc.max(0)) / 2\n    lo, hi = np.percentile(vals[vals > 0], [33, 67])\n    seed_int = vals[seeds]\n    # relative thirds of this scan's tissue intensities (not a tissue classification)\n    band = np.where(seed_int < lo, \"low intensity\",\n                    np.where(seed_int < hi, \"mid intensity\", \"high intensity\"))\n    mass = np.asarray(R.sum(axis=1)).ravel() + 1e-8\n    return dict(\n        xyz=coords_all[seeds].astype(np.int32),\n        seed_int=seed_int.astype(np.float32),\n        band=band.astype(\"U32\"),\n        region=np.array([region_label(coords_all[n], mid, codes) for n in seeds], dtype=\"U40\"),\n        foot_n=np.diff(R.indptr).astype(np.int32),\n        foot_cent=((R @ coords_all.astype(np.float64)) / mass[:, None]).astype(np.float32),\n        foot_int=((R @ vals.astype(np.float64)) / mass).astype(np.float32))\n\n\ndef word_context(circ, vocab, word, top=5):\n    \"\"\"Everything the MRI says about one word, or None if it has no circuit vector.\"\"\"\n    i = vocab.stoi.get(word, -1)\n    r = circ.row_of[i] if i >= 0 else -1\n    if r < 0 or not circ.info:\n        return None\n    f = circ.info\n    nb = np.argsort(-circ.G[r])[:top]\n    curve = f[\"curve\"][r] if \"curve\" in f else None\n    below = np.flatnonzero(curve < 0.5) if curve is not None else []\n    return dict(word=word, curve=curve,\n                half_life=(int(below[0]) if len(below) else len(curve) - 1) if curve is not None else None,\n                noodle_len=float(curve[1:].sum()) if curve is not None else None,\n                word_=word, xyz=tuple(int(v) for v in f[\"xyz\"][r]),\n                intensity=float(f[\"seed_int\"][r]), band=str(f[\"band\"][r]),\n                region=str(f[\"region\"][r]), footprint=int(f[\"foot_n\"][r]),\n                centroid=tuple(round(float(v), 1) for v in f[\"foot_cent\"][r]),\n                footprint_intensity=float(f[\"foot_int\"][r]),\n                neighbours=[(vocab.itos[circ.ids[j]], float(circ.G[r, j])) for j in nb if circ.G[r, j] > 0])\n\n\ndef build_circuit(sents, vocab, a):\n    skip = set(np.argsort(-vocab.counts)[:a.skip_top].tolist())\n    cand = [i for i in range(4, vocab.V)\n            if i not in skip and WORD_RE.match(vocab.itos[i])\n            and vocab.counts[i] >= a.circuit_min_count]\n    ids = np.array(sorted(cand, key=lambda i: -vocab.counts[i])[:a.circuit_vocab])\n    if len(ids) < 8:\n        print(\"[circuit] too few content tokens; circuit disabled\")\n        return None\n    Vc = len(ids)\n    row_of = np.full(vocab.V, -1, np.int64)\n    row_of[ids] = np.arange(Vc)\n\n    # --- PPMI over sentence co-occurrence\n    r, c = [], []\n    for si, s in enumerate(sents):\n        for t in set(vocab.encode(s)):\n            if row_of[t] >= 0:\n                r.append(si); c.append(row_of[t])\n    X = sp.csr_matrix((np.ones(len(r), np.float32), (r, c)), shape=(len(sents), Vc))\n    C = (X.T @ X).toarray().astype(np.float64)\n    np.fill_diagonal(C, 0)\n    rs = C.sum(1, keepdims=True)\n    with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n        pmi = np.log(C * C.sum() / (rs * rs.T))\n    P = np.where(np.isfinite(pmi) & (pmi > 0), pmi, 0).astype(np.float32)\n    Pn = P / (np.linalg.norm(P, axis=1, keepdims=True) + 1e-8)\n    Gp = (Pn @ Pn.T).astype(np.float32)\n    np.fill_diagonal(Gp, 0)\n\n    # cache keyed by every parameter that affects G\n    nd = dict(L=getattr(a, \"noodle_steps\", 24), K=getattr(a, \"noodle_count\", 16),\n              ang=getattr(a, \"noodle_angle\", 70.0), pct=getattr(a, \"noodle_tube_pct\", 25.0))\n    sig = json.dumps(dict(v=3, nd=nd, mri=a.mri, ds=a.downsample, vt=a.voxel_threshold, steps=a.steps,\n                          decay=a.decay, gain=a.gain, fire=a.fire_threshold,\n                          toks=[vocab.itos[i] for i in ids]), sort_keys=True)\n    if a.dots_cache and os.path.exists(a.dots_cache):\n        z = np.load(a.dots_cache, allow_pickle=False)\n        if str(z[\"sig\"]) == sig:\n            print(f\"[circuit] loaded cached dot products from {a.dots_cache}\")\n            info = {k[5:]: z[k] for k in z.files if k.startswith(\"info_\")}\n            return Circuit(ids, row_of, z[\"G\"], Gp, P, dict(cached=True, tokens=Vc), info)\n\n    # --- brain graph\n    vol, codes = load_volume(a.mri, a.downsample)\n    coords, n = build_graph(vol, a.voxel_threshold, a.edges_path)\n    vals = vol[tuple(coords.T)]\n    W = load_adjacency(a.edges_path, n)\n    ncomp, lab = connected_components(W, directed=False)\n    keep = np.flatnonzero(lab == np.bincount(lab).argmax())\n    wbar = float(W.data.mean())\n    gain = a.gain if a.gain > 0 else 1.5 * a.fire_threshold / wbar   # sharp-transition rule\n    print(f\"[circuit] volume {vol.shape}: {n} nodes, {W.nnz} directed edges, \"\n          f\"largest component {len(keep)}/{n}, mean edge weight {wbar:.2f}, \"\n          f\"gain {gain:.2f} (spreads only if gain*w > threshold {a.fire_threshold})\")\n\n    # --- place tokens on the brain: PPMI -> 3 SVD dims -> uniform [0,1] -> bbox -> nearest node\n    U, S, _ = svds(P.astype(np.float64), k=3, v0=np.random.default_rng(0).normal(size=Vc))  # seeded: reproducible placement\n    pos = np.stack([rank01(v) for v in (U * S).T], axis=1)\n    cc = coords[keep].astype(np.float64)\n    target = cc.min(0) + pos * (cc.max(0) - cc.min(0))\n    seeds = keep[cKDTree(cc).query(target)[1]]\n\n    # --- circuit responses -> dot products\n    R = circuit_responses(W, seeds, a.steps, a.decay, gain, a.fire_threshold)\n    G = (R @ R.T).toarray().astype(np.float32)\n    np.fill_diagonal(G, 0)\n    info = word_context_table(R, seeds, coords, vals, cc, codes)\n    field = noodle_field(vol, vol > a.voxel_threshold, nd[\"pct\"])\n    info[\"curve\"] = trace_noodles(field, coords[seeds], nd[\"K\"], nd[\"L\"], nd[\"ang\"])\n    hl = [(np.flatnonzero(c < 0.5)[:1].tolist() or [nd[\"L\"]])[0] for c in info[\"curve\"]]\n    print(f\"[noodles] {nd['K']} noodles/word, {nd['L']} steps: context half-life \"\n          f\"min/median/max = {min(hl)}/{int(np.median(hl))}/{max(hl)} steps \"\n          f\"(tube-ness stop threshold {field['thr']:.3f})\")\n    nnz = np.diff(R.indptr)\n    stats = dict(nodes=n, tokens=Vc, median_active_nodes=int(np.median(nnz)),\n                 frac_of_brain=float(np.median(nnz) / n), gain=gain)\n    print(f\"[circuit] extracted {Vc}x{Vc} dot products; each token's response covers \"\n          f\"~{stats['median_active_nodes']} nodes ({100 * stats['frac_of_brain']:.2f}% of brain)\")\n    if stats[\"median_active_nodes\"] < 10:\n        print(\"[circuit] warning: pulses are not spreading; raise --gain or lower --fire-threshold\")\n    if a.dots_cache:\n        np.savez(a.dots_cache, G=G, sig=sig, **{\"info_\" + k: v for k, v in info.items()})\n    return Circuit(ids, row_of, G, Gp, P, stats, info)\n\n\ndef prompt_bias(circ, vocab, toks, source):\n    \"\"\"Dot products between the prompt's content tokens and every token,\n    robustly normalised to [0, 1] and expanded to the full vocabulary.\"\"\"\n    if circ is None or source == \"none\":\n        return None\n    M = circ.G if source == \"circuit\" else circ.Gp\n    rows = [circ.row_of[vocab.stoi[t]] for t in toks\n            if t in vocab.stoi and circ.row_of[vocab.stoi[t]] >= 0]\n    if not rows:\n        return None\n    s = M[:, rows].sum(axis=1)\n    pos = s[s > 0]\n    if not pos.size:\n        return None\n    full = np.zeros(vocab.V, np.float32)\n    full[circ.ids] = np.clip(s / np.percentile(pos, 99), 0, 1)\n    return full\n\n\ndef context_bias(circ, M, vocab, gen_ids, decay, curves=False, stride=3):\n    \"\"\"Word-by-word context: each recently generated word injects its own circuit\n    response; its weight at age `a` is its noodle curve S_w(a*stride) (curves=True)\n    or decay**a. Returns the normalised dot-product bias.\"\"\"\n    u = np.zeros(len(circ.ids), np.float32)\n    C = circ.info[\"curve\"] if curves else None\n    for age, tok in enumerate(reversed(gen_ids)):\n        r = circ.row_of[tok]\n        if r >= 0:\n            u[r] += C[r, min(age * stride, C.shape[1] - 1)] if curves else decay ** age\n    if not u.any():\n        return None\n    s = M @ u\n    pos = s[s > 0]\n    if not pos.size:\n        return None\n    full = np.zeros(vocab.V, np.float32)\n    full[circ.ids] = np.clip(s / np.percentile(pos, 99), 0, 1)\n    return full\n\n\n# ===========================================================================\n# PART 4 -- DECODING\n# ===========================================================================\n@dataclass\nclass Gen:\n    max_len: int = 40\n    temp: float = 0.9\n    top_k: int = 40\n    target_entropy: float = 0.0\n    beam: int = 0\n    min_len: int = 0\n    length_alpha: float = 0.7\n    anchor_amp: float = 0.0       # direct leaky logit bias on prompt words\n    anchor_decay: float = 0.9\n    anchor_interval: int = 16\n    dots: str = \"none\"            # none | circuit | ppmi\n    beta: float = 6.0             # logit strength of the dot-product bias\n    fb: float = 1.0               # >0: generated words feed their own MRI context back in\n    fb_window: int = 4            # only the last N generated words contribute\n    fb_decay: float = 0.7         # newest word weight 1, then decay^age\n    curves: str = \"noodle\"        # noodle | exp  (per-word MRI curve vs plain exponential decay)\n    curve_stride: int = 3         # noodle steps per word of age\n    eos_guard: bool = True        # keep P(end-of-text) unchanged when a bias boosts other words\n    slack: int = 20\n\n\ndef entropy(logits, temp):\n    z = logits / temp\n    p = np.exp(z - z.max())\n    p /= p.sum()\n    nz = p[p > 0]\n    return float(-(nz * np.log(nz)).sum())\n\n\ndef temperature_for_entropy(logits, target, lo=0.05, hi=3.0, iters=24):\n    for _ in range(iters):\n        mid = (lo + hi) / 2\n        lo, hi = (mid, hi) if entropy(logits, mid) < target else (lo, mid)\n    return (lo + hi) / 2\n\n\ndef top_k_mask(lg, k):\n    if 0 < k < len(lg):\n        lg = np.where(lg < np.partition(lg, -k)[-k], -np.inf, lg)\n    return lg\n\n\ndef pick(lg, gen):\n    lg = top_k_mask(lg, gen.top_k)\n    t = (temperature_for_entropy(lg, gen.target_entropy)\n         if gen.target_entropy > 0 else max(gen.temp, 1e-3))\n    p = np.exp(lg / t - (lg / t).max())\n    return int(np.random.choice(len(p), p=p / p.sum())), t\n\n\nclass LeakySchedule:\n    \"\"\"Self-stimulation: level leaks by `decay` each step and is re-pulsed by\n    `amp` every `interval` steps (precomputed so beams share it).\"\"\"\n\n    def __init__(self, amp, decay, interval, n):\n        level, self.levels = amp, []\n        for t in range(n):\n            self.levels.append(level)\n            level *= decay\n            if (t + 1) % interval == 0:\n                level += amp\n\n    def level(self, t):\n        return self.levels[min(t, len(self.levels) - 1)]\n\n\ndef anchor_ids(vocab, toks, skip_top=20):\n    common = set(np.argsort(-vocab.counts)[:skip_top].tolist())\n    return sorted({vocab.stoi[t] for t in toks if t in vocab.stoi and WORD_RE.match(t)\n                   and vocab.stoi[t] not in common})\n\n\ndef materialize(node):\n    out = []\n    while node is not None:\n        tok, node = node\n        out.append(tok)\n    return out[::-1]\n\n\ndef log_softmax(lg):\n    m = lg.max()\n    return lg - (m + np.log(np.exp(lg - m).sum()))\n\n\ndef beam_search(step_fn, ctx0, eos, max_new, width, top_k, alpha, state_len):\n    \"\"\"state_len = how many trailing tokens fully determine the future (model order,\n    or the feedback window if larger), so merging beams on that tail is exact.\"\"\"\n    path0 = None\n    for t in ctx0:\n        path0 = (t, path0)\n    beam, done = [(0.0, path0)], []\n    for step in range(max_new):\n        cands = {}\n        for score, path in beam:\n            seq = materialize(path)\n            logp = log_softmax(step_fn(seq))\n            k = min(top_k if top_k > 0 else 16, len(logp) - 1)\n            for tok in np.argpartition(-logp, k)[:k]:\n                if not np.isfinite(logp[tok]):\n                    continue\n                tok = int(tok)\n                s, newp = score + float(logp[tok]), (tok, path)\n                if tok == eos:\n                    done.append((s / (step + 1) ** alpha, newp))\n                    continue\n                tail = tuple(seq[-(state_len - 1):] + [tok]) if state_len > 1 else (tok,)\n                if tail not in cands or s > cands[tail][0]:\n                    cands[tail] = (s, newp)\n        if not cands or len(done) >= width:\n            break\n        beam = heapq.nlargest(width, cands.values(), key=lambda c: c[0])\n    pool = done or [(s / max_new ** alpha, p) for s, p in beam]\n    out = materialize(max(pool, key=lambda c: c[0])[1])[len(ctx0):]\n    return out[:-1] if out and out[-1] == eos else out\n\n\ndef min_steps_to_eos(model, vocab, start):\n    \"\"\"Shortest observed path from `start` to end-of-text (feasibility + length floor).\"\"\"\n    if model.order < 1:\n        return None\n    graph, seen, q = model.tables[1], {start}, deque([(start, 0)])\n    while q:\n        s, d = q.popleft()\n        nxt = graph.get((s,))\n        if not nxt:\n            continue\n        if vocab.eos in nxt:\n            return d + 1\n        for n in nxt:\n            if n not in seen:\n                seen.add(n); q.append((n, d + 1))\n    return None\n\n\ndef generate(model, vocab, toks, gen, circ=None, trace=None):\n    \"\"\"trace (list, sampling mode only) receives (token_id, bias_applied_to_it).\"\"\"\n    ctx0 = [vocab.bos] + vocab.encode(toks)\n    anchors = anchor_ids(vocab, toks) if gen.anchor_amp > 0 else []\n    a_sched = (LeakySchedule(gen.anchor_amp, gen.anchor_decay, gen.anchor_interval,\n                             gen.max_len + 1) if anchors else None)\n    M = None if circ is None else {\"circuit\": circ.G, \"ppmi\": circ.Gp}.get(gen.dots)\n    bp = prompt_bias(circ, vocab, toks, gen.dots)\n    use_fb = M is not None and gen.fb > 0\n    use_curves = (gen.curves == \"noodle\" and circ is not None and bool(circ.info)\n                  and \"curve\" in circ.info)\n    d_sched = (LeakySchedule(1.0, gen.anchor_decay, gen.anchor_interval, gen.max_len + 1)\n               if bp is not None else None)\n    last = {}\n\n    def step(seq):\n        t = len(seq) - len(ctx0)\n        lg = model.logits(seq)\n        if t < gen.min_len:\n            lg[vocab.eos] = -np.inf\n        if a_sched:\n            lg[anchors] += a_sched.level(t)\n        b = None\n        if bp is not None:\n            b = d_sched.level(t) * bp\n        if use_fb:\n            f = context_bias(circ, M, vocab, seq[len(ctx0):][-gen.fb_window:], gen.fb_decay,\n                             use_curves, gen.curve_stride)\n            if f is not None:\n                b = gen.fb * f if b is None else b + gen.fb * f\n        if b is not None:\n            if gen.eos_guard and t >= gen.min_len:\n                # keep P(end-of-text) unchanged: shift it by the log-ratio of the other\n                # words' probability mass after vs before the boost\n                p = np.exp(lg - lg.max())\n                p[vocab.eos] = 0.0\n                if p.sum() > 0:\n                    lg[vocab.eos] += np.log((p * np.exp(gen.beta * b)).sum() / p.sum())\n            lg += gen.beta * b\n        last[\"b\"] = b\n        return lg\n\n    if gen.beam > 0:\n        state_len = max(model.order, 1, gen.fb_window if use_fb else 0)\n        return beam_search(step, ctx0, vocab.eos, gen.max_len, gen.beam,\n                           gen.top_k, gen.length_alpha, state_len), []\n    ctx, out, temps = list(ctx0), [], []\n    for _ in range(gen.max_len):\n        nxt, t = pick(step(ctx), gen)\n        if nxt == vocab.eos:\n            break\n        if trace is not None:\n            trace.append((nxt, 0.0 if last[\"b\"] is None else float(last[\"b\"][nxt])))\n        out.append(nxt); ctx.append(nxt); temps.append(t)\n    return out, temps\n\n\ndef complete(model, vocab, prompt, gen, circ=None, trace=None):\n    toks = TOKEN_RE.findall(prompt.lower())\n    if not toks:\n        raise ValueError(\"prompt has no usable tokens\")\n    ids = vocab.encode(toks)\n    oov = [t for t, i in zip(toks, ids) if i == vocab.unk]\n    d = min_steps_to_eos(model, vocab, ids[-1])\n    note = None\n    if d is None:\n        note = \"no observed path to end-of-text from the last prompt token\"\n    else:\n        gen = replace(gen, max_len=max(gen.max_len, d + gen.slack))\n    out, _ = generate(model, vocab, toks, gen, circ, trace)\n    return detok(toks + [vocab.itos[i] for i in out]), oov, note\n\n\ndef calibrate_beam(model, vocab, sents, circ=None, widths=(1, 2, 4, 8, 16, 32), ref=64,\n                   n_prompts=6, max_len=25, top_k=20):\n    rng = random.Random(0)\n    starts = [s[:2] for s in rng.sample(sents, min(n_prompts, len(sents)))]\n\n    def run(w):\n        g = Gen(max_len=max_len, top_k=top_k, beam=w)\n        return [tuple(generate(model, vocab, s, g, circ)[0]) for s in starts]\n\n    reference = run(ref)\n    return next((w for w in widths if run(w) == reference), ref)\n\n\ndef diagnose(model, vocab, prompt, gen, circ, n=30):\n    \"\"\"Ablation. Metric = mean PPMI between generated content words and the prompt's\n    content words (a direct corpus statistic). Caveat: PPMI also builds both dot-product\n    sources, so the 'ppmi' arm is favoured by construction; use a labelled-topic corpus\n    for an independent check.\"\"\"\n    toks = TOKEN_RE.findall(prompt.lower())\n    prompt_rows = [circ.row_of[vocab.stoi[t]] for t in toks\n                   if t in vocab.stoi and circ.row_of[vocab.stoi[t]] >= 0] if circ else []\n    anchors = set(anchor_ids(vocab, toks))\n    base = replace(gen, anchor_amp=0.0, dots=\"none\", beam=0)\n    arms = [(\"none\", base), (\"anchor\", replace(base, anchor_amp=gen.anchor_amp or 2.0))]\n    if circ is not None and prompt_rows:\n        fb = gen.fb or 0.5\n        arms += [(\"ppmi dots\", replace(base, dots=\"ppmi\")),\n                 (\"circuit dots\", replace(base, dots=\"circuit\")),\n                 (\"circuit+exp ctx\", replace(base, dots=\"circuit\", fb=fb, curves=\"exp\")),\n                 (\"circuit+noodle ctx\", replace(base, dots=\"circuit\", fb=fb, curves=\"noodle\"))]\n    print(f\"  {'arm':18s} {'prompt-PMI':>10s} {'anchor-rate':>11s} {'mean len':>8s}\")\n    for label, g in arms:\n        pm, hits, total = [], 0, 0\n        for _ in range(n):\n            out, _ = generate(model, vocab, toks, g, circ)\n            hits += sum(o in anchors for o in out)\n            total += len(out)\n            if circ is not None and prompt_rows:\n                rows = [circ.row_of[o] for o in out if circ.row_of[o] >= 0]\n                if rows:\n                    pm.append(circ.ppmi[np.ix_(rows, prompt_rows)].mean())\n        print(f\"  {label:18s} {np.mean(pm) if pm else float('nan'):10.3f} \"\n              f\"{hits / max(total, 1):11.4f} {total / n:8.1f}\")\n\n\ndef plot_curves(path, circ, vocab, words, a, K=12):\n    \"\"\"Left: each word's context curve S_w(k). Right: its noodles in 3-D over the brain.\"\"\"\n    import matplotlib\n    matplotlib.use(\"Agg\")\n    import matplotlib.pyplot as plt\n    from mpl_toolkits.mplot3d import Axes3D  # noqa: F401\n    ctxs = [c for c in (word_context(circ, vocab, w) for w in words) if c]\n    if not ctxs:\n        print(\"[plot] none of the words has a circuit vector\")\n        return\n    vol, _ = load_volume(a.mri, a.downsample)\n    mask = vol > a.voxel_threshold\n    field = noodle_field(vol, mask, getattr(a, \"noodle_tube_pct\", 25.0))\n    seeds = np.array([c[\"xyz\"] for c in ctxs])\n    L = len(ctxs[0][\"curve\"]) - 1\n    _, tr = trace_noodles(field, seeds, K, L, getattr(a, \"noodle_angle\", 70.0), paths=True)\n    fig = plt.figure(figsize=(13, 5.2))\n    ax = fig.add_subplot(1, 2, 1)\n    for c in ctxs:\n        ax.plot(c[\"curve\"], label=f\"{c['word']} (half-life {c['half_life']})\", lw=2)\n    ax.set_xlabel(\"noodle step k\"); ax.set_ylabel(\"share of noodles alive  S(k)\")\n    ax.set_title(\"per-word context curves\"); ax.legend(fontsize=8); ax.set_ylim(0, 1.02)\n    ax3 = fig.add_subplot(1, 2, 2, projection=\"3d\")\n    cloud = np.argwhere(mask)\n    cloud = cloud[np.random.default_rng(0).choice(len(cloud), min(3000, len(cloud)), replace=False)]\n    ax3.scatter(cloud[:, 2], cloud[:, 1], cloud[:, 0], c=\"lightgray\", s=1, alpha=0.12)\n    for wi, c in enumerate(ctxs):\n        color = f\"C{wi}\"\n        for k in range(K):\n            live = tr[\"alive\"][:, wi, k]\n            pts = tr[\"pos\"][live, wi, k]\n            if len(pts) > 1:\n                ax3.plot(pts[:, 2], pts[:, 1], pts[:, 0], color=color, lw=1.2, alpha=0.8)\n        ax3.scatter(*seeds[wi][[2, 1, 0]], color=color, s=40, edgecolors=\"k\")\n    ax3.set_title(\"noodles from each word's node\"); ax3.set_xlabel(\"x\"); ax3.set_ylabel(\"y\"); ax3.set_zlabel(\"z\")\n    plt.tight_layout(); plt.savefig(path, dpi=140)\n    print(f\"[plot] saved {path}\")\n\n\n# ===========================================================================\n# CLI\n# ===========================================================================\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__,\n                                 formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"path\", help=\"training text\")\n    g = ap.add_argument_group(\"language model\")\n    g.add_argument(\"--order\", type=int, default=2)\n    g.add_argument(\"--min-count\", type=int, default=1)\n    g.add_argument(\"--base-clip\", type=float, default=100.0)\n    g = ap.add_argument_group(\"circuit\")\n    g.add_argument(\"--mri\", default=\"real_brain_mri_t1.nii.gz\")\n    g.add_argument(\"--downsample\", type=int, default=4)\n    g.add_argument(\"--voxel-threshold\", type=float, default=0.2)\n    g.add_argument(\"--edges-path\", default=\"connectivity_edges.bin\")\n    g.add_argument(\"--steps\", type=int, default=4, help=\"propagation steps per token pulse\")\n    g.add_argument(\"--decay\", type=float, default=0.6)\n    g.add_argument(\"--gain\", type=float, default=0.0, help=\"0 = auto (1.5 x threshold / mean weight)\")\n    g.add_argument(\"--fire-threshold\", type=float, default=0.55)\n    g.add_argument(\"--circuit-vocab\", type=int, default=2000)\n    g.add_argument(\"--circuit-min-count\", type=int, default=2)\n    g.add_argument(\"--skip-top\", type=int, default=20)\n    g.add_argument(\"--dots-cache\", default=None)\n    g.add_argument(\"--sim-report\", action=\"store_true\")\n    g.add_argument(\"--noodle-steps\", type=int, default=24)\n    g.add_argument(\"--noodle-count\", type=int, default=16, help=\"noodles traced per word\")\n    g.add_argument(\"--noodle-angle\", type=float, default=70.0, help=\"max turn per step, degrees\")\n    g.add_argument(\"--noodle-tube-pct\", type=float, default=25.0,\n                   help=\"noodles stop where tube-ness is below this percentile of the scan\")\n    g = ap.add_argument_group(\"decoding\")\n    g.add_argument(\"--dots\", choices=[\"none\", \"circuit\", \"ppmi\"], default=\"none\")\n    g.add_argument(\"--beta\", type=float, default=6.0)\n    g.add_argument(\"--fb\", type=float, default=1.0, help=\"word-by-word MRI context strength (0=off)\")\n    g.add_argument(\"--fb-window\", type=int, default=4)\n    g.add_argument(\"--fb-decay\", type=float, default=0.7, help=\"decay for --curves exp\")\n    g.add_argument(\"--curves\", choices=[\"noodle\", \"exp\"], default=\"noodle\")\n    g.add_argument(\"--curve-stride\", type=int, default=3, help=\"noodle steps per word of age\")\n    g.add_argument(\"--n\", type=int, default=1)\n    g.add_argument(\"--temp\", type=float, default=0.9)\n    g.add_argument(\"--top-k\", type=int, default=40)\n    g.add_argument(\"--max-len\", type=int, default=400)\n    g.add_argument(\"--min-len\", type=int, default=0)\n    g.add_argument(\"--target-entropy\", type=float, default=0.0)\n    g.add_argument(\"--anchor\", type=float, default=0.0)\n    g.add_argument(\"--anchor-decay\", type=float, default=0.9)\n    g.add_argument(\"--anchor-interval\", type=int, default=16)\n    g.add_argument(\"--beam\", type=int, default=0)\n    g.add_argument(\"--length-alpha\", type=float, default=0.7)\n    g.add_argument(\"--slack\", type=int, default=20)\n    ap.add_argument(\"--explain\", nargs=\"+\", metavar=\"WORD\", help=\"print each word's MRI context\")\n    ap.add_argument(\"--plot-curves\", metavar=\"PNG\", help=\"plot context curves + noodles for --explain words (or prompt words)\")\n    ap.add_argument(\"--trace\", action=\"store_true\", help=\"per-word MRI context of the first completion\")\n    ap.add_argument(\"--no-eos-guard\", action=\"store_true\", help=\"let the bias change the stopping probability\")\n    ap.add_argument(\"--calibrate\", action=\"store_true\")\n    ap.add_argument(\"--diagnose\", action=\"store_true\")\n    ap.add_argument(\"--prompt\", default=None)\n    ap.add_argument(\"--interactive\", action=\"store_true\")\n    ap.add_argument(\"--seed\", type=int, default=42)\n    a = ap.parse_args()\n    random.seed(a.seed); np.random.seed(a.seed)\n\n    sents = load_sentences(a.path)\n    vocab = Vocab(sents, a.min_count)\n    model = NGram(vocab, a.order, base_clip=a.base_clip)\n    model.fit([[vocab.bos] + vocab.encode(s) + [vocab.eos] for s in sents])\n\n    need_circuit = a.dots != \"none\" or a.diagnose or a.sim_report or a.explain or a.trace or a.plot_curves\n    circ = build_circuit(sents, vocab, a) if need_circuit else None\n\n    if a.sim_report:   # the original simulator's regime check, on this graph\n        vol, _ = load_volume(a.mri, a.downsample)\n        coords, n = build_graph(vol, a.voxel_threshold, a.edges_path + \".sim\")\n        W = load_adjacency(a.edges_path + \".sim\", n)\n        seed = int(np.argmin(coords[:, 0]))\n        gain = a.gain if a.gain > 0 else 1.5 * a.fire_threshold / float(W.data.mean())\n        for name, kw in ((\"repo params (gain 0.4)\", dict(gain=0.4)),\n                         (f\"auto gain {gain:.2f}\", dict(gain=gain))):\n            for label, si in ((\"single pulse\", 0), (\"self-stim\", 6)):\n                act, fire = simulate_activity(W, seed, steps=30, decay=a.decay,\n                                              thr=a.fire_threshold, stim_interval=si, **kw)\n                print(f\"[sim] {name:22s} {label:12s} peak active {max(act):6d}  peak firing {max(fire):6d}\")\n\n    gen = Gen(max_len=a.max_len, temp=a.temp, top_k=a.top_k, target_entropy=a.target_entropy,\n              beam=a.beam, min_len=a.min_len, length_alpha=a.length_alpha,\n              anchor_amp=a.anchor, anchor_decay=a.anchor_decay,\n              anchor_interval=a.anchor_interval, dots=a.dots, beta=a.beta, slack=a.slack,\n              fb=a.fb, fb_window=a.fb_window, fb_decay=a.fb_decay,\n              curves=a.curves, curve_stride=a.curve_stride,\n              eos_guard=not a.no_eos_guard)\n\n    def show_context(c):\n        print(f\"  {c['word']:12s} node {c['xyz']}  {c['region']}, {c['band']}  \"\n              f\"intensity {c['intensity']:.2f}  footprint {c['footprint']} nodes \"\n              f\"(mean intensity {c['footprint_intensity']:.2f})\")\n        print(\"               nearest through the wiring: \" +\n              (\", \".join(f\"{w} {v:.2f}\" for w, v in c[\"neighbours\"]) or \"none\"))\n        if c[\"curve\"] is not None:\n            print(f\"               noodle context curve |{sparkline(c['curve'][::2])}|  \"\n                  f\"half-life {c['half_life']} steps, mean length {c['noodle_len']:.1f}\")\n\n    if a.explain:\n        explain_tokens = explain_words(a.explain)\n        print(\"[explain] per-word MRI context (node = grid coordinates after downsampling)\")\n        for word in explain_tokens:\n            c = word_context(circ, vocab, word, top=5) if circ else None\n            if c:\n                show_context(c)\n            else:\n                print(f\"  {word:12s} no circuit vector (function word, rare, or out of vocabulary)\")\n\n    if a.plot_curves and circ is not None:\n        explain_tokens = explain_words(a.explain)\n        plot_words = (\n            explain_tokens\n            if explain_tokens\n            else [\n                t for t in TOKEN_RE.findall((a.prompt or \"\").lower())\n                if t in vocab.stoi\n            ][:6]\n        )\n        plot_curves(a.plot_curves, circ, vocab, plot_words, a)\n\n    if a.calibrate:\n        w = calibrate_beam(model, vocab, sents, circ)\n        print(f\"calibrated beam width: {w} (matches a width-64 reference); use --beam {w}\")\n\n    def run(prompt):\n        oov, note = set(), None\n        for k in range(a.n):\n            tr = [] if (a.trace and k == 0 and a.beam == 0) else None\n            text, o, note = complete(model, vocab, prompt, gen, circ, tr)\n            oov.update(o)\n            print(\" \", text)\n            if tr:\n                print(\"  per-word MRI context (bias = dot-product logit boost this word received):\")\n                for tok, b in tr:\n                    c = word_context(circ, vocab, vocab.itos[tok]) if circ else None\n                    where = (f\"{c['region']}, {c['band'].split(' ')[0]}, footprint {c['footprint']}\"\n                             + (f\", noodle half-life {c['half_life']}\" if c[\"half_life\"] is not None else \"\")\n                             if c else \"no circuit vector\")\n                    print(f\"    {vocab.itos[tok]:12s} bias {b:5.2f}   {where}\")\n        if note:\n            print(f\"  ({note})\")\n        if oov:\n            print(f\"  (not in vocab, treated as <unk>: {sorted(oov)})\")\n        if a.diagnose:\n            diagnose(model, vocab, prompt, gen, circ)\n\n  \n\n\nif __name__ == \"__main__\":\n    main()\n"}], "files": [{"file_uuid": "29fb5e65-78e2-5e5f-a2c5-28d3036fb6b8", "file_name": ""}], "parent_message_uuid": "00000000-0000-4000-8000-000000000000"}, {"uuid": "01a11306-1a3a-78ef-9b8b-6d45f309fa44", "text": "\"Recognises\" can mean three things in this script, and each has its own fix:\n\n1. Words that get a brain vector. This is capped by `--circuit-vocab 2000` and `--circuit-min-count 2`.\n2. Inflections of known words, like `rivers` or `flowing`. They currently get no bias at all.\n3. Unseen or misspelled prompt words. They currently become `<unk>` and contribute nothing.\n\nHere are the patches for all three.\n\n## 1. Bigger circuit vocabulary (CLI defaults)\n\n```python\ng.add_argument(\"--circuit-vocab\", type=int, default=8000)\ng.add_argument(\"--circuit-min-count\", type=int, default=2)   # 1 works but PPMI for singletons is noisy\n```\n\nSeveral matrices are dense `Vc \u00d7 Vc` (`C`, `P`, `Gp`, `G`), so memory grows with the square of the vocabulary. The `float64` ones are the worst. Replace the PPMI block and the SVD call with these lighter versions:\n\n```python\n    X = sp.csr_matrix((np.ones(len(r), np.float32), (r, c)), shape=(len(sents), Vc))\n    C = (X.T @ X).toarray().astype(np.float32)\n    np.fill_diagonal(C, 0)\n    rs = C.sum(1, keepdims=True)\n    tot = np.float32(C.sum(dtype=np.float64))\n    with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n        pmi = np.log(C * tot / (rs * rs.T))\n    del C\n    P = np.where(np.isfinite(pmi) & (pmi > 0), pmi, 0).astype(np.float32)\n    del pmi\n```\n\n```python\n    Ps = sp.csr_matrix(P.astype(np.float64))      # PPMI is sparse; avoid a dense float64 copy\n    U, S, _ = svds(Ps, k=3, v0=np.random.default_rng(0).normal(size=Vc))\n```\n\nWith these, 8000 tokens need roughly 1 GB for the dense matrices. Going past about 12k gets heavy.\n\n## 2. Inflection aliasing\n\nAdd near the top, after `WORD_RE`:\n\n```python\n_SUFFIXES = (\"ing\", \"ed\", \"es\", \"s\", \"ly\")\n\n\ndef stem(w):\n    \"\"\"Crude suffix stripper: enough to link rivers/river, flowing/flow.\"\"\"\n    for suf in _SUFFIXES:\n        if w.endswith(suf) and len(w) - len(suf) >= 3:\n            return w[:-len(suf)]\n    return w\n```\n\nIn `build_circuit`, insert this right **after** the `Gp` computation (after PPMI, so co-occurrence counts aren't merged) and **before** the cache check:\n\n```python\n    # alias inflections of circuit words onto their sibling's row (never the skipped function words)\n    by_stem = {}\n    for i in ids:\n        by_stem.setdefault(stem(vocab.itos[i]), row_of[i])\n    for i in range(4, vocab.V):\n        if row_of[i] < 0 and i not in skip and WORD_RE.match(vocab.itos[i]):\n            rr = by_stem.get(stem(vocab.itos[i]))\n            if rr is not None:\n                row_of[i] = rr\n    print(f\"[circuit] {int((row_of >= 0).sum())} vocab words resolve to a circuit vector \"\n          f\"({Vc} direct, rest via stems)\")\n```\n\nBump the cache signature to `v=4`. The bias now has to reach those aliased words too, so add one helper and use it in both bias functions:\n\n```python\ndef expand_bias(circ, vocab, s):\n    \"\"\"Row scores -> full-vocab bias, robustly normalised; aliased words share their sibling's score.\"\"\"\n    pos = s[s > 0]\n    if not pos.size:\n        return None\n    x = np.clip(s / np.percentile(pos, 99), 0, 1)\n    full = np.zeros(vocab.V, np.float32)\n    has = circ.row_of >= 0\n    full[has] = x[circ.row_of[has]]\n    return full\n```\n\nIn `prompt_bias` and `context_bias`, replace the tail\n\n```python\n    full = np.zeros(vocab.V, np.float32)\n    full[circ.ids] = np.clip(s / np.percentile(pos, 99), 0, 1)\n    return full\n```\n\nwith `return expand_bias(circ, vocab, s)`. You can then delete the now-redundant `pos = s[s > 0]` / `if not pos.size` lines above it.\n\n## 3. Resolve unseen prompt words\n\nAdd to `Vocab`, at the end of `__init__`:\n\n```python\n        self.by_stem = {}\n        for i in range(4, self.V):                    # itos is frequency-sorted\n            self.by_stem.setdefault(stem(self.itos[i]), i)\n```\n\nand this method:\n\n```python\n    def resolve(self, tok):\n        \"\"\"Known word -> itself. Otherwise try a shared stem, then a close spelling. Returns token or None.\"\"\"\n        if tok in self.stoi:\n            return tok\n        if not WORD_RE.match(tok) or len(tok) < 4:\n            return None\n        i = self.by_stem.get(stem(tok))\n        if i is not None:\n            return self.itos[i]\n        import difflib\n        m = difflib.get_close_matches(tok, self.itos[4:], n=1, cutoff=0.85)\n        return m[0] if m else None\n```\n\nReplace `complete` with:\n\n```python\ndef complete(model, vocab, prompt, gen, circ=None, trace=None):\n    toks = TOKEN_RE.findall(prompt.lower())\n    if not toks:\n        raise ValueError(\"prompt has no usable tokens\")\n    resolved, mapped = [], []\n    for t in toks:\n        r = vocab.resolve(t)\n        if r is not None and r != t:\n            mapped.append(f\"{t}\u2192{r}\")\n        resolved.append(r if r is not None else t)\n    ids = vocab.encode(resolved)\n    oov = [t for t, i in zip(toks, ids) if i == vocab.unk]\n    d = min_steps_to_eos(model, vocab, ids[-1])\n    note = None\n    if d is None:\n        note = \"no observed path to end-of-text from the last prompt token\"\n    else:\n        gen = replace(gen, max_len=max(gen.max_len, d + gen.slack))\n    out, _ = generate(model, vocab, resolved, gen, circ, trace)\n    if mapped:\n        note = (note + \"; \" if note else \"\") + \"matched unseen words: \" + \", \".join(mapped)\n    return detok(toks + [vocab.itos[i] for i in out]), oov, note\n```\n\nThe printed text keeps what you typed, and the note shows how each word was matched.\n\n## Notes\n\n- **Delete your old `--dots-cache` file.** The token list changed, so the signature won't match anyway, but this avoids confusion.\n- **Aliased words in `--explain`:** they show their sibling's node and neighbours, since they share its row. That is intentional but not labelled in the output.\n- **The stemmer is crude.** It is English-only and will occasionally link unrelated words (`bed`/`be` is blocked by the length check, but `string`/`str`-type collisions are possible). If you want better accuracy, swap `stem` for NLTK's Porter stemmer. The rest of the patch doesn't change.\n- **Biggest remaining lever:** the corpus itself. A word the n-gram has never seen can't be generated, only matched. More training text raises both the vocabulary and PPMI quality.", "content": [{"start_timestamp": "2026-10-06T21:02:14.132691Z", "stop_timestamp": "2026-10-06T21:02:40.848342Z", "flags": null, "type": "thinking", "thinking": "", "summaries": [{"summary": "Expanding vocabulary coverage for circuit word recognition."}, {"summary": "Balancing memory limits with fallback matching for unseen words."}, {"summary": "Extending bias boosts to aliased inflected word forms."}, {"summary": "Resolving unmatched words with approximate stem matching."}], "cut_off": false, "truncated": true, "hidden": false, "thinking_hidden": true, "alternative_display_type": null, "signature": null}, {"start_timestamp": "2026-10-06T21:02:40.848375Z", "stop_timestamp": "2026-10-06T21:02:55.766529Z", "flags": null, "type": "text", "text": "\"Recognises\" can mean three things in this script, and each has its own fix:\n\n1. Words that get a brain vector. This is capped by `--circuit-vocab 2000` and `--circuit-min-count 2`.\n2. Inflections of known words, like `rivers` or `flowing`. They currently get no bias at all.\n3. Unseen or misspelled prompt words. They currently become `<unk>` and contribute nothing.\n\nHere are the patches for all three.\n\n## 1. Bigger circuit vocabulary (CLI defaults)\n\n```python\ng.add_argument(\"--circuit-vocab\", type=int, default=8000)\ng.add_argument(\"--circuit-min-count\", type=int, default=2)   # 1 works but PPMI for singletons is noisy\n```\n\nSeveral matrices are dense `Vc \u00d7 Vc` (`C`, `P`, `Gp`, `G`), so memory grows with the square of the vocabulary. The `float64` ones are the worst. Replace the PPMI block and the SVD call with these lighter versions:\n\n```python\n    X = sp.csr_matrix((np.ones(len(r), np.float32), (r, c)), shape=(len(sents), Vc))\n    C = (X.T @ X).toarray().astype(np.float32)\n    np.fill_diagonal(C, 0)\n    rs = C.sum(1, keepdims=True)\n    tot = np.float32(C.sum(dtype=np.float64))\n    with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n        pmi = np.log(C * tot / (rs * rs.T))\n    del C\n    P = np.where(np.isfinite(pmi) & (pmi > 0), pmi, 0).astype(np.float32)\n    del pmi\n```\n\n```python\n    Ps = sp.csr_matrix(P.astype(np.float64))      # PPMI is sparse; avoid a dense float64 copy\n    U, S, _ = svds(Ps, k=3, v0=np.random.default_rng(0).normal(size=Vc))\n```\n\nWith these, 8000 tokens need roughly 1 GB for the dense matrices. Going past about 12k gets heavy.\n\n## 2. Inflection aliasing\n\nAdd near the top, after `WORD_RE`:\n\n```python\n_SUFFIXES = (\"ing\", \"ed\", \"es\", \"s\", \"ly\")\n\n\ndef stem(w):\n    \"\"\"Crude suffix stripper: enough to link rivers/river, flowing/flow.\"\"\"\n    for suf in _SUFFIXES:\n        if w.endswith(suf) and len(w) - len(suf) >= 3:\n            return w[:-len(suf)]\n    return w\n```\n\nIn `build_circuit`, insert this right **after** the `Gp` computation (after PPMI, so co-occurrence counts aren't merged) and **before** the cache check:\n\n```python\n    # alias inflections of circuit words onto their sibling's row (never the skipped function words)\n    by_stem = {}\n    for i in ids:\n        by_stem.setdefault(stem(vocab.itos[i]), row_of[i])\n    for i in range(4, vocab.V):\n        if row_of[i] < 0 and i not in skip and WORD_RE.match(vocab.itos[i]):\n            rr = by_stem.get(stem(vocab.itos[i]))\n            if rr is not None:\n                row_of[i] = rr\n    print(f\"[circuit] {int((row_of >= 0).sum())} vocab words resolve to a circuit vector \"\n          f\"({Vc} direct, rest via stems)\")\n```\n\nBump the cache signature to `v=4`. The bias now has to reach those aliased words too, so add one helper and use it in both bias functions:\n\n```python\ndef expand_bias(circ, vocab, s):\n    \"\"\"Row scores -> full-vocab bias, robustly normalised; aliased words share their sibling's score.\"\"\"\n    pos = s[s > 0]\n    if not pos.size:\n        return None\n    x = np.clip(s / np.percentile(pos, 99), 0, 1)\n    full = np.zeros(vocab.V, np.float32)\n    has = circ.row_of >= 0\n    full[has] = x[circ.row_of[has]]\n    return full\n```\n\nIn `prompt_bias` and `context_bias`, replace the tail\n\n```python\n    full = np.zeros(vocab.V, np.float32)\n    full[circ.ids] = np.clip(s / np.percentile(pos, 99), 0, 1)\n    return full\n```\n\nwith `return expand_bias(circ, vocab, s)`. You can then delete the now-redundant `pos = s[s > 0]` / `if not pos.size` lines above it.\n\n## 3. Resolve unseen prompt words\n\nAdd to `Vocab`, at the end of `__init__`:\n\n```python\n        self.by_stem = {}\n        for i in range(4, self.V):                    # itos is frequency-sorted\n            self.by_stem.setdefault(stem(self.itos[i]), i)\n```\n\nand this method:\n\n```python\n    def resolve(self, tok):\n        \"\"\"Known word -> itself. Otherwise try a shared stem, then a close spelling. Returns token or None.\"\"\"\n        if tok in self.stoi:\n            return tok\n        if not WORD_RE.match(tok) or len(tok) < 4:\n            return None\n        i = self.by_stem.get(stem(tok))\n        if i is not None:\n            return self.itos[i]\n        import difflib\n        m = difflib.get_close_matches(tok, self.itos[4:], n=1, cutoff=0.85)\n        return m[0] if m else None\n```\n\nReplace `complete` with:\n\n```python\ndef complete(model, vocab, prompt, gen, circ=None, trace=None):\n    toks = TOKEN_RE.findall(prompt.lower())\n    if not toks:\n        raise ValueError(\"prompt has no usable tokens\")\n    resolved, mapped = [], []\n    for t in toks:\n        r = vocab.resolve(t)\n        if r is not None and r != t:\n            mapped.append(f\"{t}\u2192{r}\")\n        resolved.append(r if r is not None else t)\n    ids = vocab.encode(resolved)\n    oov = [t for t, i in zip(toks, ids) if i == vocab.unk]\n    d = min_steps_to_eos(model, vocab, ids[-1])\n    note = None\n    if d is None:\n        note = \"no observed path to end-of-text from the last prompt token\"\n    else:\n        gen = replace(gen, max_len=max(gen.max_len, d + gen.slack))\n    out, _ = generate(model, vocab, resolved, gen, circ, trace)\n    if mapped:\n        note = (note + \"; \" if note else \"\") + \"matched unseen words: \" + \", \".join(mapped)\n    return detok(toks + [vocab.itos[i] for i in out]), oov, note\n```\n\nThe printed text keeps what you typed, and the note shows how each word was matched.\n\n## Notes\n\n- **Delete your old `--dots-cache` file.** The token list changed, so the signature won't match anyway, but this avoids confusion.\n- **Aliased words in `--explain`:** they show their sibling's node and neighbours, since they share its row. That is intentional but not labelled in the output.\n- **The stemmer is crude.** It is English-only and will occasionally link unrelated words (`bed`/`be` is blocked by the length check, but `string`/`str`-type collisions are possible). If you want better accuracy, swap `stem` for NLTK's Porter stemmer. The rest of the patch doesn't change.\n- **Biggest remaining lever:** the corpus itself. A word the n-gram has never seen can't be generated, only matched. More training text raises both the vocabulary and PPMI quality.", "citations": []}], "sender": "assistant", "created_at": "2026-10-06T21:02:55.835409Z", "updated_at": "2026-10-06T21:02:55.835409Z", "attachments": [], "files": [], "parent_message_uuid": "01a11306-1a3a-7fe6-be38-7aa66b0dcaaa"}, {"uuid": "01a11306-ee53-7925-9380-6caa9b694fbf", "text": "do the full code", "content": [{"start_timestamp": "2026-10-06T21:03:04.541982Z", "stop_timestamp": "2026-10-06T21:03:04.541982Z", "flags": null, "type": "text", "text": "do the full code", "citations": []}], "sender": "human", "created_at": "2026-10-06T21:03:04.542168Z", "updated_at": "2026-10-06T21:03:04.542168Z", "attachments": [], "files": [], "parent_message_uuid": "01a11306-1a3a-78ef-9b8b-6d45f309fa44"}, {"uuid": "01a11306-ee53-7377-9aa9-39deec80beed", "text": "\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\nI've put the full script in `neural_llm.py` with all three patches applied. I haven't run it.\n\n**Changes beyond the patches:**\n- The file you pasted ended before the code that actually uses `--prompt` and `--interactive`. I added a short block at the end of `main()` that runs the prompt once, then loops on `>` input in interactive mode until you enter an empty line.\n- I added a small `resolve_prompt()` helper so `complete()`, `diagnose()` and `--plot-curves` all match unseen words the same way.\n- `stem()` now skips plain `-s` after `ss`, so `glass` doesn't become `glas`.\n- The docstring now describes the three ways words get recognised.\n\n**Before you run it:**\n- Delete any old `--dots-cache` file. The cache signature is now `v=4` and the token list has changed.\n- If memory is tight, lower `--circuit-vocab` (default is now 8000). The dense matrices grow with its square.", "content": [{"start_timestamp": "2026-10-06T21:03:04.541792Z", "stop_timestamp": "2026-10-06T21:03:15.813305Z", "flags": null, "type": "thinking", "thinking": "", "summaries": [{"summary": "Preparing the complete updated file with patches applied."}, {"summary": "Tracing variable integration points across the merged script."}], "cut_off": false, "truncated": true, "hidden": false, "thinking_hidden": true, "alternative_display_type": null, "signature": null}, {"start_timestamp": "2026-10-06T21:03:15.813363Z", "stop_timestamp": "2026-10-06T21:04:43.521277Z", "flags": null, "type": "tool_use", "id": "toolu_01AE5XnrDQqChA4BC4stHcTx", "name": "create_file", "input": {"description": "Full neural_llm.py with larger circuit vocab, stem aliasing, and unseen-word resolution applied", "path": "/mnt/user-data/outputs/neural_llm.py", "file_text": "#!/usr/bin/env python3\n\"\"\"neural_llm.py -- MRI neural-circuit simulator + Markov text generator in one file.\n\nPipeline\n  1. MRI volume -> voxel graph (edges streamed to disk, read back via np.memmap)\n  2. Corpus co-occurrence (PPMI) -> 3-D coordinates -> each content token is\n     placed on a brain node (nearest node in the largest connected component)\n  3. A pulse at each token's node is propagated through the circuit\n     (leaky threshold-gated dynamics from the simulator). The accumulated\n     activity is that token's response vector r_i.\n  4. DOT PRODUCTS:  G[i, j] = r_i . r_j   (unit-norm rows, so cosine similarity\n     through the brain's wiring). G is extracted once and cached.\n  5. PER-WORD MRI CONTEXT: every word keeps its own context read off the scan:\n     where its node sits (region), the local tissue intensity, how far its\n     pulse spreads (footprint), and its nearest words through the wiring.\n     `--explain WORD` prints it; `--trace` prints it for each generated word.\n  6. NOODLE CONTEXT CURVES: noodles (streamlines) are traced through the scan from\n     each word's node, following the local structure-tensor orientation. A\n     noodle ends when it leaves tissue, turns too sharply, or hits a region with\n     no tube-like structure. The share of a word's noodles still alive after k\n     steps is that word's context curve S_w(k): how long its context carries\n     forward. NOTE: this is a T1 scan (no diffusion data), so the noodles follow\n     image structure and are NOT anatomical fibre tracts.\n  7. Decoding: the prompt's content words act as a self-stimulating seed\n     (bias = beta * level(t) * normalise(G @ prompt), re-pulsed every few steps).\n     With `--fb`, every word generated so far also injects its OWN response\n     vector into the circuit state, weighted by that word's noodle curve at its\n     age (`--curves exp` swaps in a plain exponential decay), so the context\n     evolves word by word instead of being fixed by the prompt.\n\nWord recognition\n  * Up to --circuit-vocab content words get their own brain vector.\n  * Inflections of those words (rivers/river, flowing/flow) are aliased onto\n    their sibling's vector via a crude suffix stemmer.\n  * Unseen prompt words are matched to a known word by shared stem, then by\n    close spelling (difflib), before falling back to <unk>.\n\nOther generation controls: entropy-targeted temperature, direct leaky anchor,\nbeam search (heapq + linked-list paths + exact state dedup), min-len,\nfeasibility-based length floor, beam calibration, and an ablation `--diagnose`\nthat compares: no bias / direct anchor / PPMI dots (no brain) / circuit dots.\n\n  python neural_llm.py data.txt --prompt \"the old river\" --dots circuit --beta 6\n  python neural_llm.py data.txt --prompt \"the old river\" --diagnose --beta 6\n  python neural_llm.py data.txt --explain river ocean --plot-curves curves.png\n  python neural_llm.py data.txt --prompt \"the old river\" --dots circuit --fb 0.5 --trace\n  python neural_llm.py data.txt --sim-report --calibrate\n  python neural_llm.py data.txt --interactive --dots circuit --target-entropy 1.5\n\"\"\"\nimport argparse\nimport difflib\nimport heapq\nimport json\nimport os\nimport random\nimport re\nfrom collections import Counter, defaultdict, deque\nfrom dataclasses import dataclass, replace\n\nimport numpy as np\nimport scipy.sparse as sp\nfrom scipy.sparse.csgraph import connected_components\nfrom scipy.sparse.linalg import svds\nfrom scipy.spatial import cKDTree\n\nPAD, UNK, BOS, EOS = \"<pad>\", \"<unk>\", \"<bos>\", \"\"\nTOKEN_RE = re.compile(r\"[a-z0-9']+|[.,!?;:]\")\nSENT_SPLIT = re.compile(r\"(?<=[.!?])\\s+|\\n{2,}\")\nWORD_RE = re.compile(r\"[a-z0-9']\")\n\n_SUFFIXES = (\"ing\", \"ed\", \"es\", \"s\", \"ly\")\n\n\ndef stem(w):\n    \"\"\"Crude suffix stripper: enough to link rivers/river, flowing/flow.\"\"\"\n    for suf in _SUFFIXES:\n        if suf == \"s\" and w.endswith(\"ss\"):      # glass != glas\n            continue\n        if w.endswith(suf) and len(w) - len(suf) >= 3:\n            return w[:-len(suf)]\n    return w\n\n\ndef explain_words(values):\n    \"\"\"Expand one or more command-line values into individual explainable words.\"\"\"\n    words = []\n    for value in values or []:\n        words.extend(TOKEN_RE.findall(value.lower()))\n    return words\n\n\nEDGE_DTYPE = np.dtype([(\"src\", \"<u4\"), (\"dst\", \"<u4\"), (\"w\", \"<f4\")])\n\n\n# ===========================================================================\n# PART 1 -- NEURAL CIRCUIT: MRI -> graph -> dynamics\n# ===========================================================================\ndef synthesize_volume(shape=(60, 60, 40), seed=0):\n    \"\"\"Stand-in brain (ellipsoid + smooth texture) when no MRI file is present.\"\"\"\n    rng = np.random.default_rng(seed)\n    z, y, x = np.meshgrid(*[np.linspace(-1, 1, s) for s in shape], indexing=\"ij\")\n    body = (x ** 2 / 0.8 + y ** 2 / 0.9 + z ** 2 / 0.8) < 1\n    tex = rng.normal(size=shape).astype(np.float32)\n    for _ in range(2):\n        tex = (tex + np.roll(tex, 1, 0) + np.roll(tex, 1, 1) + np.roll(tex, 1, 2)) / 4\n    return np.clip(0.6 + 0.5 * tex, 0, 1) * body\n\n\ndef load_volume(path, downsample=4):\n    \"\"\"Real NIfTI scan, downsampled and robustly normalised (99th percentile).\n    Returns (volume, axis_codes); codes come from the scan's affine, e.g. ('R','A','S').\"\"\"\n    if path and os.path.exists(path):\n        import nibabel as nib\n        img = nib.load(path)\n        data = img.get_fdata().astype(np.float32)[::downsample, ::downsample, ::downsample]\n        codes = tuple(nib.aff2axcodes(img.affine))\n        return np.clip(data / np.percentile(data[data > 0], 99), 0, 1), codes\n    print(f\"[circuit] MRI '{path}' not found; using a synthetic volume (region labels nominal)\")\n    return synthesize_volume(), (\"R\", \"A\", \"S\")\n\n\ndef build_graph(vol, threshold, edges_path):\n    \"\"\"Vectorised: tissue voxels -> nodes; 6-neighbour edges written to disk.\"\"\"\n    mask = vol > threshold\n    n = int(mask.sum())\n    idx = np.full(vol.shape, -1, np.int64)\n    idx[mask] = np.arange(n)\n    coords = np.argwhere(mask)                    # same C-order as idx assignment\n    src, dst, wts = [], [], []\n    for ax in range(3):\n        a, b = [slice(None)] * 3, [slice(None)] * 3\n        a[ax], b[ax] = slice(None, -1), slice(1, None)\n        ia, ib = idx[tuple(a)], idx[tuple(b)]\n        ok = (ia >= 0) & (ib >= 0)\n        w = 1.0 - np.abs(vol[tuple(a)] - vol[tuple(b)])\n        src.append(ia[ok]); dst.append(ib[ok]); wts.append(w[ok])\n    s, d, w = np.concatenate(src), np.concatenate(dst), np.concatenate(wts)\n    rec = np.empty(2 * len(s), EDGE_DTYPE)        # both directions\n    rec[\"src\"], rec[\"dst\"], rec[\"w\"] = np.r_[s, d], np.r_[d, s], np.r_[w, w]\n    rec.tofile(edges_path)\n    return coords, n\n\n\ndef load_adjacency(edges_path, n):\n    rec = np.memmap(edges_path, dtype=EDGE_DTYPE, mode=\"r\")   # disk-backed, lazy\n    return sp.csr_matrix((np.asarray(rec[\"w\"], np.float32),\n                          (np.asarray(rec[\"src\"]), np.asarray(rec[\"dst\"]))), shape=(n, n))\n\n\ndef step_dynamics(A, W, decay, gain, thr):\n    \"\"\"One step of the simulator rule: nodes above `thr` fire and push\n    gain * w * activity to neighbours; everything leaks by `decay`.\"\"\"\n    fire = np.where(A > thr, A, 0.0)\n    return np.minimum(decay * A + gain * (W @ fire), 3.0).astype(np.float32)\n\n\ndef simulate_activity(W, seed, steps=60, decay=0.6, gain=0.4, thr=0.55,\n                      stim_interval=0, amp=1.0):\n    \"\"\"Single pulse (stim_interval=0) or periodic self-stimulation at `seed`.\n    Returns (active node counts, firing node counts) per step.\"\"\"\n    a = np.zeros((W.shape[0], 1), np.float32)\n    a[seed] = amp\n    active, firing = [int((a > 0).sum())], [int((a > thr).sum())]\n    for t in range(steps):\n        a = step_dynamics(a, W, decay, gain, thr)\n        if stim_interval and (t + 1) % stim_interval == 0:\n            a[seed] += amp\n        active.append(int((a > 0).sum())); firing.append(int((a > thr).sum()))\n    return active, firing\n\n\ndef circuit_responses(W, seed_nodes, steps, decay, gain, thr, batch=64, prune=1e-3):\n    \"\"\"Response vector of each seed: activity integrated over `steps`, as sparse\n    unit-norm rows. Batched dense propagation keeps memory flat.\"\"\"\n    N, chunks = W.shape[0], []\n    for s in range(0, len(seed_nodes), batch):\n        sn = seed_nodes[s:s + batch]\n        A = np.zeros((N, len(sn)), np.float32)\n        A[sn, np.arange(len(sn))] = 1.0\n        acc = A.copy()\n        for _ in range(steps):\n            A = step_dynamics(A, W, decay, gain, thr)\n            acc += A\n        acc[acc < prune] = 0\n        chunks.append(sp.csr_matrix(acc.T))\n    R = sp.vstack(chunks).tocsr()\n    norm = np.sqrt(np.asarray(R.multiply(R).sum(axis=1)).ravel()) + 1e-8\n    return sp.diags(1.0 / norm) @ R\n\n\n# ===========================================================================\n# PART 2 -- CORPUS + VOCAB + N-GRAM\n# ===========================================================================\ndef detok(tokens):\n    return re.sub(r\"\\s+([.,!?;:])\", r\"\\1\", \" \".join(tokens))\n\n\ndef load_sentences(path):\n    text = open(path, encoding=\"utf-8\").read().lower()\n    sents = [TOKEN_RE.findall(c) for c in SENT_SPLIT.split(text)]\n    return [s for s in sents if len(s) >= 2]\n\n\nclass Vocab:\n    def __init__(self, sents, min_count=1):\n        counts = Counter(t for s in sents for t in s)\n        kept = sorted((t for t, c in counts.items() if c >= min_count),\n                      key=lambda t: (-counts[t], t))\n        self.itos = [PAD, UNK, BOS, EOS] + kept\n        self.stoi = {t: i for i, t in enumerate(self.itos)}\n        self.V = len(self.itos)\n        self.pad, self.unk, self.bos, self.eos = range(4)\n        self.counts = np.zeros(self.V)\n        for t in kept:\n            self.counts[self.stoi[t]] = counts[t]\n        self.by_stem = {}\n        for i in range(4, self.V):                # itos is frequency-sorted\n            self.by_stem.setdefault(stem(self.itos[i]), i)\n\n    def encode(self, toks):\n        return [self.stoi.get(t, self.unk) for t in toks]\n\n    def resolve(self, tok):\n        \"\"\"Known word -> itself. Otherwise try a shared stem, then a close spelling.\n        Returns a vocabulary token or None.\"\"\"\n        if tok in self.stoi:\n            return tok\n        if not WORD_RE.match(tok) or len(tok) < 4:\n            return None\n        i = self.by_stem.get(stem(tok))\n        if i is not None:\n            return self.itos[i]\n        m = difflib.get_close_matches(tok, self.itos[4:], n=1, cutoff=0.85)\n        return m[0] if m else None\n\n\nclass NGram:\n    \"\"\"Interpolated n-gram; order = number of previous tokens used.\"\"\"\n\n    def __init__(self, vocab, order=2, lam=0.7, k=0.01, base_clip=100.0):\n        self.v, self.order, self.lam, self.k = vocab, order, lam, k\n        self.base_clip = base_clip\n        self.tables = [defaultdict(Counter) for _ in range(order + 1)]\n\n    def fit(self, seqs):\n        for seq in seqs:\n            for t in range(1, len(seq)):\n                for n in range(min(self.order, t) + 1):\n                    self.tables[n][tuple(seq[t - n:t])][seq[t]] += 1\n        base = self.v.counts.copy()\n        base[self.v.eos] = len(seqs)\n        if self.base_clip < 100:\n            pos = base[base > 0]\n            base = np.minimum(base, np.percentile(pos, self.base_clip))\n        base += self.k\n        base[[self.v.pad, self.v.bos, self.v.unk]] = 0.0\n        self.base = base / base.sum()\n\n    def dist(self, ctx):\n        p = self.base\n        ctx = tuple(ctx[-self.order:]) if self.order else ()\n        for n in range(len(ctx) + 1):\n            c = self.tables[n].get(ctx[len(ctx) - n:] if n else ())\n            if c:\n                vec = np.zeros(self.v.V)\n                for tok, cnt in c.items():\n                    vec[tok] = cnt\n                p = self.lam * vec / vec.sum() + (1 - self.lam) * p\n        return p\n\n    def logits(self, ctx):\n        lg = np.log(np.maximum(self.dist(ctx), 1e-300))\n        lg[[self.v.pad, self.v.bos, self.v.unk]] = -np.inf\n        return lg\n\n\n# ===========================================================================\n# PART 3 -- DOT-PRODUCT EXTRACTION: token placement on the brain + G matrix\n# ===========================================================================\n@dataclass\nclass Circuit:\n    ids: np.ndarray        # vocab ids that have their own circuit vector\n    row_of: np.ndarray     # vocab id -> row in G (or -1); inflections alias a sibling's row\n    G: np.ndarray          # circuit dot products  r_i . r_j   (diag = 0)\n    Gp: np.ndarray         # ablation: PPMI-cosine dots, no brain (diag = 0)\n    ppmi: np.ndarray       # raw PPMI (used only by the diagnostic metric)\n    stats: dict\n    info: dict = None      # per-word MRI context arrays (see word_context)\n\n\ndef rank01(x):\n    return np.argsort(np.argsort(x, kind=\"stable\"), kind=\"stable\") / max(len(x) - 1, 1)\n\n\ndef noodle_field(vol, mask, tube_pct=25.0, sigma_grad=1.0, sigma_int=2.0):\n    \"\"\"Structure-tensor orientation field. For each tissue voxel: the direction of least\n    intensity variation (along a noodle) and a tube-ness score (~1 tube-like, ~0 plane or\n    isotropic). The stopping threshold is a percentile of the scan's own tube-ness, because\n    the absolute scale depends on resolution and contrast.\"\"\"\n    from scipy.ndimage import gaussian_filter\n    sm = gaussian_filter(vol, sigma_grad)\n    g = np.stack(np.gradient(sm), -1)\n    J = np.empty(vol.shape + (3, 3), np.float32)\n    for i in range(3):\n        for j in range(i, 3):\n            J[..., i, j] = J[..., j, i] = gaussian_filter(g[..., i] * g[..., j], sigma_int)\n    w, v = np.linalg.eigh(J[mask])                       # eigenvalues ascending\n    direction = np.zeros(vol.shape + (3,), np.float32)\n    direction[mask] = v[:, :, 0]\n    tube = np.zeros(vol.shape, np.float32)\n    tube[mask] = (w[:, 1] - w[:, 0]) / (w[:, 2] + 1e-9)\n    return dict(dir=direction, tube=tube, mask=mask,\n                thr=float(np.percentile(tube[mask], tube_pct)))\n\n\ndef trace_noodles(field, seeds, K=16, L=24, max_angle=70.0, seed=0, paths=False):\n    \"\"\"Trace K noodles from each seed (grid coords, shape (n,3)) for up to L unit steps.\n    Returns survival S of shape (n, L+1): S[w, k] = share of word w's noodles still alive\n    after k steps (S[:,0] = 1). With paths=True also returns positions/alive for plotting.\"\"\"\n    rng = np.random.default_rng(seed)\n    n, shape = len(seeds), np.array(field[\"mask\"].shape)\n    pos = np.repeat(np.asarray(seeds, np.float64), K, 0) + rng.normal(0, 0.7, (n * K, 3))\n    sign = np.tile([1.0, -1.0], (n * K + 1) // 2)[:n * K]     # half go each way\n    cos_lim = np.cos(np.deg2rad(max_angle))\n    alive, prev = np.ones(n * K, bool), None\n    surv = [alive.reshape(n, K).mean(1)]\n    hist, ahist = [pos.copy()], [alive.copy()]\n    for _ in range(L):\n        idt = tuple(np.clip(np.rint(pos).astype(int), 0, shape - 1).T)\n        d = field[\"dir\"][idt].astype(np.float64) * sign[:, None]\n        ok = field[\"mask\"][idt] & (field[\"tube\"][idt] >= field[\"thr\"])\n        if prev is not None:\n            dot = (d * prev).sum(1)\n            d[dot < 0] *= -1                                   # orientation has no sign\n            ok &= np.abs(dot) >= cos_lim\n        alive &= ok\n        pos, prev = pos + d, d\n        surv.append(alive.reshape(n, K).mean(1))\n        hist.append(pos.copy()); ahist.append(alive.copy())\n    S = np.array(surv).T.astype(np.float32)\n    if paths:\n        return S, dict(pos=np.array(hist).reshape(L + 1, n, K, 3),\n                       alive=np.array(ahist).reshape(L + 1, n, K))\n    return S\n\n\n_SPARK = \" \u2581\u2582\u2583\u2584\u2585\u2586\u2587\u2588\"\n\n\ndef sparkline(v):\n    return \"\".join(_SPARK[int(round(min(max(x, 0), 1) * 8))] for x in v)\n\n\n_AXIS_NAMES = {\"R\": (\"right\", \"left\"), \"L\": (\"left\", \"right\"),\n               \"A\": (\"anterior\", \"posterior\"), \"P\": (\"posterior\", \"anterior\"),\n               \"S\": (\"superior\", \"inferior\"), \"I\": (\"inferior\", \"superior\")}\n_AXIS_ORDER = {\"right\": 0, \"left\": 0, \"anterior\": 1, \"posterior\": 1, \"superior\": 2, \"inferior\": 2}\n\n\ndef region_label(xyz, mid, codes):\n    \"\"\"Coarse octant name from voxel position and the scan's axis codes.\"\"\"\n    parts = [_AXIS_NAMES[c][0] if xyz[k] > mid[k] else _AXIS_NAMES[c][1]\n             for k, c in enumerate(codes)]\n    return \"-\".join(sorted(parts, key=_AXIS_ORDER.get))\n\n\ndef word_context_table(R, seeds, coords_all, vals, keep_cc, codes):\n    \"\"\"Per-word context read from the scan: seed position/region/tissue band and\n    the footprint of the word's pulse (size, centroid, mean intensity).\"\"\"\n    mid = (keep_cc.min(0) + keep_cc.max(0)) / 2\n    lo, hi = np.percentile(vals[vals > 0], [33, 67])\n    seed_int = vals[seeds]\n    # relative thirds of this scan's tissue intensities (not a tissue classification)\n    band = np.where(seed_int < lo, \"low intensity\",\n                    np.where(seed_int < hi, \"mid intensity\", \"high intensity\"))\n    mass = np.asarray(R.sum(axis=1)).ravel() + 1e-8\n    return dict(\n        xyz=coords_all[seeds].astype(np.int32),\n        seed_int=seed_int.astype(np.float32),\n        band=band.astype(\"U32\"),\n        region=np.array([region_label(coords_all[n], mid, codes) for n in seeds], dtype=\"U40\"),\n        foot_n=np.diff(R.indptr).astype(np.int32),\n        foot_cent=((R @ coords_all.astype(np.float64)) / mass[:, None]).astype(np.float32),\n        foot_int=((R @ vals.astype(np.float64)) / mass).astype(np.float32))\n\n\ndef word_context(circ, vocab, word, top=5):\n    \"\"\"Everything the MRI says about one word, or None if it has no circuit vector.\n    Inflections share their sibling's vector, so they report the sibling's context.\"\"\"\n    i = vocab.stoi.get(word, -1)\n    r = circ.row_of[i] if i >= 0 else -1\n    if r < 0 or not circ.info:\n        return None\n    f = circ.info\n    nb = np.argsort(-circ.G[r])[:top]\n    curve = f[\"curve\"][r] if \"curve\" in f else None\n    below = np.flatnonzero(curve < 0.5) if curve is not None else []\n    return dict(word=word, curve=curve,\n                half_life=(int(below[0]) if len(below) else len(curve) - 1) if curve is not None else None,\n                noodle_len=float(curve[1:].sum()) if curve is not None else None,\n                word_=word, xyz=tuple(int(v) for v in f[\"xyz\"][r]),\n                intensity=float(f[\"seed_int\"][r]), band=str(f[\"band\"][r]),\n                region=str(f[\"region\"][r]), footprint=int(f[\"foot_n\"][r]),\n                centroid=tuple(round(float(v), 1) for v in f[\"foot_cent\"][r]),\n                footprint_intensity=float(f[\"foot_int\"][r]),\n                neighbours=[(vocab.itos[circ.ids[j]], float(circ.G[r, j])) for j in nb if circ.G[r, j] > 0])\n\n\ndef build_circuit(sents, vocab, a):\n    skip = set(np.argsort(-vocab.counts)[:a.skip_top].tolist())\n    cand = [i for i in range(4, vocab.V)\n            if i not in skip and WORD_RE.match(vocab.itos[i])\n            and vocab.counts[i] >= a.circuit_min_count]\n    ids = np.array(sorted(cand, key=lambda i: -vocab.counts[i])[:a.circuit_vocab])\n    if len(ids) < 8:\n        print(\"[circuit] too few content tokens; circuit disabled\")\n        return None\n    Vc = len(ids)\n    row_of = np.full(vocab.V, -1, np.int64)\n    row_of[ids] = np.arange(Vc)\n\n    # --- PPMI over sentence co-occurrence (float32 to keep the dense Vc x Vc matrices small)\n    r, c = [], []\n    for si, s in enumerate(sents):\n        for t in set(vocab.encode(s)):\n            if row_of[t] >= 0:\n                r.append(si); c.append(row_of[t])\n    X = sp.csr_matrix((np.ones(len(r), np.float32), (r, c)), shape=(len(sents), Vc))\n    C = (X.T @ X).toarray().astype(np.float32)\n    np.fill_diagonal(C, 0)\n    rs = C.sum(1, keepdims=True)\n    tot = np.float32(C.sum(dtype=np.float64))\n    with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n        pmi = np.log(C * tot / (rs * rs.T))\n    del C\n    P = np.where(np.isfinite(pmi) & (pmi > 0), pmi, 0).astype(np.float32)\n    del pmi\n    Pn = P / (np.linalg.norm(P, axis=1, keepdims=True) + 1e-8)\n    Gp = (Pn @ Pn.T).astype(np.float32)\n    np.fill_diagonal(Gp, 0)\n    del Pn\n\n    # --- alias inflections of circuit words onto their sibling's row (done after PPMI so\n    #     co-occurrence counts aren't merged; function words in `skip` are never aliased)\n    by_stem = {}\n    for i in ids:\n        by_stem.setdefault(stem(vocab.itos[i]), row_of[i])\n    for i in range(4, vocab.V):\n        if row_of[i] < 0 and i not in skip and WORD_RE.match(vocab.itos[i]):\n            rr = by_stem.get(stem(vocab.itos[i]))\n            if rr is not None:\n                row_of[i] = rr\n    print(f\"[circuit] {int((row_of >= 0).sum())} vocab words resolve to a circuit vector \"\n          f\"({Vc} direct, rest via stems)\")\n\n    # cache keyed by every parameter that affects G\n    nd = dict(L=getattr(a, \"noodle_steps\", 24), K=getattr(a, \"noodle_count\", 16),\n              ang=getattr(a, \"noodle_angle\", 70.0), pct=getattr(a, \"noodle_tube_pct\", 25.0))\n    sig = json.dumps(dict(v=4, nd=nd, mri=a.mri, ds=a.downsample, vt=a.voxel_threshold, steps=a.steps,\n                          decay=a.decay, gain=a.gain, fire=a.fire_threshold,\n                          toks=[vocab.itos[i] for i in ids]), sort_keys=True)\n    if a.dots_cache and os.path.exists(a.dots_cache):\n        z = np.load(a.dots_cache, allow_pickle=False)\n        if str(z[\"sig\"]) == sig:\n            print(f\"[circuit] loaded cached dot products from {a.dots_cache}\")\n            info = {k[5:]: z[k] for k in z.files if k.startswith(\"info_\")}\n            return Circuit(ids, row_of, z[\"G\"], Gp, P, dict(cached=True, tokens=Vc), info)\n\n    # --- brain graph\n    vol, codes = load_volume(a.mri, a.downsample)\n    coords, n = build_graph(vol, a.voxel_threshold, a.edges_path)\n    vals = vol[tuple(coords.T)]\n    W = load_adjacency(a.edges_path, n)\n    ncomp, lab = connected_components(W, directed=False)\n    keep = np.flatnonzero(lab == np.bincount(lab).argmax())\n    wbar = float(W.data.mean())\n    gain = a.gain if a.gain > 0 else 1.5 * a.fire_threshold / wbar   # sharp-transition rule\n    print(f\"[circuit] volume {vol.shape}: {n} nodes, {W.nnz} directed edges, \"\n          f\"largest component {len(keep)}/{n}, mean edge weight {wbar:.2f}, \"\n          f\"gain {gain:.2f} (spreads only if gain*w > threshold {a.fire_threshold})\")\n\n    # --- place tokens on the brain: PPMI -> 3 SVD dims -> uniform [0,1] -> bbox -> nearest node\n    Ps = sp.csr_matrix(P).astype(np.float64)       # PPMI is sparse; avoids a dense float64 copy\n    U, S, _ = svds(Ps, k=3, v0=np.random.default_rng(0).normal(size=Vc))  # seeded: reproducible placement\n    pos = np.stack([rank01(v) for v in (U * S).T], axis=1)\n    cc = coords[keep].astype(np.float64)\n    target = cc.min(0) + pos * (cc.max(0) - cc.min(0))\n    seeds = keep[cKDTree(cc).query(target)[1]]\n\n    # --- circuit responses -> dot products\n    R = circuit_responses(W, seeds, a.steps, a.decay, gain, a.fire_threshold)\n    G = (R @ R.T).toarray().astype(np.float32)\n    np.fill_diagonal(G, 0)\n    info = word_context_table(R, seeds, coords, vals, cc, codes)\n    field = noodle_field(vol, vol > a.voxel_threshold, nd[\"pct\"])\n    info[\"curve\"] = trace_noodles(field, coords[seeds], nd[\"K\"], nd[\"L\"], nd[\"ang\"])\n    hl = [(np.flatnonzero(c < 0.5)[:1].tolist() or [nd[\"L\"]])[0] for c in info[\"curve\"]]\n    print(f\"[noodles] {nd['K']} noodles/word, {nd['L']} steps: context half-life \"\n          f\"min/median/max = {min(hl)}/{int(np.median(hl))}/{max(hl)} steps \"\n          f\"(tube-ness stop threshold {field['thr']:.3f})\")\n    nnz = np.diff(R.indptr)\n    stats = dict(nodes=n, tokens=Vc, median_active_nodes=int(np.median(nnz)),\n                 frac_of_brain=float(np.median(nnz) / n), gain=gain)\n    print(f\"[circuit] extracted {Vc}x{Vc} dot products; each token's response covers \"\n          f\"~{stats['median_active_nodes']} nodes ({100 * stats['frac_of_brain']:.2f}% of brain)\")\n    if stats[\"median_active_nodes\"] < 10:\n        print(\"[circuit] warning: pulses are not spreading; raise --gain or lower --fire-threshold\")\n    if a.dots_cache:\n        np.savez(a.dots_cache, G=G, sig=sig, **{\"info_\" + k: v for k, v in info.items()})\n    return Circuit(ids, row_of, G, Gp, P, stats, info)\n\n\ndef expand_bias(circ, vocab, s):\n    \"\"\"Row scores -> full-vocab bias, robustly normalised to [0, 1].\n    Aliased inflections share their sibling's score.\"\"\"\n    pos = s[s > 0]\n    if not pos.size:\n        return None\n    x = np.clip(s / np.percentile(pos, 99), 0, 1)\n    full = np.zeros(vocab.V, np.float32)\n    has = circ.row_of >= 0\n    full[has] = x[circ.row_of[has]]\n    return full\n\n\ndef prompt_bias(circ, vocab, toks, source):\n    \"\"\"Dot products between the prompt's content tokens and every token,\n    robustly normalised to [0, 1] and expanded to the full vocabulary.\"\"\"\n    if circ is None or source == \"none\":\n        return None\n    M = circ.G if source == \"circuit\" else circ.Gp\n    rows = [circ.row_of[vocab.stoi[t]] for t in toks\n            if t in vocab.stoi and circ.row_of[vocab.stoi[t]] >= 0]\n    if not rows:\n        return None\n    return expand_bias(circ, vocab, M[:, rows].sum(axis=1))\n\n\ndef context_bias(circ, M, vocab, gen_ids, decay, curves=False, stride=3):\n    \"\"\"Word-by-word context: each recently generated word injects its own circuit\n    response; its weight at age `a` is its noodle curve S_w(a*stride) (curves=True)\n    or decay**a. Returns the normalised dot-product bias.\"\"\"\n    u = np.zeros(len(circ.ids), np.float32)\n    C = circ.info[\"curve\"] if curves else None\n    for age, tok in enumerate(reversed(gen_ids)):\n        r = circ.row_of[tok]\n        if r >= 0:\n            u[r] += C[r, min(age * stride, C.shape[1] - 1)] if curves else decay ** age\n    if not u.any():\n        return None\n    return expand_bias(circ, vocab, M @ u)\n\n\n# ===========================================================================\n# PART 4 -- DECODING\n# ===========================================================================\n@dataclass\nclass Gen:\n    max_len: int = 40\n    temp: float = 0.9\n    top_k: int = 40\n    target_entropy: float = 0.0\n    beam: int = 0\n    min_len: int = 0\n    length_alpha: float = 0.7\n    anchor_amp: float = 0.0       # direct leaky logit bias on prompt words\n    anchor_decay: float = 0.9\n    anchor_interval: int = 16\n    dots: str = \"none\"            # none | circuit | ppmi\n    beta: float = 6.0             # logit strength of the dot-product bias\n    fb: float = 1.0               # >0: generated words feed their own MRI context back in\n    fb_window: int = 4            # only the last N generated words contribute\n    fb_decay: float = 0.7         # newest word weight 1, then decay^age\n    curves: str = \"noodle\"        # noodle | exp  (per-word MRI curve vs plain exponential decay)\n    curve_stride: int = 3         # noodle steps per word of age\n    eos_guard: bool = True        # keep P(end-of-text) unchanged when a bias boosts other words\n    slack: int = 20\n\n\ndef entropy(logits, temp):\n    z = logits / temp\n    p = np.exp(z - z.max())\n    p /= p.sum()\n    nz = p[p > 0]\n    return float(-(nz * np.log(nz)).sum())\n\n\ndef temperature_for_entropy(logits, target, lo=0.05, hi=3.0, iters=24):\n    for _ in range(iters):\n        mid = (lo + hi) / 2\n        lo, hi = (mid, hi) if entropy(logits, mid) < target else (lo, mid)\n    return (lo + hi) / 2\n\n\ndef top_k_mask(lg, k):\n    if 0 < k < len(lg):\n        lg = np.where(lg < np.partition(lg, -k)[-k], -np.inf, lg)\n    return lg\n\n\ndef pick(lg, gen):\n    lg = top_k_mask(lg, gen.top_k)\n    t = (temperature_for_entropy(lg, gen.target_entropy)\n         if gen.target_entropy > 0 else max(gen.temp, 1e-3))\n    p = np.exp(lg / t - (lg / t).max())\n    return int(np.random.choice(len(p), p=p / p.sum())), t\n\n\nclass LeakySchedule:\n    \"\"\"Self-stimulation: level leaks by `decay` each step and is re-pulsed by\n    `amp` every `interval` steps (precomputed so beams share it).\"\"\"\n\n    def __init__(self, amp, decay, interval, n):\n        level, self.levels = amp, []\n        for t in range(n):\n            self.levels.append(level)\n            level *= decay\n            if (t + 1) % interval == 0:\n                level += amp\n\n    def level(self, t):\n        return self.levels[min(t, len(self.levels) - 1)]\n\n\ndef anchor_ids(vocab, toks, skip_top=20):\n    common = set(np.argsort(-vocab.counts)[:skip_top].tolist())\n    return sorted({vocab.stoi[t] for t in toks if t in vocab.stoi and WORD_RE.match(t)\n                   and vocab.stoi[t] not in common})\n\n\ndef materialize(node):\n    out = []\n    while node is not None:\n        tok, node = node\n        out.append(tok)\n    return out[::-1]\n\n\ndef log_softmax(lg):\n    m = lg.max()\n    return lg - (m + np.log(np.exp(lg - m).sum()))\n\n\ndef beam_search(step_fn, ctx0, eos, max_new, width, top_k, alpha, state_len):\n    \"\"\"state_len = how many trailing tokens fully determine the future (model order,\n    or the feedback window if larger), so merging beams on that tail is exact.\"\"\"\n    path0 = None\n    for t in ctx0:\n        path0 = (t, path0)\n    beam, done = [(0.0, path0)], []\n    for step in range(max_new):\n        cands = {}\n        for score, path in beam:\n            seq = materialize(path)\n            logp = log_softmax(step_fn(seq))\n            k = min(top_k if top_k > 0 else 16, len(logp) - 1)\n            for tok in np.argpartition(-logp, k)[:k]:\n                if not np.isfinite(logp[tok]):\n                    continue\n                tok = int(tok)\n                s, newp = score + float(logp[tok]), (tok, path)\n                if tok == eos:\n                    done.append((s / (step + 1) ** alpha, newp))\n                    continue\n                tail = tuple(seq[-(state_len - 1):] + [tok]) if state_len > 1 else (tok,)\n                if tail not in cands or s > cands[tail][0]:\n                    cands[tail] = (s, newp)\n        if not cands or len(done) >= width:\n            break\n        beam = heapq.nlargest(width, cands.values(), key=lambda c: c[0])\n    pool = done or [(s / max_new ** alpha, p) for s, p in beam]\n    out = materialize(max(pool, key=lambda c: c[0])[1])[len(ctx0):]\n    return out[:-1] if out and out[-1] == eos else out\n\n\ndef min_steps_to_eos(model, vocab, start):\n    \"\"\"Shortest observed path from `start` to end-of-text (feasibility + length floor).\"\"\"\n    if model.order < 1:\n        return None\n    graph, seen, q = model.tables[1], {start}, deque([(start, 0)])\n    while q:\n        s, d = q.popleft()\n        nxt = graph.get((s,))\n        if not nxt:\n            continue\n        if vocab.eos in nxt:\n            return d + 1\n        for n in nxt:\n            if n not in seen:\n                seen.add(n); q.append((n, d + 1))\n    return None\n\n\ndef generate(model, vocab, toks, gen, circ=None, trace=None):\n    \"\"\"trace (list, sampling mode only) receives (token_id, bias_applied_to_it).\"\"\"\n    ctx0 = [vocab.bos] + vocab.encode(toks)\n    anchors = anchor_ids(vocab, toks) if gen.anchor_amp > 0 else []\n    a_sched = (LeakySchedule(gen.anchor_amp, gen.anchor_decay, gen.anchor_interval,\n                             gen.max_len + 1) if anchors else None)\n    M = None if circ is None else {\"circuit\": circ.G, \"ppmi\": circ.Gp}.get(gen.dots)\n    bp = prompt_bias(circ, vocab, toks, gen.dots)\n    use_fb = M is not None and gen.fb > 0\n    use_curves = (gen.curves == \"noodle\" and circ is not None and bool(circ.info)\n                  and \"curve\" in circ.info)\n    d_sched = (LeakySchedule(1.0, gen.anchor_decay, gen.anchor_interval, gen.max_len + 1)\n               if bp is not None else None)\n    last = {}\n\n    def step(seq):\n        t = len(seq) - len(ctx0)\n        lg = model.logits(seq)\n        if t < gen.min_len:\n            lg[vocab.eos] = -np.inf\n        if a_sched:\n            lg[anchors] += a_sched.level(t)\n        b = None\n        if bp is not None:\n            b = d_sched.level(t) * bp\n        if use_fb:\n            f = context_bias(circ, M, vocab, seq[len(ctx0):][-gen.fb_window:], gen.fb_decay,\n                             use_curves, gen.curve_stride)\n            if f is not None:\n                b = gen.fb * f if b is None else b + gen.fb * f\n        if b is not None:\n            if gen.eos_guard and t >= gen.min_len:\n                # keep P(end-of-text) unchanged: shift it by the log-ratio of the other\n                # words' probability mass after vs before the boost\n                p = np.exp(lg - lg.max())\n                p[vocab.eos] = 0.0\n                if p.sum() > 0:\n                    lg[vocab.eos] += np.log((p * np.exp(gen.beta * b)).sum() / p.sum())\n            lg += gen.beta * b\n        last[\"b\"] = b\n        return lg\n\n    if gen.beam > 0:\n        state_len = max(model.order, 1, gen.fb_window if use_fb else 0)\n        return beam_search(step, ctx0, vocab.eos, gen.max_len, gen.beam,\n                           gen.top_k, gen.length_alpha, state_len), []\n    ctx, out, temps = list(ctx0), [], []\n    for _ in range(gen.max_len):\n        nxt, t = pick(step(ctx), gen)\n        if nxt == vocab.eos:\n            break\n        if trace is not None:\n            trace.append((nxt, 0.0 if last[\"b\"] is None else float(last[\"b\"][nxt])))\n        out.append(nxt); ctx.append(nxt); temps.append(t)\n    return out, temps\n\n\ndef resolve_prompt(vocab, toks):\n    \"\"\"Map each prompt token to a known word where possible.\n    Returns (resolved tokens, list of 'typed\u2192matched' strings).\"\"\"\n    resolved, mapped = [], []\n    for t in toks:\n        r = vocab.resolve(t)\n        if r is not None and r != t:\n            mapped.append(f\"{t}\u2192{r}\")\n        resolved.append(r if r is not None else t)\n    return resolved, mapped\n\n\ndef complete(model, vocab, prompt, gen, circ=None, trace=None):\n    toks = TOKEN_RE.findall(prompt.lower())\n    if not toks:\n        raise ValueError(\"prompt has no usable tokens\")\n    resolved, mapped = resolve_prompt(vocab, toks)\n    ids = vocab.encode(resolved)\n    oov = [t for t, i in zip(toks, ids) if i == vocab.unk]\n    d = min_steps_to_eos(model, vocab, ids[-1])\n    note = None\n    if d is None:\n        note = \"no observed path to end-of-text from the last prompt token\"\n    else:\n        gen = replace(gen, max_len=max(gen.max_len, d + gen.slack))\n    out, _ = generate(model, vocab, resolved, gen, circ, trace)\n    if mapped:\n        note = (note + \"; \" if note else \"\") + \"matched unseen words: \" + \", \".join(mapped)\n    return detok(toks + [vocab.itos[i] for i in out]), oov, note\n\n\ndef calibrate_beam(model, vocab, sents, circ=None, widths=(1, 2, 4, 8, 16, 32), ref=64,\n                   n_prompts=6, max_len=25, top_k=20):\n    rng = random.Random(0)\n    starts = [s[:2] for s in rng.sample(sents, min(n_prompts, len(sents)))]\n\n    def run(w):\n        g = Gen(max_len=max_len, top_k=top_k, beam=w)\n        return [tuple(generate(model, vocab, s, g, circ)[0]) for s in starts]\n\n    reference = run(ref)\n    return next((w for w in widths if run(w) == reference), ref)\n\n\ndef diagnose(model, vocab, prompt, gen, circ, n=30):\n    \"\"\"Ablation. Metric = mean PPMI between generated content words and the prompt's\n    content words (a direct corpus statistic). Caveat: PPMI also builds both dot-product\n    sources, so the 'ppmi' arm is favoured by construction; use a labelled-topic corpus\n    for an independent check.\"\"\"\n    toks, _ = resolve_prompt(vocab, TOKEN_RE.findall(prompt.lower()))\n    prompt_rows = [circ.row_of[vocab.stoi[t]] for t in toks\n                   if t in vocab.stoi and circ.row_of[vocab.stoi[t]] >= 0] if circ else []\n    anchors = set(anchor_ids(vocab, toks))\n    base = replace(gen, anchor_amp=0.0, dots=\"none\", beam=0)\n    arms = [(\"none\", base), (\"anchor\", replace(base, anchor_amp=gen.anchor_amp or 2.0))]\n    if circ is not None and prompt_rows:\n        fb = gen.fb or 0.5\n        arms += [(\"ppmi dots\", replace(base, dots=\"ppmi\")),\n                 (\"circuit dots\", replace(base, dots=\"circuit\")),\n                 (\"circuit+exp ctx\", replace(base, dots=\"circuit\", fb=fb, curves=\"exp\")),\n                 (\"circuit+noodle ctx\", replace(base, dots=\"circuit\", fb=fb, curves=\"noodle\"))]\n    print(f\"  {'arm':18s} {'prompt-PMI':>10s} {'anchor-rate':>11s} {'mean len':>8s}\")\n    for label, g in arms:\n        pm, hits, total = [], 0, 0\n        for _ in range(n):\n            out, _ = generate(model, vocab, toks, g, circ)\n            hits += sum(o in anchors for o in out)\n            total += len(out)\n            if circ is not None and prompt_rows:\n                rows = [circ.row_of[o] for o in out if circ.row_of[o] >= 0]\n                if rows:\n                    pm.append(circ.ppmi[np.ix_(rows, prompt_rows)].mean())\n        print(f\"  {label:18s} {np.mean(pm) if pm else float('nan'):10.3f} \"\n              f\"{hits / max(total, 1):11.4f} {total / n:8.1f}\")\n\n\ndef plot_curves(path, circ, vocab, words, a, K=12):\n    \"\"\"Left: each word's context curve S_w(k). Right: its noodles in 3-D over the brain.\"\"\"\n    import matplotlib\n    matplotlib.use(\"Agg\")\n    import matplotlib.pyplot as plt\n    from mpl_toolkits.mplot3d import Axes3D  # noqa: F401\n    ctxs = [c for c in (word_context(circ, vocab, w) for w in words) if c]\n    if not ctxs:\n        print(\"[plot] none of the words has a circuit vector\")\n        return\n    vol, _ = load_volume(a.mri, a.downsample)\n    mask = vol > a.voxel_threshold\n    field = noodle_field(vol, mask, getattr(a, \"noodle_tube_pct\", 25.0))\n    seeds = np.array([c[\"xyz\"] for c in ctxs])\n    L = len(ctxs[0][\"curve\"]) - 1\n    _, tr = trace_noodles(field, seeds, K, L, getattr(a, \"noodle_angle\", 70.0), paths=True)\n    fig = plt.figure(figsize=(13, 5.2))\n    ax = fig.add_subplot(1, 2, 1)\n    for c in ctxs:\n        ax.plot(c[\"curve\"], label=f\"{c['word']} (half-life {c['half_life']})\", lw=2)\n    ax.set_xlabel(\"noodle step k\"); ax.set_ylabel(\"share of noodles alive  S(k)\")\n    ax.set_title(\"per-word context curves\"); ax.legend(fontsize=8); ax.set_ylim(0, 1.02)\n    ax3 = fig.add_subplot(1, 2, 2, projection=\"3d\")\n    cloud = np.argwhere(mask)\n    cloud = cloud[np.random.default_rng(0).choice(len(cloud), min(3000, len(cloud)), replace=False)]\n    ax3.scatter(cloud[:, 2], cloud[:, 1], cloud[:, 0], c=\"lightgray\", s=1, alpha=0.12)\n    for wi, c in enumerate(ctxs):\n        color = f\"C{wi}\"\n        for k in range(K):\n            live = tr[\"alive\"][:, wi, k]\n            pts = tr[\"pos\"][live, wi, k]\n            if len(pts) > 1:\n                ax3.plot(pts[:, 2], pts[:, 1], pts[:, 0], color=color, lw=1.2, alpha=0.8)\n        ax3.scatter(*seeds[wi][[2, 1, 0]], color=color, s=40, edgecolors=\"k\")\n    ax3.set_title(\"noodles from each word's node\"); ax3.set_xlabel(\"x\"); ax3.set_ylabel(\"y\"); ax3.set_zlabel(\"z\")\n    plt.tight_layout(); plt.savefig(path, dpi=140)\n    print(f\"[plot] saved {path}\")\n\n\n# ===========================================================================\n# CLI\n# ===========================================================================\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__,\n                                 formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"path\", help=\"training text\")\n    g = ap.add_argument_group(\"language model\")\n    g.add_argument(\"--order\", type=int, default=2)\n    g.add_argument(\"--min-count\", type=int, default=1)\n    g.add_argument(\"--base-clip\", type=float, default=100.0)\n    g = ap.add_argument_group(\"circuit\")\n    g.add_argument(\"--mri\", default=\"real_brain_mri_t1.nii.gz\")\n    g.add_argument(\"--downsample\", type=int, default=4)\n    g.add_argument(\"--voxel-threshold\", type=float, default=0.2)\n    g.add_argument(\"--edges-path\", default=\"connectivity_edges.bin\")\n    g.add_argument(\"--steps\", type=int, default=4, help=\"propagation steps per token pulse\")\n    g.add_argument(\"--decay\", type=float, default=0.6)\n    g.add_argument(\"--gain\", type=float, default=0.0, help=\"0 = auto (1.5 x threshold / mean weight)\")\n    g.add_argument(\"--fire-threshold\", type=float, default=0.55)\n    g.add_argument(\"--circuit-vocab\", type=int, default=8000,\n                   help=\"max content words with their own brain vector (dense Vc x Vc matrices: memory ~ Vc^2)\")\n    g.add_argument(\"--circuit-min-count\", type=int, default=2)\n    g.add_argument(\"--skip-top\", type=int, default=20)\n    g.add_argument(\"--dots-cache\", default=None)\n    g.add_argument(\"--sim-report\", action=\"store_true\")\n    g.add_argument(\"--noodle-steps\", type=int, default=24)\n    g.add_argument(\"--noodle-count\", type=int, default=16, help=\"noodles traced per word\")\n    g.add_argument(\"--noodle-angle\", type=float, default=70.0, help=\"max turn per step, degrees\")\n    g.add_argument(\"--noodle-tube-pct\", type=float, default=25.0,\n                   help=\"noodles stop where tube-ness is below this percentile of the scan\")\n    g = ap.add_argument_group(\"decoding\")\n    g.add_argument(\"--dots\", choices=[\"none\", \"circuit\", \"ppmi\"], default=\"none\")\n    g.add_argument(\"--beta\", type=float, default=6.0)\n    g.add_argument(\"--fb\", type=float, default=1.0, help=\"word-by-word MRI context strength (0=off)\")\n    g.add_argument(\"--fb-window\", type=int, default=4)\n    g.add_argument(\"--fb-decay\", type=float, default=0.7, help=\"decay for --curves exp\")\n    g.add_argument(\"--curves\", choices=[\"noodle\", \"exp\"], default=\"noodle\")\n    g.add_argument(\"--curve-stride\", type=int, default=3, help=\"noodle steps per word of age\")\n    g.add_argument(\"--n\", type=int, default=1)\n    g.add_argument(\"--temp\", type=float, default=0.9)\n    g.add_argument(\"--top-k\", type=int, default=40)\n    g.add_argument(\"--max-len\", type=int, default=400)\n    g.add_argument(\"--min-len\", type=int, default=0)\n    g.add_argument(\"--target-entropy\", type=float, default=0.0)\n    g.add_argument(\"--anchor\", type=float, default=0.0)\n    g.add_argument(\"--anchor-decay\", type=float, default=0.9)\n    g.add_argument(\"--anchor-interval\", type=int, default=16)\n    g.add_argument(\"--beam\", type=int, default=0)\n    g.add_argument(\"--length-alpha\", type=float, default=0.7)\n    g.add_argument(\"--slack\", type=int, default=20)\n    ap.add_argument(\"--explain\", nargs=\"+\", metavar=\"WORD\", help=\"print each word's MRI context\")\n    ap.add_argument(\"--plot-curves\", metavar=\"PNG\", help=\"plot context curves + noodles for --explain words (or prompt words)\")\n    ap.add_argument(\"--trace\", action=\"store_true\", help=\"per-word MRI context of the first completion\")\n    ap.add_argument(\"--no-eos-guard\", action=\"store_true\", help=\"let the bias change the stopping probability\")\n    ap.add_argument(\"--calibrate\", action=\"store_true\")\n    ap.add_argument(\"--diagnose\", action=\"store_true\")\n    ap.add_argument(\"--prompt\", default=None)\n    ap.add_argument(\"--interactive\", action=\"store_true\")\n    ap.add_argument(\"--seed\", type=int, default=42)\n    a = ap.parse_args()\n    random.seed(a.seed); np.random.seed(a.seed)\n\n    sents = load_sentences(a.path)\n    vocab = Vocab(sents, a.min_count)\n    model = NGram(vocab, a.order, base_clip=a.base_clip)\n    model.fit([[vocab.bos] + vocab.encode(s) + [vocab.eos] for s in sents])\n\n    need_circuit = a.dots != \"none\" or a.diagnose or a.sim_report or a.explain or a.trace or a.plot_curves\n    circ = build_circuit(sents, vocab, a) if need_circuit else None\n\n    if a.sim_report:   # the original simulator's regime check, on this graph\n        vol, _ = load_volume(a.mri, a.downsample)\n        coords, n = build_graph(vol, a.voxel_threshold, a.edges_path + \".sim\")\n        W = load_adjacency(a.edges_path + \".sim\", n)\n        seed = int(np.argmin(coords[:, 0]))\n        gain = a.gain if a.gain > 0 else 1.5 * a.fire_threshold / float(W.data.mean())\n        for name, kw in ((\"repo params (gain 0.4)\", dict(gain=0.4)),\n                         (f\"auto gain {gain:.2f}\", dict(gain=gain))):\n            for label, si in ((\"single pulse\", 0), (\"self-stim\", 6)):\n                act, fire = simulate_activity(W, seed, steps=30, decay=a.decay,\n                                              thr=a.fire_threshold, stim_interval=si, **kw)\n                print(f\"[sim] {name:22s} {label:12s} peak active {max(act):6d}  peak firing {max(fire):6d}\")\n\n    gen = Gen(max_len=a.max_len, temp=a.temp, top_k=a.top_k, target_entropy=a.target_entropy,\n              beam=a.beam, min_len=a.min_len, length_alpha=a.length_alpha,\n              anchor_amp=a.anchor, anchor_decay=a.anchor_decay,\n              anchor_interval=a.anchor_interval, dots=a.dots, beta=a.beta, slack=a.slack,\n              fb=a.fb, fb_window=a.fb_window, fb_decay=a.fb_decay,\n              curves=a.curves, curve_stride=a.curve_stride,\n              eos_guard=not a.no_eos_guard)\n\n    def show_context(c):\n        print(f\"  {c['word']:12s} node {c['xyz']}  {c['region']}, {c['band']}  \"\n              f\"intensity {c['intensity']:.2f}  footprint {c['footprint']} nodes \"\n              f\"(mean intensity {c['footprint_intensity']:.2f})\")\n        print(\"               nearest through the wiring: \" +\n              (\", \".join(f\"{w} {v:.2f}\" for w, v in c[\"neighbours\"]) or \"none\"))\n        if c[\"curve\"] is not None:\n            print(f\"               noodle context curve |{sparkline(c['curve'][::2])}|  \"\n                  f\"half-life {c['half_life']} steps, mean length {c['noodle_len']:.1f}\")\n\n    if a.explain:\n        explain_tokens = explain_words(a.explain)\n        print(\"[explain] per-word MRI context (node = grid coordinates after downsampling)\")\n        for word in explain_tokens:\n            c = word_context(circ, vocab, word, top=5) if circ else None\n            if c:\n                show_context(c)\n            else:\n                print(f\"  {word:12s} no circuit vector (function word, rare, or out of vocabulary)\")\n\n    if a.plot_curves and circ is not None:\n        explain_tokens = explain_words(a.explain)\n        plot_words = (\n            explain_tokens\n            if explain_tokens\n            else [\n                t for t in resolve_prompt(vocab, TOKEN_RE.findall((a.prompt or \"\").lower()))[0]\n                if t in vocab.stoi\n            ][:6]\n        )\n        plot_curves(a.plot_curves, circ, vocab, plot_words, a)\n\n    if a.calibrate:\n        w = calibrate_beam(model, vocab, sents, circ)\n        print(f\"calibrated beam width: {w} (matches a width-64 reference); use --beam {w}\")\n\n    def run(prompt):\n        oov, note = set(), None\n        for k in range(a.n):\n            tr = [] if (a.trace and k == 0 and a.beam == 0) else None\n            text, o, note = complete(model, vocab, prompt, gen, circ, tr)\n            oov.update(o)\n            print(\" \", text)\n            if tr:\n                print(\"  per-word MRI context (bias = dot-product logit boost this word received):\")\n                for tok, b in tr:\n                    c = word_context(circ, vocab, vocab.itos[tok]) if circ else None\n                    where = (f\"{c['region']}, {c['band'].split(' ')[0]}, footprint {c['footprint']}\"\n                             + (f\", noodle half-life {c['half_life']}\" if c[\"half_life\"] is not None else \"\")\n                             if c else \"no circuit vector\")\n                    print(f\"    {vocab.itos[tok]:12s} bias {b:5.2f}   {where}\")\n        if note:\n            print(f\"  ({note})\")\n        if oov:\n            print(f\"  (not in vocab, treated as <unk>: {sorted(oov)})\")\n        if a.diagnose:\n            diagnose(model, vocab, prompt, gen, circ)\n\n    if a.prompt:\n        run(a.prompt)\n    if a.interactive:\n        print(\"interactive mode: type a prompt, empty line to quit\")\n        while True:\n            try:\n                line = input(\"> \").strip()\n            except (EOFError, KeyboardInterrupt):\n                break\n            if not line:\n                break\n            try:\n                run(line)\n            except ValueError as e:\n                print(f\"  ({e})\")\n\n\nif __name__ == \"__main__\":\n    main()\n"}, "message": "Full neural_llm.py with larger circuit vocab, stem aliasing, and unseen-word resolution applied", "integration_name": "File Creation", "integration_icon_url": null, "tool_identifier": null, "icon_name": "file", "context": null, "display_content": {"type": "json_block", "json_block": "{\"language\": \"python\", \"code\": \"#!/usr/bin/env python3\\n\\\"\\\"\\\"neural_llm.py -- MRI neural-circuit simulator + Markov text generator in one file.\\n\\nPipeline\\n  1. MRI volume -> voxel graph (edges streamed to disk, read back via np.memmap)\\n  2. Corpus co-occurrence (PPMI) -> 3-D coordinates -> each content token is\\n     placed on a brain node (nearest node in the largest connected component)\\n  3. A pulse at each token's node is propagated through the circuit\\n     (leaky threshold-gated dynamics from the simulator). The accumulated\\n     activity is that token's response vector r_i.\\n  4. DOT PRODUCTS:  G[i, j] = r_i . r_j   (unit-norm rows, so cosine similarity\\n     through the brain's wiring). G is extracted once and cached.\\n  5. PER-WORD MRI CONTEXT: every word keeps its own context read off the scan:\\n     where its node sits (region), the local tissue intensity, how far its\\n     pulse spreads (footprint), and its nearest words through the wiring.\\n     `--explain WORD` prints it; `--trace` prints it for each generated word.\\n  6. NOODLE CONTEXT CURVES: noodles (streamlines) are traced through the scan from\\n     each word's node, following the local structure-tensor orientation. A\\n     noodle ends when it leaves tissue, turns too sharply, or hits a region with\\n     no tube-like structure. The share of a word's noodles still alive after k\\n     steps is that word's context curve S_w(k): how long its context carries\\n     forward. NOTE: this is a T1 scan (no diffusion data), so the noodles follow\\n     image structure and are NOT anatomical fibre tracts.\\n  7. Decoding: the prompt's content words act as a self-stimulating seed\\n     (bias = beta * level(t) * normalise(G @ prompt), re-pulsed every few steps).\\n     With `--fb`, every word generated so far also injects its OWN response\\n     vector into the circuit state, weighted by that word's noodle curve at its\\n     age (`--curves exp` swaps in a plain exponential decay), so the context\\n     evolves word by word instead of being fixed by the prompt.\\n\\nWord recognition\\n  * Up to --circuit-vocab content words get their own brain vector.\\n  * Inflections of those words (rivers/river, flowing/flow) are aliased onto\\n    their sibling's vector via a crude suffix stemmer.\\n  * Unseen prompt words are matched to a known word by shared stem, then by\\n    close spelling (difflib), before falling back to <unk>.\\n\\nOther generation controls: entropy-targeted temperature, direct leaky anchor,\\nbeam search (heapq + linked-list paths + exact state dedup), min-len,\\nfeasibility-based length floor, beam calibration, and an ablation `--diagnose`\\nthat compares: no bias / direct anchor / PPMI dots (no brain) / circuit dots.\\n\\n  python neural_llm.py data.txt --prompt \\\"the old river\\\" --dots circuit --beta 6\\n  python neural_llm.py data.txt --prompt \\\"the old river\\\" --diagnose --beta 6\\n  python neural_llm.py data.txt --explain river ocean --plot-curves curves.png\\n  python neural_llm.py data.txt --prompt \\\"the old river\\\" --dots circuit --fb 0.5 --trace\\n  python neural_llm.py data.txt --sim-report --calibrate\\n  python neural_llm.py data.txt --interactive --dots circuit --target-entropy 1.5\\n\\\"\\\"\\\"\\nimport argparse\\nimport difflib\\nimport heapq\\nimport json\\nimport os\\nimport random\\nimport re\\nfrom collections import Counter, defaultdict, deque\\nfrom dataclasses import dataclass, replace\\n\\nimport numpy as np\\nimport scipy.sparse as sp\\nfrom scipy.sparse.csgraph import connected_components\\nfrom scipy.sparse.linalg import svds\\nfrom scipy.spatial import cKDTree\\n\\nPAD, UNK, BOS, EOS = \\\"<pad>\\\", \\\"<unk>\\\", \\\"<bos>\\\", \\\"\\\"\\nTOKEN_RE = re.compile(r\\\"[a-z0-9']+|[.,!?;:]\\\")\\nSENT_SPLIT = re.compile(r\\\"(?<=[.!?])\\\\s+|\\\\n{2,}\\\")\\nWORD_RE = re.compile(r\\\"[a-z0-9']\\\")\\n\\n_SUFFIXES = (\\\"ing\\\", \\\"ed\\\", \\\"es\\\", \\\"s\\\", \\\"ly\\\")\\n\\n\\ndef stem(w):\\n    \\\"\\\"\\\"Crude suffix stripper: enough to link rivers/river, flowing/flow.\\\"\\\"\\\"\\n    for suf in _SUFFIXES:\\n        if suf == \\\"s\\\" and w.endswith(\\\"ss\\\"):      # glass != glas\\n            continue\\n        if w.endswith(suf) and len(w) - len(suf) >= 3:\\n            return w[:-len(suf)]\\n    return w\\n\\n\\ndef explain_words(values):\\n    \\\"\\\"\\\"Expand one or more command-line values into individual explainable words.\\\"\\\"\\\"\\n    words = []\\n    for value in values or []:\\n        words.extend(TOKEN_RE.findall(value.lower()))\\n    return words\\n\\n\\nEDGE_DTYPE = np.dtype([(\\\"src\\\", \\\"<u4\\\"), (\\\"dst\\\", \\\"<u4\\\"), (\\\"w\\\", \\\"<f4\\\")])\\n\\n\\n# ===========================================================================\\n# PART 1 -- NEURAL CIRCUIT: MRI -> graph -> dynamics\\n# ===========================================================================\\ndef synthesize_volume(shape=(60, 60, 40), seed=0):\\n    \\\"\\\"\\\"Stand-in brain (ellipsoid + smooth texture) when no MRI file is present.\\\"\\\"\\\"\\n    rng = np.random.default_rng(seed)\\n    z, y, x = np.meshgrid(*[np.linspace(-1, 1, s) for s in shape], indexing=\\\"ij\\\")\\n    body = (x ** 2 / 0.8 + y ** 2 / 0.9 + z ** 2 / 0.8) < 1\\n    tex = rng.normal(size=shape).astype(np.float32)\\n    for _ in range(2):\\n        tex = (tex + np.roll(tex, 1, 0) + np.roll(tex, 1, 1) + np.roll(tex, 1, 2)) / 4\\n    return np.clip(0.6 + 0.5 * tex, 0, 1) * body\\n\\n\\ndef load_volume(path, downsample=4):\\n    \\\"\\\"\\\"Real NIfTI scan, downsampled and robustly normalised (99th percentile).\\n    Returns (volume, axis_codes); codes come from the scan's affine, e.g. ('R','A','S').\\\"\\\"\\\"\\n    if path and os.path.exists(path):\\n        import nibabel as nib\\n        img = nib.load(path)\\n        data = img.get_fdata().astype(np.float32)[::downsample, ::downsample, ::downsample]\\n        codes = tuple(nib.aff2axcodes(img.affine))\\n        return np.clip(data / np.percentile(data[data > 0], 99), 0, 1), codes\\n    print(f\\\"[circuit] MRI '{path}' not found; using a synthetic volume (region labels nominal)\\\")\\n    return synthesize_volume(), (\\\"R\\\", \\\"A\\\", \\\"S\\\")\\n\\n\\ndef build_graph(vol, threshold, edges_path):\\n    \\\"\\\"\\\"Vectorised: tissue voxels -> nodes; 6-neighbour edges written to disk.\\\"\\\"\\\"\\n    mask = vol > threshold\\n    n = int(mask.sum())\\n    idx = np.full(vol.shape, -1, np.int64)\\n    idx[mask] = np.arange(n)\\n    coords = np.argwhere(mask)                    # same C-order as idx assignment\\n    src, dst, wts = [], [], []\\n    for ax in range(3):\\n        a, b = [slice(None)] * 3, [slice(None)] * 3\\n        a[ax], b[ax] = slice(None, -1), slice(1, None)\\n        ia, ib = idx[tuple(a)], idx[tuple(b)]\\n        ok = (ia >= 0) & (ib >= 0)\\n        w = 1.0 - np.abs(vol[tuple(a)] - vol[tuple(b)])\\n        src.append(ia[ok]); dst.append(ib[ok]); wts.append(w[ok])\\n    s, d, w = np.concatenate(src), np.concatenate(dst), np.concatenate(wts)\\n    rec = np.empty(2 * len(s), EDGE_DTYPE)        # both directions\\n    rec[\\\"src\\\"], rec[\\\"dst\\\"], rec[\\\"w\\\"] = np.r_[s, d], np.r_[d, s], np.r_[w, w]\\n    rec.tofile(edges_path)\\n    return coords, n\\n\\n\\ndef load_adjacency(edges_path, n):\\n    rec = np.memmap(edges_path, dtype=EDGE_DTYPE, mode=\\\"r\\\")   # disk-backed, lazy\\n    return sp.csr_matrix((np.asarray(rec[\\\"w\\\"], np.float32),\\n                          (np.asarray(rec[\\\"src\\\"]), np.asarray(rec[\\\"dst\\\"]))), shape=(n, n))\\n\\n\\ndef step_dynamics(A, W, decay, gain, thr):\\n    \\\"\\\"\\\"One step of the simulator rule: nodes above `thr` fire and push\\n    gain * w * activity to neighbours; everything leaks by `decay`.\\\"\\\"\\\"\\n    fire = np.where(A > thr, A, 0.0)\\n    return np.minimum(decay * A + gain * (W @ fire), 3.0).astype(np.float32)\\n\\n\\ndef simulate_activity(W, seed, steps=60, decay=0.6, gain=0.4, thr=0.55,\\n                      stim_interval=0, amp=1.0):\\n    \\\"\\\"\\\"Single pulse (stim_interval=0) or periodic self-stimulation at `seed`.\\n    Returns (active node counts, firing node counts) per step.\\\"\\\"\\\"\\n    a = np.zeros((W.shape[0], 1), np.float32)\\n    a[seed] = amp\\n    active, firing = [int((a > 0).sum())], [int((a > thr).sum())]\\n    for t in range(steps):\\n        a = step_dynamics(a, W, decay, gain, thr)\\n        if stim_interval and (t + 1) % stim_interval == 0:\\n            a[seed] += amp\\n        active.append(int((a > 0).sum())); firing.append(int((a > thr).sum()))\\n    return active, firing\\n\\n\\ndef circuit_responses(W, seed_nodes, steps, decay, gain, thr, batch=64, prune=1e-3):\\n    \\\"\\\"\\\"Response vector of each seed: activity integrated over `steps`, as sparse\\n    unit-norm rows. Batched dense propagation keeps memory flat.\\\"\\\"\\\"\\n    N, chunks = W.shape[0], []\\n    for s in range(0, len(seed_nodes), batch):\\n        sn = seed_nodes[s:s + batch]\\n        A = np.zeros((N, len(sn)), np.float32)\\n        A[sn, np.arange(len(sn))] = 1.0\\n        acc = A.copy()\\n        for _ in range(steps):\\n            A = step_dynamics(A, W, decay, gain, thr)\\n            acc += A\\n        acc[acc < prune] = 0\\n        chunks.append(sp.csr_matrix(acc.T))\\n    R = sp.vstack(chunks).tocsr()\\n    norm = np.sqrt(np.asarray(R.multiply(R).sum(axis=1)).ravel()) + 1e-8\\n    return sp.diags(1.0 / norm) @ R\\n\\n\\n# ===========================================================================\\n# PART 2 -- CORPUS + VOCAB + N-GRAM\\n# ===========================================================================\\ndef detok(tokens):\\n    return re.sub(r\\\"\\\\s+([.,!?;:])\\\", r\\\"\\\\1\\\", \\\" \\\".join(tokens))\\n\\n\\ndef load_sentences(path):\\n    text = open(path, encoding=\\\"utf-8\\\").read().lower()\\n    sents = [TOKEN_RE.findall(c) for c in SENT_SPLIT.split(text)]\\n    return [s for s in sents if len(s) >= 2]\\n\\n\\nclass Vocab:\\n    def __init__(self, sents, min_count=1):\\n        counts = Counter(t for s in sents for t in s)\\n        kept = sorted((t for t, c in counts.items() if c >= min_count),\\n                      key=lambda t: (-counts[t], t))\\n        self.itos = [PAD, UNK, BOS, EOS] + kept\\n        self.stoi = {t: i for i, t in enumerate(self.itos)}\\n        self.V = len(self.itos)\\n        self.pad, self.unk, self.bos, self.eos = range(4)\\n        self.counts = np.zeros(self.V)\\n        for t in kept:\\n            self.counts[self.stoi[t]] = counts[t]\\n        self.by_stem = {}\\n        for i in range(4, self.V):                # itos is frequency-sorted\\n            self.by_stem.setdefault(stem(self.itos[i]), i)\\n\\n    def encode(self, toks):\\n        return [self.stoi.get(t, self.unk) for t in toks]\\n\\n    def resolve(self, tok):\\n        \\\"\\\"\\\"Known word -> itself. Otherwise try a shared stem, then a close spelling.\\n        Returns a vocabulary token or None.\\\"\\\"\\\"\\n        if tok in self.stoi:\\n            return tok\\n        if not WORD_RE.match(tok) or len(tok) < 4:\\n            return None\\n        i = self.by_stem.get(stem(tok))\\n        if i is not None:\\n            return self.itos[i]\\n        m = difflib.get_close_matches(tok, self.itos[4:], n=1, cutoff=0.85)\\n        return m[0] if m else None\\n\\n\\nclass NGram:\\n    \\\"\\\"\\\"Interpolated n-gram; order = number of previous tokens used.\\\"\\\"\\\"\\n\\n    def __init__(self, vocab, order=2, lam=0.7, k=0.01, base_clip=100.0):\\n        self.v, self.order, self.lam, self.k = vocab, order, lam, k\\n        self.base_clip = base_clip\\n        self.tables = [defaultdict(Counter) for _ in range(order + 1)]\\n\\n    def fit(self, seqs):\\n        for seq in seqs:\\n            for t in range(1, len(seq)):\\n                for n in range(min(self.order, t) + 1):\\n                    self.tables[n][tuple(seq[t - n:t])][seq[t]] += 1\\n        base = self.v.counts.copy()\\n        base[self.v.eos] = len(seqs)\\n        if self.base_clip < 100:\\n            pos = base[base > 0]\\n            base = np.minimum(base, np.percentile(pos, self.base_clip))\\n        base += self.k\\n        base[[self.v.pad, self.v.bos, self.v.unk]] = 0.0\\n        self.base = base / base.sum()\\n\\n    def dist(self, ctx):\\n        p = self.base\\n        ctx = tuple(ctx[-self.order:]) if self.order else ()\\n        for n in range(len(ctx) + 1):\\n            c = self.tables[n].get(ctx[len(ctx) - n:] if n else ())\\n            if c:\\n                vec = np.zeros(self.v.V)\\n                for tok, cnt in c.items():\\n                    vec[tok] = cnt\\n                p = self.lam * vec / vec.sum() + (1 - self.lam) * p\\n        return p\\n\\n    def logits(self, ctx):\\n        lg = np.log(np.maximum(self.dist(ctx), 1e-300))\\n        lg[[self.v.pad, self.v.bos, self.v.unk]] = -np.inf\\n        return lg\\n\\n\\n# ===========================================================================\\n# PART 3 -- DOT-PRODUCT EXTRACTION: token placement on the brain + G matrix\\n# ===========================================================================\\n@dataclass\\nclass Circuit:\\n    ids: np.ndarray        # vocab ids that have their own circuit vector\\n    row_of: np.ndarray     # vocab id -> row in G (or -1); inflections alias a sibling's row\\n    G: np.ndarray          # circuit dot products  r_i . r_j   (diag = 0)\\n    Gp: np.ndarray         # ablation: PPMI-cosine dots, no brain (diag = 0)\\n    ppmi: np.ndarray       # raw PPMI (used only by the diagnostic metric)\\n    stats: dict\\n    info: dict = None      # per-word MRI context arrays (see word_context)\\n\\n\\ndef rank01(x):\\n    return np.argsort(np.argsort(x, kind=\\\"stable\\\"), kind=\\\"stable\\\") / max(len(x) - 1, 1)\\n\\n\\ndef noodle_field(vol, mask, tube_pct=25.0, sigma_grad=1.0, sigma_int=2.0):\\n    \\\"\\\"\\\"Structure-tensor orientation field. For each tissue voxel: the direction of least\\n    intensity variation (along a noodle) and a tube-ness score (~1 tube-like, ~0 plane or\\n    isotropic). The stopping threshold is a percentile of the scan's own tube-ness, because\\n    the absolute scale depends on resolution and contrast.\\\"\\\"\\\"\\n    from scipy.ndimage import gaussian_filter\\n    sm = gaussian_filter(vol, sigma_grad)\\n    g = np.stack(np.gradient(sm), -1)\\n    J = np.empty(vol.shape + (3, 3), np.float32)\\n    for i in range(3):\\n        for j in range(i, 3):\\n            J[..., i, j] = J[..., j, i] = gaussian_filter(g[..., i] * g[..., j], sigma_int)\\n    w, v = np.linalg.eigh(J[mask])                       # eigenvalues ascending\\n    direction = np.zeros(vol.shape + (3,), np.float32)\\n    direction[mask] = v[:, :, 0]\\n    tube = np.zeros(vol.shape, np.float32)\\n    tube[mask] = (w[:, 1] - w[:, 0]) / (w[:, 2] + 1e-9)\\n    return dict(dir=direction, tube=tube, mask=mask,\\n                thr=float(np.percentile(tube[mask], tube_pct)))\\n\\n\\ndef trace_noodles(field, seeds, K=16, L=24, max_angle=70.0, seed=0, paths=False):\\n    \\\"\\\"\\\"Trace K noodles from each seed (grid coords, shape (n,3)) for up to L unit steps.\\n    Returns survival S of shape (n, L+1): S[w, k] = share of word w's noodles still alive\\n    after k steps (S[:,0] = 1). With paths=True also returns positions/alive for plotting.\\\"\\\"\\\"\\n    rng = np.random.default_rng(seed)\\n    n, shape = len(seeds), np.array(field[\\\"mask\\\"].shape)\\n    pos = np.repeat(np.asarray(seeds, np.float64), K, 0) + rng.normal(0, 0.7, (n * K, 3))\\n    sign = np.tile([1.0, -1.0], (n * K + 1) // 2)[:n * K]     # half go each way\\n    cos_lim = np.cos(np.deg2rad(max_angle))\\n    alive, prev = np.ones(n * K, bool), None\\n    surv = [alive.reshape(n, K).mean(1)]\\n    hist, ahist = [pos.copy()], [alive.copy()]\\n    for _ in range(L):\\n        idt = tuple(np.clip(np.rint(pos).astype(int), 0, shape - 1).T)\\n        d = field[\\\"dir\\\"][idt].astype(np.float64) * sign[:, None]\\n        ok = field[\\\"mask\\\"][idt] & (field[\\\"tube\\\"][idt] >= field[\\\"thr\\\"])\\n        if prev is not None:\\n            dot = (d * prev).sum(1)\\n            d[dot < 0] *= -1                                   # orientation has no sign\\n            ok &= np.abs(dot) >= cos_lim\\n        alive &= ok\\n        pos, prev = pos + d, d\\n        surv.append(alive.reshape(n, K).mean(1))\\n        hist.append(pos.copy()); ahist.append(alive.copy())\\n    S = np.array(surv).T.astype(np.float32)\\n    if paths:\\n        return S, dict(pos=np.array(hist).reshape(L + 1, n, K, 3),\\n                       alive=np.array(ahist).reshape(L + 1, n, K))\\n    return S\\n\\n\\n_SPARK = \\\" \\u2581\\u2582\\u2583\\u2584\\u2585\\u2586\\u2587\\u2588\\\"\\n\\n\\ndef sparkline(v):\\n    return \\\"\\\".join(_SPARK[int(round(min(max(x, 0), 1) * 8))] for x in v)\\n\\n\\n_AXIS_NAMES = {\\\"R\\\": (\\\"right\\\", \\\"left\\\"), \\\"L\\\": (\\\"left\\\", \\\"right\\\"),\\n               \\\"A\\\": (\\\"anterior\\\", \\\"posterior\\\"), \\\"P\\\": (\\\"posterior\\\", \\\"anterior\\\"),\\n               \\\"S\\\": (\\\"superior\\\", \\\"inferior\\\"), \\\"I\\\": (\\\"inferior\\\", \\\"superior\\\")}\\n_AXIS_ORDER = {\\\"right\\\": 0, \\\"left\\\": 0, \\\"anterior\\\": 1, \\\"posterior\\\": 1, \\\"superior\\\": 2, \\\"inferior\\\": 2}\\n\\n\\ndef region_label(xyz, mid, codes):\\n    \\\"\\\"\\\"Coarse octant name from voxel position and the scan's axis codes.\\\"\\\"\\\"\\n    parts = [_AXIS_NAMES[c][0] if xyz[k] > mid[k] else _AXIS_NAMES[c][1]\\n             for k, c in enumerate(codes)]\\n    return \\\"-\\\".join(sorted(parts, key=_AXIS_ORDER.get))\\n\\n\\ndef word_context_table(R, seeds, coords_all, vals, keep_cc, codes):\\n    \\\"\\\"\\\"Per-word context read from the scan: seed position/region/tissue band and\\n    the footprint of the word's pulse (size, centroid, mean intensity).\\\"\\\"\\\"\\n    mid = (keep_cc.min(0) + keep_cc.max(0)) / 2\\n    lo, hi = np.percentile(vals[vals > 0], [33, 67])\\n    seed_int = vals[seeds]\\n    # relative thirds of this scan's tissue intensities (not a tissue classification)\\n    band = np.where(seed_int < lo, \\\"low intensity\\\",\\n                    np.where(seed_int < hi, \\\"mid intensity\\\", \\\"high intensity\\\"))\\n    mass = np.asarray(R.sum(axis=1)).ravel() + 1e-8\\n    return dict(\\n        xyz=coords_all[seeds].astype(np.int32),\\n        seed_int=seed_int.astype(np.float32),\\n        band=band.astype(\\\"U32\\\"),\\n        region=np.array([region_label(coords_all[n], mid, codes) for n in seeds], dtype=\\\"U40\\\"),\\n        foot_n=np.diff(R.indptr).astype(np.int32),\\n        foot_cent=((R @ coords_all.astype(np.float64)) / mass[:, None]).astype(np.float32),\\n        foot_int=((R @ vals.astype(np.float64)) / mass).astype(np.float32))\\n\\n\\ndef word_context(circ, vocab, word, top=5):\\n    \\\"\\\"\\\"Everything the MRI says about one word, or None if it has no circuit vector.\\n    Inflections share their sibling's vector, so they report the sibling's context.\\\"\\\"\\\"\\n    i = vocab.stoi.get(word, -1)\\n    r = circ.row_of[i] if i >= 0 else -1\\n    if r < 0 or not circ.info:\\n        return None\\n    f = circ.info\\n    nb = np.argsort(-circ.G[r])[:top]\\n    curve = f[\\\"curve\\\"][r] if \\\"curve\\\" in f else None\\n    below = np.flatnonzero(curve < 0.5) if curve is not None else []\\n    return dict(word=word, curve=curve,\\n                half_life=(int(below[0]) if len(below) else len(curve) - 1) if curve is not None else None,\\n                noodle_len=float(curve[1:].sum()) if curve is not None else None,\\n                word_=word, xyz=tuple(int(v) for v in f[\\\"xyz\\\"][r]),\\n                intensity=float(f[\\\"seed_int\\\"][r]), band=str(f[\\\"band\\\"][r]),\\n                region=str(f[\\\"region\\\"][r]), footprint=int(f[\\\"foot_n\\\"][r]),\\n                centroid=tuple(round(float(v), 1) for v in f[\\\"foot_cent\\\"][r]),\\n                footprint_intensity=float(f[\\\"foot_int\\\"][r]),\\n                neighbours=[(vocab.itos[circ.ids[j]], float(circ.G[r, j])) for j in nb if circ.G[r, j] > 0])\\n\\n\\ndef build_circuit(sents, vocab, a):\\n    skip = set(np.argsort(-vocab.counts)[:a.skip_top].tolist())\\n    cand = [i for i in range(4, vocab.V)\\n            if i not in skip and WORD_RE.match(vocab.itos[i])\\n            and vocab.counts[i] >= a.circuit_min_count]\\n    ids = np.array(sorted(cand, key=lambda i: -vocab.counts[i])[:a.circuit_vocab])\\n    if len(ids) < 8:\\n        print(\\\"[circuit] too few content tokens; circuit disabled\\\")\\n        return None\\n    Vc = len(ids)\\n    row_of = np.full(vocab.V, -1, np.int64)\\n    row_of[ids] = np.arange(Vc)\\n\\n    # --- PPMI over sentence co-occurrence (float32 to keep the dense Vc x Vc matrices small)\\n    r, c = [], []\\n    for si, s in enumerate(sents):\\n        for t in set(vocab.encode(s)):\\n            if row_of[t] >= 0:\\n                r.append(si); c.append(row_of[t])\\n    X = sp.csr_matrix((np.ones(len(r), np.float32), (r, c)), shape=(len(sents), Vc))\\n    C = (X.T @ X).toarray().astype(np.float32)\\n    np.fill_diagonal(C, 0)\\n    rs = C.sum(1, keepdims=True)\\n    tot = np.float32(C.sum(dtype=np.float64))\\n    with np.errstate(divide=\\\"ignore\\\", invalid=\\\"ignore\\\"):\\n        pmi = np.log(C * tot / (rs * rs.T))\\n    del C\\n    P = np.where(np.isfinite(pmi) & (pmi > 0), pmi, 0).astype(np.float32)\\n    del pmi\\n    Pn = P / (np.linalg.norm(P, axis=1, keepdims=True) + 1e-8)\\n    Gp = (Pn @ Pn.T).astype(np.float32)\\n    np.fill_diagonal(Gp, 0)\\n    del Pn\\n\\n    # --- alias inflections of circuit words onto their sibling's row (done after PPMI so\\n    #     co-occurrence counts aren't merged; function words in `skip` are never aliased)\\n    by_stem = {}\\n    for i in ids:\\n        by_stem.setdefault(stem(vocab.itos[i]), row_of[i])\\n    for i in range(4, vocab.V):\\n        if row_of[i] < 0 and i not in skip and WORD_RE.match(vocab.itos[i]):\\n            rr = by_stem.get(stem(vocab.itos[i]))\\n            if rr is not None:\\n                row_of[i] = rr\\n    print(f\\\"[circuit] {int((row_of >= 0).sum())} vocab words resolve to a circuit vector \\\"\\n          f\\\"({Vc} direct, rest via stems)\\\")\\n\\n    # cache keyed by every parameter that affects G\\n    nd = dict(L=getattr(a, \\\"noodle_steps\\\", 24), K=getattr(a, \\\"noodle_count\\\", 16),\\n              ang=getattr(a, \\\"noodle_angle\\\", 70.0), pct=getattr(a, \\\"noodle_tube_pct\\\", 25.0))\\n    sig = json.dumps(dict(v=4, nd=nd, mri=a.mri, ds=a.downsample, vt=a.voxel_threshold, steps=a.steps,\\n                          decay=a.decay, gain=a.gain, fire=a.fire_threshold,\\n                          toks=[vocab.itos[i] for i in ids]), sort_keys=True)\\n    if a.dots_cache and os.path.exists(a.dots_cache):\\n        z = np.load(a.dots_cache, allow_pickle=False)\\n        if str(z[\\\"sig\\\"]) == sig:\\n            print(f\\\"[circuit] loaded cached dot products from {a.dots_cache}\\\")\\n            info = {k[5:]: z[k] for k in z.files if k.startswith(\\\"info_\\\")}\\n            return Circuit(ids, row_of, z[\\\"G\\\"], Gp, P, dict(cached=True, tokens=Vc), info)\\n\\n    # --- brain graph\\n    vol, codes = load_volume(a.mri, a.downsample)\\n    coords, n = build_graph(vol, a.voxel_threshold, a.edges_path)\\n    vals = vol[tuple(coords.T)]\\n    W = load_adjacency(a.edges_path, n)\\n    ncomp, lab = connected_components(W, directed=False)\\n    keep = np.flatnonzero(lab == np.bincount(lab).argmax())\\n    wbar = float(W.data.mean())\\n    gain = a.gain if a.gain > 0 else 1.5 * a.fire_threshold / wbar   # sharp-transition rule\\n    print(f\\\"[circuit] volume {vol.shape}: {n} nodes, {W.nnz} directed edges, \\\"\\n          f\\\"largest component {len(keep)}/{n}, mean edge weight {wbar:.2f}, \\\"\\n          f\\\"gain {gain:.2f} (spreads only if gain*w > threshold {a.fire_threshold})\\\")\\n\\n    # --- place tokens on the brain: PPMI -> 3 SVD dims -> uniform [0,1] -> bbox -> nearest node\\n    Ps = sp.csr_matrix(P).astype(np.float64)       # PPMI is sparse; avoids a dense float64 copy\\n    U, S, _ = svds(Ps, k=3, v0=np.random.default_rng(0).normal(size=Vc))  # seeded: reproducible placement\\n    pos = np.stack([rank01(v) for v in (U * S).T], axis=1)\\n    cc = coords[keep].astype(np.float64)\\n    target = cc.min(0) + pos * (cc.max(0) - cc.min(0))\\n    seeds = keep[cKDTree(cc).query(target)[1]]\\n\\n    # --- circuit responses -> dot products\\n    R = circuit_responses(W, seeds, a.steps, a.decay, gain, a.fire_threshold)\\n    G = (R @ R.T).toarray().astype(np.float32)\\n    np.fill_diagonal(G, 0)\\n    info = word_context_table(R, seeds, coords, vals, cc, codes)\\n    field = noodle_field(vol, vol > a.voxel_threshold, nd[\\\"pct\\\"])\\n    info[\\\"curve\\\"] = trace_noodles(field, coords[seeds], nd[\\\"K\\\"], nd[\\\"L\\\"], nd[\\\"ang\\\"])\\n    hl = [(np.flatnonzero(c < 0.5)[:1].tolist() or [nd[\\\"L\\\"]])[0] for c in info[\\\"curve\\\"]]\\n    print(f\\\"[noodles] {nd['K']} noodles/word, {nd['L']} steps: context half-life \\\"\\n          f\\\"min/median/max = {min(hl)}/{int(np.median(hl))}/{max(hl)} steps \\\"\\n          f\\\"(tube-ness stop threshold {field['thr']:.3f})\\\")\\n    nnz = np.diff(R.indptr)\\n    stats = dict(nodes=n, tokens=Vc, median_active_nodes=int(np.median(nnz)),\\n                 frac_of_brain=float(np.median(nnz) / n), gain=gain)\\n    print(f\\\"[circuit] extracted {Vc}x{Vc} dot products; each token's response covers \\\"\\n          f\\\"~{stats['median_active_nodes']} nodes ({100 * stats['frac_of_brain']:.2f}% of brain)\\\")\\n    if stats[\\\"median_active_nodes\\\"] < 10:\\n        print(\\\"[circuit] warning: pulses are not spreading; raise --gain or lower --fire-threshold\\\")\\n    if a.dots_cache:\\n        np.savez(a.dots_cache, G=G, sig=sig, **{\\\"info_\\\" + k: v for k, v in info.items()})\\n    return Circuit(ids, row_of, G, Gp, P, stats, info)\\n\\n\\ndef expand_bias(circ, vocab, s):\\n    \\\"\\\"\\\"Row scores -> full-vocab bias, robustly normalised to [0, 1].\\n    Aliased inflections share their sibling's score.\\\"\\\"\\\"\\n    pos = s[s > 0]\\n    if not pos.size:\\n        return None\\n    x = np.clip(s / np.percentile(pos, 99), 0, 1)\\n    full = np.zeros(vocab.V, np.float32)\\n    has = circ.row_of >= 0\\n    full[has] = x[circ.row_of[has]]\\n    return full\\n\\n\\ndef prompt_bias(circ, vocab, toks, source):\\n    \\\"\\\"\\\"Dot products between the prompt's content tokens and every token,\\n    robustly normalised to [0, 1] and expanded to the full vocabulary.\\\"\\\"\\\"\\n    if circ is None or source == \\\"none\\\":\\n        return None\\n    M = circ.G if source == \\\"circuit\\\" else circ.Gp\\n    rows = [circ.row_of[vocab.stoi[t]] for t in toks\\n            if t in vocab.stoi and circ.row_of[vocab.stoi[t]] >= 0]\\n    if not rows:\\n        return None\\n    return expand_bias(circ, vocab, M[:, rows].sum(axis=1))\\n\\n\\ndef context_bias(circ, M, vocab, gen_ids, decay, curves=False, stride=3):\\n    \\\"\\\"\\\"Word-by-word context: each recently generated word injects its own circuit\\n    response; its weight at age `a` is its noodle curve S_w(a*stride) (curves=True)\\n    or decay**a. Returns the normalised dot-product bias.\\\"\\\"\\\"\\n    u = np.zeros(len(circ.ids), np.float32)\\n    C = circ.info[\\\"curve\\\"] if curves else None\\n    for age, tok in enumerate(reversed(gen_ids)):\\n        r = circ.row_of[tok]\\n        if r >= 0:\\n            u[r] += C[r, min(age * stride, C.shape[1] - 1)] if curves else decay ** age\\n    if not u.any():\\n        return None\\n    return expand_bias(circ, vocab, M @ u)\\n\\n\\n# ===========================================================================\\n# PART 4 -- DECODING\\n# ===========================================================================\\n@dataclass\\nclass Gen:\\n    max_len: int = 40\\n    temp: float = 0.9\\n    top_k: int = 40\\n    target_entropy: float = 0.0\\n    beam: int = 0\\n    min_len: int = 0\\n    length_alpha: float = 0.7\\n    anchor_amp: float = 0.0       # direct leaky logit bias on prompt words\\n    anchor_decay: float = 0.9\\n    anchor_interval: int = 16\\n    dots: str = \\\"none\\\"            # none | circuit | ppmi\\n    beta: float = 6.0             # logit strength of the dot-product bias\\n    fb: float = 1.0               # >0: generated words feed their own MRI context back in\\n    fb_window: int = 4            # only the last N generated words contribute\\n    fb_decay: float = 0.7         # newest word weight 1, then decay^age\\n    curves: str = \\\"noodle\\\"        # noodle | exp  (per-word MRI curve vs plain exponential decay)\\n    curve_stride: int = 3         # noodle steps per word of age\\n    eos_guard: bool = True        # keep P(end-of-text) unchanged when a bias boosts other words\\n    slack: int = 20\\n\\n\\ndef entropy(logits, temp):\\n    z = logits / temp\\n    p = np.exp(z - z.max())\\n    p /= p.sum()\\n    nz = p[p > 0]\\n    return float(-(nz * np.log(nz)).sum())\\n\\n\\ndef temperature_for_entropy(logits, target, lo=0.05, hi=3.0, iters=24):\\n    for _ in range(iters):\\n        mid = (lo + hi) / 2\\n        lo, hi = (mid, hi) if entropy(logits, mid) < target else (lo, mid)\\n    return (lo + hi) / 2\\n\\n\\ndef top_k_mask(lg, k):\\n    if 0 < k < len(lg):\\n        lg = np.where(lg < np.partition(lg, -k)[-k], -np.inf, lg)\\n    return lg\\n\\n\\ndef pick(lg, gen):\\n    lg = top_k_mask(lg, gen.top_k)\\n    t = (temperature_for_entropy(lg, gen.target_entropy)\\n         if gen.target_entropy > 0 else max(gen.temp, 1e-3))\\n    p = np.exp(lg / t - (lg / t).max())\\n    return int(np.random.choice(len(p), p=p / p.sum())), t\\n\\n\\nclass LeakySchedule:\\n    \\\"\\\"\\\"Self-stimulation: level leaks by `decay` each step and is re-pulsed by\\n    `amp` every `interval` steps (precomputed so beams share it).\\\"\\\"\\\"\\n\\n    def __init__(self, amp, decay, interval, n):\\n        level, self.levels = amp, []\\n        for t in range(n):\\n            self.levels.append(level)\\n            level *= decay\\n            if (t + 1) % interval == 0:\\n                level += amp\\n\\n    def level(self, t):\\n        return self.levels[min(t, len(self.levels) - 1)]\\n\\n\\ndef anchor_ids(vocab, toks, skip_top=20):\\n    common = set(np.argsort(-vocab.counts)[:skip_top].tolist())\\n    return sorted({vocab.stoi[t] for t in toks if t in vocab.stoi and WORD_RE.match(t)\\n                   and vocab.stoi[t] not in common})\\n\\n\\ndef materialize(node):\\n    out = []\\n    while node is not None:\\n        tok, node = node\\n        out.append(tok)\\n    return out[::-1]\\n\\n\\ndef log_softmax(lg):\\n    m = lg.max()\\n    return lg - (m + np.log(np.exp(lg - m).sum()))\\n\\n\\ndef beam_search(step_fn, ctx0, eos, max_new, width, top_k, alpha, state_len):\\n    \\\"\\\"\\\"state_len = how many trailing tokens fully determine the future (model order,\\n    or the feedback window if larger), so merging beams on that tail is exact.\\\"\\\"\\\"\\n    path0 = None\\n    for t in ctx0:\\n        path0 = (t, path0)\\n    beam, done = [(0.0, path0)], []\\n    for step in range(max_new):\\n        cands = {}\\n        for score, path in beam:\\n            seq = materialize(path)\\n            logp = log_softmax(step_fn(seq))\\n            k = min(top_k if top_k > 0 else 16, len(logp) - 1)\\n            for tok in np.argpartition(-logp, k)[:k]:\\n                if not np.isfinite(logp[tok]):\\n                    continue\\n                tok = int(tok)\\n                s, newp = score + float(logp[tok]), (tok, path)\\n                if tok == eos:\\n                    done.append((s / (step + 1) ** alpha, newp))\\n                    continue\\n                tail = tuple(seq[-(state_len - 1):] + [tok]) if state_len > 1 else (tok,)\\n                if tail not in cands or s > cands[tail][0]:\\n                    cands[tail] = (s, newp)\\n        if not cands or len(done) >= width:\\n            break\\n        beam = heapq.nlargest(width, cands.values(), key=lambda c: c[0])\\n    pool = done or [(s / max_new ** alpha, p) for s, p in beam]\\n    out = materialize(max(pool, key=lambda c: c[0])[1])[len(ctx0):]\\n    return out[:-1] if out and out[-1] == eos else out\\n\\n\\ndef min_steps_to_eos(model, vocab, start):\\n    \\\"\\\"\\\"Shortest observed path from `start` to end-of-text (feasibility + length floor).\\\"\\\"\\\"\\n    if model.order < 1:\\n        return None\\n    graph, seen, q = model.tables[1], {start}, deque([(start, 0)])\\n    while q:\\n        s, d = q.popleft()\\n        nxt = graph.get((s,))\\n        if not nxt:\\n            continue\\n        if vocab.eos in nxt:\\n            return d + 1\\n        for n in nxt:\\n            if n not in seen:\\n                seen.add(n); q.append((n, d + 1))\\n    return None\\n\\n\\ndef generate(model, vocab, toks, gen, circ=None, trace=None):\\n    \\\"\\\"\\\"trace (list, sampling mode only) receives (token_id, bias_applied_to_it).\\\"\\\"\\\"\\n    ctx0 = [vocab.bos] + vocab.encode(toks)\\n    anchors = anchor_ids(vocab, toks) if gen.anchor_amp > 0 else []\\n    a_sched = (LeakySchedule(gen.anchor_amp, gen.anchor_decay, gen.anchor_interval,\\n                             gen.max_len + 1) if anchors else None)\\n    M = None if circ is None else {\\\"circuit\\\": circ.G, \\\"ppmi\\\": circ.Gp}.get(gen.dots)\\n    bp = prompt_bias(circ, vocab, toks, gen.dots)\\n    use_fb = M is not None and gen.fb > 0\\n    use_curves = (gen.curves == \\\"noodle\\\" and circ is not None and bool(circ.info)\\n                  and \\\"curve\\\" in circ.info)\\n    d_sched = (LeakySchedule(1.0, gen.anchor_decay, gen.anchor_interval, gen.max_len + 1)\\n               if bp is not None else None)\\n    last = {}\\n\\n    def step(seq):\\n        t = len(seq) - len(ctx0)\\n        lg = model.logits(seq)\\n        if t < gen.min_len:\\n            lg[vocab.eos] = -np.inf\\n        if a_sched:\\n            lg[anchors] += a_sched.level(t)\\n        b = None\\n        if bp is not None:\\n            b = d_sched.level(t) * bp\\n        if use_fb:\\n            f = context_bias(circ, M, vocab, seq[len(ctx0):][-gen.fb_window:], gen.fb_decay,\\n                             use_curves, gen.curve_stride)\\n            if f is not None:\\n                b = gen.fb * f if b is None else b + gen.fb * f\\n        if b is not None:\\n            if gen.eos_guard and t >= gen.min_len:\\n                # keep P(end-of-text) unchanged: shift it by the log-ratio of the other\\n                # words' probability mass after vs before the boost\\n                p = np.exp(lg - lg.max())\\n                p[vocab.eos] = 0.0\\n                if p.sum() > 0:\\n                    lg[vocab.eos] += np.log((p * np.exp(gen.beta * b)).sum() / p.sum())\\n            lg += gen.beta * b\\n        last[\\\"b\\\"] = b\\n        return lg\\n\\n    if gen.beam > 0:\\n        state_len = max(model.order, 1, gen.fb_window if use_fb else 0)\\n        return beam_search(step, ctx0, vocab.eos, gen.max_len, gen.beam,\\n                           gen.top_k, gen.length_alpha, state_len), []\\n    ctx, out, temps = list(ctx0), [], []\\n    for _ in range(gen.max_len):\\n        nxt, t = pick(step(ctx), gen)\\n        if nxt == vocab.eos:\\n            break\\n        if trace is not None:\\n            trace.append((nxt, 0.0 if last[\\\"b\\\"] is None else float(last[\\\"b\\\"][nxt])))\\n        out.append(nxt); ctx.append(nxt); temps.append(t)\\n    return out, temps\\n\\n\\ndef resolve_prompt(vocab, toks):\\n    \\\"\\\"\\\"Map each prompt token to a known word where possible.\\n    Returns (resolved tokens, list of 'typed\\u2192matched' strings).\\\"\\\"\\\"\\n    resolved, mapped = [], []\\n    for t in toks:\\n        r = vocab.resolve(t)\\n        if r is not None and r != t:\\n            mapped.append(f\\\"{t}\\u2192{r}\\\")\\n        resolved.append(r if r is not None else t)\\n    return resolved, mapped\\n\\n\\ndef complete(model, vocab, prompt, gen, circ=None, trace=None):\\n    toks = TOKEN_RE.findall(prompt.lower())\\n    if not toks:\\n        raise ValueError(\\\"prompt has no usable tokens\\\")\\n    resolved, mapped = resolve_prompt(vocab, toks)\\n    ids = vocab.encode(resolved)\\n    oov = [t for t, i in zip(toks, ids) if i == vocab.unk]\\n    d = min_steps_to_eos(model, vocab, ids[-1])\\n    note = None\\n    if d is None:\\n        note = \\\"no observed path to end-of-text from the last prompt token\\\"\\n    else:\\n        gen = replace(gen, max_len=max(gen.max_len, d + gen.slack))\\n    out, _ = generate(model, vocab, resolved, gen, circ, trace)\\n    if mapped:\\n        note = (note + \\\"; \\\" if note else \\\"\\\") + \\\"matched unseen words: \\\" + \\\", \\\".join(mapped)\\n    return detok(toks + [vocab.itos[i] for i in out]), oov, note\\n\\n\\ndef calibrate_beam(model, vocab, sents, circ=None, widths=(1, 2, 4, 8, 16, 32), ref=64,\\n                   n_prompts=6, max_len=25, top_k=20):\\n    rng = random.Random(0)\\n    starts = [s[:2] for s in rng.sample(sents, min(n_prompts, len(sents)))]\\n\\n    def run(w):\\n        g = Gen(max_len=max_len, top_k=top_k, beam=w)\\n        return [tuple(generate(model, vocab, s, g, circ)[0]) for s in starts]\\n\\n    reference = run(ref)\\n    return next((w for w in widths if run(w) == reference), ref)\\n\\n\\ndef diagnose(model, vocab, prompt, gen, circ, n=30):\\n    \\\"\\\"\\\"Ablation. Metric = mean PPMI between generated content words and the prompt's\\n    content words (a direct corpus statistic). Caveat: PPMI also builds both dot-product\\n    sources, so the 'ppmi' arm is favoured by construction; use a labelled-topic corpus\\n    for an independent check.\\\"\\\"\\\"\\n    toks, _ = resolve_prompt(vocab, TOKEN_RE.findall(prompt.lower()))\\n    prompt_rows = [circ.row_of[vocab.stoi[t]] for t in toks\\n                   if t in vocab.stoi and circ.row_of[vocab.stoi[t]] >= 0] if circ else []\\n    anchors = set(anchor_ids(vocab, toks))\\n    base = replace(gen, anchor_amp=0.0, dots=\\\"none\\\", beam=0)\\n    arms = [(\\\"none\\\", base), (\\\"anchor\\\", replace(base, anchor_amp=gen.anchor_amp or 2.0))]\\n    if circ is not None and prompt_rows:\\n        fb = gen.fb or 0.5\\n        arms += [(\\\"ppmi dots\\\", replace(base, dots=\\\"ppmi\\\")),\\n                 (\\\"circuit dots\\\", replace(base, dots=\\\"circuit\\\")),\\n                 (\\\"circuit+exp ctx\\\", replace(base, dots=\\\"circuit\\\", fb=fb, curves=\\\"exp\\\")),\\n                 (\\\"circuit+noodle ctx\\\", replace(base, dots=\\\"circuit\\\", fb=fb, curves=\\\"noodle\\\"))]\\n    print(f\\\"  {'arm':18s} {'prompt-PMI':>10s} {'anchor-rate':>11s} {'mean len':>8s}\\\")\\n    for label, g in arms:\\n        pm, hits, total = [], 0, 0\\n        for _ in range(n):\\n            out, _ = generate(model, vocab, toks, g, circ)\\n            hits += sum(o in anchors for o in out)\\n            total += len(out)\\n            if circ is not None and prompt_rows:\\n                rows = [circ.row_of[o] for o in out if circ.row_of[o] >= 0]\\n                if rows:\\n                    pm.append(circ.ppmi[np.ix_(rows, prompt_rows)].mean())\\n        print(f\\\"  {label:18s} {np.mean(pm) if pm else float('nan'):10.3f} \\\"\\n              f\\\"{hits / max(total, 1):11.4f} {total / n:8.1f}\\\")\\n\\n\\ndef plot_curves(path, circ, vocab, words, a, K=12):\\n    \\\"\\\"\\\"Left: each word's context curve S_w(k). Right: its noodles in 3-D over the brain.\\\"\\\"\\\"\\n    import matplotlib\\n    matplotlib.use(\\\"Agg\\\")\\n    import matplotlib.pyplot as plt\\n    from mpl_toolkits.mplot3d import Axes3D  # noqa: F401\\n    ctxs = [c for c in (word_context(circ, vocab, w) for w in words) if c]\\n    if not ctxs:\\n        print(\\\"[plot] none of the words has a circuit vector\\\")\\n        return\\n    vol, _ = load_volume(a.mri, a.downsample)\\n    mask = vol > a.voxel_threshold\\n    field = noodle_field(vol, mask, getattr(a, \\\"noodle_tube_pct\\\", 25.0))\\n    seeds = np.array([c[\\\"xyz\\\"] for c in ctxs])\\n    L = len(ctxs[0][\\\"curve\\\"]) - 1\\n    _, tr = trace_noodles(field, seeds, K, L, getattr(a, \\\"noodle_angle\\\", 70.0), paths=True)\\n    fig = plt.figure(figsize=(13, 5.2))\\n    ax = fig.add_subplot(1, 2, 1)\\n    for c in ctxs:\\n        ax.plot(c[\\\"curve\\\"], label=f\\\"{c['word']} (half-life {c['half_life']})\\\", lw=2)\\n    ax.set_xlabel(\\\"noodle step k\\\"); ax.set_ylabel(\\\"share of noodles alive  S(k)\\\")\\n    ax.set_title(\\\"per-word context curves\\\"); ax.legend(fontsize=8); ax.set_ylim(0, 1.02)\\n    ax3 = fig.add_subplot(1, 2, 2, projection=\\\"3d\\\")\\n    cloud = np.argwhere(mask)\\n    cloud = cloud[np.random.default_rng(0).choice(len(cloud), min(3000, len(cloud)), replace=False)]\\n    ax3.scatter(cloud[:, 2], cloud[:, 1], cloud[:, 0], c=\\\"lightgray\\\", s=1, alpha=0.12)\\n    for wi, c in enumerate(ctxs):\\n        color = f\\\"C{wi}\\\"\\n        for k in range(K):\\n            live = tr[\\\"alive\\\"][:, wi, k]\\n            pts = tr[\\\"pos\\\"][live, wi, k]\\n            if len(pts) > 1:\\n                ax3.plot(pts[:, 2], pts[:, 1], pts[:, 0], color=color, lw=1.2, alpha=0.8)\\n        ax3.scatter(*seeds[wi][[2, 1, 0]], color=color, s=40, edgecolors=\\\"k\\\")\\n    ax3.set_title(\\\"noodles from each word's node\\\"); ax3.set_xlabel(\\\"x\\\"); ax3.set_ylabel(\\\"y\\\"); ax3.set_zlabel(\\\"z\\\")\\n    plt.tight_layout(); plt.savefig(path, dpi=140)\\n    print(f\\\"[plot] saved {path}\\\")\\n\\n\\n# ===========================================================================\\n# CLI\\n# ===========================================================================\\ndef main():\\n    ap = argparse.ArgumentParser(description=__doc__,\\n                                 formatter_class=argparse.RawDescriptionHelpFormatter)\\n    ap.add_argument(\\\"path\\\", help=\\\"training text\\\")\\n    g = ap.add_argument_group(\\\"language model\\\")\\n    g.add_argument(\\\"--order\\\", type=int, default=2)\\n    g.add_argument(\\\"--min-count\\\", type=int, default=1)\\n    g.add_argument(\\\"--base-clip\\\", type=float, default=100.0)\\n    g = ap.add_argument_group(\\\"circuit\\\")\\n    g.add_argument(\\\"--mri\\\", default=\\\"real_brain_mri_t1.nii.gz\\\")\\n    g.add_argument(\\\"--downsample\\\", type=int, default=4)\\n    g.add_argument(\\\"--voxel-threshold\\\", type=float, default=0.2)\\n    g.add_argument(\\\"--edges-path\\\", default=\\\"connectivity_edges.bin\\\")\\n    g.add_argument(\\\"--steps\\\", type=int, default=4, help=\\\"propagation steps per token pulse\\\")\\n    g.add_argument(\\\"--decay\\\", type=float, default=0.6)\\n    g.add_argument(\\\"--gain\\\", type=float, default=0.0, help=\\\"0 = auto (1.5 x threshold / mean weight)\\\")\\n    g.add_argument(\\\"--fire-threshold\\\", type=float, default=0.55)\\n    g.add_argument(\\\"--circuit-vocab\\\", type=int, default=8000,\\n                   help=\\\"max content words with their own brain vector (dense Vc x Vc matrices: memory ~ Vc^2)\\\")\\n    g.add_argument(\\\"--circuit-min-count\\\", type=int, default=2)\\n    g.add_argument(\\\"--skip-top\\\", type=int, default=20)\\n    g.add_argument(\\\"--dots-cache\\\", default=None)\\n    g.add_argument(\\\"--sim-report\\\", action=\\\"store_true\\\")\\n    g.add_argument(\\\"--noodle-steps\\\", type=int, default=24)\\n    g.add_argument(\\\"--noodle-count\\\", type=int, default=16, help=\\\"noodles traced per word\\\")\\n    g.add_argument(\\\"--noodle-angle\\\", type=float, default=70.0, help=\\\"max turn per step, degrees\\\")\\n    g.add_argument(\\\"--noodle-tube-pct\\\", type=float, default=25.0,\\n                   help=\\\"noodles stop where tube-ness is below this percentile of the scan\\\")\\n    g = ap.add_argument_group(\\\"decoding\\\")\\n    g.add_argument(\\\"--dots\\\", choices=[\\\"none\\\", \\\"circuit\\\", \\\"ppmi\\\"], default=\\\"none\\\")\\n    g.add_argument(\\\"--beta\\\", type=float, default=6.0)\\n    g.add_argument(\\\"--fb\\\", type=float, default=1.0, help=\\\"word-by-word MRI context strength (0=off)\\\")\\n    g.add_argument(\\\"--fb-window\\\", type=int, default=4)\\n    g.add_argument(\\\"--fb-decay\\\", type=float, default=0.7, help=\\\"decay for --curves exp\\\")\\n    g.add_argument(\\\"--curves\\\", choices=[\\\"noodle\\\", \\\"exp\\\"], default=\\\"noodle\\\")\\n    g.add_argument(\\\"--curve-stride\\\", type=int, default=3, help=\\\"noodle steps per word of age\\\")\\n    g.add_argument(\\\"--n\\\", type=int, default=1)\\n    g.add_argument(\\\"--temp\\\", type=float, default=0.9)\\n    g.add_argument(\\\"--top-k\\\", type=int, default=40)\\n    g.add_argument(\\\"--max-len\\\", type=int, default=400)\\n    g.add_argument(\\\"--min-len\\\", type=int, default=0)\\n    g.add_argument(\\\"--target-entropy\\\", type=float, default=0.0)\\n    g.add_argument(\\\"--anchor\\\", type=float, default=0.0)\\n    g.add_argument(\\\"--anchor-decay\\\", type=float, default=0.9)\\n    g.add_argument(\\\"--anchor-interval\\\", type=int, default=16)\\n    g.add_argument(\\\"--beam\\\", type=int, default=0)\\n    g.add_argument(\\\"--length-alpha\\\", type=float, default=0.7)\\n    g.add_argument(\\\"--slack\\\", type=int, default=20)\\n    ap.add_argument(\\\"--explain\\\", nargs=\\\"+\\\", metavar=\\\"WORD\\\", help=\\\"print each word's MRI context\\\")\\n    ap.add_argument(\\\"--plot-curves\\\", metavar=\\\"PNG\\\", help=\\\"plot context curves + noodles for --explain words (or prompt words)\\\")\\n    ap.add_argument(\\\"--trace\\\", action=\\\"store_true\\\", help=\\\"per-word MRI context of the first completion\\\")\\n    ap.add_argument(\\\"--no-eos-guard\\\", action=\\\"store_true\\\", help=\\\"let the bias change the stopping probability\\\")\\n    ap.add_argument(\\\"--calibrate\\\", action=\\\"store_true\\\")\\n    ap.add_argument(\\\"--diagnose\\\", action=\\\"store_true\\\")\\n    ap.add_argument(\\\"--prompt\\\", default=None)\\n    ap.add_argument(\\\"--interactive\\\", action=\\\"store_true\\\")\\n    ap.add_argument(\\\"--seed\\\", type=int, default=42)\\n    a = ap.parse_args()\\n    random.seed(a.seed); np.random.seed(a.seed)\\n\\n    sents = load_sentences(a.path)\\n    vocab = Vocab(sents, a.min_count)\\n    model = NGram(vocab, a.order, base_clip=a.base_clip)\\n    model.fit([[vocab.bos] + vocab.encode(s) + [vocab.eos] for s in sents])\\n\\n    need_circuit = a.dots != \\\"none\\\" or a.diagnose or a.sim_report or a.explain or a.trace or a.plot_curves\\n    circ = build_circuit(sents, vocab, a) if need_circuit else None\\n\\n    if a.sim_report:   # the original simulator's regime check, on this graph\\n        vol, _ = load_volume(a.mri, a.downsample)\\n        coords, n = build_graph(vol, a.voxel_threshold, a.edges_path + \\\".sim\\\")\\n        W = load_adjacency(a.edges_path + \\\".sim\\\", n)\\n        seed = int(np.argmin(coords[:, 0]))\\n        gain = a.gain if a.gain > 0 else 1.5 * a.fire_threshold / float(W.data.mean())\\n        for name, kw in ((\\\"repo params (gain 0.4)\\\", dict(gain=0.4)),\\n                         (f\\\"auto gain {gain:.2f}\\\", dict(gain=gain))):\\n            for label, si in ((\\\"single pulse\\\", 0), (\\\"self-stim\\\", 6)):\\n                act, fire = simulate_activity(W, seed, steps=30, decay=a.decay,\\n                                              thr=a.fire_threshold, stim_interval=si, **kw)\\n                print(f\\\"[sim] {name:22s} {label:12s} peak active {max(act):6d}  peak firing {max(fire):6d}\\\")\\n\\n    gen = Gen(max_len=a.max_len, temp=a.temp, top_k=a.top_k, target_entropy=a.target_entropy,\\n              beam=a.beam, min_len=a.min_len, length_alpha=a.length_alpha,\\n              anchor_amp=a.anchor, anchor_decay=a.anchor_decay,\\n              anchor_interval=a.anchor_interval, dots=a.dots, beta=a.beta, slack=a.slack,\\n              fb=a.fb, fb_window=a.fb_window, fb_decay=a.fb_decay,\\n              curves=a.curves, curve_stride=a.curve_stride,\\n              eos_guard=not a.no_eos_guard)\\n\\n    def show_context(c):\\n        print(f\\\"  {c['word']:12s} node {c['xyz']}  {c['region']}, {c['band']}  \\\"\\n              f\\\"intensity {c['intensity']:.2f}  footprint {c['footprint']} nodes \\\"\\n              f\\\"(mean intensity {c['footprint_intensity']:.2f})\\\")\\n        print(\\\"               nearest through the wiring: \\\" +\\n              (\\\", \\\".join(f\\\"{w} {v:.2f}\\\" for w, v in c[\\\"neighbours\\\"]) or \\\"none\\\"))\\n        if c[\\\"curve\\\"] is not None:\\n            print(f\\\"               noodle context curve |{sparkline(c['curve'][::2])}|  \\\"\\n                  f\\\"half-life {c['half_life']} steps, mean length {c['noodle_len']:.1f}\\\")\\n\\n    if a.explain:\\n        explain_tokens = explain_words(a.explain)\\n        print(\\\"[explain] per-word MRI context (node = grid coordinates after downsampling)\\\")\\n        for word in explain_tokens:\\n            c = word_context(circ, vocab, word, top=5) if circ else None\\n            if c:\\n                show_context(c)\\n            else:\\n                print(f\\\"  {word:12s} no circuit vector (function word, rare, or out of vocabulary)\\\")\\n\\n    if a.plot_curves and circ is not None:\\n        explain_tokens = explain_words(a.explain)\\n        plot_words = (\\n            explain_tokens\\n            if explain_tokens\\n            else [\\n                t for t in resolve_prompt(vocab, TOKEN_RE.findall((a.prompt or \\\"\\\").lower()))[0]\\n                if t in vocab.stoi\\n            ][:6]\\n        )\\n        plot_curves(a.plot_curves, circ, vocab, plot_words, a)\\n\\n    if a.calibrate:\\n        w = calibrate_beam(model, vocab, sents, circ)\\n        print(f\\\"calibrated beam width: {w} (matches a width-64 reference); use --beam {w}\\\")\\n\\n    def run(prompt):\\n        oov, note = set(), None\\n        for k in range(a.n):\\n            tr = [] if (a.trace and k == 0 and a.beam == 0) else None\\n            text, o, note = complete(model, vocab, prompt, gen, circ, tr)\\n            oov.update(o)\\n            print(\\\" \\\", text)\\n            if tr:\\n                print(\\\"  per-word MRI context (bias = dot-product logit boost this word received):\\\")\\n                for tok, b in tr:\\n                    c = word_context(circ, vocab, vocab.itos[tok]) if circ else None\\n                    where = (f\\\"{c['region']}, {c['band'].split(' ')[0]}, footprint {c['footprint']}\\\"\\n                             + (f\\\", noodle half-life {c['half_life']}\\\" if c[\\\"half_life\\\"] is not None else \\\"\\\")\\n                             if c else \\\"no circuit vector\\\")\\n                    print(f\\\"    {vocab.itos[tok]:12s} bias {b:5.2f}   {where}\\\")\\n        if note:\\n            print(f\\\"  ({note})\\\")\\n        if oov:\\n            print(f\\\"  (not in vocab, treated as <unk>: {sorted(oov)})\\\")\\n        if a.diagnose:\\n            diagnose(model, vocab, prompt, gen, circ)\\n\\n    if a.prompt:\\n        run(a.prompt)\\n    if a.interactive:\\n        print(\\\"interactive mode: type a prompt, empty line to quit\\\")\\n        while True:\\n            try:\\n                line = input(\\\"> \\\").strip()\\n            except (EOFError, KeyboardInterrupt):\\n                break\\n            if not line:\\n                break\\n            try:\\n                run(line)\\n            except ValueError as e:\\n                print(f\\\"  ({e})\\\")\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\", \"filename\": \"/mnt/user-data/outputs/neural_llm.py\"}"}, "approval_options": null, "approval_key": null, "approval_key_legacy": null, "is_mcp_app": null, "hidden_in_chat": null, "mcp_server_url": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-10-06T21:04:44.958016Z", "stop_timestamp": "2026-10-06T21:04:44.958053Z", "flags": null, "type": "tool_result", "tool_use_id": "toolu_01AE5XnrDQqChA4BC4stHcTx", "name": "create_file", "content": [{"type": "text", "text": "File created successfully: /mnt/user-data/outputs/neural_llm.py"}], "is_error": false, "structured_content": null, "meta": {"output_format_category": "other"}, "message": null, "integration_name": "File Creation", "mcp_server_url": null, "integration_icon_url": null, "icon_name": "file", "display_content": {"type": "text", "text": "File created successfully: /mnt/user-data/outputs/neural_llm.py"}, "hidden_in_chat": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-10-06T21:04:46.747792Z", "stop_timestamp": "2026-10-06T21:04:46.986562Z", "flags": null, "type": "tool_use", "id": "toolu_01AqGQZ7xc1mEYd3TbSxPSfU", "name": "present_files", "input": {"filepaths": ["/mnt/user-data/outputs/neural_llm.py"]}, "message": "Presenting file(s)...", "integration_name": "File Creation", "integration_icon_url": null, "tool_identifier": null, "icon_name": "file", "context": null, "display_content": {"type": "table", "table": [["filepaths", "['/mnt/user-data/outputs/neural_llm.py']"]]}, "approval_options": null, "approval_key": null, "approval_key_legacy": null, "is_mcp_app": null, "hidden_in_chat": null, "mcp_server_url": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-10-06T21:04:47.007148Z", "stop_timestamp": "2026-10-06T21:04:47.007179Z", "flags": null, "type": "tool_result", "tool_use_id": "toolu_01AqGQZ7xc1mEYd3TbSxPSfU", "name": "present_files", "content": [{"type": "local_resource", "file_path": "/mnt/user-data/outputs/neural_llm.py", "name": "neural llm", "mime_type": "text/x-python", "artifact_publishable": false}, {"type": "text", "text": "\n\nThe file cards appear at the end of your reply if it ends with text, otherwise under this step; say they are below only if you finish the reply with text."}], "is_error": false, "structured_content": null, "meta": {"output_format_category": "other"}, "message": "Presented file", "integration_name": "File Creation", "mcp_server_url": null, "integration_icon_url": null, "icon_name": "file", "display_content": null, "hidden_in_chat": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-10-06T21:04:50.436989Z", "stop_timestamp": "2026-10-06T21:04:50.446957Z", "flags": null, "type": "text", "text": "I've put the full script in `neural_llm.py` with all three patches applied. I haven't run it.\n\n**Changes beyond the patches:**\n- The file you pasted ended before the code that actually uses `--prompt` and `--interactive`. I added a short block at the end of `main()` that runs the prompt once, then loops on `>` input in interactive mode until you enter an empty line.\n- I added a small `resolve_prompt()` helper so `complete()`, `diagnose()` and `--plot-curves` all match unseen words the same way.\n- `stem()` now skips plain `-s` after `ss`, so `glass` doesn't become `glas`.\n- The docstring now describes the three ways words get recognised.\n\n**Before you run it:**\n- Delete any old `--dots-cache` file. The cache signature is now `v=4` and the token list has changed.\n- If memory is tight, lower `--circuit-vocab` (default is now 8000). The dense matrices grow with its square.", "citations": []}], "sender": "assistant", "created_at": "2026-10-06T21:04:50.526465Z", "updated_at": "2026-10-06T21:04:50.526465Z", "attachments": [], "files": [], "parent_message_uuid": "01a11306-ee53-7925-9380-6caa9b694fbf"}]},{"uuid": "bab6f7f7-741c-4c7a-8875-08d7430fdb38", "name": "Web renderer for self-hosted compiler", "summary": "", "created_at": "2026-10-07T10:12:21.052771Z", "updated_at": "2026-10-11T07:14:40.233090Z", "account": {"uuid": "8d7882cd-3e98-47cc-a6e7-61494a1ee4ac"}, "chat_messages": [{"uuid": "01a115d9-868c-7287-9e31-74ca2b812097", "text": "https://github.com/synthreason-source/OS\n\nmake a basic web renderer for the self hosted compiler as a program source code, then add all the web drivers and comp.h and drivers.h gui.h etc including the web source and editf.c... into the hardrive image.", "content": [{"start_timestamp": "2026-10-07T10:12:22.526707Z", "stop_timestamp": "2026-10-07T10:12:22.526707Z", "flags": null, "type": "text", "text": "https://github.com/synthreason-source/OS\n\nmake a basic web renderer for the self hosted compiler as a program source code, then add all the web drivers and comp.h and drivers.h gui.h etc including the web source and editf.c... into the hardrive image.", "citations": []}], "sender": "human", "created_at": "2026-10-07T10:12:22.526961Z", "updated_at": "2026-10-07T10:12:22.526961Z", "attachments": [], "files": [], "parent_message_uuid": "00000000-0000-4000-8000-000000000000"}, {"uuid": "01a115d9-868c-772a-bb1d-f8f5c365daf1", "text": "I'll start by looking at the repo to see how the compiler, drivers and disk image are structured.\n```\nThis block is not supported on your current device yet.\n```\n\nThe repo's guest programs rely on `comp.h` and `drivers.h`, so I'll clone it and read those interfaces before writing the renderer.\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\nmtools is in. Now I'll build the repo's own `i386-tcc` from the bundled source so I can compile and check the program exactly as `make cc` would.\n```\nThis block is not supported on your current device yet.\n```\n\n`i386-tcc` is built. Now let me see what's on the shipped disk image.\n```\nThis block is not supported on your current device yet.\n```\n\nThe disk image ships empty (a 256 MiB FAT32 volume). Before sizing buffers, I'll check how much memory a guest program gets.\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\nI left a placeholder hack in the script/style skipping. I'll fix it properly by recording which tag opened the skip, then append the rest (drawing, navigation, main loop).\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\nNow the sample pages. `test.htm` doubles as a feature test.\n```\nThis block is not supported on your current device yet.\n```\n\nFirst the real check: compile with the repo's own `i386-tcc` and link with `tcc_guest.ld`, the same steps `make cc` uses.\n```\nThis block is not supported on your current device yet.\n```\n\nIt compiles and links cleanly. One thing worth checking: the entry point is `0x08005d95`, not the start of `.text`, because `_start` is defined last. I'll check whether the kernel honours `e_entry`.\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\nThe shell here doesn't do brace expansion, so the copy failed. Redoing it explicitly.\n```\nThis block is not supported on your current device yet.\n```\n\nThe earlier `&&` chain aborted before writing the mock and harness files, so I'll recreate them.\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\nIt now opens its own source (1275 items). Let me look at the frames.\n```\nThis block is not supported on your current device yet.\n```\n\nLayout, headings, bullets, link colours, the hover highlight and the status-bar link target all work. The \"Back\" label is cramped in its button, so I'll widen the buttons. Now the markup test page.\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\nThe network and error pages work. Applying the fixes now: wider toolbar buttons, a wider `<ol>` indent, and multi-character entities like `&copy;` \u2192 `(c)`.\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\nThe fixes work. Since this parses arbitrary files with no bounds checking from a libc, I'll fuzz the parser/layout with random and malformed input under ASan/UBSan.\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\nNow the injection script (decompress or create the image, compile the ELFs with the `make cc` pipeline, copy everything with `mcopy`), plus a small additive `webdisk` Makefile target.\n```\nThis block is not supported on your current device yet.\n```\n\nThe image is built with 17 files and long names stored as VFAT LFN entries. Let me verify it: byte-for-byte read-back through mtools, and a filesystem consistency check.\n```\nThis block is not supported on your current device yet.\n```\n\nRead-back is byte-identical and `fsck.fat` is clean. The repo ships a prebuilt `main.iso`, so I'll try the real end-to-end test: boot the OS in QEMU with this disk and run `web`.\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\nQEMU is available. I'll boot the repo's `main.iso` with a scratch copy of the new image and grab screenshots through the monitor.\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\nThe OS boots to its desktop. I'll open the Terminal from the taskbar using the QEMU monitor's mouse and keyboard.\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\nQEMU was reaped when the earlier shell call ended. I'll relaunch it detached with `setsid` and drive it in the same session.\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\nThe cursor moved with a different scale than I assumed. I'll steer it closed-loop by locating the cursor in screenshots.\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\nThe cursor moves at 2\u00d7 the requested units, which is easy to compensate for. Moving onto the Terminal button now.\n```\nThis block is not supported on your current device yet.\n```\n\nThe renderer is written and tested on a host harness, and the disk image builds and passes checks. I ran out of tool calls before exporting any files to you, and I never saw `web` run inside the booted OS.\n\n## Not yet done\n- **No download links.** Everything is in my sandbox at `/home/claude/OS` (`web.c`, `www/*.htm`, `mkwebdisk.sh`, a `webdisk` target appended to the Makefile, and the built `disk.img`). Send me another message and I'll package `web.c`, the scripts and a compressed `disk.img.xz` for download.\n- **No test inside the OS.** I booted your `main.iso` in QEMU with the new disk and it reached the desktop. I was still steering the mouse to open the Terminal when I ran out of calls, so the ELF has not been run inside your kernel.\n\n## What I built\n- **`web.c`:** a single-file renderer for the OS's TCC. It reads a page from the FAT32 disk with `kfread`, lays it out, and draws it into the 320\u00d7200 canvas using `comp.h`.\n  - **Markup:** headings, paragraphs, bold/italic/underline, links, nested `ul`/`ol`, `pre`/`code`, blockquote, center, tables (flattened into rows of text), `img` shown as `[alt]`, entities, comments, and skipped `<script>`/`<style>`.\n  - **Controls:** toolbar with Back, Home, a URL box and Go, a scrollbar, and keyboard shortcuts (`q` quit, `h` home, `g` URL box, arrows, Space/b, Backspace for back).\n  - **Other files:** a `.c`, `.h` or `.txt` file opens as plain monospace text, so you can browse `web.c`, `editf.c` and `comp.h` in it.\n- **No network.** Your kernel has no TCP and `drivers.h` gives guest programs no socket calls, so `http://` links show a \"No network access\" page. Real fetching needs a kernel-side ABI first.\n- **Sample pages:** `home.htm`, `about.htm`, `help.htm` and `test.htm`, which exercises every supported tag.\n\n## Disk image (`mkwebdisk.sh`)\n- **Starting point:** your shipped `disk.img.xz` unpacks to an empty 256 MiB FAT32 volume, and the script fills it.\n- **Headers:** `drivers.h`, `bochs_drivers.h`, `driver.h`, `comp.h`, `font.h`, `gui_scene.h`, `gui_render.h`.\n- **Sources:** `web.c`, `editf.c`, `driverkit.c`, so `cc web.c` works inside the OS.\n- **Prebuilt ELFs:** `web`, `editf`, `driverkit`.\n- **Pages:** the four `.htm` files.\n\nYour `make cc` never copies `drivers.h`, but `comp.h` includes it, so in-OS compiles would have failed without it on the disk.\n\n## What I checked\n- **Compile:** `web`, `editf` and `driverkit` build and link with your bundled `i386-tcc` and `tcc_guest.ld`.\n- **Host harness:** the real `comp.h` and `font.h` plus `web.c`, with only port I/O mocked, ran scripted clicks, hover, keys, URL entry, a 404 and the network page cleanly under ASan/UBSan. I looked at the rendered frames and fixed what showed up: ordered-list numbers touching their text, `&copy;` showing as \"c\", and cramped toolbar buttons.\n- **Fuzzing:** 6000 random and malformed inputs ran without overflows.\n- **Disk image:** all 17 files read back byte-for-byte through mtools and `fsck.fat` reported it clean.\n\n## Interpretations and limits\n- **File names:** there is no `gui.h` in the repo, so I used `gui_scene.h` and `gui_render.h`. I read \"web drivers\" as the driver headers and `driverkit.c`.\n- **Editor version:** `editf.c` and `EDITF.C` collide on FAT's case-insensitive names. I shipped the lowercase live-mode editor you named. The static-GUI `EDITF.C` is not on the disk.\n- **Rough edges:** the scrollbar thumb has a fixed size (a `comp.h` limitation), plain-text files hard-wrap at 37 columns, and there is a one-frame lag before the URL box updates after navigation.\n\nTo try it yourself:\n1. Run `make setup-tcc && make webdisk`.\n2. Boot with your QEMU command and run `web` in the terminal.\n\nIf it misbehaves in the real kernel, tell me what you see. The likeliest culprits are the 48 KB static buffers and per-frame cost.", "content": [{"start_timestamp": "2026-10-07T10:12:22.779185Z", "stop_timestamp": "2026-10-07T10:12:23.114745Z", "flags": null, "type": "text", "text": "I'll start by looking at the repo to see how the compiler, drivers and disk image are structured.", "citations": []}, {"start_timestamp": "2026-10-07T10:12:23.114779Z", "stop_timestamp": "2026-10-07T10:12:23.279169Z", "flags": null, "type": "tool_use", "id": "toolu_017R5D9tZ91z5W9HRurfcose", "name": "web_fetch", "input": {"url": "https://github.com/synthreason-source/OS"}, "message": "Fetching: https://github.com/synthreason-source/OS", "integration_name": "Web Fetch", "integration_icon_url": null, "tool_identifier": null, "icon_name": "globe", "context": null, "display_content": null, "approval_options": null, "approval_key": null, "approval_key_legacy": null, "is_mcp_app": null, "hidden_in_cha