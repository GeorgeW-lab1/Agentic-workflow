url, loc, tmp);\n            w_cpy(url, tmp, URL_LEN);\n            continue;''','''            resolve_url(url, loc, tmp);\n            w_cpy(url, tmp, URL_LEN);\n            canon_url(url);\n            continue;''')\n# drop dead tmp assignment in https branch\ns=s.replace('''            w_cpy(tmp, \"http://\", URL_LEN); w_cat(tmp, url + 8, URL_LEN);\n            show_error(\"https is not supported\",''','''            show_error(\"https is not supported\",''')\nopen(p,'w').write(s)\nEOF\ncd /tmp/ht2 && cp /home/claude/OS/web.c . && python3 - <<'EOF'\np='/tmp/ht2/harness.c'\ns=open(p).read()\n# check expectations/dumps at the start of the NEXT frame (final state of previous frame)\ns=s.replace('''void mock_mouse(mouse_state_t*m){\n  memset(m,0,sizeof *m); frames++; cur_key=0; pending_dump=0; pending_expect=0;''','''static void finish_frame(void);\nvoid mock_mouse(mouse_state_t*m){\n  finish_frame();\n  memset(m,0,sizeof *m); frames++; cur_key=0; pending_dump=0; pending_expect=0;''')\na=s.index('int mock_present(void){'); b=s.index('int mock_kfread')\ns=s[:a]+'''static void finish_frame(void){\n  if(pending_expect){ int ok = strcmp(s_cur,pending_expect)==0; if(!ok) fails++;\n    printf(\"%s -> cur='%s'%s%s%s\\\\n\", ok?\"ok  \":\"FAIL\", s_cur, ok?\"\":\"   EXPECTED '\", ok?\"\":pending_expect, ok?\"\":\"'\"); }\n  if(pending_dump){\n    char fn[128]; snprintf(fn,sizeof fn,\"out/%s.ppm\",pending_dump); FILE*f=fopen(fn,\"wb\");\n    fprintf(f,\"P6\\\\n320 200\\\\n255\\\\n\"); for(int i=0;i<320*200;i++){ unsigned c=gfx_framebuffer[i]; fputc(c>>16,f);fputc(c>>8,f);fputc(c>>0,f);} fclose(f);\n    printf(\"      dump %-20s title='%s' items=%d trunc=%d status='%s'\\\\n\",pending_dump,s_title,s_item_n,s_truncated,s_status); }\n  pending_dump=0; pending_expect=0; }\nint mock_present(void){ return 0; }\n'''+s[b:]\ns=s.replace('void mock_exit(int c){ printf(','void mock_exit(int c){ finish_frame(); printf(')\nopen(p,'w').write(s)\nEOF\nsed -i 's#add(E_CLICK,\"Disk\",0,\"14_d