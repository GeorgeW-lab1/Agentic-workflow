void memory bloat.\n    \"\"\"\n    rng = random.Random(seed)\n    print(f\"Generating binary dataset of {n_elements:,} elements to '{filepath}'...\")\n    \n    # Each 32-bit unsigned integer takes 4 bytes on disk\n    with open(filepath, \"wb\") as f:\n        written = 0\n        while written < n_elements:\n            current_batch = min(batch_size, n_elements - written)\n            batch = [rng.randint(1, 100_000_000) for _ in range(current_batch)]\n            # Pack as unsigned 32-bit integers ('I')\n            f.write(struct.pack(f\"<{current_batch}I\", *batch))\n            written += current_batch\n            \n    print(f\"Dataset successfully written ({os.path.getsize(filepath) / (1024*1024):.2f} MB).\\n\")\n\ndef holographic_equation_beam_search_disk(filepath, n, target, r, c=2, max_beam_width=2000):\n    \"\"\"\n    Streams numbers directly from disk using memory-mapping (mmap), \n    ensuring O(1) RAM consumption during the search execution.\n    \"\"\"\n    theoretical_cap = n ** c\n    cap = min(theoretical_cap, max_beam_width)\n\n    target_str = str(target)\n    max_len = len(target_str) + 2\n    target_tensor = number_to_holographic_tensor(target_str, max_len)\n    target_norm = np.linalg.norm(target_tensor)\n\n    beam = [(0, None)]\n\n    # Open file and map into memory for instantaneous disk streaming\n    with open(filepath, \"rb\") as f:\n        with mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ) as mm:\n            for k in range(1, n + 1):\n                # Each integer is 4 bytes; calculate byte offset\n                offset = (k - 1) * 4\n                x = struct.unpack(\"<I\", mm[offset:offset+4])[0]\n\n                seen = {}\n                for partial, node in beam:\n                    if partial not in seen:\n                        seen[partial] = node\n                    new_partial = partial + x\n                    if new_partial <= target and new_partial not in seen:\n                        seen[new_partial] = (x, node)\n\n                if target in seen:\n                    return _materialize(seen[target]), k\n\n                log_width = n * math.log(2) + k * math.log(1 - r)\n                if log_width > math.log(cap):\n                    width = cap\n                else:\n                    width = max(1, min(cap, math.ceil(math.exp(log_width))))\n\n                items = list(seen.items())\n                if len(items) <= width:\n                    beam = items\n                else:\n                    scored_items = []\n                    for partial, node in items:\n                        dist_penalty = abs(target - partial)\n                        resonance = compute_holographic_resonance(partial, target_str, max_len, target_tensor, target_norm)\n                        hybrid_score = dist_penalty - (resonance * 10.0)\n                        scored_items.append((hybrid_score, partial, node))\n                    \n                    best_items = heapq.nsmallest(width, scored_items)\n                    beam = [(partial, node) for _, partial, node in best_items]\n\n    return None, n\n\nif __name__ == \"__main__\":\n    db_path = \"subset_numbers.bin\"\n    n_scale = 1_000_000_000  # Scale up freely based on your available disk space\n    sample_target = 150_000_001\n    auto_r = 0.35\n\n    print(\"=== Holographic Beam Search Pipeline ===\")\n    \n    # Step 1: Automatically check dataset status (prevents accidental overwrites)\n    if os.path.exists(db_path):\n        file_size_mb = os.path.getsize(db_path) / (1024 * 1024)\n        print(f\"[INFO] Dataset already exists at '{db_path}' ({file_size_mb:.2f} MB).\")\n        print(\"[INFO] Skipping generation to protect existing data and save time.\\n\")\n    else:\n        print(f\"[INFO] Dataset not found at '{db_path}'. Creating a new one...\")\n        generate_disk_dataset(db_path, n_scale, seed=42)\n\n    # Step 2: Run beam search via direct disk streaming\n    print(f\"Running disk-streamed beam search across {n_scale:,} records...\")\n    result, steps_used = holographic_equation_beam_search_disk(\n        filepath=db_path,\n        n=n_scale,\n        target=sample_target,\n        r=auto_r,\n        max_beam_width=1000\n    )\n\n    if result:\n        print(f\"\\nResult: Found subset path in {steps_used} steps!\")\n        print(f\"Subset Elements: {result}\")\n        print(f\"Total Sum: {sum(result)} (Target: {sample_target})\")\n    else:\n        print(f\"\\nResult: FAILED (Ran {steps_used} steps)\")\nimport math\nimport random\nimport heapq\nimport numpy as np\nimport struct\nimport os\nimport mmap\n\ndef number_to_holographic_tensor(num_str, max_len):\n    \"\"\"Projects a decimal number string into a 3D holographic cardinal tensor.\"\"\"\n    padded = num_str.zfill(max_len)\n    tensor = np.zeros((max_len, 10, 3), dtype=float)\n    \n    for idx, char in enumerate(padded):\n        digit = int(char)\n        norm_pos = idx / max(1, max_len - 1)\n        \n        tensor[idx, digit, 0] = 1.0 - norm_pos\n        tensor[idx, digit, 1] = np.sin(2.0 * np.pi * (digit / 10.0))\n        tensor[idx, digit, 2] = np.cos(2.0 * np.pi * norm_pos)\n        \n    return tensor\n\ndef compute_holographic_resonance(partial_val, target_str, max_len, target_tensor, target_norm):\n    \"\"\"Computes structural holographic resonance against target tensor field.\"\"\"\n    p_str = str(partial_val)\n    p_tensor = number_to_holographic_tensor(p_str, max_len)\n    p_norm = np.linalg.norm(p_tensor)\n    \n    if p_norm == 0 or target_norm == 0:\n        return 0.0\n        \n    return np.sum(target_tensor * p_tensor) / (target_norm * p_norm)\n\ndef _materialize(node):\n    \"\"\"Walk an immutable path linked-list back to a plain Python list.\"\"\"\n    out = []\n    while node is not None:\n        val, node = node\n        out.append(val)\n    out.reverse()\n    return out\n\ndef generate_disk_dataset(filepath, n_elements, batch_size=500_000, seed=42):\n    \"\"\"\n    Dataset Generator: Streams numbers sequentially to a compact binary file \n    on the hard disk to avoid memory bloat.\n    \"\"\"\n    rng = random.Random(seed)\n    print(f\"Generating binary dataset of {n_elements:,} elements to '{filepath}'...\")\n    \n    # Each 32-bit unsigned integer takes 4 bytes on disk\n    with open(filepath, \"wb\") as f:\n        written = 0\n        while written < n_elements:\n            current_batch = min(batch_size, n_elements - written)\n            batch = [rng.randint(1, 100_000_000) for _ in range(current_batch)]\n            # Pack as unsigned 32-bit integers ('I')\n            f.write(struct.pack(f\"<{current_batch}I\", *batch))\n            written += current_batch\n            \n    print(f\"Dataset successfully written ({os.path.getsize(filepath) / (1024*1024):.2f} MB).\\n\")\n\ndef holographic_equation_beam_search_disk(filepath, n, target, r, c=2, max_beam_width=2000):\n    \"\"\"\n    Streams numbers directly from disk using memory-mapping (mmap), \n    ensuring O(1) RAM consumption during the search execution.\n    \"\"\"\n    theoretical_cap = n ** c\n    cap = min(theoretical_cap, max_beam_width)\n\n    target_str = str(target)\n    max_len = len(target_str) + 2\n    target_tensor = number_to_holographic_tensor(target_str, max_len)\n    target_norm = np.linalg.norm(target_tensor)\n\n    beam = [(0, None)]\n\n    # Open file and map into memory for instantaneous disk streaming\n    with open(filepath, \"rb\") as f:\n        with mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ) as mm:\n            for k in range(1, n + 1):\n                # Each integer is 4 bytes; calculate byte offset\n                offset = (k - 1) * 4\n                x = struct.unpack(\"<I\", mm[offset:offset+4])[0]\n\n                seen = {}\n                for partial, node in beam:\n                    if partial not in seen:\n                        seen[partial] = node\n                    new_partial = partial + x\n                    if new_partial <= target and new_partial not in seen:\n                        seen[new_partial] = (x, node)\n\n                if target in seen:\n                    return _materialize(seen[target]), k\n\n                log_width = n * math.log(2) + k * math.log(1 - r)\n                if log_width > math.log(cap):\n                    width = cap\n                else:\n                    width = max(1, min(cap, math.ceil(math.exp(log_width))))\n\n                items = list(seen.items())\n                if len(items) <= width:\n                    beam = items\n                else:\n                    scored_items = []\n                    for partial, node in items:\n                        dist_penalty = abs(target - partial)\n                        resonance = compute_holographic_resonance(partial, target_str, max_len, target_tensor, target_norm)\n                        hybrid_score = dist_penalty - (resonance * 10.0)\n                        scored_items.append((hybrid_score, partial, node))\n                    \n                    best_items = heapq.nsmallest(width, scored_items)\n                    beam = [(partial, node) for _, partial, node in best_items]\n\n    return None, n\n\nif __name__ == \"__main__\":\n    db_path = \"subset_numbers.bin\"\n    n_scale = 1_000_000_000  # Scale up freely based on your available disk space\n    sample_target = 150_000_001\n    auto_r = 0.35\n\n    print(\"=== Holographic Beam Search Pipeline ===\")\n    \n    # Step 1: Automatically check dataset status (prevents accidental overwrites)\n    if os.path.exists(db_path):\n        file_size_mb = os.path.getsize(db_path) / (1024 * 1024)\n        print(f\"[INFO] Dataset already exists at '{db_path}' ({file_size_mb:.2f} MB).\")\n        print(\"[INFO] Skipping generation to protect existing data and save time.\\n\")\n    else:\n        print(f\"[INFO] Dataset not found at '{db_path}'. Creating a new one...\")\n        generate_disk_dataset(db_path, n_scale, seed=42)\n\n    # Step 2: Run beam search via direct disk streaming\n    print(f\"Running disk-streamed beam search across {n_scale:,} records...\")\n    result, steps_used = holographic_equation_beam_search_disk(\n        filepath=db_path,\n        n=n_scale,\n        target=sample_target,\n        r=auto_r,\n        max_beam_width=1000\n    )\n\n    if result:\n        print(f\"\\nResult: Found subset path in {steps_used} steps!\")\n        print(f\"Subset Elements: {result}\")\n        print(f\"Total Sum: {sum(result)} (Target: {sample_target})\")\n    else:\n        print(f\"\\nResult: FAILED (Ran {steps_used} steps)\")\n\napply the subset sum solver to the dataset load and processing", "citations": []}], "sender": "human", "created_at": "2026-09-30T20:55:55.544635Z", "updated_at": "2026-09-30T20:55:55.544635Z", "attachments": [{"file_name": "", "file_size": 21845, "file_type": "txt", "extracted_content": "#!/usr/bin/env python3\r\n\"\"\"Dynamic frequency-decay text generator.\r\n\r\nExtends the supplied graph/byte/context/mask/copy/knapsack generator with\r\none important change: during generation, every emitted surface word receives\r\na growing frequency penalty. The penalty is applied at each sampling step,\r\nso the probability landscape changes continuously as the stream moves on.\r\n\r\nThe generated-count penalty is reset at sentence boundaries, while the\r\noptional global mode can keep counts for the whole generation.\r\n\"\"\"\r\nimport argparse\r\nimport hashlib\r\nimport math\r\nimport re\r\nimport sys\r\nimport time\r\nfrom collections import Counter, defaultdict\r\n\r\nimport numpy as np\r\nimport scipy.sparse as sp\r\n\r\nimport nltk\r\nfrom nltk.corpus import wordnet\r\n\r\nSEP = 256\r\nSENTENCE_END = {\".\", \"!\", \"?\"}\r\nSOFT_PUNCT = {\",\", \";\", \":\"}\r\nHARD = -30.0\r\nCOPY_MARK = \"#\"\r\nANCHOR_SYNSETS = [wordnet.synset(\"entity.n.01\")]\r\n\r\n\r\ndef nltk_word_value(word, anchor_synsets, default=1e-6):\r\n    synsets = wordnet.synsets(word)\r\n    if not synsets or not anchor_synsets:\r\n        return default\r\n    best = 0.0\r\n    for s in synsets:\r\n        for a in anchor_synsets:\r\n            try:\r\n                sim = s.path_similarity(a)\r\n            except Exception:\r\n                sim = 0.0\r\n            if sim is None:\r\n                sim = 0.0\r\n            best = max(best, sim)\r\n    return max(best, 1e-6)\r\n\r\n\r\ndef surf(token):\r\n    return token.partition(COPY_MARK)[0]\r\n\r\n\r\ndef copy_of(token):\r\n    _, _, c = token.partition(COPY_MARK)\r\n    return int(c) if c else 0\r\n\r\n\r\ndef tag(word, copy):\r\n    return word if copy == 0 else f\"{word}{COPY_MARK}{copy}\"\r\n\r\n\r\ndef shift_token(token, offset, copies):\r\n    return tag(surf(token), (copy_of(token) + offset) % copies)\r\n\r\n\r\ndef link_class(first, second, copies, salt=\"\"):\r\n    digest = hashlib.blake2b(f\"{salt}\\x00{first}\\x00{second}\".encode(\"utf-8\"), digest_size=8).digest()\r\n    return int.from_bytes(digest, \"big\") % copies\r\n\r\n\r\ndef lift_tokens(tokens, copies, salt=\"\"):\r\n    out, copy, previous = [], 0, None\r\n    for t in tokens:\r\n        if previous is not None:\r\n            copy = (copy + link_class(previous, t, copies, salt)) % copies\r\n        out.append(tag(t, copy))\r\n        previous = t\r\n    return out\r\n\r\n\r\ndef lift_prompt(ptoks, tg, copies, salt, rng):\r\n    rel = lift_tokens(ptoks, copies, salt)\r\n    if copies == 1 or not rel:\r\n        return rel\r\n    weights = []\r\n    for o in range(copies):\r\n        shifted = [shift_token(t, o, copies) for t in rel]\r\n        w = 0.0\r\n        if len(shifted) >= 2 and (shifted[-2], shifted[-1]) in tg.tri:\r\n            w = float(sum(tg.tri[(shifted[-2], shifted[-1])].values()))\r\n        elif shifted[-1] in tg.bi:\r\n            w = 0.01 * float(sum(tg.bi[shifted[-1]].values()))\r\n        weights.append(w)\r\n    weights = np.array(weights)\r\n    o = 0 if weights.sum() == 0 else int(rng.choice(copies, p=weights / weights.sum()))\r\n    return [shift_token(t, o, copies) for t in rel]\r\n\r\n\r\ndef partition_report(tokens, lifted, copies, salt):\r\n    seen, distinct, occ = set(), Counter(), Counter()\r\n    for a, b in zip(tokens, tokens[1:]):\r\n        c = link_class(a, b, copies, salt)\r\n        occ[c] += 1\r\n        if (a, b) not in seen:\r\n            seen.add((a, b))\r\n            distinct[c] += 1\r\n    return {\"copies\": copies, \"vocab\": len(set(lifted)), \"distinct_links_per_class\": dict(sorted(distinct.items())), \"occurrences_per_class\": dict(sorted(occ.items())), \"projects_back_to_dataset\": [surf(t) for t in lifted] == tokens}\r\n\r\n\r\ndef subset_table(items):\r\n    W = np.zeros(1, dtype=np.int64)\r\n    V = np.zeros(1)\r\n    M = np.zeros(1, dtype=np.int64)\r\n    for i, (w, v) in enumerate(items):\r\n        W = np.concatenate([W, W + w])\r\n        V = np.concatenate([V, V + v])\r\n        M = np.concatenate([M, M | (1 << i)])\r\n    return W, V, M\r\n\r\n\r\ndef knapsack_mitm(set_a, set_b, budget):\r\n    WA, VA, MA = subset_table(set_a)\r\n    WB, VB, MB = subset_table(set_b)\r\n    oa = np.argsort(WA, kind=\"stable\")\r\n    ob = np.argsort(-WB, kind=\"stable\")\r\n    WA, VA, MA = WA[oa], VA[oa], MA[oa]\r\n    WB, VB, MB = WB[ob], VB[ob], MB[ob]\r\n    nb = len(WB)\r\n    sufv = np.empty(nb)\r\n    sufi = np.empty(nb, dtype=np.int64)\r\n    best_v, best_i = -1.0, 0\r\n    for j in range(nb - 1, -1, -1):\r\n        if VB[j] > best_v:\r\n            best_v, best_i = VB[j], j\r\n        sufv[j], sufi[j] = best_v, best_i\r\n    best = (-1.0, 0, 0)\r\n    j = 0\r\n    for a in range(len(WA)):\r\n        room = budget - WA[a]\r\n        if room < 0:\r\n            break\r\n        while j < nb and WB[j] > room:\r\n            j += 1\r\n        if j == nb:\r\n            break\r\n        total = VA[a] + sufv[j]\r\n        if total > best[0]:\r\n            best = (total, int(MA[a]), int(MB[sufi[j]]))\r\n    return best[0], best[1], best[2], len(WA) + len(WB)\r\n\r\n\r\ndef knapsack_brute(items, budget):\r\n    W, V, _ = subset_table(items)\r\n    return float(V[W <= budget].max())\r\n\r\n\r\ndef solve_agenda(vf, lcounts, copies, pool=18, budget=30, check=False):\r\n    by_surface = defaultdict(list)\r\n    for t in vf.vocab:\r\n        if re.fullmatch(r\"[\\w']+\", surf(t)):\r\n            by_surface[surf(t)].append(t)\r\n    cand = []\r\n    for word, toks in by_surface.items():\r\n        home = max(toks, key=lambda t: (lcounts[t], -copy_of(t)))\r\n        cand.append((word, home, float(vf.field[vf.idx[home]])))\r\n    cand = [c for c in sorted(cand, key=lambda c: -c[2])[:pool] if c[2] > 1e-6]\r\n    halves = ([], [])\r\n    for rank, (word, home, val) in enumerate(cand):\r\n        h = copy_of(home) % 2 if copies >= 2 else rank % 2\r\n        halves[h].append((word, len(word) + 1, val))\r\n    value, ma, mb, ops = knapsack_mitm([(w, v) for _, w, v in halves[0]], [(w, v) for _, w, v in halves[1]], budget)\r\n    words = [halves[0][i][0] for i in range(len(halves[0])) if ma >> i & 1] + [halves[1][i][0] for i in range(len(halves[1])) if mb >> i & 1]\r\n    report = {\"candidates\": len(cand), \"half_A\": len(halves[0]), \"half_B\": len(halves[1]), \"agenda\": words, \"chars\": sum(len(w) + 1 for w in words), \"budget\": budget, \"value\": round(value, 3), \"subsets_examined\": ops, \"brute_force_would_examine\": 2 ** len(cand)}\r\n    if check and len(cand) <= 22:\r\n        brute = knapsack_brute([(len(w) + 1, v) for w, _, v in cand], budget)\r\n        report[\"matches_brute_force\"] = bool(abs(brute - max(value, 0.0)) < 1e-9)\r\n    return words, report\r\n\r\n\r\ndef normalize_rows(M):\r\n    s = np.asarray(M.sum(axis=1)).ravel()\r\n    s[s == 0] = 1.0\r\n    return sp.diags(1.0 / s) @ M if sp.issparse(M) else M / s[:, None]\r\n\r\n\r\ndef word_states(word, k=3):\r\n    seq = (SEP,) + tuple(word.encode(\"utf-8\")) + (SEP,)\r\n    seq = seq + (SEP,) * max(0, k - len(seq))\r\n    return [seq[i:i + k] for i in range(len(seq) - k + 1)]\r\n\r\n\r\nclass ValueField:\r\n    def __init__(self, tokens, values, top=5, hops=3, decay=0.5, mix=0.5, k=3):\r\n        self.k = k\r\n        self.vocab = sorted(set(tokens))\r\n        self.idx = {w: i for i, w in enumerate(self.vocab)}\r\n        n = len(self.vocab)\r\n        C = np.zeros((n, n))\r\n        for a, b in zip(tokens, tokens[1:]):\r\n            C[self.idx[a], self.idx[b]] += 1.0\r\n        X = np.hstack([normalize_rows(C), normalize_rows(C.T)])\r\n        X /= np.maximum(np.linalg.norm(X, axis=1, keepdims=True), 1e-12)\r\n        self.X = X\r\n        S = X @ X.T\r\n        np.fill_diagonal(S, 0.0)\r\n        K = np.zeros_like(S)\r\n        for i in range(n):\r\n            j = np.argsort(S[i])[-top:]\r\n            K[i, j] = S[i, j]\r\n        K = np.maximum(K, K.T)\r\n        d = np.sqrt(np.maximum(K.sum(axis=1), 1e-12))\r\n        Sn = K / np.outer(d, d)\r\n        self.states = {}\r\n        rows, cols, edges = [], [], set()\r\n        for wi, w in enumerate(self.vocab):\r\n            path = [self.states.setdefault(st, len(self.states)) for st in word_states(surf(w), k)]\r\n            rows += [wi] * len(path)\r\n            cols += path\r\n            for a, b in zip(path, path[1:]):\r\n                edges.add((a, b)); edges.add((b, a))\r\n        ns = len(self.states)\r\n        B = normalize_rows(sp.csr_matrix((np.ones(len(rows)), (rows, cols)), shape=(n, ns)))\r\n        er, ec = zip(*edges) if edges else ([], [])\r\n        A = sp.csr_matrix((np.ones(len(er)), (er, ec)), shape=(ns, ns))\r\n        A.data[:] = 1.0\r\n        dd = 1.0 / np.sqrt(np.maximum(np.asarray(A.sum(axis=1)).ravel(), 1e-12))\r\n        Sb = sp.diags(dd) @ A @ sp.diags(dd)\r\n        v0 = np.zeros(n)\r\n        for w, x in values.items():\r\n            if w in self.idx:\r\n                v0[self.idx[w]] = x\r\n        cur, self.field = v0, v0.copy()\r\n        self.tiers = [v0]\r\n        self.state_field = B.T @ v0\r\n        for _ in range(hops):\r\n            via_use = Sn @ cur\r\n            st = Sb @ (B.T @ cur)\r\n            via_bytes = B @ st\r\n            cur = decay * (mix * via_use + (1 - mix) * via_bytes)\r\n            self.state_field = self.state_field + (1 - mix) * decay * st\r\n            self.field = self.field + cur\r\n            self.tiers.append(cur)\r\n\r\n    def read(self, word):\r\n        ids = [self.states[s] for s in word_states(surf(word), self.k) if s in self.states]\r\n        return float(np.mean(self.state_field[ids])) if ids else 0.0\r\n\r\n\r\nclass LogicMask:\r\n    def __init__(self, vf, tokens, n_classes=12, min_len=4, window=6, floor=1e-3, seed=0, iters=15):\r\n        self.vf, self.min_len, self.window, self.floor = vf, min_len, window, floor\r\n        rng = np.random.default_rng(seed)\r\n        n = len(vf.vocab)\r\n        Z = vf.X @ rng.standard_normal((vf.X.shape[1], min(32, vf.X.shape[1])))\r\n        Z /= np.maximum(np.linalg.norm(Z, axis=1, keepdims=True), 1e-12)\r\n        k = max(1, min(n_classes, n))\r\n        cent = Z[rng.choice(n, k, replace=False)].copy()\r\n        lab = np.zeros(n, dtype=int)\r\n        for _ in range(iters):\r\n            lab = np.argmax(Z @ cent.T, axis=1)\r\n            for c in range(k):\r\n                m = lab == c\r\n                if m.any():\r\n                    v = Z[m].mean(axis=0); cent[c] = v / max(np.linalg.norm(v), 1e-12)\r\n        self.END, self.PUNCT, self.BOS = k, k + 1, k + 2\r\n        self.R = k + 2\r\n        self.role = lab.copy()\r\n        for w, i in vf.idx.items():\r\n            if surf(w) in SENTENCE_END: self.role[i] = self.END\r\n            elif surf(w) in SOFT_PUNCT: self.role[i] = self.PUNCT\r\n        self.bi = np.zeros((self.BOS + 1, self.R))\r\n        self.tri = defaultdict(lambda: np.zeros(self.R))\r\n        prev = [self.BOS]\r\n        for t in tokens:\r\n            r = self.role[vf.idx[t]]\r\n            self.bi[prev[-1], r] += 1\r\n            if len(prev) >= 2: self.tri[(prev[-2], prev[-1])][r] += 1\r\n            prev = [self.BOS] if surf(t) in SENTENCE_END else (prev + [r])[-2:]\r\n        rs = self.bi.sum(axis=1, keepdims=True)\r\n        self.p_end = np.where(rs[:, 0] > 0, self.bi[:, self.END] / np.maximum(rs[:, 0], 1), 0.0)\r\n\r\n    def roles_of(self, words):\r\n        return [self.role[self.vf.idx[w]] for w in words if w in self.vf.idx]\r\n\r\n    def bias(self, sent_words, cand_words):\r\n        roles = [self.BOS] + self.roles_of(sent_words)\r\n        last = roles[-1]\r\n        dist = self.tri.get((roles[-2], roles[-1])) if len(roles) >= 2 else None\r\n        if dist is None or dist.sum() == 0: dist = self.bi[last]\r\n        dist = dist / max(dist.sum(), 1e-12)\r\n        recent = {surf(x) for x in sent_words[-self.window:]}\r\n        n_words = sum(1 for w in sent_words if surf(w) not in SOFT_PUNCT)\r\n        out = np.zeros(len(cand_words))\r\n        for i, w in enumerate(cand_words):\r\n            r = self.role[self.vf.idx[w]]\r\n            b = math.log(dist[r] + self.floor)\r\n            if r == self.END: b += math.log(self.p_end[last] + self.floor)\r\n            if n_words < self.min_len or last in (self.BOS, self.PUNCT): b += HARD\r\n            if r in (self.END, self.PUNCT) and last in (self.BOS, self.END, self.PUNCT): b += HARD\r\n            if r < self.END and surf(w) in recent: b += HARD / 3\r\n            out[i] = b\r\n        return out\r\n\r\n\r\nclass Trigrams:\r\n    def __init__(self, tokens):\r\n        self.tri, self.bi = defaultdict(Counter), defaultdict(Counter)\r\n        self.starts = Counter(tokens[:1])\r\n        for a, b in zip(tokens, tokens[1:]):\r\n            if surf(a) in SENTENCE_END: self.starts[b] += 1\r\n        for a, b, c in zip(tokens, tokens[1:], tokens[2:]): self.tri[(a, b)][c] += 1\r\n        for a, b in zip(tokens, tokens[1:]): self.bi[a][b] += 1\r\n\r\n    def table(self, out):\r\n        if len(out) >= 2 and (out[-2], out[-1]) in self.tri: return self.tri[(out[-2], out[-1])]\r\n        return self.bi.get(out[-1])\r\n\r\n\r\ndef curved_schedule(max_order, power):\r\n    ks, j = [], 0\r\n    while True:\r\n        k = 1 + int(round(j ** power))\r\n        if k > max_order: break\r\n        if not ks or k > ks[-1]: ks.append(k)\r\n        j += 1\r\n    return ks\r\n\r\n\r\nclass CurvedContext(Trigrams):\r\n    curved = True\r\n    def __init__(self, tokens, max_order=10, power=1.6, pin=1):\r\n        super().__init__(tokens)\r\n        self.tokens, self.pin = tokens, pin\r\n        self.schedule = curved_schedule(max_order, power)\r\n        self.index = {k: defaultdict(list) for k in self.schedule}\r\n        for k in self.schedule:\r\n            for i in range(k - 1, len(tokens) - 1): self.index[k][tuple(tokens[i-k+1:i+1])].append(i)\r\n        self.last = {\"order\": 0, \"positions\": 0, \"pinned\": False}\r\n\r\n    def table(self, history):\r\n        best = None\r\n        for k in self.schedule:\r\n            if k > len(history): break\r\n            positions = self.index[k].get(tuple(history[-k:]))\r\n            if not positions: break\r\n            best = (k, positions)\r\n            if len(positions) <= self.pin: break\r\n        if best is None:\r\n            self.last = {\"order\": 0, \"positions\": 0, \"pinned\": False}\r\n            return Trigrams.table(self, history)\r\n        k, positions = best\r\n        self.last = {\"order\": k, \"positions\": len(positions), \"pinned\": len(positions) <= self.pin}\r\n        return Counter(self.tokens[p + 1] for p in positions)\r\n\r\n\r\ndef _pick(vf, table, beta, rng, mask=None, sent=(), gamma=1.0, favor=(), bonus=0.0, generated_counts=None, freq_strength=0.0, decay_mode=\"linear\"):\r\n    words = list(table)\r\n    p = np.array([table[w] for w in words], dtype=np.float64)\r\n    logits = np.log(p / p.sum()) + beta * np.exp(vf.field[[vf.idx[w] for w in words]])\r\n    if mask is not None: logits += gamma * mask.bias(list(sent), words)\r\n    if generated_counts is not None and freq_strength:\r\n        counts = np.array([generated_counts[surf(w)] for w in words], dtype=np.float64)\r\n        if decay_mode == \"sqrt\":\r\n            penalty = np.sqrt(counts)\r\n        elif decay_mode == \"log\":\r\n            penalty = np.log1p(counts)\r\n        elif decay_mode == \"quadratic\":\r\n            penalty = counts * counts\r\n        else:\r\n            penalty = counts\r\n        logits -= freq_strength * penalty\r\n    if bonus and favor:\r\n        spread = max(float(logits.max() - logits.min()), 1.0)\r\n        logits += bonus * spread * np.array([surf(w) in favor for w in words], dtype=np.float64)\r\n    probs = np.exp(logits - logits.max())\r\n    return words[rng.choice(len(words), p=probs / probs.sum())]\r\n\r\n\r\ndef stream_tokens(vf, tg, beta=3.0, rng=None, ctx=None, mask=None, gamma=1.0, trace=False, agenda=(), bonus=0.0, history=None, freq_strength=0.0, freq_reset=\"sentence\", decay_mode=\"linear\"):\r\n    rng = rng or np.random.default_rng()\r\n    ctx, sent, history = list(ctx or []), list(ctx or []), list(history or [])\r\n    pending = set(agenda) - {surf(x) for x in sent}\r\n    generated_counts = Counter()\r\n    curved = getattr(tg, \"curved\", False)\r\n    step = 0\r\n    while True:\r\n        table = tg.table(history) if curved and history else (tg.starts if curved else (tg.table(ctx) if ctx else tg.starts))\r\n        if not table:\r\n            ctx, sent, history = [], [], []\r\n            if freq_reset == \"sentence\": generated_counts.clear()\r\n            continue\r\n        w = _pick(vf, table, beta, rng, mask, sent, gamma, pending, bonus, generated_counts, freq_strength, decay_mode)\r\n        step += 1\r\n        if trace:\r\n            print(f\"[step {step}] {w!r} surface={surf(w)!r} generated_count={generated_counts[surf(w)]}\", file=sys.stderr)\r\n            if mask is not None: print(f\"[mask] role={mask.role[vf.idx[w]]}\", file=sys.stderr)\r\n            if curved: print(f\"[context] {tg.last}\", file=sys.stderr)\r\n        yield w\r\n        generated_counts[surf(w)] += 1\r\n        pending.discard(surf(w))\r\n        history = (history + [w])[-64:]\r\n        if surf(w) in SENTENCE_END:\r\n            ctx, sent = [], []\r\n            pending = set(agenda)\r\n            if freq_reset == \"sentence\": generated_counts.clear()\r\n        else:\r\n            ctx = (ctx + [w])[-2:]\r\n            sent.append(w)\r\n\r\n\r\ndef stream_text(tokens, first=True, cap=True):\r\n    for t in tokens:\r\n        s = surf(t)\r\n        if re.match(r\"[.,!?;:]\", s): chunk = s\r\n        else: chunk = (\"\" if first else \" \") + (s[:1].upper() + s[1:] if cap else s)\r\n        cap, first = s in SENTENCE_END, False\r\n        yield chunk\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    ap = argparse.ArgumentParser()\r\n    ap.add_argument(\"--data\", required=True)\r\n    ap.add_argument(\"--value\", type=float, default=3.0)\r\n    ap.add_argument(\"--mix\", type=float, default=0.0)\r\n    ap.add_argument(\"--k\", type=int, default=3)\r\n    ap.add_argument(\"--show\", type=int, default=10)\r\n    ap.add_argument(\"--beta\", type=float, default=3.0)\r\n    ap.add_argument(\"--gamma\", type=float, default=1.0)\r\n    ap.add_argument(\"--classes\", type=int, default=12)\r\n    ap.add_argument(\"--min-len\", type=int, default=4)\r\n    ap.add_argument(\"--no-mask\", action=\"store_true\")\r\n    ap.add_argument(\"--trace\", action=\"store_true\")\r\n    ap.add_argument(\"--copies\", type=int, default=2)\r\n    ap.add_argument(\"--link-seed\", type=int, default=0)\r\n    ap.add_argument(\"--context\", choices=(\"curved\", \"trigram\"), default=\"curved\")\r\n    ap.add_argument(\"--max-order\", type=int, default=10)\r\n    ap.add_argument(\"--curve\", type=float, default=1.6)\r\n    ap.add_argument(\"--pin\", type=int, default=3)\r\n    ap.add_argument(\"--agenda-pool\", type=int, default=32)\r\n    ap.add_argument(\"--agenda-chars\", type=int, default=64)\r\n    ap.add_argument(\"--agenda-bonus\", type=float, default=0.9)\r\n    ap.add_argument(\"--no-agenda\", action=\"store_true\")\r\n    ap.add_argument(\"--check-solver\", action=\"store_true\")\r\n    ap.add_argument(\"--semantic-weight\", type=float, default=1.0)\r\n    ap.add_argument(\"--words\", type=int, default=600)\r\n    ap.add_argument(\"--delay\", type=float, default=0.03)\r\n    ap.add_argument(\"--freq-strength\", type=float, default=0.75, help=\"dynamic probability reduction per generated occurrence\")\r\n    ap.add_argument(\"--freq-reset\", choices=(\"sentence\", \"generation\"), default=\"sentence\", help=\"reset generated frequency counts at sentence boundaries or keep them for the whole generation\")\r\n    ap.add_argument(\"--freq-decay\", choices=(\"linear\", \"sqrt\", \"log\", \"quadratic\"), default=\"linear\", help=\"shape of the dynamic frequency penalty\")\r\n    args = ap.parse_args()\r\n\r\n    text = open(args.data, encoding=\"utf-8\", errors=\"ignore\").read().lower()\r\n    tokens = re.findall(r\"[\\w']+|[.,!?;:]\", text)\r\n    copies, salt = max(1, args.copies), str(args.link_seed)\r\n    lifted = lift_tokens(tokens, copies, salt)\r\n    lifted_set = set(lifted)\r\n    lcounts = Counter(lifted)\r\n    print(f\"[partition] {partition_report(tokens, lifted, copies, salt)}\", file=sys.stderr)\r\n    counts = Counter(tokens)\r\n\r\n    while True:\r\n        ptoks = re.findall(r\"[\\w']+|[.,!?;:]\", input(\"USER: \").lower())\r\n        is_word = lambda t: re.match(r\"[\\w']+\", t)\r\n        known = [w for w in dict.fromkeys(ptoks) if is_word(w) and w in counts]\r\n        unknown = [w for w in dict.fromkeys(ptoks) if is_word(w) and w not in counts]\r\n        if unknown: print(f\"[warn] not in the data, no value assigned: {unknown}\", file=sys.stderr)\r\n        if not known: raise SystemExit(\"no prompt word appears in the data\")\r\n\r\n        rarity = {w: max(math.log(len(tokens) / counts[w]), 1e-9) for w in known}\r\n        max_rarity = max(rarity.values()) or 1.0\r\n        rarity_scaled = {w: rarity[w] / max_rarity for w in known}\r\n        semantic = {w: nltk_word_value(w, ANCHOR_SYNSETS) for w in known}\r\n        max_sem = max(semantic.values()) or 1.0\r\n        semantic_scaled = {w: semantic[w] / max_sem for w in known}\r\n        w_sem = float(args.semantic_weight)\r\n        w_rar = 1.0 - w_sem\r\n        values = {w: args.value * (w_sem * semantic_scaled[w] + w_rar * rarity_scaled[w]) for w in known}\r\n        values = {tag(w, c): x for w, x in values.items() for c in range(copies) if tag(w, c) in lifted_set}\r\n        vf = ValueField(lifted, values, mix=args.mix, k=args.k)\r\n\r\n        agenda = []\r\n        if not args.no_agenda:\r\n            agenda, rep_ = solve_agenda(vf, lcounts, copies, args.agenda_pool, args.agenda_chars, args.check_solver)\r\n            print(f\"[agenda] {rep_}\", file=sys.stderr)\r\n\r\n        mask = None if args.no_mask else LogicMask(vf, lifted, n_classes=args.classes, min_len=args.min_len)\r\n        tg = CurvedContext(lifted, args.max_order, args.curve, args.pin) if args.context == \"curved\" else Trigrams(lifted)\r\n        gen_seed = int(np.random.SeedSequence().entropy % 2**32)\r\n        rng = np.random.default_rng(gen_seed)\r\n        ended = bool(ptoks) and ptoks[-1] in SENTENCE_END\r\n        lp = lift_prompt(ptoks, tg, copies, salt, rng)\r\n        ctx0 = [] if (not ptoks or ended) else lp[-2:]\r\n        toks = stream_tokens(vf, tg, args.beta, rng, ctx=ctx0, mask=mask, gamma=args.gamma, trace=args.trace, agenda=agenda, bonus=args.agenda_bonus, history=lp, freq_strength=args.freq_strength, freq_reset=args.freq_reset, decay_mode=args.freq_decay)\r\n        for n, chunk in enumerate(stream_text(toks, first=False, cap=ended), 1):\r\n            sys.stdout.write(chunk); sys.stdout.flush()\r\n            if args.delay: time.sleep(args.delay)\r\n            if args.words and n >= args.words: break\r\n        print()"}], "files": [{"file_uuid": "f4dcfb18-9ba5-41bd-9552-6d1fb70fbd0a", "file_name": ""}], "parent_message_uuid": "01a0f1ac-f5d0-78d7-8b35-46d10480eb75"}, {"uuid": "01a0f41a-12b1-7a25-ba71-a20d1d9886b6", "text": "", "content": [{"start_timestamp": "2026-09-30T20:55:55.357208Z", "stop_timestamp": "2026-09-30T20:56:10.573648Z", "flags": null, "type": "thinking", "thinking": "", "summaries": [{"summary": "Reviewing two provided code components before responding."}, {"summary": "Mapping the subset-sum solver onto dataset chunk selection."}, {"summary": "Tracking chunk indices and speeding up resonance scoring."}], "cut_off": false, "truncated": true, "hidden": false, "thinking_hidden": true, "alternative_display_type": null, "signature": null}], "sender": "assistant", "created_at": "2026-09-30T20:56:10.586905Z", "updated_at": "2026-09-30T20:56:10.586905Z", "attachments": [], "files": [], "parent_message_uuid": "01a0f41a-12b1-75b5-90ed-6309ab3815cb"}, {"uuid": "01a0f41a-fa4f-7b75-8e8a-34137d91713c", "text": "make sure the subset sum sovler solves the weights for the generate function via standards in the dataset", "content": [{"start_timestamp": "2026-09-30T20:56:44.847563Z", "stop_timestamp": "2026-09-30T20:56:44.847563Z", "flags": null, "type": "text", "text": "make sure the subset sum sovler solves the weights for the generate function via standards in the dataset", "citations": []}], "sender": "human", "created_at": "2026-09-30T20:56:44.847763Z", "updated_at": "2026-09-30T20:56:44.847763Z", "attachments": [], "files": [], "parent_message_uuid": "01a0f41a-12b1-7a25-ba71-a20d1d9886b6"}, {"uuid": "01a0f41a-fa4f-7ae1-a5ee-ef0531578907", "text": "\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\nI've added the subset-sum solver to your frequency-decay generator as `word_values_solved.py`. The solver doesn't output the weights directly: it picks an exact-size sample of the dataset, and the generate weights are computed from that sample's standards. I tested with WordNet replaced by a stub, because nltk can't be installed in my sandbox, so the semantic values were never exercised and all runs used `--semantic-weight 0`. Your nltk import is unchanged.\n\n**Dataset load and processing**\n- **Load:** the dataset is split into sentences, and the word count of each sentence is written to a binary table (`<data>.sentlen.bin`). The table is checksummed and reused if it still matches, and it falls back to the temp folder if the data folder isn't writable.\n- **Solve:** your holographic beam-search solver streams that table through mmap. It finds a set of sentences whose word counts add up exactly to a target, which is `--standard-fraction` of the dataset (default 0.25). The path now stores item indices so the chosen sentences can be recovered. If no exact sum is reachable, it returns the closest one and flags it.\n- **Standards and weights:** these are measured on that sample:\n  - `min_len` is 0.4 \u00d7 the mean sentence length.\n  - `agenda_chars` is 0.5 \u00d7 the mean characters per sentence.\n  - `gamma` is 1 + max(0, 1 \u2212 length spread).\n  - `freq_strength` is clip(\u2212ln(repeat rate) / 4).\n  A weight given on the command line always overrides these. `--no-solve` restores the old fixed defaults.\n\nI chose those four formulas and their constants myself. They are heuristics, not something derived from the solver.\n\n**What I checked**\n- **Exact sums:** every sample had an exact sum and was a valid subset (16 of 16 across both test corpora).\n- **Random sample:** my first version stopped after 26 sentences, so the \"standard sample\" was just the start of the GPL-3 file (spread 0.50 against 0.93 for the whole dataset). The table is now stored in a seeded shuffled order (`--standard-seed`), so the sample is random. The sample's standards differ from the whole dataset's by 9\u201315% on GPL-3 at the 25% fraction.\n- **Effect on output (GPL-3):** with the solved weights, generated sentence length and characters came much closer to the dataset's than with the old fixed weights, and the repeat rate also moved closer:\n\n| Measure | Old fixed weights | Solved weights |\n|---|---|---|\n| Sentence length, error vs dataset | 55% | 13% |\n| Characters per sentence, error vs dataset | 56% | 15% |\n| Length spread, error vs dataset | 29% | 24% |\n| Repeat rate (dataset: 0.0195) | 0.010 | 0.018 |\n\n- **Templated corpus:** there was no meaningful change, because it was already uniform.\n\n**Caveats**\n- **Bug in your mask rule:** the \"no early sentence end\" rule had slipped outside its `if r == END` block. That penalised every candidate equally, so `min_len` would have been inert. I restored it. I found this by reading the code and did not measure before and after.\n- **`min_len` is soft:** 18% of generated sentences on GPL-3 were still shorter than `min_len`. A single-option context, such as a pinned dataset continuation, is taken whatever the penalty.", "content": [{"start_timestamp": "2026-09-30T20:56:44.841553Z", "stop_timestamp": "2026-09-30T20:58:28.670117Z", "flags": null, "type": "thinking", "thinking": "", "summaries": [{"summary": "Fixing a subset sum solver to match dataset weights."}, {"summary": "Deriving dataset-based targets for the weight quantities."}, {"summary": "Designing vocabulary coverage as a subset-sum selection task."}, {"summary": "Mapping dataset counts to generate-function weight quanta."}, {"summary": "Linking dataset word counts to weight targets concretely."}, {"summary": "Calibrating how weight quanta affect generation statistics."}, {"summary": "Reinterpreting dataset standards as reference word-frequency distributions."}, {"summary": "Allocating a fixed weight budget through spendable quanta."}, {"summary": "Sampling representative sentences to ground weight statistics."}, {"summary": "Settling on an exemplar-subset approach for weight standards."}, {"summary": "Adapting the disk-based solver to return sentence indices."}, {"summary": "Defining heuristic formulas for each weight from sentence statistics."}, {"summary": "Caching sentence lengths and offsets for fast retrieval."}, {"summary": "Handling fallback cases and defining content-word repetition metrics."}, {"summary": "Checking whether a needed library can run in the sandbox."}], "cut_off": false, "truncated": true, "hidden": false, "thinking_hidden": true, "alternative_display_type": null, "signature": null}, {"start_timestamp": "2026-09-30T20:58:28.670219Z", "stop_timestamp": "2026-09-30T20:58:28.854648Z", "flags": null, "type": "tool_use", "id": "toolu_0133jqcPNQ6QBghrjS5nhuFQ", "name": "bash_tool", "input": {"command": "python3 -c \"import nltk; print('nltk', nltk.__version__)\" 2>&1; python3 - << 'EOF' 2>&1 | tail -3\ntry:\n    from nltk.corpus import wordnet\n    print(wordnet.synset(\"entity.n.01\"))\nexcept Exception as e:\n    print(\"wordnet missing:\", type(e).__name__)\nEOF"}, "message": "Running command", "integration_name": "File Creation", "integration_icon_url": null, "tool_identifier": null, "icon_name": "commandLine", "context": null, "display_content": {"type": "json_block", "json_block": "{\"language\": \"bash\", \"code\": \"python3 -c \\\"import nltk; print('nltk', nltk.__version__)\\\" 2>&1; python3 - << 'EOF' 2>&1 | tail -3\\ntry:\\n    from nltk.corpus import wordnet\\n    print(wordnet.synset(\\\"entity.n.01\\\"))\\nexcept Exception as e:\\n    print(\\\"wordnet missing:\\\", type(e).__name__)\\nEOF\"}"}, "approval_options": null, "approval_key": null, "approval_key_legacy": null, "is_mcp_app": null, "hidden_in_chat": null, "mcp_server_url": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-09-30T20:58:30.099041Z", "stop_timestamp": "2026-09-30T20:58:30.099088Z", "flags": null, "type": "tool_result", "tool_use_id": "toolu_0133jqcPNQ6QBghrjS5nhuFQ", "name": "bash_tool", "content": [{"type": "text", "text": "{\"returncode\":0,\"stdout\":\"Traceback (most recent call last):\\n  File \\\"<string>\\\", line 1, in <module>\\nModuleNotFoundError: No module named 'nltk'\\nwordnet missing: ModuleNotFoundError\\n\",\"stderr\":\"\"}"}], "is_error": false, "structured_content": null, "meta": {"output_format_category": "none"}, "message": null, "integration_name": "File Creation", "mcp_server_url": null, "integration_icon_url": null, "icon_name": "commandLine", "display_content": {"type": "json_block", "json_block": "{\"returncode\":0,\"stdout\":\"Traceback (most recent call last):\\n  File \\\"<string>\\\", line 1, in <module>\\nModuleNotFoundError: No module named 'nltk'\\nwordnet missing: ModuleNotFoundError\\n\",\"stderr\":\"\"}"}, "hidden_in_chat": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-09-30T20:58:35.969716Z", "stop_timestamp": "2026-09-30T20:58:36.726523Z", "flags": null, "type": "tool_use", "id": "toolu_0188fKFETU8ZyGL9jQDUScFq", "name": "bash_tool", "input": {"command": "pip install nltk --break-system-packages -q 2>&1 | tail -2; python3 - << 'EOF' 2>&1 | tail -4\nimport nltk\nok = nltk.download('wordnet', quiet=True)\nprint(\"download ok:\", ok)\nfrom nltk.corpus import wordnet\nprint(wordnet.synset(\"entity.n.01\"), len(wordnet.synsets(\"license\")))\nEOF"}, "message": "Running command", "integration_name": "File Creation", "integration_icon_url": null, "tool_identifier": null, "icon_name": "commandLine", "context": null, "display_content": {"type": "json_block", "json_block": "{\"language\": \"bash\", \"code\": \"pip install nltk --break-system-packages -q 2>&1 | tail -2; python3 - << 'EOF' 2>&1 | tail -4\\nimport nltk\\nok = nltk.download('wordnet', quiet=True)\\nprint(\\\"download ok:\\\", ok)\\nfrom nltk.corpus import wordnet\\nprint(wordnet.synset(\\\"entity.n.01\\\"), len(wordnet.synsets(\\\"license\\\")))\\nEOF\"}"}, "approval_options": null, "approval_key": null, "approval_key_legacy": null, "is_mcp_app": null, "hidden_in_chat": null, "mcp_server_url": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-09-30T20:58:37.646260Z", "stop_timestamp": "2026-09-30T20:58:37.646314Z", "flags": null, "type": "tool_result", "tool_use_id": "toolu_0188fKFETU8ZyGL9jQDUScFq", "name": "bash_tool", "content": [{"type": "text", "text": "{\"returncode\":0,\"stdout\":\"ERROR: Could not find a version that satisfies the requirement nltk (from versions: none)\\nERROR: No matching distribution found for nltk\\nTraceback (most recent call last):\\n  File \\\"<stdin>\\\", line 1, in <module>\\nModuleNotFoundError: No module named 'nltk'\\n\",\"stderr\":\"\"}"}], "is_error": false, "structured_content": null, "meta": {"output_format_category": "none"}, "message": null, "integration_name": "File Creation", "mcp_server_url": null, "integration_icon_url": null, "icon_name": "commandLine", "display_content": {"type": "json_block", "json_block": "{\"returncode\":0,\"stdout\":\"ERROR: Could not find a version that satisfies the requirement nltk (from versions: none)\\nERROR: No matching distribution found for nltk\\nTraceback (most recent call last):\\n  File \\\"<stdin>\\\", line 1, in <module>\\nModuleNotFoundError: No module named 'nltk'\\n\",\"stderr\":\"\"}"}, "hidden_in_chat": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-09-30T20:58:39.668218Z", "stop_timestamp": "2026-09-30T20:59:13.407563Z", "flags": null, "type": "thinking", "thinking": "", "summaries": [{"summary": "Working around a missing dependency to test the script."}, {"summary": "Reconstructing the holographic subset-sum solver from the file."}, {"summary": "Adding a checksum to verify the cached sentence table."}, {"summary": "Deriving sentence-length statistics and matching solver weights."}, {"summary": "Spotting a bug in how the length penalty applies."}, {"summary": "Fixing the length-penalty bug to restore its intended effect."}], "cut_off": false, "truncated": true, "hidden": false, "thinking_hidden": true, "alternative_display_type": null, "signature": null}, {"start_timestamp": "2026-09-30T20:59:13.407696Z", "stop_timestamp": "2026-09-30T20:59:13.407945Z", "flags": null, "type": "thinking", "thinking": "", "summaries": [{"summary": "Fixing overly broad early-end rule while testing with a stub wordnet"}], "cut_off": false, "truncated": true, "hidden": false, "thinking_hidden": true, "alternative_display_type": null, "signature": null}, {"start_timestamp": "2026-09-30T20:59:13.408092Z", "stop_timestamp": "2026-09-30T21:00:17.349442Z", "flags": null, "type": "tool_use", "id": "toolu_01KtDCH4EN1wm2cuHwmXbD5U", "name": "create_file", "input": {"description": "Frequency-decay generator with dataset load/processing through the holographic subset-sum solver; generate weights solved from dataset standards", "path": "/mnt/user-data/outputs/word_values_solved.py", "file_text": "#!/usr/bin/env python3\n\"\"\"Dynamic frequency-decay text generator, weights solved from the dataset.\n\nExtends the supplied graph/byte/context/mask/copy/knapsack generator with\none important change: during generation, every emitted surface word receives\na growing frequency penalty. The penalty is applied at each sampling step,\nso the probability landscape changes continuously as the stream moves on.\n\nThe generated-count penalty is reset at sentence boundaries, while the\noptional global mode can keep counts for the whole generation.\n\nNEW  dataset load + processing through the holographic subset-sum solver\n  1. load        the dataset is split into sentences; the word count of every\n                 sentence is written to a compact binary table on disk\n                 (<data>.sentlen.bin: header + uint32 per sentence, checksummed,\n                 reused on later runs if it still matches the dataset).\n  2. process     the supplied holographic beam-search subset-sum solver streams\n                 that table through mmap and finds a set of sentences whose\n                 word counts add up EXACTLY to a target size\n                 (--standard-fraction of the dataset). That set is the\n                 dataset's standard sample.\n  3. standards   measured on the standard sample (and, for comparison, on the\n                 whole dataset): mean sentence length, length spread, mean\n                 characters per sentence, in-sentence repeat rate.\n  4. weights     the generate function's weights are then solved from those\n                 standards instead of being typed in:\n                   min_len        = 0.4 * mean sentence length\n                   agenda_chars   = 0.5 * mean characters per sentence\n                   gamma          = 1 + max(0, 1 - spread)        regular text -> firmer mask\n                   freq_strength  = clip(-ln(repeat rate) / 4)    rarely repeats -> harder penalty\n                 A weight given on the command line always wins.\n\"\"\"\nimport argparse\nimport hashlib\nimport heapq\nimport math\nimport mmap\nimport os\nimport re\nimport struct\nimport sys\nimport tempfile\nimport time\nimport zlib\nfrom collections import Counter, defaultdict\n\nimport numpy as np\nimport scipy.sparse as sp\n\nimport nltk\nfrom nltk.corpus import wordnet\n\nSEP = 256\nSENTENCE_END = {\".\", \"!\", \"?\"}\nSOFT_PUNCT = {\",\", \";\", \":\"}\nHARD = -30.0\nCOPY_MARK = \"#\"\nANCHOR_SYNSETS = [wordnet.synset(\"entity.n.01\")]\n\n\ndef nltk_word_value(word, anchor_synsets, default=1e-6):\n    synsets = wordnet.synsets(word)\n    if not synsets or not anchor_synsets:\n        return default\n    best = 0.0\n    for s in synsets:\n        for a in anchor_synsets:\n            try:\n                sim = s.path_similarity(a)\n            except Exception:\n                sim = 0.0\n            if sim is None:\n                sim = 0.0\n            best = max(best, sim)\n    return max(best, 1e-6)\n\n\n# ---------------------------------------------------------------------------\n# holographic subset-sum solver (the supplied one), reading a binary table\n# ---------------------------------------------------------------------------\n\ndef number_to_holographic_tensor(num_str, max_len):\n    \"\"\"Projects a decimal number string into a 3D holographic cardinal tensor.\"\"\"\n    padded = num_str.zfill(max_len)\n    tensor = np.zeros((max_len, 10, 3), dtype=float)\n\n    for idx, char in enumerate(padded):\n        digit = int(char)\n        norm_pos = idx / max(1, max_len - 1)\n\n        tensor[idx, digit, 0] = 1.0 - norm_pos\n        tensor[idx, digit, 1] = np.sin(2.0 * np.pi * (digit / 10.0))\n        tensor[idx, digit, 2] = np.cos(2.0 * np.pi * norm_pos)\n\n    return tensor\n\n\ndef compute_holographic_resonance(partial_val, target_str, max_len, target_tensor, target_norm):\n    \"\"\"Computes structural holographic resonance against target tensor field.\"\"\"\n    p_str = str(partial_val)\n    p_tensor = number_to_holographic_tensor(p_str, max_len)\n    p_norm = np.linalg.norm(p_tensor)\n\n    if p_norm == 0 or target_norm == 0:\n        return 0.0\n\n    return np.sum(target_tensor * p_tensor) / (target_norm * p_norm)\n\n\ndef _materialize(node):\n    \"\"\"Walk an immutable path linked-list back to a plain Python list.\"\"\"\n    out = []\n    while node is not None:\n        val, node = node\n        out.append(val)\n    out.reverse()\n    return out\n\n\nHEADER = struct.Struct(\"<4sIIII\")            # magic, version, sentences, words, crc32\nMAGIC = b\"SSUM\"\n\n\ndef holographic_subset_search(filepath, n, target, r=0.35, c=2, max_beam_width=1000,\n                              offset=HEADER.size):\n    \"\"\"The supplied beam search. Differences: items are read from the table\n    after its header, the path stores ITEM INDICES (so the subset can be mapped\n    back to sentences), and if no exact sum is reachable the closest one in the\n    final beam is returned with exact=False.  Returns (indices, steps, exact).\"\"\"\n    theoretical_cap = n ** c\n    cap = min(theoretical_cap, max_beam_width)\n\n    target_str = str(target)\n    max_len = len(target_str) + 2\n    target_tensor = number_to_holographic_tensor(target_str, max_len)\n    target_norm = np.linalg.norm(target_tensor)\n\n    beam = [(0, None)]\n\n    with open(filepath, \"rb\") as f:\n        with mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ) as mm:\n            for k in range(1, n + 1):\n                pos = offset + (k - 1) * 4\n                x = struct.unpack(\"<I\", mm[pos:pos + 4])[0]\n\n                seen = {}\n                for partial, node in beam:\n                    if partial not in seen:\n                        seen[partial] = node\n                    new_partial = partial + x\n                    if new_partial <= target and new_partial not in seen:\n                        seen[new_partial] = (k - 1, node)\n\n                if target in seen:\n                    return _materialize(seen[target]), k, True\n\n                log_width = n * math.log(2) + k * math.log(1 - r)\n                if log_width > math.log(cap):\n                    width = cap\n                else:\n                    width = max(1, min(cap, math.ceil(math.exp(log_width))))\n\n                items = list(seen.items())\n                if len(items) <= width:\n                    beam = items\n                else:\n                    scored_items = []\n                    for partial, node in items:\n                        dist_penalty = abs(target - partial)\n                        resonance = compute_holographic_resonance(\n                            partial, target_str, max_len, target_tensor, target_norm)\n                        hybrid_score = dist_penalty - (resonance * 10.0)\n                        scored_items.append((hybrid_score, partial, node))\n\n                    best_items = heapq.nsmallest(width, scored_items)\n                    beam = [(partial, node) for _, partial, node in best_items]\n\n    best = min(beam, key=lambda b: abs(target - b[0]))\n    return _materialize(best[1]), n, best[0] == target\n\n\n# ---------------------------------------------------------------------------\n# dataset load + processing: sentence table on disk, standard sample, weights\n# ---------------------------------------------------------------------------\n\n_is_word = re.compile(r\"[\\w']+\").match\n\n\ndef split_sentences(tokens):\n    sents, cur = [], []\n    for t in tokens:\n        cur.append(t)\n        if t in SENTENCE_END:\n            sents.append(cur)\n            cur = []\n    if cur:\n        sents.append(cur)\n    return [s for s in sents if any(_is_word(w) for w in s)]\n\n\ndef word_count(sent):\n    return sum(1 for w in sent if _is_word(w))\n\n\ndef sentence_table(tokens, path):\n    \"\"\"Write (or reuse) the binary table of sentence word counts.\"\"\"\n    sents = split_sentences(tokens)\n    lens = [word_count(s) for s in sents]\n    payload = struct.pack(f\"<{len(lens)}I\", *lens)\n    head = HEADER.pack(MAGIC, 1, len(sents), sum(lens), zlib.crc32(payload))\n\n    if os.path.exists(path) and os.path.getsize(path) == HEADER.size + len(payload):\n        with open(path, \"rb\") as f:\n            if f.read(HEADER.size) == head:\n                return sents, lens, True                        # still matches the dataset\n    with open(path, \"wb\") as f:\n        f.write(head)\n        f.write(payload)\n    return sents, lens, False\n\n\ndef sentence_standards(sents, window=6):\n    \"\"\"Standards measured on a set of sentences. A 'content' word has >= 4\n    letters; a repeat is a content word seen again within `window` words of\n    the same sentence.\"\"\"\n    lens = np.array([word_count(s) for s in sents], dtype=float)\n    chars = np.array([sum(len(w) + 1 for w in s if _is_word(w)) for s in sents], dtype=float)\n    repeats = content = 0\n    every = []\n    for s in sents:\n        ws = [w for w in s if _is_word(w)]\n        every += ws\n        for i, w in enumerate(ws):\n            if len(w) >= 4:\n                content += 1\n                if w in ws[max(0, i - window):i]:\n                    repeats += 1\n    mean_len = float(lens.mean())\n    return {\n        \"sentences\": len(sents),\n        \"mean_len\": round(mean_len, 3),\n        \"spread\": round(float(lens.std()) / max(mean_len, 1e-9), 3),\n        \"mean_chars\": round(float(chars.mean()), 3),\n        \"repeat_rate\": round(repeats / max(content, 1), 4),\n    }\n\n\ndef solve_weights(std):\n    \"\"\"Generate-function weights from the standards.\"\"\"\n    return {\n        \"min_len\": max(2, int(round(0.4 * std[\"mean_len\"]))),\n        \"agenda_chars\": max(12, int(round(0.5 * std[\"mean_chars\"]))),\n        \"gamma\": round(1.0 + max(0.0, 1.0 - std[\"spread\"]), 3),\n        \"freq_strength\": round(float(np.clip(-math.log(max(std[\"repeat_rate\"], 0.02)) / 4.0, 0.1, 2.0)), 3),\n    }\n\n\ndef solve_from_dataset(tokens, path, fraction=0.1, r=0.35, beam=1000):\n    sents, lens, reused = sentence_table(tokens, path)\n    total = sum(lens)\n    target = max(1, min(total, int(round(fraction * total))))\n    idx, steps, exact = holographic_subset_search(path, len(sents), target, r,\n                                                  max_beam_width=beam)\n    chosen = [sents[i] for i in idx]\n    std_all = sentence_standards(sents)\n    std_sample = sentence_standards(chosen) if chosen else std_all\n    check = {\n        \"table_reused\": reused,\n        \"exact_sum\": exact and sum(lens[i] for i in idx) == target,\n        \"subset_valid\": idx == sorted(set(idx)) and all(0 <= i < len(sents) for i in idx),\n    }\n    info = {\"sentences\": len(sents), \"words\": total, \"target_words\": target,\n            \"sample_sentences\": len(idx), \"steps\": steps, **check}\n    return std_all, std_sample, solve_weights(std_sample), solve_weights(std_all), info\n\n\n# ---------------------------------------------------------------------------\n\ndef surf(token):\n    return token.partition(COPY_MARK)[0]\n\n\ndef copy_of(token):\n    _, _, c = token.partition(COPY_MARK)\n    return int(c) if c else 0\n\n\ndef tag(word, copy):\n    return word if copy == 0 else f\"{word}{COPY_MARK}{copy}\"\n\n\ndef shift_token(token, offset, copies):\n    return tag(surf(token), (copy_of(token) + offset) % copies)\n\n\ndef link_class(first, second, copies, salt=\"\"):\n    digest = hashlib.blake2b(f\"{salt}\\x00{first}\\x00{second}\".encode(\"utf-8\"), digest_size=8).digest()\n    return int.from_bytes(digest, \"big\") % copies\n\n\ndef lift_tokens(tokens, copies, salt=\"\"):\n    out, copy, previous = [], 0, None\n    for t in tokens:\n        if previous is not None:\n            copy = (copy + link_class(previous, t, copies, salt)) % copies\n        out.append(tag(t, copy))\n        previous = t\n    return out\n\n\ndef lift_prompt(ptoks, tg, copies, salt, rng):\n    rel = lift_tokens(ptoks, copies, salt)\n    if copies == 1 or not rel:\n        return rel\n    weights = []\n    for o in range(copies):\n        shifted = [shift_token(t, o, copies) for t in rel]\n        w = 0.0\n        if len(shifted) >= 2 and (shifted[-2], shifted[-1]) in tg.tri:\n            w = float(sum(tg.tri[(shifted[-2], shifted[-1])].values()))\n        elif shifted[-1] in tg.bi:\n            w = 0.01 * float(sum(tg.bi[shifted[-1]].values()))\n        weights.append(w)\n    weights = np.array(weights)\n    o = 0 if weights.sum() == 0 else int(rng.choice(copies, p=weights / weights.sum()))\n    return [shift_token(t, o, copies) for t in rel]\n\n\ndef partition_report(tokens, lifted, copies, salt):\n    seen, distinct, occ = set(), Counter(), Counter()\n    for a, b in zip(tokens, tokens[1:]):\n        c = link_class(a, b, copies, salt)\n        occ[c] += 1\n        if (a, b) not in seen:\n            seen.add((a, b))\n            distinct[c] += 1\n    return {\"copies\": copies, \"vocab\": len(set(lifted)), \"distinct_links_per_class\": dict(sorted(distinct.items())), \"occurrences_per_class\": dict(sorted(occ.items())), \"projects_back_to_dataset\": [surf(t) for t in lifted] == tokens}\n\n\ndef subset_table(items):\n    W = np.zeros(1, dtype=np.int64)\n    V = np.zeros(1)\n    M = np.zeros(1, dtype=np.int64)\n    for i, (w, v) in enumerate(items):\n        W = np.concatenate([W, W + w])\n        V = np.concatenate([V, V + v])\n        M = np.concatenate([M, M | (1 << i)])\n    return W, V, M\n\n\ndef knapsack_mitm(set_a, set_b, budget):\n    WA, VA, MA = subset_table(set_a)\n    WB, VB, MB = subset_table(set_b)\n    oa = np.argsort(WA, kind=\"stable\")\n    ob = np.argsort(-WB, kind=\"stable\")\n    WA, VA, MA = WA[oa], VA[oa], MA[oa]\n    WB, VB, MB = WB[ob], VB[ob], MB[ob]\n    nb = len(WB)\n    sufv = np.empty(nb)\n    sufi = np.empty(nb, dtype=np.int64)\n    best_v, best_i = -1.0, 0\n    for j in range(nb - 1, -1, -1):\n        if VB[j] > best_v:\n            best_v, best_i = VB[j], j\n        sufv[j], sufi[j] = best_v, best_i\n    best = (-1.0, 0, 0)\n    j = 0\n    for a in range(len(WA)):\n        room = budget - WA[a]\n        if room < 0:\n            break\n        while j < nb and WB[j] > room:\n            j += 1\n        if j == nb:\n            break\n        total = VA[a] + sufv[j]\n        if total > best[0]:\n            best = (total, int(MA[a]), int(MB[sufi[j]]))\n    return best[0], best[1], best[2], len(WA) + len(WB)\n\n\ndef knapsack_brute(items, budget):\n    W, V, _ = subset_table(items)\n    return float(V[W <= budget].max())\n\n\ndef solve_agenda(vf, lcounts, copies, pool=18, budget=30, check=False):\n    by_surface = defaultdict(list)\n    for t in vf.vocab:\n        if re.fullmatch(r\"[\\w']+\", surf(t)):\n            by_surface[surf(t)].append(t)\n    cand = []\n    for word, toks in by_surface.items():\n        home = max(toks, key=lambda t: (lcounts[t], -copy_of(t)))\n        cand.append((word, home, float(vf.field[vf.idx[home]])))\n    cand = [c for c in sorted(cand, key=lambda c: -c[2])[:pool] if c[2] > 1e-6]\n    halves = ([], [])\n    for rank, (word, home, val) in enumerate(cand):\n        h = copy_of(home) % 2 if copies >= 2 else rank % 2\n        halves[h].append((word, len(word) + 1, val))\n    value, ma, mb, ops = knapsack_mitm([(w, v) for _, w, v in halves[0]], [(w, v) for _, w, v in halves[1]], budget)\n    words = [halves[0][i][0] for i in range(len(halves[0])) if ma >> i & 1] + [halves[1][i][0] for i in range(len(halves[1])) if mb >> i & 1]\n    report = {\"candidates\": len(cand), \"half_A\": len(halves[0]), \"half_B\": len(halves[1]), \"agenda\": words, \"chars\": sum(len(w) + 1 for w in words), \"budget\": budget, \"value\": round(value, 3), \"subsets_examined\": ops, \"brute_force_would_examine\": 2 ** len(cand)}\n    if check and len(cand) <= 22:\n        brute = knapsack_brute([(len(w) + 1, v) for w, _, v in cand], budget)\n        report[\"matches_brute_force\"] = bool(abs(brute - max(value, 0.0)) < 1e-9)\n    return words, report\n\n\ndef normalize_rows(M):\n    s = np.asarray(M.sum(axis=1)).ravel()\n    s[s == 0] = 1.0\n    return sp.diags(1.0 / s) @ M if sp.issparse(M) else M / s[:, None]\n\n\ndef word_states(word, k=3):\n    seq = (SEP,) + tuple(word.encode(\"utf-8\")) + (SEP,)\n    seq = seq + (SEP,) * max(0, k - len(seq))\n    return [seq[i:i + k] for i in range(len(seq) - k + 1)]\n\n\nclass ValueField:\n    def __init__(self, tokens, values, top=5, hops=3, decay=0.5, mix=0.5, k=3):\n        self.k = k\n        self.vocab = sorted(set(tokens))\n        self.idx = {w: i for i, w in enumerate(self.vocab)}\n        n = len(self.vocab)\n        C = np.zeros((n, n))\n        for a, b in zip(tokens, tokens[1:]):\n            C[self.idx[a], self.idx[b]] += 1.0\n        X = np.hstack([normalize_rows(C), normalize_rows(C.T)])\n        X /= np.maximum(np.linalg.norm(X, axis=1, keepdims=True), 1e-12)\n        self.X = X\n        S = X @ X.T\n        np.fill_diagonal(S, 0.0)\n        K = np.zeros_like(S)\n        for i in range(n):\n            j = np.argsort(S[i])[-top:]\n            K[i, j] = S[i, j]\n        K = np.maximum(K, K.T)\n        d = np.sqrt(np.maximum(K.sum(axis=1), 1e-12))\n        Sn = K / np.outer(d, d)\n        self.states = {}\n        rows, cols, edges = [], [], set()\n        for wi, w in enumerate(self.vocab):\n            path = [self.states.setdefault(st, len(self.states)) for st in word_states(surf(w), k)]\n            rows += [wi] * len(path)\n            cols += path\n            for a, b in zip(path, path[1:]):\n                edges.add((a, b)); edges.add((b, a))\n        ns = len(self.states)\n        B = normalize_rows(sp.csr_matrix((np.ones(len(rows)), (rows, cols)), shape=(n, ns)))\n        er, ec = zip(*edges) if edges else ([], [])\n        A = sp.csr_matrix((np.ones(len(er)), (er, ec)), shape=(ns, ns))\n        A.data[:] = 1.0\n        dd = 1.0 / np.sqrt(np.maximum(np.asarray(A.sum(axis=1)).ravel(), 1e-12))\n        Sb = sp.diags(dd) @ A @ sp.diags(dd)\n        v0 = np.zeros(n)\n        for w, x in values.items():\n            if w in self.idx:\n                v0[self.idx[w]] = x\n        cur, self.field = v0, v0.copy()\n        self.tiers = [v0]\n        self.state_field = B.T @ v0\n        for _ in range(hops):\n            via_use = Sn @ cur\n            st = Sb @ (B.T @ cur)\n            via_bytes = B @ st\n            cur = decay * (mix * via_use + (1 - mix) * via_bytes)\n            self.state_field = self.state_field + (1 - mix) * decay * st\n            self.field = self.field + cur\n            self.tiers.append(cur)\n\n    def read(self, word):\n        ids = [self.states[s] for s in word_states(surf(word), self.k) if s in self.states]\n        return float(np.mean(self.state_field[ids])) if ids else 0.0\n\n\nclass LogicMask:\n    def __init__(self, vf, tokens, n_classes=12, min_len=4, window=6, floor=1e-3, seed=0, iters=15):\n        self.vf, self.min_len, self.window, self.floor = vf, min_len, window, floor\n        rng = np.random.default_rng(seed)\n        n = len(vf.vocab)\n        Z = vf.X @ rng.standard_normal((vf.X.shape[1], min(32, vf.X.shape[1])))\n        Z /= np.maximum(np.linalg.norm(Z, axis=1, keepdims=True), 1e-12)\n        k = max(1, min(n_classes, n))\n        cent = Z[rng.choice(n, k, replace=False)].copy()\n        lab = np.zeros(n, dtype=int)\n        for _ in range(iters):\n            lab = np.argmax(Z @ cent.T, axis=1)\n            for c in range(k):\n                m = lab == c\n                if m.any():\n                    v = Z[m].mean(axis=0); cent[c] = v / max(np.linalg.norm(v), 1e-12)\n        self.END, self.PUNCT, self.BOS = k, k + 1, k + 2\n        self.R = k + 2\n        self.role = lab.copy()\n        for w, i in vf.idx.items():\n            if surf(w) in SENTENCE_END: self.role[i] = self.END\n            elif surf(w) in SOFT_PUNCT: self.role[i] = self.PUNCT\n        self.bi = np.zeros((self.BOS + 1, self.R))\n        self.tri = defaultdict(lambda: np.zeros(self.R))\n        prev = [self.BOS]\n        for t in tokens:\n            r = self.role[vf.idx[t]]\n            self.bi[prev[-1], r] += 1\n            if len(prev) >= 2: self.tri[(prev[-2], prev[-1])][r] += 1\n            prev = [self.BOS] if surf(t) in SENTENCE_END else (prev + [r])[-2:]\n        rs = self.bi.sum(axis=1, keepdims=True)\n        self.p_end = np.where(rs[:, 0] > 0, self.bi[:, self.END] / np.maximum(rs[:, 0], 1), 0.0)\n\n    def roles_of(self, words):\n        return [self.role[self.vf.idx[w]] for w in words if w in self.vf.idx]\n\n    def bias(self, sent_words, cand_words):\n        roles = [self.BOS] + self.roles_of(sent_words)\n        last = roles[-1]\n        dist = self.tri.get((roles[-2], roles[-1])) if len(roles) >= 2 else None\n        if dist is None or dist.sum() == 0: dist = self.bi[last]\n        dist = dist / max(dist.sum(), 1e-12)\n        recent = {surf(x) for x in sent_words[-self.window:]}\n        n_words = sum(1 for w in sent_words if surf(w) not in SOFT_PUNCT)\n        out = np.zeros(len(cand_words))\n        for i, w in enumerate(cand_words):\n            r = self.role[self.vf.idx[w]]\n            b = math.log(dist[r] + self.floor)\n            if r == self.END:\n                # R2: END only after `min_len` words and only after a role that\n                # has ended sentences (restored: it had slipped outside this\n                # `if`, which penalised every candidate and made min_len inert)\n                b += math.log(self.p_end[last] + self.floor)\n                if n_words < self.min_len or last in (self.BOS, self.PUNCT): b += HARD\n            if r in (self.END, self.PUNCT) and last in (self.BOS, self.END, self.PUNCT): b += HARD\n            if r < self.END and surf(w) in recent: b += HARD / 3\n            out[i] = b\n        return out\n\n\nclass Trigrams:\n    def __init__(self, tokens):\n        self.tri, self.bi = defaultdict(Counter), defaultdict(Counter)\n        self.starts = Counter(tokens[:1])\n        for a, b in zip(tokens, tokens[1:]):\n            if surf(a) in SENTENCE_END: self.starts[b] += 1\n        for a, b, c in zip(tokens, tokens[1:], tokens[2:]): self.tri[(a, b)][c] += 1\n        for a, b in zip(tokens, tokens[1:]): self.bi[a][b] += 1\n\n    def table(self, out):\n        if len(out) >= 2 and (out[-2], out[-1]) in self.tri: return self.tri[(out[-2], out[-1])]\n        return self.bi.get(out[-1])\n\n\ndef curved_schedule(max_order, power):\n    ks, j = [], 0\n    while True:\n        k = 1 + int(round(j ** power))\n        if k > max_order: break\n        if not ks or k > ks[-1]: ks.append(k)\n        j += 1\n    return ks\n\n\nclass CurvedContext(Trigrams):\n    curved = True\n    def __init__(self, tokens, max_order=10, power=1.6, pin=1):\n        super().__init__(tokens)\n        self.tokens, self.pin = tokens, pin\n        self.schedule = curved_schedule(max_order, power)\n        self.index = {k: defaultdict(list) for k in self.schedule}\n        for k in self.schedule:\n            for i in range(k - 1, len(tokens) - 1): self.index[k][tuple(tokens[i-k+1:i+1])].append(i)\n        self.last = {\"order\": 0, \"positions\": 0, \"pinned\": False}\n\n    def table(self, history):\n        best = None\n        for k in self.schedule:\n            if k > len(history): break\n            positions = self.index[k].get(tuple(history[-k:]))\n            if not positions: break\n            best = (k, positions)\n            if len(positions) <= self.pin: break\n        if best is None:\n            self.last = {\"order\": 0, \"positions\": 0, \"pinned\": False}\n            return Trigrams.table(self, history)\n        k, positions = best\n        self.last = {\"order\": k, \"positions\": len(positions), \"pinned\": len(positions) <= self.pin}\n        return Counter(self.tokens[p + 1] for p in positions)\n\n\ndef _pick(vf, table, beta, rng, mask=None, sent=(), gamma=1.0, favor=(), bonus=0.0, generated_counts=None, freq_strength=0.0, decay_mode=\"linear\"):\n    words = list(table)\n    p = np.array([table[w] for w in words], dtype=np.float64)\n    logits = np.log(p / p.sum()) + beta * np.exp(vf.field[[vf.idx[w] for w in words]])\n    if mask is not None: logits += gamma * mask.bias(list(sent), words)\n    if generated_counts is not None and freq_strength:\n        counts = np.array([generated_counts[surf(w)] for w in words], dtype=np.float64)\n        if decay_mode == \"sqrt\":\n            penalty = np.sqrt(counts)\n        elif decay_mode == \"log\":\n            penalty = np.log1p(counts)\n        elif decay_mode == \"quadratic\":\n            penalty = counts * counts\n        else:\n            penalty = counts\n        logits -= freq_strength * penalty\n    if bonus and favor:\n        spread = max(float(logits.max() - logits.min()), 1.0)\n        logits += bonus * spread * np.array([surf(w) in favor for w in words], dtype=np.float64)\n    probs = np.exp(logits - logits.max())\n    return words[rng.choice(len(words), p=probs / probs.sum())]\n\n\ndef stream_tokens(vf, tg, beta=3.0, rng=None, ctx=None, mask=None, gamma=1.0, trace=False, agenda=(), bonus=0.0, history=None, freq_strength=0.0, freq_reset=\"sentence\", decay_mode=\"linear\"):\n    rng = rng or np.random.default_rng()\n    ctx, sent, history = list(ctx or []), list(ctx or []), list(history or [])\n    pending = set(agenda) - {surf(x) for x in sent}\n    generated_counts = Counter()\n    curved = getattr(tg, \"curved\", False)\n    step = 0\n    while True:\n        table = tg.table(history) if curved and history else (tg.starts if curved else (tg.table(ctx) if ctx else tg.starts))\n        if not table:\n            ctx, sent, history = [], [], []\n            if freq_reset == \"sentence\": generated_counts.clear()\n            continue\n        w = _pick(vf, table, beta, rng, mask, sent, gamma, pending, bonus, generated_counts, freq_strength, decay_mode)\n        step += 1\n        if trace:\n            print(f\"[step {step}] {w!r} surface={surf(w)!r} generated_count={generated_counts[surf(w)]}\", file=sys.stderr)\n            if mask is not None: print(f\"[mask] role={mask.role[vf.idx[w]]}\", file=sys.stderr)\n            if curved: print(f\"[context] {tg.last}\", file=sys.stderr)\n        yield w\n        generated_counts[surf(w)] += 1\n        pending.discard(surf(w))\n        history = (history + [w])[-64:]\n        if surf(w) in SENTENCE_END:\n            ctx, sent = [], []\n            pending = set(agenda)\n            if freq_reset == \"sentence\": generated_counts.clear()\n        else:\n            ctx = (ctx + [w])[-2:]\n            sent.append(w)\n\n\ndef stream_text(tokens, first=True, cap=True):\n    for t in tokens:\n        s = surf(t)\n        if re.match(r\"[.,!?;:]\", s): chunk = s\n        else: chunk = (\"\" if first else \" \") + (s[:1].upper() + s[1:] if cap else s)\n        cap, first = s in SENTENCE_END, False\n        yield chunk\n\n\nif __name__ == \"__main__\":\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--data\", required=True)\n    ap.add_argument(\"--value\", type=float, default=3.0)\n    ap.add_argument(\"--mix\", type=float, default=0.0)\n    ap.add_argument(\"--k\", type=int, default=3)\n    ap.add_argument(\"--show\", type=int, default=10)\n    ap.add_argument(\"--beta\", type=float, default=3.0)\n    ap.add_argument(\"--gamma\", type=float, default=None, help=\"mask weight (solved from the dataset unless given)\")\n    ap.add_argument(\"--classes\", type=int, default=12)\n    ap.add_argument(\"--min-len\", type=int, default=None, help=\"min words before a sentence may end (solved unless given)\")\n    ap.add_argument(\"--no-mask\", action=\"store_true\")\n    ap.add_argument(\"--trace\", action=\"store_true\")\n    ap.add_argument(\"--copies\", type=int, default=2)\n    ap.add_argument(\"--link-seed\", type=int, default=0)\n    ap.add_argument(\"--context\", choices=(\"curved\", \"trigram\"), default=\"curved\")\n    ap.add_argument(\"--max-order\", type=int, default=10)\n    ap.add_argument(\"--curve\", type=float, default=1.6)\n    ap.add_argument(\"--pin\", type=int, default=3)\n    ap.add_argument(\"--agenda-pool\", type=int, default=32)\n    ap.add_argument(\"--agenda-chars\", type=int, default=None, help=\"knapsack character budget (solved unless given)\")\n    ap.add_argument(\"--agenda-bonus\", type=float, default=0.9)\n    ap.add_argument(\"--no-agenda\", action=\"store_true\")\n    ap.add_argument(\"--check-solver\", action=\"store_true\")\n    ap.add_argument(\"--semantic-weight\", type=float, default=1.0)\n    ap.add_argument(\"--words\", type=int, default=600)\n    ap.add_argument(\"--delay\", type=float, default=0.03)\n    ap.add_argument(\"--freq-strength\", type=float, default=None, help=\"dynamic probability reduction per generated occurrence (solved unless given)\")\n    ap.add_argument(\"--freq-reset\", choices=(\"sentence\", \"generation\"), default=\"sentence\", help=\"reset generated frequency counts at sentence boundaries or keep them for the whole generation\")\n    ap.add_argument(\"--freq-decay\", choices=(\"linear\", \"sqrt\", \"log\", \"quadratic\"), default=\"linear\", help=\"shape of the dynamic frequency penalty\")\n    ap.add_argument(\"--no-solve\", action=\"store_true\", help=\"skip the dataset solve; use the old fixed defaults\")\n    ap.add_argument(\"--standard-fraction\", type=float, default=0.1, help=\"size of the standard sample, as a fraction of the dataset's words\")\n    ap.add_argument(\"--standard-r\", type=float, default=0.35, help=\"beam-width decay of the subset-sum solver\")\n    ap.add_argument(\"--standard-beam\", type=int, default=1000, help=\"max beam width of the subset-sum solver\")\n    ap.add_argument(\"--table-path\", default=None, help=\"where the sentence table is written (default: next to --data)\")\n    args = ap.parse_args()\n\n    text = open(args.data, encoding=\"utf-8\", errors=\"ignore\").read().lower()\n    tokens = re.findall(r\"[\\w']+|[.,!?;:]\", text)\n\n    # dataset load + processing: sentence table on disk -> subset-sum -> standards -> weights\n    fixed = {\"freq_strength\": 0.75, \"gamma\": 1.0, \"min_len\": 4, \"agenda_chars\": 64}\n    if args.no_solve:\n        solved = dict(fixed)\n    else:\n        table_path = args.table_path or (args.data + \".sentlen.bin\")\n        try:\n            out = solve_from_dataset(tokens, table_path, args.standard_fraction, args.standard_r, args.standard_beam)\n        except OSError:\n            table_path = os.path.join(tempfile.gettempdir(), os.path.basename(args.data) + \".sentlen.bin\")\n            out = solve_from_dataset(tokens, table_path, args.standard_fraction, args.standard_r, args.standard_beam)\n        std_all, std_sample, solved, solved_all, info = out\n        print(f\"[standards: whole dataset] {std_all}\", file=sys.stderr)\n        print(f\"[standards: exact-size sample] {std_sample}\", file=sys.stderr)\n        print(f\"[solver] {info}\", file=sys.stderr)\n        print(f\"[weights from sample] {solved}   (from whole dataset: {solved_all})\", file=sys.stderr)\n    for key in fixed:\n        if getattr(args, key.replace(\"_\", \"_\")) is None:\n            setattr(args, key, solved[key])\n    print(f\"[weights in use] freq_strength={args.freq_strength} gamma={args.gamma} min_len={args.min_len} agenda_chars={args.agenda_chars}\", file=sys.stderr)\n\n    copies, salt = max(1, args.copies), str(args.link_seed)\n    lifted = lift_tokens(tokens, copies, salt)\n    lifted_set = set(lifted)\n    lcounts = Counter(lifted)\n    print(f\"[partition] {partition_report(tokens, lifted, copies, salt)}\", file=sys.stderr)\n    counts = Counter(tokens)\n\n    while True:\n        ptoks = re.findall(r\"[\\w']+|[.,!?;:]\", input(\"USER: \").lower())\n        is_word = lambda t: re.match(r\"[\\w']+\", t)\n        known = [w for w in dict.fromkeys(ptoks) if is_word(w) and w in counts]\n        unknown = [w for w in dict.fromkeys(ptoks) if is_word(w) and w not in counts]\n        if unknown: print(f\"[warn] not in the data, no value assigned: {unknown}\", file=sys.stderr)\n        if not known: raise SystemExit(\"no prompt word appears in the data\")\n\n        rarity = {w: max(math.log(len(tokens) / counts[w]), 1e-9) for w in known}\n        max_rarity = max(rarity.values()) or 1.0\n        rarity_scaled = {w: rarity[w] / max_rarity for w in known}\n        semantic = {w: nltk_word_value(w, ANCHOR_SYNSETS) for w in known}\n        max_sem = max(semantic.values()) or 1.0\n        semantic_scaled = {w: semantic[w] / max_sem for w in known}\n        w_sem = float(args.semantic_weight)\n        w_rar = 1.0 - w_sem\n        values = {w: args.value * (w_sem * semantic_scaled[w] + w_rar * rarity_scaled[w]) for w in known}\n        values = {tag(w, c): x for w, x in values.items() for c in range(copies) if tag(w, c) in lifted_set}\n        vf = ValueField(lifted, values, mix=args.mix, k=args.k)\n\n        agenda = []\n        if not args.no_agenda:\n            agenda, rep_ = solve_agenda(vf, lcounts, copies, args.agenda_pool, args.agenda_chars, args.check_solver)\n            print(f\"[agenda] {rep_}\", file=sys.stderr)\n\n        mask = None if args.no_mask else LogicMask(vf, lifted, n_classes=args.classes, min_len=args.min_len)\n        tg = CurvedContext(lifted, args.max_order, args.curve, args.pin) if args.context == \"curved\" else Trigrams(lifted)\n        gen_seed = int(np.random.SeedSequence().entropy % 2**32)\n        rng = np.random.default_rng(gen_seed)\n        ended = bool(ptoks) and ptoks[-1] in SENTENCE_END\n        lp = lift_prompt(ptoks, tg, copies, salt, rng)\n        ctx0 = [] if (not ptoks or ended) else lp[-2:]\n        toks = stream_tokens(vf, tg, args.beta, rng, ctx=ctx0, mask=mask, gamma=args.gamma, trace=args.trace, agenda=agenda, bonus=args.agenda_bonus, history=lp, freq_strength=args.freq_strength, freq_reset=args.freq_reset, decay_mode=args.freq_decay)\n        for n, chunk in enumerate(stream_text(toks, first=False, cap=ended), 1):\n            sys.stdout.write(chunk); sys.stdout.flush()\n            if args.delay: time.sleep(args.delay)\n            if args.words and n >= args.words: break\n        print()\n"}, "message": "Frequency-decay generator with dataset load/processing through the holographic subset-sum solver; generate weights solved from dataset standards", "integration_name": "File Creation", "integration_icon_url": null, "tool_identifier": null, "icon_name": "file", "context": null, "display_content": {"type": "json_block", "json_block": "{\"language\": \"python\", \"code\": \"#!/usr/bin/env python3\\n\\\"\\\"\\\"Dynamic frequency-decay text generator, weights solved from the dataset.\\n\\nExtends the supplied graph/byte/context/mask/copy/knapsack generator with\\none important change: during generation, every emitted surface word receives\\na growing frequency penalty. The penalty is applied at each sampling step,\\nso the probability landscape changes continuously as the stream moves on.\\n\\nThe generated-count penalty is reset at sentence boundaries, while the\\noptional global mode can keep counts for the whole generation.\\n\\nNEW  dataset load + processing through the holographic subset-sum solver\\n  1. load        the dataset is split into sentences; the word count of every\\n                 sentence is written to a compact binary table on disk\\n                 (<data>.sentlen.bin: header + uint32 per sentence, checksummed,\\n                 reused on later runs if it still matches the dataset).\\n  2. process     the supplied holographic beam-search subset-sum solver streams\\n                 that table through mmap and finds a set of sentences whose\\n                 word counts add up EXACTLY to a target size\\n                 (--standard-fraction of the dataset). That set is the\\n                 dataset's standard sample.\\n  3. standards   measured on the standard sample (and, for comparison, on the\\n                 whole dataset): mean sentence length, length spread, mean\\n                 characters per sentence, in-sentence repeat rate.\\n  4. weights     the generate function's weights are then solved from those\\n                 standards instead of being typed in:\\n                   min_len        = 0.4 * mean sentence length\\n                   agenda_chars   = 0.5 * mean characters per sentence\\n                   gamma          = 1 + max(0, 1 - spread)        regular text -> firmer mask\\n                   freq_strength  = clip(-ln(repeat rate) / 4)    rarely repeats -> harder penalty\\n                 A weight given on the command line always wins.\\n\\\"\\\"\\\"\\nimport argparse\\nimport hashlib\\nimport heapq\\nimport math\\nimport mmap\\nimport os\\nimport re\\nimport struct\\nimport sys\\nimport tempfile\\nimport time\\nimport zlib\\nfrom collections import Counter, defaultdict\\n\\nimport numpy as np\\nimport scipy.sparse as sp\\n\\nimport nltk\\nfrom nltk.corpus import wordnet\\n\\nSEP = 256\\nSENTENCE_END = {\\\".\\\", \\\"!\\\", \\\"?\\\"}\\nSOFT_PUNCT = {\\\",\\\", \\\";\\\", \\\":\\\"}\\nHARD = -30.0\\nCOPY_MARK = \\\"#\\\"\\nANCHOR_SYNSETS = [wordnet.synset(\\\"entity.n.01\\\")]\\n\\n\\ndef nltk_word_value(word, anchor_synsets, default=1e-6):\\n    synsets = wordnet.synsets(word)\\n    if not synsets or not anchor_synsets:\\n        return default\\n    best = 0.0\\n    for s in synsets:\\n        for a in anchor_synsets:\\n            try:\\n                sim = s.path_similarity(a)\\n            except Exception:\\n                sim = 0.0\\n            if sim is None:\\n                sim = 0.0\\n            best = max(best, sim)\\n    return max(best, 1e-6)\\n\\n\\n# ---------------------------------------------------------------------------\\n# holographic subset-sum solver (the supplied one), reading a binary table\\n# ---------------------------------------------------------------------------\\n\\ndef number_to_holographic_tensor(num_str, max_len):\\n    \\\"\\\"\\\"Projects a decimal number string into a 3D holographic cardinal tensor.\\\"\\\"\\\"\\n    padded = num_str.zfill(max_len)\\n    tensor = np.zeros((max_len, 10, 3), dtype=float)\\n\\n    for idx, char in enumerate(padded):\\n        digit = int(char)\\n        norm_pos = idx / max(1, max_len - 1)\\n\\n        tensor[idx, digit, 0] = 1.0 - norm_pos\\n        tensor[idx, digit, 1] = np.sin(2.0 * np.pi * (digit / 10.0))\\n        tensor[idx, digit, 2] = np.cos(2.0 * np.pi * norm_pos)\\n\\n    return tensor\\n\\n\\ndef compute_holographic_resonance(partial_val, target_str, max_len, target_tensor, target_norm):\\n    \\\"\\\"\\\"Computes structural holographic resonance against target tensor field.\\\"\\\"\\\"\\n    p_str = str(partial_val)\\n    p_tensor = number_to_holographic_tensor(p_str, max_len)\\n    p_norm = np.linalg.norm(p_tensor)\\n\\n    if p_norm == 0 or target_norm == 0:\\n        return 0.0\\n\\n    return np.sum(target_tensor * p_tensor) / (target_norm * p_norm)\\n\\n\\ndef _materialize(node):\\n    \\\"\\\"\\\"Walk an immutable path linked-list back to a plain Python list.\\\"\\\"\\\"\\n    out = []\\n    while node is not None:\\n        val, node = node\\n        out.append(val)\\n    out.reverse()\\n    return out\\n\\n\\nHEADER = struct.Struct(\\\"<4sIIII\\\")            # magic, version, sentences, words, crc32\\nMAGIC = b\\\"SSUM\\\"\\n\\n\\ndef holographic_subset_search(filepath, n, target, r=0.35, c=2, max_beam_width=1000,\\n                              offset=HEADER.size):\\n    \\\"\\\"\\\"The supplied beam search. Differences: items are read from the table\\n    after its header, the path stores ITEM INDICES (so the subset can be mapped\\n    back to sentences), and if no exact sum is reachable the closest one in the\\n    final beam is returned with exact=False.  Returns (indices, steps, exact).\\\"\\\"\\\"\\n    theoretical_cap = n ** c\\n    cap = min(theoretical_cap, max_beam_width)\\n\\n    target_str = str(target)\\n    max_len = len(target_str) + 2\\n    target_tensor = number_to_holographic_tensor(target_str, max_len)\\n    target_norm = np.linalg.norm(target_tensor)\\n\\n    beam = [(0, None)]\\n\\n    with open(filepath, \\\"rb\\\") as f:\\n        with mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ) as mm:\\n            for k in range(1, n + 1):\\n                pos = offset + (k - 1) * 4\\n                x = struct.unpack(\\\"<I\\\", mm[pos:pos + 4])[0]\\n\\n                seen = {}\\n                for partial, node in beam:\\n                    if partial not in seen:\\n                        seen[partial] = node\\n                    new_partial = partial + x\\n                    if new_partial <= target and new_partial not in seen:\\n                        seen[new_partial] = (k - 1, node)\\n\\n                if target in seen:\\n                    return _materialize(seen[target]), k, True\\n\\n                log_width = n * math.log(2) + k * math.log(1 - r)\\n                if log_width > math.log(cap):\\n                    width = cap\\n                else:\\n                    width = max(1, min(cap, math.ceil(math.exp(log_width))))\\n\\n                items = list(seen.items())\\n                if len(items) <= width:\\n                    beam = items\\n                else:\\n                    scored_items = []\\n                    for partial, node in items:\\n                        dist_penalty = abs(target - partial)\\n                        resonance = compute_holographic_resonance(\\n                            partial, target_str, max_len, target_tensor, target_norm)\\n                        hybrid_score = dist_penalty - (resonance * 10.0)\\n                        scored_items.append((hybrid_score, partial, node))\\n\\n                    best_items = heapq.nsmallest(width, scored_items)\\n                    beam = [(partial, node) for _, partial, node in best_items]\\n\\n    best = min(beam, key=lambda b: abs(target - b[0]))\\n    return _materialize(best[1]), n, best[0] == target\\n\\n\\n# ---------------------------------------------------------------------------\\n# dataset load + processing: sentence table on disk, standard sample, weights\\n# ---------------------------------------------------------------------------\\n\\n_is_word = re.compile(r\\\"[\\\\w']+\\\").match\\n\\n\\ndef split_sentences(tokens):\\n    sents, cur = [], []\\n    for t in tokens:\\n        cur.append(t)\\n        if t in SENTENCE_END:\\n            sents.append(cur)\\n            cur = []\\n    if cur:\\n        sents.append(cur)\\n    return [s for s in sents if any(_is_word(w) for w in s)]\\n\\n\\ndef word_count(sent):\\n    return sum(1 for w in sent if _is_word(w))\\n\\n\\ndef sentence_table(tokens, path):\\n    \\\"\\\"\\\"Write (or reuse) the binary table of sentence word counts.\\\"\\\"\\\"\\n    sents = split_sentences(tokens)\\n    lens = [word_count(s) for s in sents]\\n    payload = struct.pack(f\\\"<{len(lens)}I\\\", *lens)\\n    head = HEADER.pack(MAGIC, 1, len(sents), sum(lens), zlib.crc32(payload))\\n\\n    if os.path.exists(path) and os.path.getsize(path) == HEADER.size + len(payload):\\n        with open(path, \\\"rb\\\") as f:\\n            if f.read(HEADER.size) == head:\\n                return sents, lens, True                        # still matches the dataset\\n    with open(path, \\\"wb\\\") as f:\\n        f.write(head)\\n        f.write(payload)\\n    return sents, lens, False\\n\\n\\ndef sentence_standards(sents, window=6):\\n    \\\"\\\"\\\"Standards measured on a set of sentences. A 'content' word has >= 4\\n    letters; a repeat is a content word seen again within `window` words of\\n    the same sentence.\\\"\\\"\\\"\\n    lens = np.array([word_count(s) for s in sents], dtype=float)\\n    chars = np.array([sum(len(w) + 1 for w in s if _is_word(w)) for s in sents], dtype=float)\\n    repeats = content = 0\\n    every = []\\n    for s in sents:\\n        ws = [w for w in s if _is_word(w)]\\n        every += ws\\n        for i, w in enumerate(ws):\\n            if len(w) >= 4:\\n                content += 1\\n                if w in ws[max(0, i - window):i]:\\n                    repeats += 1\\n    mean_len = float(lens.mean())\\n    return {\\n        \\\"sentences\\\": len(sents),\\n        \\\"mean_len\\\": round(mean_len, 3),\\n        \\\"spread\\\": round(float(lens.std()) / max(mean_len, 1e-9), 3),\\n        \\\"mean_chars\\\": round(float(chars.mean()), 3),\\n        \\\"repeat_rate\\\": round(repeats / max(content, 1), 4),\\n    }\\n\\n\\ndef solve_weights(std):\\n    \\\"\\\"\\\"Generate-function weights from the standards.\\\"\\\"\\\"\\n    return {\\n        \\\"min_len\\\": max(2, int(round(0.4 * std[\\\"mean_len\\\"]))),\\n        \\\"agenda_chars\\\": max(12, int(round(0.5 * std[\\\"mean_chars\\\"]))),\\n        \\\"gamma\\\": round(1.0 + max(0.0, 1.0 - std[\\\"spread\\\"]), 3),\\n        \\\"freq_strength\\\": round(float(np.clip(-math.log(max(std[\\\"repeat_rate\\\"], 0.02)) / 4.0, 0.1, 2.0)), 3),\\n    }\\n\\n\\ndef solve_from_dataset(tokens, path, fraction=0.1, r=0.35, beam=1000):\\n    sents, lens, reused = sentence_table(tokens, path)\\n    total = sum(lens)\\n    target = max(1, min(total, int(round(fraction * total))))\\n    idx, steps, exact = holographic_subset_search(path, len(sents), target, r,\\n                                                  max_beam_width=beam)\\n    chosen = [sents[i] for i in idx]\\n    std_all = sentence_standards(sents)\\n    std_sample = sentence_standards(chosen) if chosen else std_all\\n    check = {\\n        \\\"table_reused\\\": reused,\\n        \\\"exact_sum\\\": exact and sum(lens[i] for i in idx) == target,\\n        \\\"subset_valid\\\": idx == sorted(set(idx)) and all(0 <= i < len(sents) for i in idx),\\n    }\\n    info = {\\\"sentences\\\": len(sents), \\\"words\\\": total, \\\"target_words\\\": target,\\n            \\\"sample_sentences\\\": len(idx), \\\"steps\\\": steps, **check}\\n    return std_all, std_sample, solve_weights(std_sample), solve_weights(std_all), info\\n\\n\\n# ---------------------------------------------------------------------------\\n\\ndef surf(token):\\n    return token.partition(COPY_MARK)[0]\\n\\n\\ndef copy_of(token):\\n    _, _, c = token.partition(COPY_MARK)\\n    return int(c) if c else 0\\n\\n\\ndef tag(word, copy):\\n    return word if copy == 0 else f\\\"{word}{COPY_MARK}{copy}\\\"\\n\\n\\ndef shift_token(token, offset, copies):\\n    return tag(surf(token), (copy_of(token) + offset) % copies)\\n\\n\\ndef link_class(first, second, copies, salt=\\\"\\\"):\\n    digest = hashlib.blake2b(f\\\"{salt}\\\\x00{first}\\\\x00{second}\\\".encode(\\\"utf-8\\\"), digest_size=8).digest()\\n    return int.from_bytes(digest, \\\"big\\\") % copies\\n\\n\\ndef lift_tokens(tokens, copies, salt=\\\"\\\"):\\n    out, copy, previous = [], 0, None\\n    for t in tokens:\\n        if previous is not None:\\n            copy = (copy + link_class(previous, t, copies, salt)) % copies\\n        out.append(tag(t, copy))\\n        previous = t\\n    return out\\n\\n\\ndef lift_prompt(ptoks, tg, copies, salt, rng):\\n    rel = lift_tokens(ptoks, copies, salt)\\n    if copies == 1 or not rel:\\n        return rel\\n    weights = []\\n    for o in range(copies):\\n        shifted = [shift_token(t, o, copies) for t in rel]\\n        w = 0.0\\n        if len(shifted) >= 2 and (shifted[-2], shifted[-1]) in tg.tri:\\n            w = float(sum(tg.tri[(shifted[-2], shifted[-1])].values()))\\n        elif shifted[-1] in tg.bi:\\n            w = 0.01 * float(sum(tg.bi[shifted[-1]].values()))\\n        weights.append(w)\\n    weights = np.array(weights)\\n    o = 0 if weights.sum() == 0 else int(rng.choice(copies, p=weights / weights.sum()))\\n    return [shift_token(t, o, copies) for t in rel]\\n\\n\\ndef partition_report(tokens, lifted, copies, salt):\\n    seen, distinct, occ = set(), Counter(), Counter()\\n    for a, b in zip(tokens, tokens[1:]):\\n        c = link_class(a, b, copies, salt)\\n        occ[c] += 1\\n        if (a, b) not in seen:\\n            seen.add((a, b))\\n            distinct[c] += 1\\n    return {\\\"copies\\\": copies, \\\"vocab\\\": len(set(lifted)), \\\"distinct_links_per_class\\\": dict(sorted(distinct.items())), \\\"occurrences_per_class\\\": dict(sorted(occ.items())), \\\"projects_back_to_dataset\\\": [surf(t) for t in lifted] == tokens}\\n\\n\\ndef subset_table(items):\\n    W = np.zeros(1, dtype=np.int64)\\n    V = np.zeros(1)\\n    M = np.zeros(1, dtype=np.int64)\\n    for i, (w, v) in enumerate(items):\\n        W = np.concatenate([W, W + w])\\n        V = np.concatenate([V, V + v])\\n        M = np.concatenate([M, M | (1 << i)])\\n    return W, V, M\\n\\n\\ndef knapsack_mitm(set_a, set_b, budget):\\n    WA, VA, MA = subset_table(set_a)\\n    WB, VB, MB = subset_table(set_b)\\n    oa = np.argsort(WA, kind=\\\"stable\\\")\\n    ob = np.argsort(-WB, kind=\\\"stable\\\")\\n    WA, VA, MA = WA[oa], VA[oa], MA[oa]\\n    WB, VB, MB = WB[ob], VB[ob], MB[ob]\\n    nb = len(WB)\\n    sufv = np.empty(nb)\\n    sufi = np.empty(nb, dtype=np.int64)\\n    best_v, best_i = -1.0, 0\\n    for j in range(nb - 1, -1, -1):\\n        if VB[j] > best_v:\\n            best_v, best_i = VB[j], j\\n        sufv[j], sufi[j] = best_v, best_i\\n    best = (-1.0, 0, 0)\\n    j = 0\\n    for a in range(len(WA)):\\n        room = budget - WA[a]\\n        if room < 0:\\n            break\\n        while j < nb and WB[j] > room:\\n            j += 1\\n        if j == nb:\\n            break\\n        total = VA[a] + sufv[j]\\n        if total > best[0]:\\n            best = (total, int(MA[a]), int(MB[sufi[j]]))\\n    return best[0], best[1], best[2], len(WA) + len(WB)\\n\\n\\ndef knapsack_brute(items, budget):\\n    W, V, _ = subset_table(items)\\n    return float(V[W <= budget].max())\\n\\n\\ndef solve_agenda(vf, lcounts, copies, pool=18, budget=30, check=False):\\n    by_surface = defaultdict(list)\\n    for t in vf.vocab:\\n        if re.fullmatch(r\\\"[\\\\w']+\\\", surf(t)):\\n            by_surface[surf(t)].append(t)\\n    cand = []\\n    for word, toks in by_surface.items():\\n        home = max(toks, key=lambda t: (lcounts[t], -copy_of(t)))\\n        cand.append((word, home, float(vf.field[vf.idx[home]])))\\n    cand = [c for c in sorted(cand, key=lambda c: -c[2])[:pool] if c[2] > 1e-6]\\n    halves = ([], [])\\n    for rank, (word, home, val) in enumerate(cand):\\n        h = copy_of(home) % 2 if copies >= 2 else rank % 2\\n        halves[h].append((word, len(word) + 1, val))\\n    value, ma, mb, ops = knapsack_mitm([(w, v) for _, w, v in halves[0]], [(w, v) for _, w, v in halves[1]], budget)\\n    words = [halves[0][i][0] for i in range(len(halves[0])) if ma >> i & 1] + [halves[1][i][0] for i in range(len(halves[1])) if mb >> i & 1]\\n    report = {\\\"candidates\\\": len(cand), \\\"half_A\\\": len(halves[0]), \\\"half_B\\\": len(halves[1]), \\\"agenda\\\": words, \\\"chars\\\": sum(len(w) + 1 for w in words), \\\"budget\\\": budget, \\\"value\\\": round(value, 3), \\\"subsets_examined\\\": ops, \\\"brute_force_would_examine\\\": 2 ** len(cand)}\\n    if check and len(cand) <= 22:\\n        brute = knapsack_brute([(len(w) + 1, v) for w, _, v in cand], budget)\\n        report[\\\"matches_brute_force\\\"] = bool(abs(brute - max(value, 0.0)) < 1e-9)\\n    return words, report\\n\\n\\ndef normalize_rows(M):\\n    s = np.asarray(M.sum(axis=1)).ravel()\\n    s[s == 0] = 1.0\\n    return sp.diags(1.0 / s) @ M if sp.issparse(M) else M / s[:, None]\\n\\n\\ndef word_states(word, k=3):\\n    seq = (SEP,) + tuple(word.encode(\\\"utf-8\\\")) + (SEP,)\\n    seq = seq + (SEP,) * max(0, k - len(seq))\\n    return [seq[i:i + k] for i in range(len(seq) - k + 1)]\\n\\n\\nclass ValueField:\\n    def __init__(self, tokens, values, top=5, hops=3, decay=0.5, mix=0.5, k=3):\\n        self.k = k\\n        self.vocab = sorted(set(tokens))\\n        self.idx = {w: i for i, w in enumerate(self.vocab)}\\n        n = len(self.vocab)\\n        C = np.zeros((n, n))\\n        for a, b in zip(tokens, tokens[1:]):\\n            C[self.idx[a], self.idx[b]] += 1.0\\n        X = np.hstack([normalize_rows(C), normalize_rows(C.T)])\\n        X /= np.maximum(np.linalg.norm(X, axis=1, keepdims=True), 1e-12)\\n        self.X = X\\n        S = X @ X.T\\n        np.fill_diagonal(S, 0.0)\\n        K = np.zeros_like(S)\\n        for i in range(n):\\n            j = np.argsort(S[i])[-top:]\\n            K[i, j] = S[i, j]\\n        K = np.maximum(K, K.T)\\n        d = np.sqrt(np.maximum(K.sum(axis=1), 1e-12))\\n        Sn = K / np.outer(d, d)\\n        self.states = {}\\n        rows, cols, edges = [], [], set()\\n        for wi, w in enumerate(self.vocab):\\n            path = [self.states.setdefault(st, len(self.states)) for st in word_states(surf(w), k)]\\n            rows += [wi] * len(path)\\n            cols += path\\n            for a, b in zip(path, path[1:]):\\n                edges.add((a, b)); edges.add((b, a))\\n        ns = len(self.states)\\n        B = normalize_rows(sp.csr_matrix((np.ones(len(rows)), (rows, cols)), shape=(n, ns)))\\n        er, ec = zip(*edges) if edges else ([], [])\\n        A = sp.csr_matrix((np.ones(len(er)), (er, ec)), shape=(ns, ns))\\n        A.data[:] = 1.0\\n        dd = 1.0 / np.sqrt(np.maximum(np.asarray(A.sum(axis=1)).ravel(), 1e-12))\\n        Sb = sp.diags(dd) @ A @ sp.diags(dd)\\n        v0 = np.zeros(n)\\n        for w, x in values.items():\\n            if w in self.idx:\\n                v0[self.idx[w]] = x\\n        cur, self.field = v0, v0.copy()\\n        self.tiers = [v0]\\n        self.state_field = B.T @ v0\\n        for _ in range(hops):\\n            via_use = Sn @ cur\\n            st = Sb @ (B.T @ cur)\\n            via_bytes = B @ st\\n            cur = decay * (mix * via_use + (1 - mix) * via_bytes)\\n            self.state_field = self.state_field + (1 - mix) * decay * st\\n            self.field = self.field + cur\\n            self.tiers.append(cur)\\n\\n    def read(self, word):\\n        ids = [self.states[s] for s in word_states(surf(word), self.k) if s in self.states]\\n        return float(np.mean(self.state_field[ids])) if ids else 0.0\\n\\n\\nclass LogicMask:\\n    def __init__(self, vf, tokens, n_classes=12, min_len=4, window=6, floor=1e-3, seed=0, iters=15):\\n        self.vf, self.min_len, self.window, self.floor = vf, min_len, window, floor\\n        rng = np.random.default_rng(seed)\\n        n = len(vf.vocab)\\n        Z = vf.X @ rng.standard_normal((vf.X.shape[1], min(32, vf.X.shape[1])))\\n        Z /= np.maximum(np.linalg.norm(Z, axis=1, keepdims=True), 1e-12)\\n        k = max(1, min(n_classes, n))\\n        cent = Z[rng.choice(n, k, replace=False)].copy()\\n        lab = np.zeros(n, dtype=int)\\n        for _ in range(iters):\\n            lab = np.argmax(Z @ cent.T, axis=1)\\n            for c in range(k):\\n                m = lab == c\\n                if m.any():\\n                    v = Z[m].mean(axis=0); cent[c] = v / max(np.linalg.norm(v), 1e-12)\\n        self.END, self.PUNCT, self.BOS = k, k + 1, k + 2\\n        self.R = k + 2\\n        self.role = lab.copy()\\n        for w, i in vf.idx.items():\\n            if surf(w) in SENTENCE_END: self.role[i] = self.END\\n            elif surf(w) in SOFT_PUNCT: self.role[i] = self.PUNCT\\n        self.bi = np.zeros((self.BOS + 1, self.R))\\n        self.tri = defaultdict(lambda: np.zeros(self.R))\\n        prev = [self.BOS]\\n        for t in tokens:\\n            r = self.role[vf.idx[t]]\\n            self.bi[prev[-1], r] += 1\\n            if len(prev) >= 2: self.tri[(prev[-2], prev[-1])][r] += 1\\n            prev = [self.BOS] if surf(t) in SENTENCE_END else (prev + [r])[-2:]\\n        rs = self.bi.sum(axis=1, keepdims=True)\\n        self.p_end = np.where(rs[:, 0] > 0, self.bi[:, self.END] / np.maximum(rs[:, 0], 1), 0.0)\\n\\n    def roles_of(self, words):\\n        return [self.role[self.vf.idx[w]] for w in words if w in self.vf.idx]\\n\\n    def bias(self, sent_words, cand_words):\\n        roles = [self.BOS] + self.roles_of(sent_words)\\n        last = roles[-1]\\n        dist = self.tri.get((roles[-2], roles[-1])) if len(roles) >= 2 else None\\n        if dist is None or dist.sum() == 0: dist = self.bi[last]\\n        dist = dist / max(dist.sum(), 1e-12)\\n        recent = {surf(x) for x in sent_words[-self.window:]}\\n        n_words = sum(1 for w in sent_words if surf(w) not in SOFT_PUNCT)\\n        out = np.zeros(len(cand_words))\\n        for i, w in enumerate(cand_words):\\n            r = self.role[self.vf.idx[w]]\\n            b = math.log(dist[r] + self.floor)\\n            if r == self.END:\\n                # R2: END only after `min_len` words and only after a role that\\n                # has ended sentences (restored: it had slipped outside this\\n                # `if`, which penalised every candidate and made min_len inert)\\n                b += math.log(self.p_end[last] + self.floor)\\n                if n_words < self.min_len or last in (self.BOS, self.PUNCT): b += HARD\\n            if r in (self.END, self.PUNCT) and last in (self.BOS, self.END, self.PUNCT): b += HARD\\n            if r < self.END and surf(w) in recent: b += HARD / 3\\n            out[i] = b\\n        return out\\n\\n\\nclass Trigrams:\\n    def __init__(self, tokens):\\n        self.tri, self.bi = defaultdict(Counter), defaultdict(Counter)\\n        self.starts = Counter(tokens[:1])\\n        for a, b in zip(tokens, tokens[1:]):\\n            if surf(a) in SENTENCE_END: self.starts[b] += 1\\n        for a, b, c in zip(tokens, tokens[1:], tokens[2:]): self.tri[(a, b)][c] += 1\\n        for a, b in zip(tokens, tokens[1:]): self.bi[a][b] += 1\\n\\n    def table(self, out):\\n        if len(out) >= 2 and (out[-2], out[-1]) in self.tri: return self.tri[(out[-2], out[-1])]\\n        return self.bi.get(out[-1])\\n\\n\\ndef curved_schedule(max_order, power):\\n    ks, j = [], 0\\n    while True:\\n        k = 1 + int(round(j ** power))\\n        if k > max_order: break\\n        if not ks or k > ks[-1]: ks.append(k)\\n        j += 1\\n    return ks\\n\\n\\nclass CurvedContext(Trigrams):\\n    curved = True\\n    def __init__(self, tokens, max_order=10, power=1.6, pin=1):\\n        super().__init__(tokens)\\n        self.tokens, self.pin = tokens, pin\\n        self.schedule = curved_schedule(max_order, power)\\n        self.index = {k: defaultdict(list) for k in self.schedule}\\n        for k in self.schedule:\\n            for i in range(k - 1, len(tokens) - 1): self.index[k][tuple(tokens[i-k+1:i+1])].append(i)\\n        self.last = {\\\"order\\\": 0, \\\"positions\\\": 0, \\\"pinned\\\": False}\\n\\n    def table(self, history):\\n        best = None\\n        for k in self.schedule:\\n            if k > len(history): break\\n            positions = self.index[k].get(tuple(history[-k:]))\\n            if not positions: break\\n            best = (k, positions)\\n            if len(positions) <= self.pin: break\\n        if best is None:\\n            self.last = {\\\"order\\\": 0, \\\"positions\\\": 0, \\\"pinned\\\": False}\\n            return Trigrams.table(self, history)\\n        k, positions = best\\n        self.last = {\\\"order\\\": k, \\\"positions\\\": len(positions), \\\"pinned\\\": len(positions) <= self.pin}\\n        return Counter(self.tokens[p + 1] for p in positions)\\n\\n\\ndef _pick(vf, table, beta, rng, mask=None, sent=(), gamma=1.0, favor=(), bonus=0.0, generated_counts=None, freq_strength=0.0, decay_mode=\\\"linear\\\"):\\n    words = list(table)\\n    p = np.array([table[w] for w in words], dtype=np.float64)\\n    logits = np.log(p / p.sum()) + beta * np.exp(vf.field[[vf.idx[w] for w in words]])\\n    if mask is not None: logits += gamma * mask.bias(list(sent), words)\\n    if generated_counts is not None and freq_strength:\\n        counts = np.array([generated_counts[surf(w)] for w in words], dtype=np.float64)\\n        if decay_mode == \\\"sqrt\\\":\\n            penalty = np.sqrt(counts)\\n        elif decay_mode == \\\"log\\\":\\n            penalty = np.log1p(counts)\\n        elif decay_mode == \\\"quadratic\\\":\\n            penalty = counts * counts\\n        else:\\n            penalty = counts\\n        logits -= freq_strength * penalty\\n    if bonus and favor:\\n        spread = max(float(logits.max() - logits.min()), 1.0)\\n        logits += bonus * spread * np.array([surf(w) in favor for w in words], dtype=np.float64)\\n    probs = np.exp(logits - logits.max())\\n    return words[rng.choice(len(words), p=probs / probs.sum())]\\n\\n\\ndef stream_tokens(vf, tg, beta=3.0, rng=None, ctx=None, mask=None, gamma=1.0, trace=False, agenda=(), bonus=0.0, history=None, freq_strength=0.0, freq_reset=\\\"sentence\\\", decay_mode=\\\"linear\\\"):\\n    rng = rng or np.random.default_rng()\\n    ctx, sent, history = list(ctx or []), list(ctx or []), list(history or [])\\n    pending = set(agenda) - {surf(x) for x in sent}\\n    generated_counts = Counter()\\n    curved = getattr(tg, \\\"curved\\\", False)\\n    step = 0\\n    while True:\\n        table = tg.table(history) if curved and history else (tg.starts if curved else (tg.table(ctx) if ctx else tg.starts))\\n        if not table:\\n            ctx, sent, history = [], [], []\\n            if freq_reset == \\\"sentence\\\": generated_counts.clear()\\n            continue\\n        w = _pick(vf, table, beta, rng, mask, sent, gamma, pending, bonus, generated_counts, freq_strength, decay_mode)\\n        step += 1\\n        if trace:\\n            print(f\\\"[step {step}] {w!r} surface={surf(w)!r} generated_count={generated_counts[surf(w)]}\\\", file=sys.stderr)\\n            if mask is not None: print(f\\\"[mask] role={mask.role[vf.idx[w]]}\\\", file=sys.stderr)\\n            if curved: print(f\\\"[context] {tg.last}\\\", file=sys.stderr)\\n        yield w\\n        generated_counts[surf(w)] += 1\\n        pending.discard(surf(w))\\n        history = (history + [w])[-64:]\\n        if surf(w) in SENTENCE_END:\\n            ctx, sent = [], []\\n            pending = set(agenda)\\n            if freq_reset == \\\"sentence\\\": generated_counts.clear()\\n        else:\\n            ctx = (ctx + [w])[-2:]\\n            sent.append(w)\\n\\n\\ndef stream_text(tokens, first=True, cap=True):\\n    for t in tokens:\\n        s = surf(t)\\n        if re.match(r\\\"[.,!?;:]\\\", s): chunk = s\\n        else: chunk = (\\\"\\\" if first else \\\" \\\") + (s[:1].upper() + s[1:] if cap else s)\\n        cap, first = s in SENTENCE_END, False\\n        yield chunk\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    ap = argparse.ArgumentParser()\\n    ap.add_argument(\\\"--data\\\", required=True)\\n    ap.add_argument(\\\"--value\\\", type=float, default=3.0)\\n    ap.add_argument(\\\"--mix\\\", type=float, default=0.0)\\n    ap.add_argument(\\\"--k\\\", type=int, default=3)\\n    ap.add_argument(\\\"--show\\\", type=int, default=10)\\n    ap.add_argument(\\\"--beta\\\", type=float, default=3.0)\\n    ap.add_argument(\\\"--gamma\\\", type=float, default=None, help=\\\"mask weight (solved from the dataset unless given)\\\")\\n    ap.add_argument(\\\"--classes\\\", type=int, default=12)\\n    ap.add_argument(\\\"--min-len\\\", type=int, default=None, help=\\\"min words before a sentence may end (solved unless given)\\\")\\n    ap.add_argument(\\\"--no-mask\\\", action=\\\"store_true\\\")\\n    ap.add_argument(\\\"--trace\\\", action=\\\"store_true\\\")\\n    ap.add_argument(\\\"--copies\\\", type=int, default=2)\\n    ap.add_argument(\\\"--link-seed\\\", type=int, default=0)\\n    ap.add_argument(\\\"--context\\\", choices=(\\\"curved\\\", \\\"trigram\\\"), default=\\\"curved\\\")\\n    ap.add_argument(\\\"--max-order\\\", type=int, default=10)\\n    ap.add_argument(\\\"--curve\\\", type=float, default=1.6)\\n    ap.add_argument(\\\"--pin\\\", type=int, default=3)\\n    ap.add_argument(\\\"--agenda-pool\\\", type=int, default=32)\\n    ap.add_argument(\\\"--agenda-chars\\\", type=int, default=None, help=\\\"knapsack character budget (solved unless given)\\\")\\n    ap.add_argument(\\\"--agenda-bonus\\\", type=float, default=0.9)\\n    ap.add_argument(\\\"--no-agenda\\\", action=\\\"store_true\\\")\\n    ap.add_argument(\\\"--check-solver\\\", action=\\\"store_true\\\")\\n    ap.add_argument(\\\"--semantic-weight\\\", type=float, default=1.0)\\n    ap.add_argument(\\\"--words\\\", type=int, default=600)\\n    ap.add_argument(\\\"--delay\\\", type=float, default=0.03)\\n    ap.add_argument(\\\"--freq-strength\\\", type=float, default=None, help=\\\"dynamic probability reduction per generated occurrence (solved unless given)\\\")\\n    ap.add_argument(\\\"--freq-reset\\\", choices=(\\\"sentence\\\", \\\"generation\\\"), default=\\\"sentence\\\", help=\\\"reset generated frequency counts at sentence boundaries or keep them for the whole generation\\\")\\n    ap.add_argument(\\\"--freq-decay\\\", choices=(\\\"linear\\\", \\\"sqrt\\\", \\\"log\\\", \\\"quadratic\\\"), default=\\\"linear\\\", help=\\\"shape of the dynamic frequency penalty\\\")\\n    ap.add_argument(\\\"--no-solve\\\", action=\\\"store_true\\\", help=\\\"skip the dataset solve; use the old fixed defaults\\\")\\n    ap.add_argument(\\\"--standard-fraction\\\", type=float, default=0.1, help=\\\"size of the standard sample, as a fraction of the dataset's words\\\")\\n    ap.add_argument(\\\"--standard-r\\\", type=float, default=0.35, help=\\\"beam-width decay of the subset-sum solver\\\")\\n    ap.add_argument(\\\"--standard-beam\\\", type=int, default=1000, help=\\\"max beam width of the subset-sum solver\\\")\\n    ap.add_argument(\\\"--table-path\\\", default=None, help=\\\"where the sentence table is written (default: next to --data)\\\")\\n    args = ap.parse_args()\\n\\n    text = open(args.data, encoding=\\\"utf-8\\\", errors=\\\"ignore\\\").read().lower()\\n    tokens = re.findall(r\\\"[\\\\w']+|[.,!?;:]\\\", text)\\n\\n    # dataset load + processing: sentence table on disk -> subset-sum -> standards -> weights\\n    fixed = {\\\"freq_strength\\\": 0.75, \\\"gamma\\\": 1.0, \\\"min_len\\\": 4, \\\"agenda_chars\\\": 64}\\n    if args.no_solve:\\n        solved = dict(fixed)\\n    else:\\n        table_path = args.table_path or (args.data + \\\".sentlen.bin\\\")\\n        try:\\n            out = solve_from_dataset(tokens, table_path, args.standard_fraction, args.standard_r, args.standard_beam)\\n        except OSError:\\n            table_path = os.path.join(tempfile.gettempdir(), os.path.basename(args.data) + \\\".sentlen.bin\\\")\\n            out = solve_from_dataset(tokens, table_path, args.standard_fraction, args.standard_r, args.standard_beam)\\n        std_all, std_sample, solved, solved_all, info = out\\n        print(f\\\"[standards: whole dataset] {std_all}\\\", file=sys.stderr)\\n        print(f\\\"[standards: exact-size sample] {std_sample}\\\", file=sys.stderr)\\n        print(f\\\"[solver] {info}\\\", file=sys.stderr)\\n        print(f\\\"[weights from sample] {solved}   (from whole dataset: {solved_all})\\\", file=sys.stderr)\\n    for key in fixed:\\n        if getattr(args, key.replace(\\\"_\\\", \\\"_\\\")) is None:\\n            setattr(args, key, solved[key])\\n    print(f\\\"[weights in use] freq_strength={args.freq_strength} gamma={args.gamma} min_len={args.min_len} agenda_chars={args.agenda_chars}\\\", file=sys.stderr)\\n\\n    copies, salt = max(1, args.copies), str(args.link_seed)\\n    lifted = lift_tokens(tokens, copies, salt)\\n    lifted_set = set(lifted)\\n    lcounts = Counter(lifted)\\n    print(f\\\"[partition] {partition_report(tokens, lifted, copies, salt)}\\\", file=sys.stderr)\\n    counts = Counter(tokens)\\n\\n    while True:\\n        ptoks = re.findall(r\\\"[\\\\w']+|[.,!?;:]\\\", input(\\\"USER: \\\").lower())\\n        is_word = lambda t: re.match(r\\\"[\\\\w']+\\\", t)\\n        known = [w for w in dict.fromkeys(ptoks) if is_word(w) and w in counts]\\n        unknown = [w for w in dict.fromkeys(ptoks) if is_word(w) and w not in counts]\\n        if unknown: print(f\\\"[warn] not in the data, no value assigned: {unknown}\\\", file=sys.stderr)\\n        if not known: raise SystemExit(\\\"no prompt word appears in the data\\\")\\n\\n        rarity = {w: max(math.log(len(tokens) / counts[w]), 1e-9) for w in known}\\n        max_rarity = max(rarity.values()) or 1.0\\n        rarity_scaled = {w: rarity[w] / max_rarity for w in known}\\n        semantic = {w: nltk_word_value(w, ANCHOR_SYNSETS) for w in known}\\n        max_sem = max(semantic.values()) or 1.0\\n        semantic_scaled = {w: semantic[w] / max_sem for w in known}\\n        w_sem = float(args.semantic_weight)\\n        w_rar = 1.0 - w_sem\\n        values = {w: args.value * (w_sem * semantic_scaled[w] + w_rar * rarity_scaled[w]) for w in known}\\n        values = {tag(w, c): x for w, x in values.items() for c in range(copies) if tag(w, c) in lifted_set}\\n        vf = ValueField(lifted, values, mix=args.mix, k=args.k)\\n\\n        agenda = []\\n        if not args.no_agenda:\\n            agenda, rep_ = solve_agenda(vf, lcounts, copies, args.agenda_pool, args.agenda_chars, args.check_solver)\\n            print(f\\\"[agenda] {rep_}\\\", file=sys.stderr)\\n\\n        mask = None if args.no_mask else LogicMask(vf, lifted, n_classes=args.classes, min_len=args.min_len)\\n        tg = CurvedContext(lifted, args.max_order, args.curve, args.pin) if args.context == \\\"curved\\\" else Trigrams(lifted)\\n        gen_seed = int(np.random.SeedSequence().entropy % 2**32)\\n        rng = np.random.default_rng(gen_seed)\\n        ended = bool(ptoks) and ptoks[-1] in SENTENCE_END\\n        lp = lift_prompt(ptoks, tg, copies, salt, rng)\\n        ctx0 = [] if (not ptoks or ended) else lp[-2:]\\n        toks = stream_tokens(vf, tg, args.beta, rng, ctx=ctx0, mask=mask, gamma=args.gamma, trace=args.trace, agenda=agenda, bonus=args.agenda_bonus, history=lp, freq_strength=args.freq_strength, freq_reset=args.freq_reset, decay_mode=args.freq_decay)\\n        for n, chunk in enumerate(stream_text(toks, first=False, cap=ended), 1):\\n            sys.stdout.write(chunk); sys.stdout.flush()\\n            if args.delay: time.sleep(args.delay)\\n            if args.words and n >= args.words: break\\n        print()\\n\", \"filename\": \"/mnt/user-data/outputs/word_values_solved.py\"}"}, "approval_options": null, "approval_key": null, "approval_key_legacy": null, "is_mcp_app": null, "hidden_in_chat": null, "mcp_server_url": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-09-30T21:00:17.670754Z", "stop_timestamp": "2026-09-30T21:00:17.670796Z", "flags": null, "type": "tool_result", "tool_use_id": "toolu_01KtDCH4EN1wm2cuHwmXbD5U", "name": "create_file", "content": [{"type": "text", "text": "File created successfully: /mnt/user-data/outputs/word_values_solved.py"}], "is_error": false, "structured_content": null, "meta": {"output_format_category": "other"}, "message": null, "integration_name": "File Creation", "mcp_server_url": null, "integration_icon_url": null, "icon_name": "file", "display_content": {"type": "text", "text": "File created successfully: /mnt/user-data/outputs/word_values_solved.py"}, "hidden_in_chat": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-09-30T21:00:21.400578Z", "stop_timestamp": "2026-09-30T21:00:23.807761Z", "flags": null, "type": "tool_use", "id": "toolu_013uxneBsWy8qGZXkXGmit33", "name": "bash_tool", "input": {"command": "cd /mnt/user-data/outputs && sed -i 's/getattr(args, key.replace(\"_\", \"_\"))/getattr(args, key)/' word_values_solved.py\nmkdir -p /tmp/stubs/nltk/corpus && echo \"\" > /tmp/stubs/nltk/__init__.py && cat > /tmp/stubs/nltk/corpus/__init__.py << 'EOF'\nclass _WN:                      # test stub: no real WordNet in this sandbox\n    def synset(self, name): return object()\n    def synsets(self, word): return []\nwordnet = _WN()\nEOF\nexport PYTHONPATH=/tmp/stubs\ncp /usr/share/common-licenses/GPL-3 /tmp/gpl3.txt; rm -f /tmp/gpl3.txt.sentlen.bin\necho \"=== first run (writes the sentence table)\"; printf 'license\\n' | python3 word_values_solved.py --data /tmp/gpl3.txt --semantic-weight 0 --words 40 --delay 0 2>&1 | grep -E \"^\\[(standards|solver|weights)|^USER\" | cut -c1-330\necho; echo \"=== second run (reuses the table)\"; printf 'license\\n' | python3 word_values_solved.py --data /tmp/gpl3.txt --semantic-weight 0 --words 5 --delay 0 2>&1 | grep -E \"^\\[solver\\]\" | cut -c1-330\nls -la /tmp/gpl3.txt.sentlen.bin"}, "message": "Running command", "integration_name": "File Creation", "integration_icon_url": null, "tool_identifier": null, "icon_name": "commandLine", "context": null, "display_con