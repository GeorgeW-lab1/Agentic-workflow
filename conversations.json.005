"\nobj.inner_points_path = \"brain_inner_points.npy\"\nobj._build_or_load_brain_surface = app_module.NeuralBeamSimulationApp._build_or_load_brain_surface.__get__(obj)\nobj._build_or_load_inner_points = app_module.NeuralBeamSimulationApp._build_or_load_inner_points.__get__(obj)\nobj._get_scientific_region_name = app_module.NeuralBeamSimulationApp._get_scientific_region_name.__get__(obj)\nobj._get_inner_structure_name = app_module.NeuralBeamSimulationApp._get_inner_structure_name.__get__(obj)\nobj.latest_results = [\n    (0.1, 6.9, (1.5, 2.2, 3.8, -1.6, 5.0, 6.3, 1.1)),\n    (0.3, 7.3, (2.2, 5.0, 4.1)),\n]\nclass DummyStatus:\n    def set(self, *a, **k): pass\nclass DummyRoot:\n    def update_idletasks(self): pass\nobj.status_var = DummyStatus()\nobj.root = DummyRoot()\n\nt0=time.time()\nobj.show_cortical_overlay = app_module.NeuralBeamSimulationApp.show_cortical_overlay.__get__(obj)\nobj.show_cortical_overlay()\nprint(\"total render time:\", round(time.time()-t0,2))\nimport os\nprint(\"HTML size KB:\", round(os.path.getsize(\"labeled_clean_brain.html\")/1024,1))\n\nhtml = open(\"labeled_clean_brain.html\").read()\nprint(\"has darkred inner trace:\", '\"color\":\"darkred\"' in html)\nprint(\"has Thalamus text:\", \"Thalamus\" in html)\nEOF\n", "description": "Final full end-to-end confirmation"}, "message": "Final full end-to-end confirmation", "integration_name": "File Creation", "integration_icon_url": null, "tool_identifier": null, "icon_name": "commandLine", "context": null, "display_content": {"type": "json_block", "json_block": "{\"language\": \"bash\", \"code\": \"cd /home/claude/ncs && rm -f labeled_clean_brain.html && python3 - <<'EOF'\\nimport numpy as np, time\\nimport app as app_module\\n\\nclass Fake: pass\\nobj = Fake()\\nobj.mri_path = \\\"real_brain_mri_t1.nii.gz\\\"\\nobj.surface_verts_path = \\\"brain_surface_verts.npy\\\"\\nobj.surface_faces_path = \\\"brain_surface_faces.npy\\\"\\nobj.inner_points_path = \\\"brain_inner_points.npy\\\"\\nobj._build_