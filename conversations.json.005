+ btn_w >= (int)fb_info.width - 100) break; // guard overflow\\nkernel_parts/04_window_system.h:413:            // and no zero-padding width specifiers \u2014 so \\\"%02u:%02u\\\" was\\nkernel_parts/04_window_system.h:430:            int clock_box_x = (int)fb_info.width - clock_box_w - 4;\\nkernel_parts/04_window_system.h:494:            int menu_width = 150;\\nkernel_parts/04_window_system.h:497:            draw_rect_filled(context_menu_x, context_menu_y, menu_width, menu_height, ColorPalette::BUTTON_FACE);\\nkernel_parts/04_window_system.h:498:            draw_rect_filled(context_menu_x, context_menu_y, menu_width, 1, ColorPalette::BUTTON_HIGHLIGHT);\\nkernel_parts/04_window_system.h:500:            draw_rect_filled(context_menu_x+menu_width-1, context_menu_y, 1, menu_height, ColorPalette::BUTTON_SHADOW);\\nkernel_parts/04_window_system.h:501:            draw_rect_filled(context_menu_x, context_menu_y+menu_height-1, menu_width, 1, ColorPalette::BUTTON_SHADOW);\\nkernel_parts/05_io_wait_ps2_funcs.h:138:static inline void pci_write_config_dword(uint16_t bus, uint8_t device, uint8_t function, uint8_t offset, uint32_t value) {\\nkernel_parts/05_io_wait_ps2_funcs.h:140:    outl(0xCF8, address);\\nkernel_parts/05_io_wait_ps2_funcs.h:141:    outl(0xCFC, value);\\nkernel_parts/05_io_wait_ps2_funcs.h:150:    uint16_t pci_bus;\\nkernel_parts/05_io_wait_ps2_funcs.h:151:    uint8_t pci_device;\\nkernel_parts/05_io_wait_ps2_funcs.h:152:    uint8_t pci_function;\\nkernel_parts/05_io_wait_ps2_funcs.h:160:            uint32_t vid = pci_read_config_dword(bus, device, 0, 0) & 0xFFFF;\\nkernel_parts/05_io_wait_ps2_funcs.h:162:            uint32_t class_code = pci_read_config_dword(bus, device, 0, 0x08);\\nkernel_parts/05_io_wait_ps2_funcs.h:171:                usb_info.pci_bus = bus;\\nkernel_parts/05_io_wait_ps2_funcs.h:172:                usb_info.pci_device = device;\\nkernel_parts/05_io_wait_ps2_funcs.h:173:                usb_info.pci_function = 0;\\nkernel_parts/05_io_wait_ps2