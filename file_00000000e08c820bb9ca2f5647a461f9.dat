import re
from collections import Counter, defaultdict
import torch


# ============================================================
# DEVICE
# ============================================================

DEVICE = torch.device(
    "cuda" if torch.cuda.is_available() else "cpu"
)

print("Using:", DEVICE)

if DEVICE.type == "cuda":
    print("GPU:", torch.cuda.get_device_name(0))


# ============================================================
# 1. TEXT PREPROCESSING
# ============================================================


# ============================================================
# 2. VOCABULARY
# ============================================================

def tokenize(text: str) -> list[str]:
    tokens = text.lower().split()
    return [" ".join(t) for t in zip(tokens, tokens[1:], tokens[2:])]


# ============================================================
# 4. GPU TRANSITION MATRIX
# ============================================================

def build_transition_matrix(
    a,
    b,
    c,
    vocabulary_size
):

    """
    Build transition matrix directly on GPU.

        P[b, c] += 1

    """

    counts = torch.zeros(
        (
            vocabulary_size,
            vocabulary_size
        ),
        dtype=torch.float32,
        device=DEVICE
    )

    # Flattened index:
    #
    # b * vocabulary_size + c

    indices = (
        b * vocabulary_size + c
    )

    flat_counts = counts.view(-1)

    flat_counts.scatter_add_(
        0,
        indices,
        torch.ones_like(
            indices,
            dtype=torch.float32
        )
    )

    counts = flat_counts.view(
        vocabulary_size,
        vocabulary_size
    )

    # Row normalization
    row_sums = counts.sum(
        dim=1,
        keepdim=True
    )

    P = counts / row_sums.clamp_min(
        1e-12
    )

    # Dead rows become uniform
    dead = (
        row_sums.squeeze(1) == 0
    )

    if dead.any():

        P[dead] = (
            1.0 /
            vocabulary_size
        )

    return P


# ============================================================
# 5. INITIAL DISTRIBUTION
# ============================================================

def build_initial_distribution(
    encoded,
    vocabulary_size
):

    counts = torch.bincount(
        encoded,
        minlength=vocabulary_size
    ).float()

    p_t = counts / counts.sum().clamp_min(
        1e-12
    )

    return p_t


# ============================================================
# 6. COMPLETE PREPROCESSING
# ============================================================

def process_trigram_dataset(filename):

    # CPU text processing
    tokens = preprocess_text(filename)

    if len(tokens) < 3:
        raise ValueError(
            "Dataset must contain at least 3 tokens."
        )

    # GPU integer representation
    vocabulary, token_to_idx, encoded = \
        build_vocabulary(tokens)

    vocabulary_size = len(vocabulary)

    # GPU trigram construction
    a, b, c = build_trigrams(encoded)

    # GPU transition matrix
    P = build_transition_matrix(
        a,
        b,
        c,
        vocabulary_size
    )

    # GPU initial state
    p_t = build_initial_distribution(
        encoded,
        vocabulary_size
    )

    return (
        P,
        p_t,
        vocabulary,
        token_to_idx,
        encoded
    )


# ============================================================
# GPU MARKOV MODEL
# ============================================================

class MarkovModel:

    def __init__(
        self,
        P,
        vocabulary
    ):

        self.P = P
        self.vocabulary = vocabulary

        self.device = P

    # ========================================================
    # SUM-PRODUCT
    # ========================================================

    @torch.no_grad()
    def sumprod(self, p_t):

        """
        GPU sum-product:

            result[j] = SUM_i p[i] P[i,j]

        Matrix form:

            result = p_t @ P
        """

        return torch.matmul(
            p_t,
            self.P
        )

    # ========================================================
    # NORMALIZATION
    # ========================================================

    @torch.no_grad()
    def normalize(
        self,
        x,
        eps=1e-12
    ):

        x = torch.clamp(
            x,
            min=eps
        )

        return x / x.sum().clamp_min(
            eps
        )

    # ========================================================
    # NONLINEAR TRANSFORMATION
    # ========================================================

    @torch.no_grad()
    def transform(
        self,
        raw,
        p_t,
        eps=1e-12
    ):

        x = torch.clamp(
            raw,
            min=eps
        )

        exponential = torch.exp(x)

        condition = (
            exponential >=
            torch.cos(p_t)
        )

        transformed = torch.where(
            condition,
            exponential,
            raw / 2.0
        )

        return transformed

    # ========================================================
    # STEP
    # ========================================================

    @torch.no_grad()
    def step(
        self,
        p_t: torch.Tensor,
        temperature: float = 1.0,
        eps: float = 1e-12
    ) -> torch.Tensor:

        # ========================================================
        # 1. SUM-PRODUCT TRANSITION
        #
        # r[j] = Σ_i p_t[i] P[i,j]
        #
        # No sorting or permutation.
        # ========================================================

        raw = torch.matmul(
            p_t,
            self.P
        )

        # ========================================================
        # 2. CUMULATIVE SUM
        #
        # Replace any product accumulation with cumulative
        # addition while preserving index ordering.
        #
        # cumulative[j] = Σ_{k<=j} raw[k]
        # ========================================================

        cumulative = torch.cumsum(
            raw,
            dim=0
        )

        # ========================================================
        # 3. NORMALIZE
        #
        # Keeps cumulative state numerically bounded.
        # ========================================================

        cumulative = cumulative / (
            cumulative[-1].clamp_min(eps)
        )

        # ========================================================
        # 4. ELEMENT-WISE STATE TRANSFORMATION
        #
        # Index j remains vocabulary[j].
        # ========================================================

        x = torch.clamp(
            cumulative,
            min=eps
        )

        exponential = torch.exp(x)

        condition = (
            exponential >= torch.cos(p_t)
        )

        transformed = torch.where(
            condition,
            exponential,
            cumulative / 2.0
        )

        # ========================================================
        # 5. TEMPERATURE
        # ========================================================

        T = max(
            float(temperature),
            eps
        )

        logits = transformed / T

        # ========================================================
        # 6. SOFTMAX
        # ========================================================

        p_next = torch.softmax(
            logits,
            dim=0
        )

        return p_next

    # ========================================================
    # GPU TEXT GENERATION
    # ========================================================

    @torch.no_grad()
    def generate_text(
        self,
        p_t,
        length=100,
        temperature=1.0
    ):

        current_p = p_t

        generated_indices = []

        for _ in range(length):

            # GPU sampling
            token_idx = torch.multinomial(
                current_p,
                num_samples=1
            )

            generated_indices.append(
                token_idx
            )

            # GPU state propagation
            current_p = self.step(
                current_p,
                temperature
            )

        # Keep indices on GPU until generation finishes
        indices = torch.cat(
            generated_indices
        )

        # Vocabulary lookup is inherently Python-side
        return " ".join(
            self.vocabulary[i]
            for i in indices.cpu().tolist()
        )


# ============================================================
# MAIN
# ============================================================

if __name__ == "__main__":

        filename = "singlekb.txt"



        with open(filename, "r", encoding="utf-8") as f:
            vocabulary = tokenize(f.read())
        print("=" * 60)
        print("GPU MARKOV PIPELINE")
        print("=" * 60)

        print(
            "Device:",
            DEVICE
        )

        # ----------------------------------------------------
        # MODEL
        # ----------------------------------------------------

        P = defaultdict(int)

        for trigram in vocabulary:
            P[trigram] += 1

        model = MarkovModel(
            P,
            vocabulary
        )

        # ----------------------------------------------------
        # EXPLICIT SUM-PRODUCT
        # ----------------------------------------------------

       

        # ----------------------------------------------------
        # GENERATION
        # ----------------------------------------------------

        text = model.generate_text(
            P,
            length=100,
            temperature=1.0
        )

        print()
        print("=" * 60)
        print("GENERATED TEXT")
        print("=" * 60)

        print(text)

  
