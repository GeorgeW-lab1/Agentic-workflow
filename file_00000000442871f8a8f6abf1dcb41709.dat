    cookies: ['__qca'],
    keywords: ['quantserve', 'quantcast', 'audience measurement']
  }
};

// Extract page text and analyze it
function analyzePageContent() {
  // Get all visible text from the page
  const bodyText = document.body.innerText.toLowerCase();
  const htmlText = document.documentElement.innerHTML.toLowerCase();
  
  // Combine for analysis
  const fullText = bodyText + ' ' + htmlText;
  
  // Find which services are mentioned
  const detectedServices = {};
  
  for (const [serviceName, serviceData] of Object.entries(SERVICE_DATABASE)) {
    // Check for service names
    const nameFound = serviceData.names.some(name => fullText.includes(name.toLowerCase()));
    
    // Check for specific keywords
    const keywordsFound = serviceData.keywords.some(keyword => fullText.includes(keyword.toLowerCase()));
    
    if (nameFound || keywordsFound) {
      detectedServices[serviceName] = {
        confidence: (nameFound && keywordsFound) ? 'high' : 'medium',
        cookies: serviceData.cookies
      };
    }
  }
  
  // Send results to extension
  chrome.runtime.sendMessage({
    action: 'pageAnalyzed',
    detectedServices: detectedServices,
    pageUrl: window.location.href
  });
  
  return detectedServices;
}

// Run analysis
analyzePageContent();
