import math
import random
from collections import defaultdict

import torch
import torch.nn as nn
import torch.nn.functional as F
from torch.utils.data import Dataset, DataLoader


# =========================
# CONFIG
# =========================
class Config:
    text_path = "singlekb.txt"
    seed = 42
    device = "cuda" if torch.cuda.is_available() else "cpu"

    max_vocab = None
    min_freq = 0

    seq_len = 4
    batch_size = 256
    epochs = 8
    lr = 2e-3
    weight_decay = 1e-5

    d_model = 96
    d_coef = 32
    d_obj = 96
    d_part = 64
    d_mem = 96
    num_partitions = 32
    num_objects = 24
    num_experts = 4
    topk_experts = 2
    mem_slots = 4

    temp_step = 0.08

    lambda_object = 1.0
    lambda_partition = 0.7
    lambda_temporal = 0.5
    lambda_contrastive = 0.2
    lambda_recon = 1.0
    lambda_gen = 1.0
    lambda_sparse = 0.05
    lambda_mem = 0.1


# =========================
# UTILS
# =========================
def set_seed(seed):
    random.seed(seed)
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)


def tokenize(text):
    text = text.lower()
    tokens = []
    cur = []
    for ch in text:
        if ch.isalnum() or ch == "'":
            cur.append(ch)
        else:
            if cur:
                tokens.append("".join(cur))
                cur = []
            if ch in ".!?;:,()[]{}":
                tokens.append(ch)
    if cur:
        tokens.append("".join(cur))
    return tokens


def build_vocab(tokens, min_freq=1, max_vocab=None):
    freq = defaultdict(int)
    for t in tokens:
        freq[t] += 1
    items = [(t, c) for t, c in freq.items() if c >= min_freq]
    items.sort(key=lambda x: (-x[1], x[0]))
    if max_vocab is not None:
        items = items[:max_vocab]
    specials = ["<pad>", "<unk>", "<bos>", "<eos>"]
    vocab = specials + [t for t, _ in items if t not in specials]
    stoi = {t: i for i, t in enumerate(vocab)}
    itos = {i: t for t, i in stoi.items()}
    return vocab, stoi, itos


# =========================
# DATASET
# =========================
class TextWindowDataset(Dataset):
    def __init__(self, token_ids, seq_len=4):
        self.samples = [token_ids[i:i + seq_len] for i in range(len(token_ids) - seq_len)]

    def __len__(self):
        return len(self.samples)

    def __getitem__(self, idx):
        s = self.samples[idx]
        x = torch.tensor(s[:-1], dtype=torch.long)
        y = torch.tensor(s[-1], dtype=torch.long)
        return x, y


# =========================
# MEMORY GRAPH
# =========================
class DynamicMemoryGraph:
    def __init__(self, slots, dim, device):
        self.slots = slots
        self.dim = dim
        self.device = device
        self.node = torch.zeros(slots, dim, device=device)
        self.age = torch.zeros(slots, device=device)
        self.ptr = 0
        self.token_to_slot = {}

    def update(self, token_ids, features):
        with torch.no_grad():
            for tid, feat in zip(token_ids.tolist(), features):
                if tid not in self.token_to_slot:
                    sid = self.ptr
                    self.token_to_slot[tid] = sid
                    self.ptr = (self.ptr + 1) % self.slots
                else:
                    sid = self.token_to_slot[tid]
                self.node[sid] = 0.95 * self.node[sid] + 0.05 * feat
                self.age[sid] = 0
            self.age += 1

    def read(self, token_ids):
        outs = []
        for tid in token_ids.tolist():
            if tid in self.token_to_slot:
                outs.append(self.node[self.token_to_slot[tid]])
            else:
                outs.append(torch.zeros(self.dim, device=self.device))
        return torch.stack(outs, dim=0)


# =========================
# MODEL
# =========================
class NOCN(nn.Module):
    def __init__(self, vocab_size, cfg):
        super().__init__()
        self.cfg = cfg

        self.word_emb = nn.Embedding(vocab_size, cfg.d_model)
        self.pos_emb = nn.Embedding(cfg.seq_len - 1, cfg.d_model)

        self.coeff_encoder = nn.Sequential(
            nn.Linear(cfg.d_model, cfg.d_coef),
            nn.Tanh(),
            nn.Linear(cfg.d_coef, cfg.d_coef),
        )

        self.h_to_coef = nn.Linear(cfg.d_model, cfg.d_coef)
        self.coef_to_obj = nn.Linear(cfg.d_coef, cfg.d_obj)

        self.temporal_ode = nn.Sequential(
            nn.Linear(cfg.d_model + cfg.d_coef, cfg.d_obj),
            nn.SiLU(),
            nn.Linear(cfg.d_obj, cfg.d_obj),
        )

        self.partition_bank = nn.Parameter(torch.randn(cfg.num_partitions, cfg.d_part) * 0.02)
        self.partition_key = nn.Linear(cfg.d_obj, cfg.num_partitions)
        self.partition_to_obj = nn.Linear(cfg.d_part, cfg.d_obj)

        self.object_bank = nn.Parameter(torch.randn(cfg.num_objects, cfg.d_obj) * 0.02)
        self.object_key = nn.Linear(cfg.d_part, cfg.num_objects)

        self.experts = nn.ModuleList([
            nn.Sequential(
                nn.Linear(cfg.d_obj + cfg.d_part, cfg.d_obj),
                nn.ReLU(),
                nn.Linear(cfg.d_obj, cfg.d_obj),
            )
            for _ in range(cfg.num_experts)
        ])
        self.expert_gate = nn.Linear(cfg.d_obj + cfg.d_part, cfg.num_experts)

        self.mem_project = nn.Linear(cfg.d_mem, cfg.d_obj)

        self.reconstructor = nn.Sequential(
            nn.Linear(cfg.d_obj * 3, cfg.d_obj),
            nn.GELU(),
            nn.Linear(cfg.d_obj, vocab_size),
        )

        self.partition_decoder = nn.Linear(cfg.d_part, vocab_size)
        self.object_decoder = nn.Linear(cfg.d_obj, vocab_size)
        self.contrast_proj = nn.Linear(cfg.d_obj, cfg.d_obj)

    def encode_context(self, x):
        B, T = x.shape
        pos = torch.arange(T, device=x.device)
        h = self.word_emb(x) + self.pos_emb(pos)[None, :, :]
        h = h.mean(dim=1)
        c = self.coeff_encoder(h)
        return h, c

    def temporal_dynamics(self, h, c):
        z = torch.cat([h, c], dim=-1)
        dz = self.temporal_ode(z)
        return h + self.cfg.temp_step * dz

    def route_partitions(self, obj_state):
        p_logits = self.partition_key(obj_state)
        p_prob = F.softmax(p_logits, dim=-1)
        p_soft = p_prob @ self.partition_bank
        p_idx = torch.argmax(p_prob, dim=-1)
        p_vec = self.partition_bank[p_idx]
        return p_prob, p_vec, p_soft

    def route_objects(self, p_soft):
        o_logits = self.object_key(p_soft)
        o_prob = F.softmax(o_logits, dim=-1)
        o_soft = o_prob @ self.object_bank
        o_idx = torch.argmax(o_prob, dim=-1)
        o_vec = self.object_bank[o_idx]
        return o_prob, o_vec, o_soft

    def sparse_expert_mix(self, obj_state, p_soft):
        gate_logits = self.expert_gate(torch.cat([obj_state, p_soft], dim=-1))
        gate_prob = F.softmax(gate_logits, dim=-1)
        topk = torch.topk(gate_prob, k=min(self.cfg.topk_experts, gate_prob.size(-1)), dim=-1)
        mask = torch.zeros_like(gate_prob)
        mask.scatter_(1, topk.indices, 1.0)
        gate_sparse = gate_prob * mask
        gate_sparse = gate_sparse / (gate_sparse.sum(dim=-1, keepdim=True) + 1e-8)

        inp = torch.cat([obj_state, p_soft], dim=-1)
        mixed = torch.zeros(obj_state.size(0), self.cfg.d_obj, device=obj_state.device)
        for i, expert in enumerate(self.experts):
            mixed = mixed + gate_sparse[:, i:i + 1] * expert(inp)
        return mixed, gate_prob, gate_sparse

    def forward(self, x, memory_read):
        h, c = self.encode_context(x)
        obj_state = self.temporal_dynamics(h, c)
        p_prob, p_vec, p_soft = self.route_partitions(obj_state)
        o_prob, o_vec, o_soft = self.route_objects(p_soft)
        expert_out, gate_prob, gate_sparse = self.sparse_expert_mix(obj_state, p_soft)

        if memory_read.dim() == 1:
            memory_read = memory_read.unsqueeze(0).expand(x.size(0), -1)
        mem = self.mem_project(memory_read)

        recon_in = torch.cat([expert_out, o_soft, mem], dim=-1)
        logits = self.reconstructor(recon_in)

        part_logits = self.partition_decoder(p_soft)
        obj_logits = self.object_decoder(o_soft)

        return {
            "logits": logits,
            "part_logits": part_logits,
            "obj_logits": obj_logits,
            "obj_state": obj_state,
            "p_prob": p_prob,
            "o_prob": o_prob,
            "gate_prob": gate_prob,
            "gate_sparse": gate_sparse,
            "p_soft": p_soft,
            "o_soft": o_soft,
            "h": h,
            "c": c,
        }

    def loss_fn(self, out, y, token_ids, memory_graph):
        logits = out["logits"]
        part_logits = out["part_logits"]
        obj_logits = out["obj_logits"]
        p_prob = out["p_prob"]
        o_prob = out["o_prob"]
        gate_sparse = out["gate_sparse"]
        obj_state = out["obj_state"]

        object_loss = F.cross_entropy(obj_logits, y)
        partition_loss = F.cross_entropy(part_logits, y)
        recon_loss = F.cross_entropy(logits, y)
        gen_loss = F.cross_entropy(logits, y)

        coef_target = self.h_to_coef(out["h"].detach())
        temporal_target = torch.tanh(out["h"].detach() + 0.1 * self.coef_to_obj(coef_target))
        temporal_loss = F.mse_loss(obj_state, temporal_target)

        p_ent = -(p_prob * (p_prob + 1e-8).log()).sum(dim=-1).mean()
        o_ent = -(o_prob * (o_prob + 1e-8).log()).sum(dim=-1).mean()
        sparse_loss = p_ent + o_ent + (gate_sparse.sum(dim=-1) - 1.0).abs().mean()

        z = F.normalize(self.contrast_proj(obj_state), dim=-1)
        sim = z @ z.t()
        eye = torch.eye(sim.size(0), device=sim.device)
        contrastive_loss = ((sim - eye) ** 2).mean()

        mem_read = memory_graph.read(token_ids)
        mem_loss = F.mse_loss(mem_read, out["h"].detach())

        total = (
            self.cfg.lambda_object * object_loss +
            self.cfg.lambda_partition * partition_loss +
            self.cfg.lambda_temporal * temporal_loss +
            self.cfg.lambda_contrastive * contrastive_loss +
            self.cfg.lambda_recon * recon_loss +
            self.cfg.lambda_gen * gen_loss +
            self.cfg.lambda_sparse * sparse_loss +
            self.cfg.lambda_mem * mem_loss
        )

        return total, {
            "total": total.item(),
            "object": object_loss.item(),
            "partition": partition_loss.item(),
            "temporal": temporal_loss.item(),
            "contrast": contrastive_loss.item(),
            "recon": recon_loss.item(),
            "sparse": sparse_loss.item(),
            "mem": mem_loss.item(),
        }


# =========================
# GENERATION
# =========================
@torch.no_grad()
def generate(model, memory_graph, stoi, itos, seed_text, max_new_tokens=40, temperature=0.9):
    model.eval()
    toks = tokenize(seed_text)
    ids = [stoi.get(t, stoi["<unk>"]) for t in toks]
    if len(ids) < 3:
        ids = [stoi["<bos>"], stoi["<bos>"], stoi["<bos>"]] + ids
    out = toks[:]

    for _ in range(max_new_tokens):
        x = torch.tensor([ids[-3:]], device=next(model.parameters()).device)
        mem = memory_graph.read(x[0]).mean(dim=0)
        res = model(x, mem)
        logits = res["logits"][0] / temperature
        probs = F.softmax(logits, dim=-1)
        nxt = torch.multinomial(probs, 1).item()
        out.append(itos[nxt])
        ids.append(nxt)
        ids = ids[-3:]

    return " ".join(out)


# =========================
# TRAINING
# =========================
def train():
    cfg = Config()
    set_seed(cfg.seed)
    device = torch.device(cfg.device)

    text = open(cfg.text_path, "r", encoding="utf-8").read()
    toks = tokenize(text)
    vocab, stoi, itos = build_vocab(toks, min_freq=cfg.min_freq, max_vocab=cfg.max_vocab)
    token_ids = [stoi["<bos>"]] + [stoi.get(t, stoi["<unk>"]) for t in toks] + [stoi["<eos>"]]

    ds = TextWindowDataset(token_ids, seq_len=cfg.seq_len)
    dl = DataLoader(ds, batch_size=cfg.batch_size, shuffle=True, drop_last=True)

    model = NOCN(len(vocab), cfg).to(device)
    memory = DynamicMemoryGraph(cfg.mem_slots, cfg.d_mem, device)
    opt = torch.optim.AdamW(model.parameters(), lr=cfg.lr, weight_decay=cfg.weight_decay)

    print("device:", device)
    print("vocab:", len(vocab))
    print("samples:", len(ds))

    for ep in range(cfg.epochs):
        model.train()
        running = 0.0
        stats = defaultdict(float)
        n = 0

        for x, y in dl:
            x = x.to(device)
            y = y.to(device)

            mem_read = memory.read(x[:, -1])
            out = model(x, mem_read)
            loss, ls = model.loss_fn(out, y, x[:, -1], memory)

            opt.zero_grad(set_to_none=True)
            loss.backward()
            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
            opt.step()

            with torch.no_grad():
                memory.update(x[:, -1], out["h"].detach())

            running += loss.item()
            for k, v in ls.items():
                stats[k] += v
            n += 1

        print(
            f"epoch {ep+1}/{cfg.epochs} | loss {running/n:.4f} | "
            f"obj {stats['object']/n:.4f} | part {stats['partition']/n:.4f} | "
            f"temp {stats['temporal']/n:.4f} | ctr {stats['contrast']/n:.4f}"
        )
        print("sample:", generate(model, memory, stoi, itos, "the car", 24, 0.9))
        print()

    return model, memory, stoi, itos


if __name__ == "__main__":
    model, memory, stoi, itos = train()

    while True:
        try:
            seed = input("USER: ").strip()
            if not seed:
                continue
            print(generate(model, memory, stoi, itos, seed, max_new_tokens=60))
            print()
        except (KeyboardInterrupt, EOFError):
            break

